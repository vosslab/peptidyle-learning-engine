# Containerfile.api - multi-stage image for the Peptidyle API server (WP-F4).
#
# Build from the repo root so the whole Cargo workspace is in context:
#   podman build -f containers/Containerfile.api -t peptidyle-api .
#
# Two stages, because a Rust toolchain is roughly 1.5 GB and the running
# service needs none of it. The final image carries the binary and TLS trust
# store -- nothing else.

# ---------- stage 1: build ----------
# Rust 1.97.1 on Debian Trixie. The official multi-architecture OCI index
# includes both linux/amd64 and linux/arm64; refresh this tag and digest together.
FROM docker.io/library/rust:1.97.1-trixie@sha256:3382bd20aa942806c533e9a73cd000474fb3ef173f71e684cc9b942675781769 AS builder

WORKDIR /build

# Copy manifests first so dependency compilation caches independently of source
# edits. Without this split, every source change rebuilds every dependency.
COPY Cargo.toml Cargo.lock ./
COPY crates crates
# SQLx embeds the verified migration baseline in the server binary. Keep this
# authoritative directory as an explicit build input instead of relying on a
# developer's wider working tree.
COPY schemas/migrations schemas/migrations

# --locked fails the build if Cargo.lock would need to change, which is what
# makes a container build reproducible rather than "whatever resolved today".
# The default production target deliberately has no E2E-only features.
FROM builder AS e2e-observability-builder
RUN cargo build --release --locked --bin server_core --features e2e-observability,local-disposable-storage

FROM builder AS live-demo-builder
RUN cargo build --release --locked --bin server_core --features local-disposable-storage

FROM builder AS production-builder
RUN cargo build --release --locked --bin server_core

# ---------- stage 2: runtime ----------
# Keep the runtime on the builder's Debian release and pin the official
# multi-architecture OCI index (linux/amd64 and linux/arm64).
FROM docker.io/library/debian:13.5-slim@sha256:28de0877c2189802884ccd20f15ee41c203573bd87bb6b883f5f46362d24c5c2 AS runtime-base
LABEL org.opencontainers.image.source="https://github.com/vosslab/peptidyle-learning-engine"

# ca-certificates: TLS trust for S3 and PostgreSQL.
RUN apt-get update \
	&& apt-get install --no-install-recommends --yes ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Run as a non-root user. A compromised web process should not own its own
# filesystem.
RUN useradd --system --create-home --uid 10001 peptidyle
USER peptidyle
WORKDIR /home/peptidyle

# Configuration and credentials arrive from the environment at run time. No
# credential is baked into this image, and there is no default that would let
# the server reach an unintended database.
ENV PLE_BIND_ADDR=0.0.0.0:3000
EXPOSE 3000

# The health check is the same endpoint the orchestrator uses: it returns 200
# only after a real SELECT 1 and a real bucket probe.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
	CMD ["/usr/local/bin/peptidyle-api", "--health-probe"]

FROM runtime-base AS e2e-observability
COPY --from=e2e-observability-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]

FROM runtime-base AS live-demo
COPY --from=live-demo-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]

# Keep this final target production-safe for direct `podman build` use. The
# replica E2E Compose override selects the named target above explicitly.
FROM runtime-base AS production
COPY --from=production-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]
