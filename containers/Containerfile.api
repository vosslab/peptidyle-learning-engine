# Containerfile.api - multi-stage image for the Peptidyle API server.
#
# Build from the repo root so the whole Cargo workspace is in context:
#   podman build -f containers/Containerfile.api -t peptidyle-api .
#
# Two stages, because a Rust toolchain is roughly 1.5 GB and the running
# service needs none of it. The final image carries the binary and TLS trust
# store -- nothing else.

# ---------- stage 1: build ----------
# Use the current official Rust toolchain image.
FROM docker.io/library/rust:latest AS builder

WORKDIR /build

# Copy manifests first so dependency compilation caches independently of source
# edits. Without this split, every source change rebuilds every dependency.
COPY Cargo.toml Cargo.lock ./
COPY crates crates
# The server embeds exactly the reviewed current RDKit JS/WASM pair at compile
# time. Keep these two source files in the builder context, not the runtime image.
COPY assets/author-content-dependencies/rdkit/RDKit_minimal.js assets/author-content-dependencies/rdkit/RDKit_minimal.wasm assets/author-content-dependencies/rdkit/
# SQLx embeds the forward-migration directory in the server binary. The
# database-migrator target also packages the canonical base manifest from this
# explicit source instead of relying on a developer's wider working tree.
COPY schemas/base_schema schemas/base_schema
COPY schemas/installation_data schemas/installation_data
COPY schemas/migrations schemas/migrations
COPY content/genetics content/genetics
COPY content/pilot content/pilot

# --locked fails the build if Cargo.lock would need to change, which is what
# makes a container build reproducible rather than "whatever resolved today".
# The default production target deliberately has no E2E-only features.
FROM builder AS e2e-observability-builder
RUN cargo build --release --locked --bin server_core --features e2e-observability,local-disposable-storage

FROM builder AS live-demo-builder
RUN cargo build --release --locked --bin server_core --features local-disposable-storage

# The local controller executes migrations in a one-shot Compose job so the
# administration client shares the database network on every supported Podman
# connection. It is not included in the API runtime image.
FROM builder AS database-migrator-builder
RUN cargo build --release --locked -p project-tools

FROM builder AS production-builder
RUN cargo build --release --locked --bin server_core

# ---------- stage 2: runtime ----------
# Use the current stable Debian runtime.
FROM docker.io/library/debian:stable-slim AS runtime-base
LABEL org.opencontainers.image.source="https://github.com/vosslab/peptidyle-learning-engine"

# ca-certificates: TLS trust for S3 and PostgreSQL.
RUN apt-get update \
	&& apt-get install --no-install-recommends --yes ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Run as a non-root user. A compromised web process should not own its own
# filesystem.
RUN useradd --system --create-home --uid 10001 peptidyle
USER peptidyle
WORKDIR /home/peptidyle

# Configuration and credentials arrive from the environment at run time. No
# credential is baked into this image, and there is no default that would let
# the server reach an unintended database.
ENV PLE_BIND_ADDR=0.0.0.0:3000
EXPOSE 3000

# The health check is the same endpoint the orchestrator uses: it returns 200
# only after a real SELECT 1 and a real bucket probe.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
	CMD ["/usr/local/bin/peptidyle-api", "--health-probe"]

FROM runtime-base AS e2e-observability
COPY --from=e2e-observability-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]

FROM runtime-base AS live-demo
COPY --from=live-demo-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]

FROM runtime-base AS database-migrator
# The migrator alone runs the canonical PostgreSQL installation manifest and
# carries its client capability. API, live-demo, and production runtime targets
# carry only their application capability (ASVS 15.2.3).
USER root
RUN apt-get update \
	&& apt-get install --no-install-recommends --yes postgresql-client \
	&& rm -rf /var/lib/apt/lists/*
USER peptidyle
COPY --from=database-migrator-builder /build/target/release/project-tools /usr/local/bin/ple-database-tools
COPY --chown=peptidyle:peptidyle --from=database-migrator-builder /build/schemas/base_schema /opt/ple/schemas/base_schema
COPY --chown=peptidyle:peptidyle --from=database-migrator-builder /build/schemas/installation_data /opt/ple/schemas/installation_data
COPY --chown=peptidyle:peptidyle --from=database-migrator-builder /build/schemas/migrations /opt/ple/schemas/migrations
COPY --chown=peptidyle:peptidyle --from=database-migrator-builder /build/content/genetics /opt/ple/content/genetics
COPY --chown=peptidyle:peptidyle --from=database-migrator-builder /build/content/pilot /opt/ple/content/pilot
HEALTHCHECK NONE
ENTRYPOINT ["/usr/local/bin/ple-database-tools"]

# Keep this final target production-safe for direct `podman build` use. The
# canonical local Compose file selects the live-demo target explicitly.
FROM runtime-base AS production
COPY --from=production-builder /build/target/release/server_core /usr/local/bin/peptidyle-api
ENTRYPOINT ["/usr/local/bin/peptidyle-api"]
