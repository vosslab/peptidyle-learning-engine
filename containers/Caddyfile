{
	# The canonical Live Demo browser gateway is HTTPS-only. Caddy's internal CA
	# stays inside the disposable stack; automated browser runners accept only
	# the selected owner's certificate. Human browsers retain their own trust policy.
	auto_https disable_redirects
	skip_install_trust
	admin off
	persist_config off
	servers {
		protocols h1
		max_header_size 64KB
		timeouts {
			read_body 30s
			read_header 5s
			write 30s
			idle 30s
		}
	}
}

# This is the one Live Demo browser gateway used by the human launcher and
# Playwright. It serves the production browser bundle, proxies the ordinary API,
# and exposes the disposable installation's public object-storage namespace.
# API-shaped and public-asset paths never fall through to index.html.
https://localhost:8080 {
	bind 0.0.0.0
	tls internal

	# These headers apply even to error responses generated by the edge. The API
	# owns dynamic-response policy as well; shared headers deliberately use the
	# same values at both layers.
	header {
		-Server
		?Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Application routes can deliberately own a narrower CORP value. In
		# particular, C901's two fixed public RDKit assets must remain
		# cross-origin for the opaque author-content sandbox; every response
		# without an explicit policy remains same-origin.
		?Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# Readiness has to forward a dependency's own bounded 503. The active
	# replica health policy below is intentionally not used for this request:
	# a degraded dependency makes an API replica report 503 while it remains
	# able to serve all unaffected routes.
	@health path /health
	handle @health {
		reverse_proxy {
			@api_unavailable status 502 504
			handle_response @api_unavailable {
				respond `{"status":"degraded","unavailable":["api"]}` 503
			}
			dynamic a api 3000 {
				refresh 2s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 1
			transport http {
				network_proxy none
				versions 1.1
				dial_timeout 2s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {
			# A stopped API cannot produce its own readiness body. Map only the
			# edge's upstream failure response to the bounded M2 readiness form.
			@api_unavailable status 502 503 504
			handle_response @api_unavailable {
				respond `{"status":"degraded","unavailable":["api"]}` 503
			}
			# Dynamic A discovery asks Compose DNS for every api replica instead of
			# resolving one container name once at gateway startup. Caddy refreshes
			# this bounded list while requests are being served.
			dynamic a api 3000 {
				refresh 2s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 1
			# Replica readiness is determined only by the dedicated semantic health
			# route. A bounded backend such as WebWork can intentionally return 503
			# without evicting an otherwise healthy API replica or breaking native
			# learning, authentication, and course navigation.
			health_uri /health
			health_interval 5s
			health_timeout 2s
			health_status 200
			transport http {
				network_proxy none
				# Keep the local edge and upstream on the same unambiguous protocol.
				# Do not add HTTP/2-to-HTTP/1 downgrade behavior here.
				versions 1.1
				dial_timeout 2s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	# Public Live Demo assets use the same HTTPS origin as the application. The
	# browser profile attaches this gateway to the disposable storage network;
	# no second edge configuration owns this route.
	@public_assets path /public-assets /public-assets/*
	handle @public_assets {
		reverse_proxy minio:9000 {
			transport http {
				network_proxy none
				versions 1.1
			}
		}
	}

	# ASVS 3.4.2 and 3.5.8: these installation-published files are the exact
	# PLE-owned dependencies of the opaque WeBWorK preview. Serve them without
	# consulting credentials and fail as files instead of falling through to the SPA.
	@opaque_preview_public_code {
		path /styles/ple_embed.css /ple_bridge.js
		file {
			root /srv/peptidyle
			try_files {path}
		}
	}
	handle @opaque_preview_public_code {
		header Cache-Control "no-store"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/peptidyle
		file_server
	}
	@opaque_preview_code_path path /styles/ple_embed.css /ple_bridge.js
	handle @opaque_preview_code_path {
		respond 404
	}

	# Opaque-origin font fetches additionally require noncredentialed CORS.
	@opaque_preview_public_font {
		path /assets/fonts/atkinson_hyperlegible_next/atkinson_hyperlegible_next_variable.woff2 /assets/fonts/atkinson_hyperlegible_next/atkinson_hyperlegible_next_variable_italic.woff2 /assets/fonts/atkinson_hyperlegible_mono/atkinson_hyperlegible_mono_variable.woff2 /assets/fonts/atkinson_hyperlegible_mono/atkinson_hyperlegible_mono_variable_italic.woff2
		file {
			root /srv/peptidyle
			try_files {path}
		}
	}
	handle @opaque_preview_public_font {
		header Cache-Control "no-store"
		header Cross-Origin-Resource-Policy "cross-origin"
		header Access-Control-Allow-Origin "*"
		root * /srv/peptidyle
		file_server
	}
	@opaque_preview_font_path path /assets/fonts/atkinson_hyperlegible_next/atkinson_hyperlegible_next_variable.woff2 /assets/fonts/atkinson_hyperlegible_next/atkinson_hyperlegible_next_variable_italic.woff2 /assets/fonts/atkinson_hyperlegible_mono/atkinson_hyperlegible_mono_variable.woff2 /assets/fonts/atkinson_hyperlegible_mono/atkinson_hyperlegible_mono_variable_italic.woff2
	handle @opaque_preview_font_path {
		respond 404
	}

	handle {
		# Scripts remain same-origin. The browser bundle uses catalog-owned inline
		# custom properties and component-scoped styles; learner and author content
		# reaches text and allowlisted presentation nodes rather than style sinks.
		header Content-Security-Policy "base-uri 'none'; default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-src 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'"
		root * /srv/peptidyle
		try_files {path} /index.html
		file_server
	}

	# A dial failure never reaches reverse_proxy's response interceptor. Restrict
	# error normalization to readiness so a stopped API has the same bounded M2
	# response while unrelated edge errors preserve their own behavior.
	handle_errors {
		@readiness_api_unavailable expression `{path} == "/health" && ({err.status_code} == 502 || {err.status_code} == 504)`
		handle @readiness_api_unavailable {
			respond `{"status":"degraded","unavailable":["api"]}` 503
		}
	}
}
