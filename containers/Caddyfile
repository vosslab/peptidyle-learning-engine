{
	auto_https off
	# This is the loopback-only development edge.  Keep its parser surface small
	# and bounded: it speaks HTTP/1.1 on both sides of the proxy rather than
	# accepting HTTP/2 and downgrading it to the Axum HTTP/1.1 upstream.  A real
	# HTTPS edge belongs to deployment configuration, where HTTP/2 must be kept
	# end-to-end or independently desync-tested.
	admin off
	persist_config off
	servers :8080 {
		protocols h1
		max_header_size 64KB
		timeouts {
			read_body 30s
			read_header 5s
			write 30s
			idle 30s
		}
	}
}

# The local gateway is deliberately small: it is not an authentication,
# storage, asset, or renderer boundary. It serves the browser bundle built on
# the host and proxies PLE's HTTP API to all currently discoverable Compose
# `api` replicas. API-shaped paths never fall through to index.html.
:8080 {
	# These headers apply even to error responses generated by the edge. The API
	# owns dynamic-response policy as well; shared headers deliberately use the
	# same values at both layers.
	header {
		-Server
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	@api path /api /api/* /health
	handle @api {
		reverse_proxy {
			# Dynamic A discovery asks Compose DNS for every api replica instead of
			# resolving one container name once at gateway startup. Caddy refreshes
			# this bounded list while requests are being served.
			dynamic a api 3000 {
				refresh 2s
				versions ipv4
			}
			lb_policy round_robin
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			max_fails 1
			# Replica readiness is determined only by the dedicated semantic health
			# route. A bounded backend such as WebWork can intentionally return 503
			# without evicting an otherwise healthy API replica or breaking native
			# learning, authentication, and course navigation.
			health_uri /health
			health_interval 5s
			health_timeout 2s
			health_status 200
			transport http {
				network_proxy none
				# Keep the local edge and upstream on the same unambiguous protocol.
				# Do not add HTTP/2-to-HTTP/1 downgrade behavior here.
				versions 1.1
				dial_timeout 2s
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
		}
	}

	handle {
		# Scripts remain same-origin. The browser bundle uses catalog-owned inline
		# custom properties and component-scoped styles; learner and author content
		# reaches text and allowlisted presentation nodes rather than style sinks.
		header Content-Security-Policy "base-uri 'none'; default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; frame-src 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'"
		root * /srv/peptidyle
		try_files {path} /index.html
		file_server
	}
}
