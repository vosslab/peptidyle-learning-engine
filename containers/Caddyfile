{
	auto_https off
}

# The local gateway is deliberately small: it is not an authentication,
# storage, asset, or renderer boundary. It proxies PLE's HTTP API to all
# currently discoverable Compose `api` replicas.
:8080 {
	reverse_proxy {
		# Dynamic A discovery asks Compose DNS for every api replica instead of
		# resolving one container name once at gateway startup. Caddy refreshes
		# this bounded list while requests are being served.
		dynamic a api 3000 {
			refresh 2s
			versions ipv4
		}
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 10s
		max_fails 1
		# Readiness is semantic: a replica that can answer HTTP but reports its
		# persistent dependencies degraded must leave the round-robin pool until
		# the short passive-health window elapses.
		unhealthy_status 503
		transport http {
			network_proxy none
			dial_timeout 2s
			response_header_timeout 30s
			read_timeout 30s
			write_timeout 30s
		}
	}
}
