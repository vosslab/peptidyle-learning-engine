# env.example - template for containers/env.local (WP-F4).
#
# Copy this file, then set real values:
#   cp containers/env.example containers/env.local
#
# containers/env.local is gitignored. Never commit real credentials, and never
# reuse these development values anywhere reachable from a network.
#
# Use the maintained launcher so image-pin validation, the PostgreSQL-major
# guard, migrations, seed data, and readiness checks run in
# the required order:
#   ./run_live_demo.sh --headless
#
# After the launcher reports readiness, deliberately exercise two API replicas
# through the same gateway with the fixed replica owner command.

# PostgreSQL superuser for local development. In a deployed environment the
# application connects as a non-superuser role that cannot bypass row-level
# security; this account is for migrations and local convenience only.
POSTGRES_USER=peptidyle
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=peptidyle
# PostgreSQL is pinned to the official PostgreSQL 17 multi-architecture
# manifest.  The launcher verifies this is a 64-character lowercase SHA-256
# before it ever starts a container.
PLE_POSTGRES_IMAGE_SHA256=7958605b474b3d264a969cb3a123d6aa00ad1e1fe9da8a69984dabb704d93317
# Local-only password for the migration-created `ple_grading_reader` login.
# The root launcher generates and provisions this automatically. A deployed
# environment supplies its own secret and never shares the application login.
PLE_LOCAL_AUTOMATED_GRADING_PASSWORD=change-me-before-first-run
# All host-facing infrastructure ports remain loopback-only. The defaults are
# convenient for a local stack; an isolated container E2E project can select
# unused values without touching another developer's stack.
PLE_POSTGRES_HOST_PORT=5432

# MinIO root credentials. The API and worker containers receive these as
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=peptidyle
MINIO_ROOT_PASSWORD=change-me-before-first-run
PLE_MINIO_API_HOST_PORT=9000
PLE_MINIO_CONSOLE_HOST_PORT=9001
# Pin both object-storage images.  These are public Linux manifest digests,
# not mutable release tags.
PLE_MINIO_IMAGE_SHA256=14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
PLE_MINIO_MC_IMAGE_SHA256=a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# Bounded worker-pool controls. The defaults allow one job to finish inside
# its lease and keep idle polling inexpensive; each process handles one job at
# a time so shutdown is observed between claims. Scale the worker service for
# concurrency instead of increasing an in-process batch.
PLE_WORKER_LEASE_SECONDS=120
PLE_WORKER_PREPARATION_TIMEOUT_SECONDS=90
PLE_WORKER_POLL_MILLIS=500

# The gateway is the only host-published PLE HTTP listener. It discovers API
# replicas with Caddy's dynamic A upstream support. The image repository is
# fixed to the official Caddy Linux image, which supplies the `curl` readiness
# probe used by Compose. This digest is required: mutable tags are deliberately
# rejected. Choose an official image with Caddy's standard dynamic A module.
PLE_GATEWAY_HOST_PORT=8080
PLE_GATEWAY_IMAGE_SHA256=844f60b64e4724a5aa8245e019dace0d3f199f7433ce6c57676cb30a920dbad9

# Local development public base for immutable learner-facing assets. Private
# sources, archives, renders, and course banners use a separate bucket and
# never enter this public URL namespace.
PLE_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:9000/public-assets

# PLE-owned passwordless WebAuthn relying-party identity. Production origins
# must use HTTPS. Exact http://localhost is accepted only for local development.
# RP ID changes invalidate every registered passkey, so treat it as durable.
PLE_WEBAUTHN_RP_ID=localhost
PLE_WEBAUTHN_ORIGIN=http://localhost:8080
PLE_WEBAUTHN_RP_NAME=Peptidyle Learning Engine

# The launcher creates this ignored mode-0600 canonical 32-byte base64url
# secret. It issues one-time course invitation links and derives passwordless
# rate-limit keys; it is not an SMTP credential and never enters env.local.
PLE_INVITATION_TOKEN_SECRET_HOST_FILE=

# Dedicated key for random human-facing Question IDs and their validation
# character. Keep it durable: changing it invalidates existing Question IDs.
PLE_QUESTION_ID_SECRET_HOST_FILE=

# Optional external SMTP submission. PLE does not run a mail server. Leave
# these empty and omit the optional SMTP Compose overlay until an operator has
# selected a credible provider and created a provider-specific token. Port 587
# normally uses starttls; port 465 normally uses implicit-tls. The public app
# URL must be the deployed HTTPS origin because one-time sign-in links bind to
# that browser origin.
PLE_SMTP_RELAY=
PLE_SMTP_PORT=
PLE_SMTP_TLS_MODE=
PLE_SMTP_USERNAME=
PLE_SMTP_PASSWORD_HOST_FILE=
PLE_SMTP_FROM=
PLE_PUBLIC_APP_BASE_URL=

# The private renderer is the image built and maintained by the standalone
# webwork-pg-renderer project, not the WebWork2 assignment platform.
# The reviewed local sibling build is selected by its designated image name.
# At startup PLE resolves this name to an OCI configuration ID, verifies the
# running container uses that exact ID, and records both values as run
# provenance. A deployment that pulls a published renderer may use its
# registry `repository@sha256:...` value through this same setting.
PLE_WEBWORK_RENDERER_IMAGE=localhost/pg-renderer:reviewed
# Official Alpine 3.21 multi-architecture OCI index for native API secret
# initializers.
PLE_SECRET_INIT_IMAGE_SHA256=48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

# Compose supplies this private service root. The browser never receives it.
PLE_WEBWORK_RENDERER_BASE_URL=http://webwork-renderer:3000/
PLE_WEBWORK_RENDERER_ID=vosslab-webwork-pg-renderer
PLE_WEBWORK_REQUEST_TIMEOUT_SECONDS=15
PLE_WEBWORK_MAX_RESPONSE_BYTES=1048576
# Private renderer-internal JWT signing keys. The local launcher generates
# independent values in the ignored mode-0600 env.local file. They let normal
# Compose logs, stop, and restart commands resolve the renderer configuration;
# they are not PLE grading authority or durable renderer data.
PLE_WEBWORK_PROBLEM_JWT_SECRET=change-me-before-first-run
PLE_WEBWORK_SESSION_JWT_SECRET=change-me-before-first-run

# Contracted iMathAS scored-embed provider. Leaving PLE_IMATHAS_PROVIDER_KEY
# absent disables iMathAS entirely: its protected launch/activity/submission
# routes are not mounted. Generic hosted MyOpenMath is not a supported
# provider. When enabling a reviewed, self-hosted provider, keep every secret
# below in deployment secret storage rather than this tracked example.
# PLE_IMATHAS_PROVIDER_KEY=institution-imathas
# PLE_IMATHAS_BASE_URL=https://imathas.internal.example
# PLE_IMATHAS_REQUEST_TIMEOUT_SECONDS=15
# PLE_IMATHAS_MAX_TRANSPORT_BYTES=1048576
# PLE_IMATHAS_MAX_SNAPSHOT_BYTES=1048576
# PLE_IMATHAS_MAX_RESULT_BYTES=8192
# PLE_IMATHAS_LAUNCH_TTL_MILLIS=30000
# PLE_IMATHAS_LAUNCH_STATE_SECRET=<canonical-32-byte-base64url-secret>
# PLE_IMATHAS_CORRELATION_SECRET=<canonical-32-byte-base64url-secret>
# PLE_IMATHAS_LAUNCH_SIGNING_SECRET=<deployment-secret>
# PLE_IMATHAS_RESULT_VERIFICATION_SECRET=<deployment-secret>
# PLE_IMATHAS_PROVIDER_AUTH_HEADER_NAME=x-ple-provider-auth
# PLE_IMATHAS_PROVIDER_AUTH_VALUE=<deployment-secret>

# Published QTI/native grading uses the separately provisioned
# `ple_grading_reader` URL assembled by Compose from PLE_LOCAL_AUTOMATED_GRADING_PASSWORD.
# It is never the API's DATABASE_URL and never a role-switching URL. Deployment
# secret storage must replace this local-only convenience.
