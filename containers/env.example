# env.example - template for containers/env.local (WP-F4).
#
# Copy this file, then set real values:
#   cp containers/env.example containers/env.local
#
# containers/env.local is gitignored. Never commit real credentials, and never
# reuse these development values anywhere reachable from a network.
#
# Usage:
#   podman compose -f containers/compose.yaml --env-file containers/env.local up -d
#
# The API is reached through the gateway.  To deliberately exercise two
# replicas locally, use:
#   podman compose -f containers/compose.yaml --env-file containers/env.local up -d --scale api=2

# PostgreSQL superuser for local development. In a deployed environment the
# application connects as a non-superuser role that cannot bypass row-level
# security; this account is for migrations and local convenience only.
POSTGRES_USER=peptidyle
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=peptidyle
# All host-facing infrastructure ports remain loopback-only. The defaults are
# convenient for a local stack; an isolated container E2E project can select
# unused values without touching another developer's stack.
PLE_POSTGRES_HOST_PORT=5432

# MinIO root credentials. The api container receives these as
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=peptidyle
MINIO_ROOT_PASSWORD=change-me-before-first-run
PLE_MINIO_API_HOST_PORT=9000
PLE_MINIO_CONSOLE_HOST_PORT=9001

# The gateway is the only host-published PLE HTTP listener. It discovers API
# replicas with Caddy's dynamic A upstream support. The image repository is
# fixed to the official Caddy Linux image, which supplies the `curl` readiness
# probe used by Compose. This digest is required: mutable tags are deliberately
# rejected. Choose an official image with Caddy's standard dynamic A module.
PLE_GATEWAY_HOST_PORT=3000
PLE_GATEWAY_IMAGE_SHA256=

# Local development identity file. Create a separate file from
# containers/local-identities.example.json, replace its empty credentials list
# with generated-token SHA-256 records, and set this to its host path. The API
# receives only /run/ple/local-identities.json; it never receives this host
# path, a bearer token, or a credential hash through its environment.
#
# This is required even for local-only use. Leaving it blank makes Compose stop
# with a clear error before it starts the API.
PLE_LOCAL_AUTH_HOST_FILE=

# Local development public base for immutable content assets. In deployment,
# set this to the institution's public CDN/origin URL for the content bucket.
PLE_PUBLIC_ASSET_BASE_URL=http://127.0.0.1:9000/content

# WeBWorK renderer (MOD-ADP-WW). The renderer remains private to compose: the
# API reaches it through the internal renderer_private network and no host
# port is published. Select the maintained renderer HTTP image for your
# institution and pin the exact immutable manifest digest. PLE intentionally
# supplies no image default because the repository does not define an upstream
# renderer HTTP contract.
PLE_WEBWORK_RENDERER_IMAGE_REPOSITORY=
PLE_WEBWORK_RENDERER_IMAGE_SHA256=

# This must name only the private Compose service, never a public endpoint.
# Match its port and HTTP path to the pinned renderer's documented contract.
PLE_WEBWORK_RENDERER_BASE_URL=http://webwork-renderer:8080

# The server-side renderer client uses this bounded deadline. Measure and tune
# it for the local workload; it is never a browser-selected value.
PLE_WEBWORK_REQUEST_TIMEOUT_SECONDS=15

# The API bounds untrusted renderer response bytes. This is a server-only
# limit, not a browser-provided setting. The single request deadline above
# also bounds connection setup in `HttpWebworkRenderer`.
PLE_WEBWORK_MAX_RESPONSE_BYTES=1048576

# These must exactly match the pinned renderer's response identity. They are
# compatibility IDs, not the repository's CalVer release version.
PLE_WEBWORK_RENDERER_ID=
PLE_WEBWORK_RENDERER_VERSION=

# Optional renderer authorization is intentionally not included in Compose's
# normal environment list: leaving it absent is the explicit no-auth mode.
# An institution that requires it adds both values through a private deploy
# override; never put the header value in a tracked env file.
# PLE_WEBWORK_RENDERER_AUTH_HEADER_NAME=
# PLE_WEBWORK_RENDERER_AUTH_HEADER_VALUE=

# Contracted iMathAS scored-embed provider. Leaving PLE_IMATHAS_PROVIDER_KEY
# absent disables iMathAS entirely: its protected launch/activity/submission
# routes are not mounted. Generic hosted MyOpenMath is not a supported
# provider. When enabling a reviewed, self-hosted provider, keep every secret
# below in deployment secret storage rather than this tracked example.
# PLE_IMATHAS_PROVIDER_KEY=institution-imathas
# PLE_IMATHAS_BASE_URL=https://imathas.internal.example
# PLE_IMATHAS_REQUEST_TIMEOUT_SECONDS=15
# PLE_IMATHAS_MAX_TRANSPORT_BYTES=1048576
# PLE_IMATHAS_MAX_SNAPSHOT_BYTES=1048576
# PLE_IMATHAS_MAX_RESULT_BYTES=8192
# PLE_IMATHAS_LAUNCH_TTL_MILLIS=30000
# PLE_IMATHAS_LAUNCH_STATE_SECRET=<canonical-32-byte-base64url-secret>
# PLE_IMATHAS_CORRELATION_SECRET=<canonical-32-byte-base64url-secret>
# PLE_IMATHAS_LAUNCH_SIGNING_SECRET=<deployment-secret>
# PLE_IMATHAS_RESULT_VERIFICATION_SECRET=<deployment-secret>
# PLE_IMATHAS_PROVIDER_AUTH_HEADER_NAME=x-ple-provider-auth
# PLE_IMATHAS_PROVIDER_AUTH_VALUE=<deployment-secret>

# Published QTI runtime. Leave both settings absent to keep QTI unsupported;
# the generic routes then cannot dispatch it. Enable only as this exact pair.
# The grader URL is a separately provisioned `ple_qti_grader` login, never the
# API's DATABASE_URL and never a role-switching URL. Keep it in deployment
# secret storage rather than this tracked example.
# PLE_QTI_RUNTIME_ENABLED=1
# PLE_GRADER_DATABASE_URL=postgres://ple_qti_grader:<deployment-secret>@postgres:5432/${POSTGRES_DB:-peptidyle}

# A shell command supported by the selected pinned renderer image, such as its
# documented loopback HTTP readiness request. Keeping this explicit prevents
# PLE from assuming a route, port, or health tool that the shipped service does
# not provide.
PLE_WEBWORK_RENDERER_HEALTHCHECK=
