# ASVS 15.2.4: build from official upstream sources and images.
# MinIO's community distribution is source-only; build both executables once
# and share the resulting image between the server and bucket initializer.
FROM docker.io/library/golang:latest AS build
ENV CGO_ENABLED=0 GOBIN=/out GOMAXPROCS=2
RUN go install -p 2 github.com/minio/mc@latest
RUN go install -p 2 github.com/minio/minio@latest

FROM docker.io/library/alpine:latest
COPY --from=build /out/minio /out/mc /usr/bin/
ENV HOME=/tmp
USER 10001:10001
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data"]
