DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4A9C_72BE';
<p>4a9c_72be</p> <p>For the ABO blood group in humans, the i<sup>A</sup> and i<sup>B</sup> alleles are codominant and the i allele is recessive.</p><p>If a female &female; with <u>type B blood</u> marries a male &male; with <u>type A blood</u>, which of the following blood types could their children possibly have? Check all that apply.</p>
PROMPT_4A9C_72BE
loadMacros('parserCheckboxList.pl');
$choice_1 = <<'LITERAL_4A9C_72BE_CHOICE_1';
Type O blood
LITERAL_4A9C_72BE_CHOICE_1
$choice_2 = <<'LITERAL_4A9C_72BE_CHOICE_2';
Type A blood
LITERAL_4A9C_72BE_CHOICE_2
$choice_3 = <<'LITERAL_4A9C_72BE_CHOICE_3';
Type B blood
LITERAL_4A9C_72BE_CHOICE_3
$choice_4 = <<'LITERAL_4A9C_72BE_CHOICE_4';
Type AB blood
LITERAL_4A9C_72BE_CHOICE_4
$correct_1 = <<'LITERAL_4A9C_72BE_CORRECT_1';
Type O blood
LITERAL_4A9C_72BE_CORRECT_1
$correct_2 = <<'LITERAL_4A9C_72BE_CORRECT_2';
Type A blood
LITERAL_4A9C_72BE_CORRECT_2
$correct_3 = <<'LITERAL_4A9C_72BE_CORRECT_3';
Type B blood
LITERAL_4A9C_72BE_CORRECT_3
$correct_4 = <<'LITERAL_4A9C_72BE_CORRECT_4';
Type AB blood
LITERAL_4A9C_72BE_CORRECT_4
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
@correct = ($correct_1, $correct_2, $correct_3, $correct_4);
$answer = CheckboxList([@choices], [@correct], labels => 'ABC', displayLabels => 1, randomize => 0, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->checks\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
