DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B676_CAA8';
<p>b676_caa8</p> <h3>Phenotype Diversity in Hybrid Cross</h3><p>In a hybrid cross, you can determine the variety of phenotypes in the offspring by examining the genetic makeup of the parents. Specifically, look at whether each gene can be dominant, recessive, or both.</p><p>A dominant gene can mask the effect of its recessive counterpart, thus influencing the number of unique phenotypes.</p><p><i>Hint: To find the number of unique phenotypes, consider each gene pair. <br/>For gene pairs with at least one heterozygous and one either heterozygous or homozygous recessive gene, 2 phenotypes are possible. <br/>For all other combinations, only 1 phenotype is possible.</i></p><p>Assume complete dominance and the principle of independent assortment for all genes.</p><p>Given these principles, how many unique <span style="color: OrangeRed;"><strong>PHENOTYPES</strong></span> could result from a hybrid cross between the following individuals?</p><table style='border-collapse: collapse; border: 1px solid black;'><tbody><tr><td style='padding-left: 10px; padding-right: 10px;'>Female (&female;)</td><td style='padding-left: 10px; padding-right: 10px;'><span style="font-family: monospace; font-size: 1.3em; background-color: #f0f0f0; padding: 3px 6px; border-radius: 4px;">AA Bb Cc Dd ee FF </span></td></tr><tr><td style='padding-left: 10px; padding-right: 10px;'>Male (&male;)</td><td style='padding-left: 10px; padding-right: 10px;'><span style="font-family: monospace; font-size: 1.3em; background-color: #f0f0f0; padding: 3px 6px; border-radius: 4px;">aa Bb CC Dd Ee Ff </span></td></tr></tbody></table>
PROMPT_B676_CAA8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B676_CAA8_CHOICE_1';
2<sup>2</sup> &nbsp; = 4 (<i>i.e.</i> 2 genes with two forms)
LITERAL_B676_CAA8_CHOICE_1
$choice_2 = <<'LITERAL_B676_CAA8_CHOICE_2';
2 &times; 3 &nbsp; = 6 (<i>i.e.</i> 1 gene with two forms and 1 gene with three forms)
LITERAL_B676_CAA8_CHOICE_2
$choice_3 = <<'LITERAL_B676_CAA8_CHOICE_3';
2<sup>3</sup> &nbsp; = 8 (<i>i.e.</i> 3 genes with two forms)
LITERAL_B676_CAA8_CHOICE_3
$choice_4 = <<'LITERAL_B676_CAA8_CHOICE_4';
2<sup>2</sup> &times; 3 &nbsp; = 12 (<i>i.e.</i> 2 genes with two forms and 1 gene with three forms)
LITERAL_B676_CAA8_CHOICE_4
$choice_5 = <<'LITERAL_B676_CAA8_CHOICE_5';
2<sup>3</sup> &times; 3 &nbsp; = 24 (<i>i.e.</i> 3 genes with two forms and 1 gene with three forms)
LITERAL_B676_CAA8_CHOICE_5
$correct_1 = <<'LITERAL_B676_CAA8_CORRECT_1';
2<sup>3</sup> &nbsp; = 8 (<i>i.e.</i> 3 genes with two forms)
LITERAL_B676_CAA8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
