DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4577_4683';
<p>4577_4683</p> <h3>Gamete Diversity in Sexual Reproduction</h3><p>In sexual reproduction, the potential diversity of gametes &ndash; such as sperm and eggs in animals, or pollen and ovules in plants &ndash; can be calculated based on the genotype of an individual.</p><p>How many unique <span style="color: Green;"><strong>GAMETES</strong></span> could be produced through the process of independent assortment by an individual with the following genotype?</p> <p><i>Hint: Remember, each heterozygous gene pair (like `Aa` or `Bb`) can give rise to two (2) different gametes, while homozygous pairs (like `AA`, `BB`, and `aa`, `bb`) can only give rise to one gamete.</i></p><p><strong>Genotype:</strong>&nbsp;<span style="font-family: monospace; font-size: 1.3em; background-color: #f0f0f0; padding: 3px 6px; border-radius: 4px;">AA Bb cc Dd ee ff Gg </span></p>
PROMPT_4577_4683
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4577_4683_CHOICE_1';
2<sup>2</sup> = 4 (i.e., two genes with two alternative forms each)
LITERAL_4577_4683_CHOICE_1
$choice_2 = <<'LITERAL_4577_4683_CHOICE_2';
2<sup>3</sup> = 8 (i.e., three genes with two alternative forms each)
LITERAL_4577_4683_CHOICE_2
$choice_3 = <<'LITERAL_4577_4683_CHOICE_3';
2<sup>4</sup> = 16 (i.e., four genes with two alternative forms each)
LITERAL_4577_4683_CHOICE_3
$choice_4 = <<'LITERAL_4577_4683_CHOICE_4';
2<sup>5</sup> = 32 (i.e., five genes with two alternative forms each)
LITERAL_4577_4683_CHOICE_4
$choice_5 = <<'LITERAL_4577_4683_CHOICE_5';
2<sup>6</sup> = 64 (i.e., six genes with two alternative forms each)
LITERAL_4577_4683_CHOICE_5
$correct_1 = <<'LITERAL_4577_4683_CORRECT_1';
2<sup>3</sup> = 8 (i.e., three genes with two alternative forms each)
LITERAL_4577_4683_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
