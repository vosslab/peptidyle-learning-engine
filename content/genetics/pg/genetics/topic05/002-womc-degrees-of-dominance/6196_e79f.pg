DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6196_E79F';
<p>6196_e79f</p> <p>Which one of the following inheritance patterns correspond to the definition <span style='font-size: 1em;'><strong>'heterozygotes equally express both alleles in the phenotype'</strong></span>.</p>
PROMPT_6196_E79F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6196_E79F_CHOICE_1';
codominance
LITERAL_6196_E79F_CHOICE_1
$choice_2 = <<'LITERAL_6196_E79F_CHOICE_2';
complete dominance
LITERAL_6196_E79F_CHOICE_2
$choice_3 = <<'LITERAL_6196_E79F_CHOICE_3';
epistasis
LITERAL_6196_E79F_CHOICE_3
$choice_4 = <<'LITERAL_6196_E79F_CHOICE_4';
incomplete dominance
LITERAL_6196_E79F_CHOICE_4
$correct_1 = <<'LITERAL_6196_E79F_CORRECT_1';
codominance
LITERAL_6196_E79F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
