DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_97C9_B062';
<p>97c9_b062</p> <h3>Genotype Diversity in Hybrid Cross</h3><p>In a hybrid cross, the range of possible genotypes in the offspring is determined by the genetic makeup of the parental organisms.</p><p>Assume that all genes sort independently and display complete dominance.</p><p><i>Hint: For each gene pair from the parents, you can get 1, 2, or 3 unique genotypes.<br/>This is based on the combinations: homozygous x homozygous (1), homozygous x heterozygous (2), and heterozygous x heterozygous (3).</i></p><p>Considering the principle of independent assortment, how many unique <span style="color: MediumBlue;"><strong>GENOTYPES</strong></span> could be produced in a hybrid cross between the following individuals?</p><table style='border-collapse: collapse; border: 1px solid black;'><tbody><tr><td style='padding-left: 10px; padding-right: 10px;'>Female (&female;)</td><td style='padding-left: 10px; padding-right: 10px;'><span style="font-family: monospace; font-size: 1.3em; background-color: #f0f0f0; padding: 3px 6px; border-radius: 4px;">Aa BB cc Dd EE FF </span></td></tr><tr><td style='padding-left: 10px; padding-right: 10px;'>Male (&male;)</td><td style='padding-left: 10px; padding-right: 10px;'><span style="font-family: monospace; font-size: 1.3em; background-color: #f0f0f0; padding: 3px 6px; border-radius: 4px;">aa Bb CC Dd ee Ff </span></td></tr></tbody></table>
PROMPT_97C9_B062
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_97C9_B062_CHOICE_1';
2<sup>2</sup> &nbsp; = 4 (<i>i.e.</i> 2 genes with two forms)
LITERAL_97C9_B062_CHOICE_1
$choice_2 = <<'LITERAL_97C9_B062_CHOICE_2';
2 &times; 3 &nbsp; = 6 (<i>i.e.</i> 1 gene with two forms and 1 gene with three forms)
LITERAL_97C9_B062_CHOICE_2
$choice_3 = <<'LITERAL_97C9_B062_CHOICE_3';
2<sup>3</sup> &nbsp; = 8 (<i>i.e.</i> 3 genes with two forms)
LITERAL_97C9_B062_CHOICE_3
$choice_4 = <<'LITERAL_97C9_B062_CHOICE_4';
2<sup>3</sup> &times; 3 &nbsp; = 24 (<i>i.e.</i> 3 genes with two forms and 1 gene with three forms)
LITERAL_97C9_B062_CHOICE_4
$choice_5 = <<'LITERAL_97C9_B062_CHOICE_5';
2<sup>5</sup> &nbsp; = 32 (<i>i.e.</i> 5 genes with two forms)
LITERAL_97C9_B062_CHOICE_5
$correct_1 = <<'LITERAL_97C9_B062_CORRECT_1';
2<sup>3</sup> &times; 3 &nbsp; = 24 (<i>i.e.</i> 3 genes with two forms and 1 gene with three forms)
LITERAL_97C9_B062_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
