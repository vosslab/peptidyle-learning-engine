## DESCRIPTION
## Imported Genetics source row b36d_3b3c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic05/bbq-MATCH-degrees_of_dominance-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B36D_3B3C';
<p>b36d_3b3c</p> <p>Match each of the following inheritance patterns with their corresponding definitions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_B36D_3B3C
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_B36D_3B3C_MATCH_TERM_0';
<span style="color: #006e58;">epistasis</span>
LITERAL_B36D_3B3C_MATCH_TERM_0
$match_term_1 = <<'LITERAL_B36D_3B3C_MATCH_TERM_1';
<span style="color: #666100;">complete dominance</span>
LITERAL_B36D_3B3C_MATCH_TERM_1
$match_term_2 = <<'LITERAL_B36D_3B3C_MATCH_TERM_2';
<span style="color: #7142a7;">incomplete dominance</span>
LITERAL_B36D_3B3C_MATCH_TERM_2
$match_term_3 = <<'LITERAL_B36D_3B3C_MATCH_TERM_3';
<span style="color: #9a3740;">codominance</span>
LITERAL_B36D_3B3C_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_B36D_3B3C_MATCH_CHOICE_0';
one gene suppresses the effect of another gene that is<strong> <strong>NOT</strong> </strong>its allele
LITERAL_B36D_3B3C_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_B36D_3B3C_MATCH_CHOICE_1';
one allele masks the effect of another allele
LITERAL_B36D_3B3C_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_B36D_3B3C_MATCH_CHOICE_2';
heterozygote appearance is a blended phenotype of both homozygous phenotypes
LITERAL_B36D_3B3C_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_B36D_3B3C_MATCH_CHOICE_3';
heterozygotes equally express both alleles in the phenotype
LITERAL_B36D_3B3C_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
