## DESCRIPTION
## Imported Genetics source row 3a19_9122; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic07/bbq-chi_square_hypotheses-pair-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3A19_9122';
<p>3a19_9122</p> <p>You perform a dihybrid testcross (AaBb &times; aabb) and count the offspring phenotypes.</p><p>Total offspring scored: <span style='font-family: monospace;'>272</span></p><table style="border: 1px solid black; border-collapse: collapse;"><colgroup width="220"></colgroup><colgroup width="80"></colgroup><colgroup width="90"></colgroup><colgroup width="90"></colgroup><tr> <th align='center' colspan='4' style='background-color: silver'>Observed data</th> </tr><tr> <th align='center' style='background-color: lightgray'>Category</th> <th align='center' style='background-color: lightgray'>Ratio</th> <th align='center' style='background-color: lightgray'>Expected</th> <th align='center' style='background-color: lightgray'>Observed</th> </tr><tr> <td>&nbsp;A&ndash;B&ndash;</td> <td align='center'>1</td> <td align='center'>68</td> <td align='center'>71</td></tr><tr> <td>&nbsp;A&ndash;bb</td> <td align='center'>1</td> <td align='center'>68</td> <td align='center'>74</td></tr><tr> <td>&nbsp;aaB&ndash;</td> <td align='center'>1</td> <td align='center'>68</td> <td align='center'>65</td></tr><tr> <td>&nbsp;aabb</td> <td align='center'>1</td> <td align='center'>68</td> <td align='center'>62</td></tr></table><hr/> <p>For a chi-squared (&chi;<sup>2</sup>) goodness-of-fit test, which option correctly states the null hypothesis (H<sub>0</sub>) and the alternative hypothesis (H<sub>A</sub>)?</p>
PROMPT_3A19_9122
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3A19_9122_CHOICE_1';
<p><b>H<sub>0</sub></b>: The offspring proportions are consistent with the expected 1:1:1:1 ratio (any differences from the expected ratio are due to chance).<br/><b>H<sub>A</sub></b>: The offspring proportions are not consistent with the expected 1:1:1:1 ratio (the differences are too large to explain by chance alone).</p>
LITERAL_3A19_9122_CHOICE_1
$choice_2 = <<'LITERAL_3A19_9122_CHOICE_2';
<p><b>H<sub>0</sub></b>: The offspring proportions are not consistent with the expected 1:1:1:1 ratio (the differences are too large to explain by chance alone).<br/><b>H<sub>A</sub></b>: The offspring proportions are consistent with the expected 1:1:1:1 ratio (any differences from the expected ratio are due to chance).</p>
LITERAL_3A19_9122_CHOICE_2
$choice_3 = <<'LITERAL_3A19_9122_CHOICE_3';
<p><b>H<sub>0</sub></b>: The observed counts are exactly in a 1:1:1:1 ratio.<br/><b>H<sub>A</sub></b>: The observed counts are not exactly in a 1:1:1:1 ratio.</p>
LITERAL_3A19_9122_CHOICE_3
$choice_4 = <<'LITERAL_3A19_9122_CHOICE_4';
<p><b>H<sub>0</sub></b>: The offspring proportions are consistent with the expected 9:3:3:1 ratio (any differences from the expected ratio are due to chance).<br/><b>H<sub>A</sub></b>: The offspring proportions are not consistent with the expected 9:3:3:1 ratio (the differences are too large to explain by chance alone).</p>
LITERAL_3A19_9122_CHOICE_4
$correct_1 = <<'LITERAL_3A19_9122_CORRECT_1';
<p><b>H<sub>0</sub></b>: The offspring proportions are consistent with the expected 1:1:1:1 ratio (any differences from the expected ratio are due to chance).<br/><b>H<sub>A</sub></b>: The offspring proportions are not consistent with the expected 1:1:1:1 ratio (the differences are too large to explain by chance alone).</p>
LITERAL_3A19_9122_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
