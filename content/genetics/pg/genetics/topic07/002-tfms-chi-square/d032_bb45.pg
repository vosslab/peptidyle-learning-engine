## DESCRIPTION
## Imported Genetics source row d032_bb45; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic07/bbq-TFMS-chi-square-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D032_BB45';
<p>d032_bb45</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> concerning chi-square (&chi;&sup2;) tests?</p>
PROMPT_D032_BB45
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D032_BB45_CHOICE_1';
the <strong><span style="color: #076dad;">null hypothesis, H<sub>0</sub></span></strong> <strong>is <span style="color: #007a00;">NOT REJECTED</span></strong> if the <strong><span style="color: #0067cc;">chi-square (&chi;&sup2;) statistic</span></strong> is <strong>larger than</strong> the <strong><span style="color: #935d00;">critical value</span></strong>
LITERAL_D032_BB45_CHOICE_1
$choice_2 = <<'LITERAL_D032_BB45_CHOICE_2';
the <strong><span style="color: #c80085;">alternative hypothesis, H<sub>a</sub></span></strong> <strong>is <span style="color: #d40000;">NOT SUPPORTED</span></strong> if the <strong><span style="color: #3b7600;">p-value</span></strong> is <strong>larger than</strong> the <strong><span style="color: #935d00;">critical value</span></strong>
LITERAL_D032_BB45_CHOICE_2
$choice_3 = <<'LITERAL_D032_BB45_CHOICE_3';
the <strong><span style="color: #076dad;">null hypothesis, H<sub>0</sub></span></strong> <strong>is <span style="color: #d40000;">REJECTED</span></strong> if the <strong><span style="color: #3b7600;">p-value</span></strong> is <strong>larger than</strong> the <strong><span style="color: #935d00;">critical value</span></strong>
LITERAL_D032_BB45_CHOICE_3
$choice_4 = <<'LITERAL_D032_BB45_CHOICE_4';
the <strong><span style="color: #c80085;">alternative hypothesis, H<sub>a</sub></span></strong> <strong>is <span style="color: #007a00;">SUPPORTED</span></strong> if the <strong><span style="color: #0067cc;">chi-square (&chi;&sup2;) statistic</span></strong> is <strong>less than</strong> the <strong><span style="color: #935d00;">critical value</span></strong>
LITERAL_D032_BB45_CHOICE_4
$choice_5 = <<'LITERAL_D032_BB45_CHOICE_5';
the <strong><span style="color: #076dad;">null hypothesis, H<sub>0</sub></span></strong> <strong>is <span style="color: #007a00;">NOT REJECTED</span></strong> if the <strong><span style="color: #3b7600;"><strong><span style="color: #3b7600;">p-value</span></strong></span></strong> is <strong><strong>larger than</strong></strong> the <strong><span style="color: #b74300;">level of significance, &alpha;</span></strong>
LITERAL_D032_BB45_CHOICE_5
$correct_1 = <<'LITERAL_D032_BB45_CORRECT_1';
the <strong><span style="color: #076dad;">null hypothesis, H<sub>0</sub></span></strong> <strong>is <span style="color: #007a00;">NOT REJECTED</span></strong> if the <strong><span style="color: #3b7600;"><strong><span style="color: #3b7600;">p-value</span></strong></span></strong> is <strong><strong>larger than</strong></strong> the <strong><span style="color: #b74300;">level of significance, &alpha;</span></strong>
LITERAL_D032_BB45_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
