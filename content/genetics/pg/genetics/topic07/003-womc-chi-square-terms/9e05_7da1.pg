## DESCRIPTION
## Imported Genetics source row 9e05_7da1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic07/bbq-WOMC-chi-square_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9E05_7DA1';
<p>9e05_7da1</p> <p>Which one of the following <strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> terms correspond to the definition <span style='font-size: 1em;'><strong>'we are attempting to <strong><span style="color: #4d8426;">support</span> </strong>this hypothesis indirectly by using the <strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> test'</strong></span>.</p>
PROMPT_9E05_7DA1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9E05_7DA1_CHOICE_1';
<strong><span style="color: #cf4b03;">alternative hypothesis, H<sub>a</sub></span></strong>
LITERAL_9E05_7DA1_CHOICE_1
$choice_2 = <<'LITERAL_9E05_7DA1_CHOICE_2';
<strong><span style="color: #4424D6;">critical value</span></strong>
LITERAL_9E05_7DA1_CHOICE_2
$choice_3 = <<'LITERAL_9E05_7DA1_CHOICE_3';
<strong><span style="color: #8601AF;">level of significance, &alpha;</span></strong>
LITERAL_9E05_7DA1_CHOICE_3
$choice_4 = <<'LITERAL_9E05_7DA1_CHOICE_4';
<strong><span style="color: #0247FE;">null hypothesis, H<sub>0</sub></span></strong>
LITERAL_9E05_7DA1_CHOICE_4
$choice_5 = <<'LITERAL_9E05_7DA1_CHOICE_5';
<strong><span style="color: #C21460;">p-value</span></strong>
LITERAL_9E05_7DA1_CHOICE_5
$correct_1 = <<'LITERAL_9E05_7DA1_CORRECT_1';
<strong><span style="color: #cf4b03;">alternative hypothesis, H<sub>a</sub></span></strong>
LITERAL_9E05_7DA1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
