## DESCRIPTION
## Imported Genetics source row b55f_c78e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic07/bbq-WOMC-chi-square_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B55F_C78E';
<p>b55f_c78e</p> <p>Which one of the following <strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> terms correspond to the definition <span style='font-size: 1em;'><strong>'the fixed probability for whether or<strong> <strong>NOT</strong> </strong>the <strong><span style="color: #0247FE;">null hypothesis, H<sub>0</sub></span></strong> can be <strong><span style="color: #4d8426;">supported</span></strong>'</strong></span>.</p>
PROMPT_B55F_C78E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B55F_C78E_CHOICE_1';
<strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> test statistic
LITERAL_B55F_C78E_CHOICE_1
$choice_2 = <<'LITERAL_B55F_C78E_CHOICE_2';
<strong><span style="color: #4424D6;">critical value</span></strong>
LITERAL_B55F_C78E_CHOICE_2
$choice_3 = <<'LITERAL_B55F_C78E_CHOICE_3';
<strong><span style="color: #8601AF;">level of significance, &alpha;</span></strong>
LITERAL_B55F_C78E_CHOICE_3
$choice_4 = <<'LITERAL_B55F_C78E_CHOICE_4';
<strong><span style="color: #0247FE;">null hypothesis, H<sub>0</sub></span></strong>
LITERAL_B55F_C78E_CHOICE_4
$choice_5 = <<'LITERAL_B55F_C78E_CHOICE_5';
<strong><span style="color: #C21460;">p-value</span></strong>
LITERAL_B55F_C78E_CHOICE_5
$correct_1 = <<'LITERAL_B55F_C78E_CORRECT_1';
<strong><span style="color: #8601AF;">level of significance, &alpha;</span></strong>
LITERAL_B55F_C78E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
