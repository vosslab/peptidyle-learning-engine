## DESCRIPTION
## Imported Genetics source row b75a_89aa; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic07/bbq-WOMC-chi-square_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B75A_89AA';
<p>b75a_89aa</p> <p>Which one of the following <strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> terms correspond to the definition <span style='font-size: 1em;'><strong>'found in a table for a given degrees of freedom and <strong><span style="color: #8601AF;">level of significance, &alpha;</span></strong>'</strong></span>.</p>
PROMPT_B75A_89AA
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B75A_89AA_CHOICE_1';
<strong><span style="color: #cf4b03;">alternative hypothesis, H<sub>a</sub></span></strong>
LITERAL_B75A_89AA_CHOICE_1
$choice_2 = <<'LITERAL_B75A_89AA_CHOICE_2';
<strong><span style="color: #aa6701;">chi-square (&chi;&sup2;)</span></strong> test statistic
LITERAL_B75A_89AA_CHOICE_2
$choice_3 = <<'LITERAL_B75A_89AA_CHOICE_3';
<strong><span style="color: #4424D6;">critical value</span></strong>
LITERAL_B75A_89AA_CHOICE_3
$choice_4 = <<'LITERAL_B75A_89AA_CHOICE_4';
<strong><span style="color: #687f19;">degrees of freedom</span></strong>
LITERAL_B75A_89AA_CHOICE_4
$choice_5 = <<'LITERAL_B75A_89AA_CHOICE_5';
<strong><span style="color: #8601AF;">level of significance, &alpha;</span></strong>
LITERAL_B75A_89AA_CHOICE_5
$correct_1 = <<'LITERAL_B75A_89AA_CORRECT_1';
<strong><span style="color: #4424D6;">critical value</span></strong>
LITERAL_B75A_89AA_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
