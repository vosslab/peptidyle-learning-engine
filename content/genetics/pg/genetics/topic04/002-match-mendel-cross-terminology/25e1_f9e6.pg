## DESCRIPTION
## Imported Genetics source row 25e1_f9e6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-MATCH-mendel_cross_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_25E1_F9E6';
<p>25e1_f9e6</p> <p>Match each of the following Mendelian crosses and generational stages with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_25E1_F9E6
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_25E1_F9E6_MATCH_TERM_0';
<strong><span style="color: #007a00;">F<sub>2</sub> generation</span></strong>
LITERAL_25E1_F9E6_MATCH_TERM_0
$match_term_1 = <<'LITERAL_25E1_F9E6_MATCH_TERM_1';
<strong><span style="color: #3b7600;">backcross</span></strong>
LITERAL_25E1_F9E6_MATCH_TERM_1
$match_term_2 = <<'LITERAL_25E1_F9E6_MATCH_TERM_2';
<strong><span style="color: #007576;">hybrid cross</span></strong>
LITERAL_25E1_F9E6_MATCH_TERM_2
$match_term_3 = <<'LITERAL_25E1_F9E6_MATCH_TERM_3';
<strong><span style="color: #c80085;">P generation</span></strong>
LITERAL_25E1_F9E6_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_25E1_F9E6_MATCH_CHOICE_0';
the generation resulting from the mating of <strong><span style="color: #b74300;">F<sub>1</sub> generation</span></strong> hybrids
LITERAL_25E1_F9E6_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_25E1_F9E6_MATCH_CHOICE_1';
a genetic cross to trace the <strong><span style="color: #935d00;">inheritance</span></strong> of a specific trait back to one of the original parents
LITERAL_25E1_F9E6_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_25E1_F9E6_MATCH_CHOICE_2';
a type of cross that mates two true-breeding individuals with different <strong><span style="color: #cc0066;"><strong><span style="color: #cc0066;">phenotype</span></strong></span></strong>
LITERAL_25E1_F9E6_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_25E1_F9E6_MATCH_CHOICE_3';
this generation consists of two true-breeding individuals, each exhibiting different traits, participating in a <strong><span style="color: #007576;">hybrid cross</span></strong>
LITERAL_25E1_F9E6_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
