## DESCRIPTION
## Imported Genetics source row 95a9_c075; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_95A9_C075';
<p>95a9_c075</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'describes a <strong><span style="color: #b74300;">trait</span></strong> whose expression is masked by another <strong><span style="color: #b74300;">trait</span></strong> when the <strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong> for both <strong><span style="color: #b74300;"><strong><span style="color: #b74300;">trait</span></strong>s</span></strong> are present'</strong></span>.</p>
PROMPT_95A9_C075
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_95A9_C075_CHOICE_1';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_95A9_C075_CHOICE_1
$choice_2 = <<'LITERAL_95A9_C075_CHOICE_2';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_95A9_C075_CHOICE_2
$choice_3 = <<'LITERAL_95A9_C075_CHOICE_3';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_95A9_C075_CHOICE_3
$choice_4 = <<'LITERAL_95A9_C075_CHOICE_4';
<strong><span style="color: #b74300;">trait</span></strong>
LITERAL_95A9_C075_CHOICE_4
$correct_1 = <<'LITERAL_95A9_C075_CORRECT_1';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_95A9_C075_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
