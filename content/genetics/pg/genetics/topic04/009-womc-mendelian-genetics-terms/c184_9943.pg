## DESCRIPTION
## Imported Genetics source row c184_9943; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C184_9943';
<p>c184_9943</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'variants of the gene'</strong></span>.</p>
PROMPT_C184_9943
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C184_9943_CHOICE_1';
<strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong>
LITERAL_C184_9943_CHOICE_1
$choice_2 = <<'LITERAL_C184_9943_CHOICE_2';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_C184_9943_CHOICE_2
$choice_3 = <<'LITERAL_C184_9943_CHOICE_3';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_C184_9943_CHOICE_3
$choice_4 = <<'LITERAL_C184_9943_CHOICE_4';
<strong><span style="color: #007576;">phenotype</span></strong>
LITERAL_C184_9943_CHOICE_4
$correct_1 = <<'LITERAL_C184_9943_CORRECT_1';
<strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong>
LITERAL_C184_9943_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
