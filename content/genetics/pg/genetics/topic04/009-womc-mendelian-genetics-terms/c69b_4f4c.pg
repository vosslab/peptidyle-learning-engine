## DESCRIPTION
## Imported Genetics source row c69b_4f4c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C69B_4F4C';
<p>c69b_4f4c</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'when two copies of a gene are different'</strong></span>.</p>
PROMPT_C69B_4F4C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C69B_4F4C_CHOICE_1';
<strong><span style="color: #007a00;">heterozygous</span></strong>
LITERAL_C69B_4F4C_CHOICE_1
$choice_2 = <<'LITERAL_C69B_4F4C_CHOICE_2';
<strong><span style="color: #c80085;">homozygous</span></strong>
LITERAL_C69B_4F4C_CHOICE_2
$choice_3 = <<'LITERAL_C69B_4F4C_CHOICE_3';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_C69B_4F4C_CHOICE_3
$choice_4 = <<'LITERAL_C69B_4F4C_CHOICE_4';
<strong><span style="color: #b74300;">trait</span></strong>
LITERAL_C69B_4F4C_CHOICE_4
$correct_1 = <<'LITERAL_C69B_4F4C_CORRECT_1';
<strong><span style="color: #007a00;">heterozygous</span></strong>
LITERAL_C69B_4F4C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
