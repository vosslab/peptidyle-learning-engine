DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8130_4DB6';
<p>8130_4db6</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'this <strong><span style="color: #6c6c00;">allele</span></strong> is masked if both <strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong> differ'</strong></span>.</p>
PROMPT_8130_4DB6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8130_4DB6_CHOICE_1';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_8130_4DB6_CHOICE_1
$choice_2 = <<'LITERAL_8130_4DB6_CHOICE_2';
<strong><span style="color: #007a00;">heterozygous</span></strong>
LITERAL_8130_4DB6_CHOICE_2
$choice_3 = <<'LITERAL_8130_4DB6_CHOICE_3';
<strong><span style="color: #c80085;">homozygous</span></strong>
LITERAL_8130_4DB6_CHOICE_3
$choice_4 = <<'LITERAL_8130_4DB6_CHOICE_4';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_8130_4DB6_CHOICE_4
$correct_1 = <<'LITERAL_8130_4DB6_CORRECT_1';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_8130_4DB6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
