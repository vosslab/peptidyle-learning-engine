## DESCRIPTION
## Imported Genetics source row 775a_8b03; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_775A_8B03';
<p>775a_8b03</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'an <strong><span style="color: #6c6c00;">allele</span></strong> that masks another <strong><span style="color: #6c6c00;">allele</span></strong> in the presence of both <strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong>'</strong></span>.</p>
PROMPT_775A_8B03
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_775A_8B03_CHOICE_1';
<strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong>
LITERAL_775A_8B03_CHOICE_1
$choice_2 = <<'LITERAL_775A_8B03_CHOICE_2';
<strong><span style="color: #00775f;">dominant</span></strong>
LITERAL_775A_8B03_CHOICE_2
$choice_3 = <<'LITERAL_775A_8B03_CHOICE_3';
<strong><span style="color: #c80085;">homozygous</span></strong>
LITERAL_775A_8B03_CHOICE_3
$choice_4 = <<'LITERAL_775A_8B03_CHOICE_4';
<strong><span style="color: #b74300;">trait</span></strong>
LITERAL_775A_8B03_CHOICE_4
$correct_1 = <<'LITERAL_775A_8B03_CORRECT_1';
<strong><span style="color: #00775f;">dominant</span></strong>
LITERAL_775A_8B03_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
