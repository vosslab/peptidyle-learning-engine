DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B854_244B';
<p>b854_244b</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'all the <strong><span style="color: #003fff;">observable</span></strong> <strong><span style="color: #b74300;"><strong><span style="color: #b74300;">trait</span></strong>s</span></strong> of an individual, such as height and eye color'</strong></span>.</p>
PROMPT_B854_244B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B854_244B_CHOICE_1';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_B854_244B_CHOICE_1
$choice_2 = <<'LITERAL_B854_244B_CHOICE_2';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_B854_244B_CHOICE_2
$choice_3 = <<'LITERAL_B854_244B_CHOICE_3';
<strong><span style="color: #007576;">phenotype</span></strong>
LITERAL_B854_244B_CHOICE_3
$choice_4 = <<'LITERAL_B854_244B_CHOICE_4';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_B854_244B_CHOICE_4
$correct_1 = <<'LITERAL_B854_244B_CORRECT_1';
<strong><span style="color: #007576;">phenotype</span></strong>
LITERAL_B854_244B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
