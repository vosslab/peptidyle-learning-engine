## DESCRIPTION
## Imported Genetics source row 17a7_0bd3; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_17A7_0BD3';
<p>17a7_0bd3</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'a single feature that can be inherited and varies among organisms, like seed color'</strong></span>.</p>
PROMPT_17A7_0BD3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_17A7_0BD3_CHOICE_1';
<strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong>
LITERAL_17A7_0BD3_CHOICE_1
$choice_2 = <<'LITERAL_17A7_0BD3_CHOICE_2';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_17A7_0BD3_CHOICE_2
$choice_3 = <<'LITERAL_17A7_0BD3_CHOICE_3';
<strong><span style="color: #3b7600;">gamete</span></strong>
LITERAL_17A7_0BD3_CHOICE_3
$choice_4 = <<'LITERAL_17A7_0BD3_CHOICE_4';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_17A7_0BD3_CHOICE_4
$correct_1 = <<'LITERAL_17A7_0BD3_CORRECT_1';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_17A7_0BD3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
