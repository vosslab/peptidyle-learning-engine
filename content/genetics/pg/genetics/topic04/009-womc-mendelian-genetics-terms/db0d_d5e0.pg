## DESCRIPTION
## Imported Genetics source row db0d_d5e0; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_DB0D_D5E0';
<p>db0d_d5e0</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'<strong><span style="color: #0067cc;">identical</span></strong> <strong><span style="color: #6c6c00;"><strong><span style="color: #6c6c00;">allele</span></strong>s</span></strong> at one or more corresponding chromosomal loci'</strong></span>.</p>
PROMPT_DB0D_D5E0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_DB0D_D5E0_CHOICE_1';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_DB0D_D5E0_CHOICE_1
$choice_2 = <<'LITERAL_DB0D_D5E0_CHOICE_2';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_DB0D_D5E0_CHOICE_2
$choice_3 = <<'LITERAL_DB0D_D5E0_CHOICE_3';
<strong><span style="color: #c80085;">homozygous</span></strong>
LITERAL_DB0D_D5E0_CHOICE_3
$choice_4 = <<'LITERAL_DB0D_D5E0_CHOICE_4';
<strong><span style="color: #a719db;">recessive</span></strong>
LITERAL_DB0D_D5E0_CHOICE_4
$correct_1 = <<'LITERAL_DB0D_D5E0_CORRECT_1';
<strong><span style="color: #c80085;">homozygous</span></strong>
LITERAL_DB0D_D5E0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
