DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_061E_D76B';
<p>061e_d76b</p> <p>Which one of the following Mendelian genetics terms correspond to the definition <span style='font-size: 1em;'><strong>'Mendel referred to this as the <i>"internal nature"</i> of an organism'</strong></span>.</p>
PROMPT_061E_D76B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_061E_D76B_CHOICE_1';
<strong><span style="color: #076dad;">character</span></strong>
LITERAL_061E_D76B_CHOICE_1
$choice_2 = <<'LITERAL_061E_D76B_CHOICE_2';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_061E_D76B_CHOICE_2
$choice_3 = <<'LITERAL_061E_D76B_CHOICE_3';
<strong><span style="color: #007a00;">heterozygous</span></strong>
LITERAL_061E_D76B_CHOICE_3
$choice_4 = <<'LITERAL_061E_D76B_CHOICE_4';
<strong><span style="color: #b74300;">trait</span></strong>
LITERAL_061E_D76B_CHOICE_4
$correct_1 = <<'LITERAL_061E_D76B_CORRECT_1';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_061E_D76B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
