## DESCRIPTION
## Imported Genetics source row 0dc0_e245; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-monohybrid_litter_inference-questions.txt')
