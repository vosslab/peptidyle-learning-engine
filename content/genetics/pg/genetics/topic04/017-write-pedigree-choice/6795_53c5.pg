gn: middle; width: 65px; height: 65px;">&nbsp;</td></tr><tr></tr></table></p><p>&nbsp;</p><p>Examine the pedigree above. Which one of the following patterns of inheritance is most likely demonstrated in the above pedigree inheritance?</p>
PROMPT_6795_53C5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6795_53C5_CHOICE_1';
autosomal dominant
LITERAL_6795_53C5_CHOICE_1
$choice_2 = <<'LITERAL_6795_53C5_CHOICE_2';
autosomal recessive
LITERAL_6795_53C5_CHOICE_2
$choice_3 = <<'LITERAL_6795_53C5_CHOICE_3';
x-linked dominant
LITERAL_6795_53C5_CHOICE_3
$choice_4 = <<'LITERAL_6795_53C5_CHOICE_4';
x-linked recessive
LITERAL_6795_53C5_CHOICE_4
$choice_5 = <<'LITERAL_6795_53C5_CHOICE_5';
y-linked
LITERAL_6795_53C5_CHOICE_5
$correct_1 = <<'LITERAL_6795_53C5_CORRECT_1';
y-linked
LITERAL_6795_53C5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
