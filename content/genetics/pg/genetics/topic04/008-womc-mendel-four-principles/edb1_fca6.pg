## DESCRIPTION
## Imported Genetics source row edb1_fca6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendel_four_principles-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EDB1_FCA6';
<p>edb1_fca6</p> <p>Which one of the following Mendel's Foundational Principles of Genetics correspond to the description <span style='font-size: 1em;'><strong>'Two <strong><span style="color: #a719db;">factors</span></strong> of a character get randomly distributed to <strong><span style="color: #c80085;">different</span></strong> <strong><span style="color: #007a00;"><strong><span style="color: #007a00;">gamete</span></strong>s</span></strong>.'</strong></span>.</p>
PROMPT_EDB1_FCA6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_EDB1_FCA6_CHOICE_1';
<strong><span style="color: #3b7600;">Law of Independent&nbsp;Assortment</span></strong>
LITERAL_EDB1_FCA6_CHOICE_1
$choice_2 = <<'LITERAL_EDB1_FCA6_CHOICE_2';
<strong><span style="color: #003fff;">Law of Segregation</span></strong>
LITERAL_EDB1_FCA6_CHOICE_2
$choice_3 = <<'LITERAL_EDB1_FCA6_CHOICE_3';
<strong><span style="color: #b74300;">Principle of Dominance</span></strong>
LITERAL_EDB1_FCA6_CHOICE_3
$choice_4 = <<'LITERAL_EDB1_FCA6_CHOICE_4';
<strong><span style="color: #cc0066;">Principle of Paired&nbsp;Factors</span></strong>
LITERAL_EDB1_FCA6_CHOICE_4
$correct_1 = <<'LITERAL_EDB1_FCA6_CORRECT_1';
<strong><span style="color: #003fff;">Law of Segregation</span></strong>
LITERAL_EDB1_FCA6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
