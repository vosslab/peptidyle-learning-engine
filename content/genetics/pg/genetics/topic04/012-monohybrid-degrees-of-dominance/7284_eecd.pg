## DESCRIPTION
## Imported Genetics source row 7284_eecd; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-monohybrid_degrees_of_dominance-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7284_EECD';
<p>7284_eecd</p> <table style="border: 1px solid black; border-collapse: collapse; "><colgroup width="60"></colgroup> <colgroup width="60"></colgroup> <colgroup width="80"></colgroup> <colgroup width="80"></colgroup> <tr> <th align='center' colspan='2' rowspan='2' style='background-color: lightgray'>Gene 1</th> <th align='center' colspan='2'>Female &female;</th> </tr><tr> <td align='center' style='background-color: lightgray'>D</td> <td align='center' style='background-color: lightgray'>d</td></tr><tr> <th align='center' rowspan='2'><br/>Male<br/>&male;<br/><br/></th> <td align='center' style='background-color: lightgray;'>D</td> <td align='center' style='background-color: cornflowerblue;'>DD</td> <td align='center' style='background-color: cornflowerblue;'>Dd</td></tr><tr> <td align='center' style='background-color: lightgray'>d</td> <td align='center' style='background-color: cornflowerblue;'>Dd</td> <td align='center' style='background-color: azure;'>dd</td></tr></table> <br/> <p>Two organisms were crossed in a monohybrid experiment. The offspring showed three <strong>blue (<span style="color: cornflowerblue; font-size: 1.8em;">&#x25A0;</span>)</strong> and one <strong>white (<span style="color: azure; font-size: 1.8em;">&#x25A0;</span>)</strong> phenotype.</p><p><strong>What type of dominance best explains these results?</strong></p>
PROMPT_7284_EECD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7284_EECD_CHOICE_1';
The gene shows complete dominance
LITERAL_7284_EECD_CHOICE_1
$choice_2 = <<'LITERAL_7284_EECD_CHOICE_2';
The gene shows epistasis
LITERAL_7284_EECD_CHOICE_2
$choice_3 = <<'LITERAL_7284_EECD_CHOICE_3';
The gene shows incomplete dominance
LITERAL_7284_EECD_CHOICE_3
$choice_4 = <<'LITERAL_7284_EECD_CHOICE_4';
The gene shows codominance
LITERAL_7284_EECD_CHOICE_4
$choice_5 = <<'LITERAL_7284_EECD_CHOICE_5';
The gene shows X-linked recessive
LITERAL_7284_EECD_CHOICE_5
$correct_1 = <<'LITERAL_7284_EECD_CORRECT_1';
The gene shows complete dominance
LITERAL_7284_EECD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
