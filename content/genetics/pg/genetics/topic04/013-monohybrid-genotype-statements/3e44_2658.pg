DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3E44_2658';
<p>3e44_2658</p> Which cross leads to <b>only one phenotype</b> as the only outcome in the progeny?
PROMPT_3E44_2658
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3E44_2658_CHOICE_1';
<strong><span style="font-family: monospace; font-size: 1.5em; color: #ba372a;">AA</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #236fa1;">aa</span></strong>
LITERAL_3E44_2658_CHOICE_1
$choice_2 = <<'LITERAL_3E44_2658_CHOICE_2';
<strong><span style="font-family: monospace; font-size: 1.5em; color: #843fa1;">Aa</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #843fa1;">Aa</span></strong>
LITERAL_3E44_2658_CHOICE_2
$choice_3 = <<'LITERAL_3E44_2658_CHOICE_3';
<strong><span style="font-family: monospace; font-size: 1.5em; color: #843fa1;">Aa</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #236fa1;">aa</span></strong>
LITERAL_3E44_2658_CHOICE_3
$correct_1 = <<'LITERAL_3E44_2658_CORRECT_1';
<strong><span style="font-family: monospace; font-size: 1.5em; color: #ba372a;">AA</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #236fa1;">aa</span></strong>
LITERAL_3E44_2658_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
