<strong><span style="font-family: monospace; font-size: 1.5em; color: #ba372a;">AA</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #843fa1;">Aa</span></strong>
LITERAL_4954_4452_CHOICE_2
$choice_3 = <<'LITERAL_4954_4452_CHOICE_3';
<strong><span style="font-family: monospace; font-size: 1.5em; color: #ba372a;">AA</span></strong> &nbsp;&times;&nbsp; <strong><span style="font-family: monospace; font-size: 1.5em; color: #236fa1;">aa</span></strong>
LITERAL_4954_4452_CHOICE_3
