DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7383_5A2C';
<p>7383_5a2c</p> <p>Which one of the following parental genotypes in monohybrid crosses correspond to the description of the progeny <span style='font-size: 1em;'><strong>'Produces a 1:1 phenotype ratio in progeny'</strong></span>.</p>
PROMPT_7383_5A2C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7383_5A2C_CHOICE_1';
<strong><span style="color: #ba372a;">AA</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #ba372a;">AA</span></strong>
LITERAL_7383_5A2C_CHOICE_1
$choice_2 = <<'LITERAL_7383_5A2C_CHOICE_2';
<strong><span style="color: #ba372a;">AA</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #843fa1;">Aa</span></strong>
LITERAL_7383_5A2C_CHOICE_2
$choice_3 = <<'LITERAL_7383_5A2C_CHOICE_3';
<strong><span style="color: #ba372a;">AA</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #236fa1;">aa</span></strong>
LITERAL_7383_5A2C_CHOICE_3
$choice_4 = <<'LITERAL_7383_5A2C_CHOICE_4';
<strong><span style="color: #843fa1;">Aa</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #843fa1;">Aa</span></strong>
LITERAL_7383_5A2C_CHOICE_4
$choice_5 = <<'LITERAL_7383_5A2C_CHOICE_5';
<strong><span style="color: #843fa1;">Aa</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #236fa1;">aa</span></strong>
LITERAL_7383_5A2C_CHOICE_5
$choice_6 = <<'LITERAL_7383_5A2C_CHOICE_6';
<strong><span style="color: #236fa1;">aa</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #236fa1;">aa</span></strong>
LITERAL_7383_5A2C_CHOICE_6
$correct_1 = <<'LITERAL_7383_5A2C_CORRECT_1';
<strong><span style="color: #843fa1;">Aa</span></strong><strong>&nbsp;&times;&nbsp;</strong><strong><span style="color: #236fa1;">aa</span></strong>
LITERAL_7383_5A2C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
