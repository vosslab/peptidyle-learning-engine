## DESCRIPTION
## Imported Genetics source row c07b_ce6d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-MATCH-mendelian_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C07B_CE6D';
<p>c07b_ce6d</p> <p>Match each of the following Mendelian genetics terms with their corresponding definitions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_C07B_CE6D
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_C07B_CE6D_MATCH_TERM_0';
<strong><span style="color: #007576;">phenotype</span></strong>
LITERAL_C07B_CE6D_MATCH_TERM_0
$match_term_1 = <<'LITERAL_C07B_CE6D_MATCH_TERM_1';
<strong><span style="color: #b74300;">trait</span></strong>
LITERAL_C07B_CE6D_MATCH_TERM_1
$match_term_2 = <<'LITERAL_C07B_CE6D_MATCH_TERM_2';
<strong><span style="color: #3b7600;">gamete</span></strong>
LITERAL_C07B_CE6D_MATCH_TERM_2
$match_term_3 = <<'LITERAL_C07B_CE6D_MATCH_TERM_3';
<strong><span style="color: #935d00;">genotype</span></strong>
LITERAL_C07B_CE6D_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_C07B_CE6D_MATCH_CHOICE_0';
the physical expression of an organism's entire genetic content
LITERAL_C07B_CE6D_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_C07B_CE6D_MATCH_CHOICE_1';
each variant for a <strong><span style="color: #076dad;">character</span></strong>, such as purple or white color for flowers
LITERAL_C07B_CE6D_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_C07B_CE6D_MATCH_CHOICE_2';
a haploid reproductive cell having the half number of chromosomes
LITERAL_C07B_CE6D_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_C07B_CE6D_MATCH_CHOICE_3';
Mendel labeled this as an organism's "internal makeup"
LITERAL_C07B_CE6D_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
