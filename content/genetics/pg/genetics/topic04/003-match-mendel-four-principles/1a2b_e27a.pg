## DESCRIPTION
## Imported Genetics source row 1a2b_e27a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-MATCH-mendel_four_principles-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1A2B_E27A';
<p>1a2b_e27a</p> <p>Match each of the following Mendel's Foundational Principles of Genetics with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_1A2B_E27A
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_1A2B_E27A_MATCH_TERM_0';
<strong><span style="color: #003fff;">Law of Segregation</span></strong>
LITERAL_1A2B_E27A_MATCH_TERM_0
$match_term_1 = <<'LITERAL_1A2B_E27A_MATCH_TERM_1';
<strong><span style="color: #b74300;">Principle of Dominance</span></strong>
LITERAL_1A2B_E27A_MATCH_TERM_1
$match_term_2 = <<'LITERAL_1A2B_E27A_MATCH_TERM_2';
<strong><span style="color: #cc0066;">Principle of Paired&nbsp;Factors</span></strong>
LITERAL_1A2B_E27A_MATCH_TERM_2
$match_term_3 = <<'LITERAL_1A2B_E27A_MATCH_TERM_3';
<strong><span style="color: #3b7600;">Law of Independent&nbsp;Assortment</span></strong>
LITERAL_1A2B_E27A_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_1A2B_E27A_MATCH_CHOICE_0';
Each parent passes a single <strong><span style="color: #d40000;">allele</span></strong> for each trait to the offspring during sexual reproduction.
LITERAL_1A2B_E27A_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_1A2B_E27A_MATCH_CHOICE_1';
Out of the two <strong><span style="color: #c80085;">different</span></strong> <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">allele</span></strong>s</span></strong> for the same gene, only one is able to express its effect.
LITERAL_1A2B_E27A_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_1A2B_E27A_MATCH_CHOICE_2';
An organism has two <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">allele</span></strong>s</span></strong> that make up the <strong><span style="color: #935d00;"><strong><span style="color: #00775f;">characters</span></strong></span></strong> for a specific trait.
LITERAL_1A2B_E27A_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_1A2B_E27A_MATCH_CHOICE_3';
Sorting one pair of <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">allele</span></strong>s</span></strong> into <strong><span style="color: #007a00;"><strong><span style="color: #007a00;">gamete</span></strong>s</span></strong> does<strong> <strong>NOT</strong> </strong>alter the sorting of another pair of <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">allele</span></strong>s</span></strong>.
LITERAL_1A2B_E27A_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
