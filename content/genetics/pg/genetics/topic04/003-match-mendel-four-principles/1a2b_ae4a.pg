## DESCRIPTION
## Imported Genetics source row 1a2b_ae4a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-MATCH-mendel_four_principles-questions.txt')
