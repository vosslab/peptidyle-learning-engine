## DESCRIPTION
## Imported Genetics source row 0c77_534c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-genetics_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0C77_534C';
<p>0c77_534c</p> <p>Which one of the following <strong><span style="color: #a719db;">genetic terms</span></strong> correspond to the definition <span style='font-size: 1em;'><strong>'chromosomes which contain the same genes in the same order along their chromosomal arms'</strong></span>.</p>
PROMPT_0C77_534C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0C77_534C_CHOICE_1';
<strong><span style="color: #007576;">diploid</span></strong>
LITERAL_0C77_534C_CHOICE_1
$choice_2 = <<'LITERAL_0C77_534C_CHOICE_2';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_0C77_534C_CHOICE_2
$choice_3 = <<'LITERAL_0C77_534C_CHOICE_3';
<strong><span style="color: #c80085;">genomics</span></strong>
LITERAL_0C77_534C_CHOICE_3
$choice_4 = <<'LITERAL_0C77_534C_CHOICE_4';
<strong><span style="color: #00775f;">homologous chromosomes</span></strong>
LITERAL_0C77_534C_CHOICE_4
$choice_5 = <<'LITERAL_0C77_534C_CHOICE_5';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_0C77_534C_CHOICE_5
$correct_1 = <<'LITERAL_0C77_534C_CORRECT_1';
<strong><span style="color: #00775f;">homologous chromosomes</span></strong>
LITERAL_0C77_534C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
