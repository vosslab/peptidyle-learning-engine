DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8720_CB7E';
<p>8720_cb7e</p> <p>Which one of the following <strong><span style="color: #a719db;">genetic terms</span></strong> correspond to the definition <span style='font-size: 1em;'><strong>'the study of the effect of genetic differences on organisms'</strong></span>.</p>
PROMPT_8720_CB7E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8720_CB7E_CHOICE_1';
<strong><span style="color: #b74300;">gene</span> </strong>
LITERAL_8720_CB7E_CHOICE_1
$choice_2 = <<'LITERAL_8720_CB7E_CHOICE_2';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_8720_CB7E_CHOICE_2
$choice_3 = <<'LITERAL_8720_CB7E_CHOICE_3';
<strong><span style="color: #6c6c00;">genome</span> </strong>
LITERAL_8720_CB7E_CHOICE_3
$choice_4 = <<'LITERAL_8720_CB7E_CHOICE_4';
<strong><span style="color: #d40000;">haploid</span></strong>
LITERAL_8720_CB7E_CHOICE_4
$choice_5 = <<'LITERAL_8720_CB7E_CHOICE_5';
<strong><span style="color: #00775f;">homologous chromosomes</span></strong>
LITERAL_8720_CB7E_CHOICE_5
$correct_1 = <<'LITERAL_8720_CB7E_CORRECT_1';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_8720_CB7E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
