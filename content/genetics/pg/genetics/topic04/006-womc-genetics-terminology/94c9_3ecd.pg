## DESCRIPTION
## Imported Genetics source row 94c9_3ecd; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-genetics_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_94C9_3ECD';
<p>94c9_3ecd</p> <p>Which one of the following <strong><span style="color: #a719db;">genetic terms</span></strong> correspond to the definition <span style='font-size: 1em;'><strong>'a genomic variant at a single base position in the DNA'</strong></span>.</p>
PROMPT_94C9_3ECD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_94C9_3ECD_CHOICE_1';
<strong><span style="color: #003fff;">genetic code</span></strong>
LITERAL_94C9_3ECD_CHOICE_1
$choice_2 = <<'LITERAL_94C9_3ECD_CHOICE_2';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_94C9_3ECD_CHOICE_2
$choice_3 = <<'LITERAL_94C9_3ECD_CHOICE_3';
<strong><span style="color: #d40000;">haploid</span></strong>
LITERAL_94C9_3ECD_CHOICE_3
$choice_4 = <<'LITERAL_94C9_3ECD_CHOICE_4';
<strong><span style="color: #935d00;">locus</span></strong>
LITERAL_94C9_3ECD_CHOICE_4
$choice_5 = <<'LITERAL_94C9_3ECD_CHOICE_5';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_94C9_3ECD_CHOICE_5
$correct_1 = <<'LITERAL_94C9_3ECD_CORRECT_1';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_94C9_3ECD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
