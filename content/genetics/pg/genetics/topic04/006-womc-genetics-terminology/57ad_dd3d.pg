## DESCRIPTION
## Imported Genetics source row 57ad_dd3d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-genetics_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_57AD_DD3D';
<p>57ad_dd3d</p> <p>Which one of the following <strong><span style="color: #a719db;">genetic terms</span></strong> correspond to the definition <span style='font-size: 1em;'><strong>'most common type of genetic variation among people'</strong></span>.</p>
PROMPT_57AD_DD3D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_57AD_DD3D_CHOICE_1';
<strong><span style="color: #003fff;">genetic code</span></strong>
LITERAL_57AD_DD3D_CHOICE_1
$choice_2 = <<'LITERAL_57AD_DD3D_CHOICE_2';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_57AD_DD3D_CHOICE_2
$choice_3 = <<'LITERAL_57AD_DD3D_CHOICE_3';
<strong><span style="color: #00775f;">homologous chromosomes</span></strong>
LITERAL_57AD_DD3D_CHOICE_3
$choice_4 = <<'LITERAL_57AD_DD3D_CHOICE_4';
<strong><span style="color: #935d00;">locus</span></strong>
LITERAL_57AD_DD3D_CHOICE_4
$choice_5 = <<'LITERAL_57AD_DD3D_CHOICE_5';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_57AD_DD3D_CHOICE_5
$correct_1 = <<'LITERAL_57AD_DD3D_CORRECT_1';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_57AD_DD3D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
