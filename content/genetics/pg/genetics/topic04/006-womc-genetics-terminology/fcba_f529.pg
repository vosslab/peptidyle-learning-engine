## DESCRIPTION
## Imported Genetics source row fcba_f529; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-genetics_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FCBA_F529';
<p>fcba_f529</p> <p>Which one of the following <strong><span style="color: #a719db;">genetic terms</span></strong> correspond to the definition <span style='font-size: 1em;'><strong>'the set of instructions that converts the sequence of nucleotides into an amino acid sequence in proteins'</strong></span>.</p>
PROMPT_FCBA_F529
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FCBA_F529_CHOICE_1';
<strong><span style="color: #007576;">diploid</span></strong>
LITERAL_FCBA_F529_CHOICE_1
$choice_2 = <<'LITERAL_FCBA_F529_CHOICE_2';
<strong><span style="color: #b74300;">gene</span> </strong>
LITERAL_FCBA_F529_CHOICE_2
$choice_3 = <<'LITERAL_FCBA_F529_CHOICE_3';
<strong><span style="color: #003fff;">genetic code</span></strong>
LITERAL_FCBA_F529_CHOICE_3
$choice_4 = <<'LITERAL_FCBA_F529_CHOICE_4';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_FCBA_F529_CHOICE_4
$choice_5 = <<'LITERAL_FCBA_F529_CHOICE_5';
<strong><span style="color: #c80085;">genomics</span></strong>
LITERAL_FCBA_F529_CHOICE_5
$correct_1 = <<'LITERAL_FCBA_F529_CORRECT_1';
<strong><span style="color: #003fff;">genetic code</span></strong>
LITERAL_FCBA_F529_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
