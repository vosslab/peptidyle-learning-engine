## DESCRIPTION
## Imported Genetics source row 26fe_ceef; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_26FE_CEEF';
<p>26fe_ceef</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x Tt.</p><p>If 160 conceptions occur, how many are expected to show tailless?</p>
PROMPT_26FE_CEEF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_26FE_CEEF_CHOICE_1';
80
LITERAL_26FE_CEEF_CHOICE_1
$choice_2 = <<'LITERAL_26FE_CEEF_CHOICE_2';
40
LITERAL_26FE_CEEF_CHOICE_2
$choice_3 = <<'LITERAL_26FE_CEEF_CHOICE_3';
120
LITERAL_26FE_CEEF_CHOICE_3
$choice_4 = <<'LITERAL_26FE_CEEF_CHOICE_4';
76
LITERAL_26FE_CEEF_CHOICE_4
$choice_5 = <<'LITERAL_26FE_CEEF_CHOICE_5';
160
LITERAL_26FE_CEEF_CHOICE_5
$correct_1 = <<'LITERAL_26FE_CEEF_CORRECT_1';
80
LITERAL_26FE_CEEF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
