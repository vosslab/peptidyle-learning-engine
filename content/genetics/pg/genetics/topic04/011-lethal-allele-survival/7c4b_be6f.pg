DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7C4B_BE6F';
<p>7c4b_be6f</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>If 80 conceptions occur, how many are expected to have the normal phenotype?</p>
PROMPT_7C4B_BE6F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7C4B_BE6F_CHOICE_1';
80
LITERAL_7C4B_BE6F_CHOICE_1
$choice_2 = <<'LITERAL_7C4B_BE6F_CHOICE_2';
36
LITERAL_7C4B_BE6F_CHOICE_2
$choice_3 = <<'LITERAL_7C4B_BE6F_CHOICE_3';
60
LITERAL_7C4B_BE6F_CHOICE_3
$choice_4 = <<'LITERAL_7C4B_BE6F_CHOICE_4';
44
LITERAL_7C4B_BE6F_CHOICE_4
$choice_5 = <<'LITERAL_7C4B_BE6F_CHOICE_5';
40
LITERAL_7C4B_BE6F_CHOICE_5
$correct_1 = <<'LITERAL_7C4B_BE6F_CORRECT_1';
40
LITERAL_7C4B_BE6F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
