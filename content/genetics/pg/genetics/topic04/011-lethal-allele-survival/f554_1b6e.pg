DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F554_1B6E';
<p>f554_1b6e</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x tt.</p><p>If 40 conceptions occur, how many are expected to show tailless?</p>
PROMPT_F554_1B6E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F554_1B6E_CHOICE_1';
16
LITERAL_F554_1B6E_CHOICE_1
$choice_2 = <<'LITERAL_F554_1B6E_CHOICE_2';
30
LITERAL_F554_1B6E_CHOICE_2
$choice_3 = <<'LITERAL_F554_1B6E_CHOICE_3';
24
LITERAL_F554_1B6E_CHOICE_3
$choice_4 = <<'LITERAL_F554_1B6E_CHOICE_4';
20
LITERAL_F554_1B6E_CHOICE_4
$choice_5 = <<'LITERAL_F554_1B6E_CHOICE_5';
40
LITERAL_F554_1B6E_CHOICE_5
$correct_1 = <<'LITERAL_F554_1B6E_CORRECT_1';
20
LITERAL_F554_1B6E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
