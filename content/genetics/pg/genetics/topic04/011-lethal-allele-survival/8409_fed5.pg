## DESCRIPTION
## Imported Genetics source row 8409_fed5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8409_FED5';
<p>8409_fed5</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). The parental cross is Dd x Dd.</p><p>What fraction of all conceptions are expected to survive?</p>
PROMPT_8409_FED5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8409_FED5_CHOICE_1';
2/3, 66.7%
LITERAL_8409_FED5_CHOICE_1
$choice_2 = <<'LITERAL_8409_FED5_CHOICE_2';
All, 100%
LITERAL_8409_FED5_CHOICE_2
$choice_3 = <<'LITERAL_8409_FED5_CHOICE_3';
1/2, 50%
LITERAL_8409_FED5_CHOICE_3
$choice_4 = <<'LITERAL_8409_FED5_CHOICE_4';
3/4, 75%
LITERAL_8409_FED5_CHOICE_4
$choice_5 = <<'LITERAL_8409_FED5_CHOICE_5';
None, 0%
LITERAL_8409_FED5_CHOICE_5
$correct_1 = <<'LITERAL_8409_FED5_CORRECT_1';
3/4, 75%
LITERAL_8409_FED5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
