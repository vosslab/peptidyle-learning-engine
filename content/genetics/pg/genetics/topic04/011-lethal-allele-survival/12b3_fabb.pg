## DESCRIPTION
## Imported Genetics source row 12b3_fabb; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_12B3_FABB';
<p>12b3_fabb</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what is the ratio of normal phenotype to tailless?</p>
PROMPT_12B3_FABB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_12B3_FABB_CHOICE_1';
1 to 2
LITERAL_12B3_FABB_CHOICE_1
$choice_2 = <<'LITERAL_12B3_FABB_CHOICE_2';
3 to 2
LITERAL_12B3_FABB_CHOICE_2
$choice_3 = <<'LITERAL_12B3_FABB_CHOICE_3';
2 to 1
LITERAL_12B3_FABB_CHOICE_3
$choice_4 = <<'LITERAL_12B3_FABB_CHOICE_4';
3 to 1
LITERAL_12B3_FABB_CHOICE_4
$choice_5 = <<'LITERAL_12B3_FABB_CHOICE_5';
1 to 1
LITERAL_12B3_FABB_CHOICE_5
$correct_1 = <<'LITERAL_12B3_FABB_CORRECT_1';
1 to 2
LITERAL_12B3_FABB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
