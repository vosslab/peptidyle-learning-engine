DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0B74_C14C';
<p>0b74_c14c</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). The parental cross is Dd x dd.</p><p>If 160 conceptions occur, how many are expected to show dwarf legs?</p>
PROMPT_0B74_C14C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0B74_C14C_CHOICE_1';
84
LITERAL_0B74_C14C_CHOICE_1
$choice_2 = <<'LITERAL_0B74_C14C_CHOICE_2';
160
LITERAL_0B74_C14C_CHOICE_2
$choice_3 = <<'LITERAL_0B74_C14C_CHOICE_3';
40
LITERAL_0B74_C14C_CHOICE_3
$choice_4 = <<'LITERAL_0B74_C14C_CHOICE_4';
80
LITERAL_0B74_C14C_CHOICE_4
$choice_5 = <<'LITERAL_0B74_C14C_CHOICE_5';
76
LITERAL_0B74_C14C_CHOICE_5
$correct_1 = <<'LITERAL_0B74_C14C_CORRECT_1';
80
LITERAL_0B74_C14C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
