## DESCRIPTION
## Imported Genetics source row b1d9_8333; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B1D9_8333';
<p>b1d9_8333</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). The parental cross is Yy x yy.</p><p>If 80 conceptions occur, how many are expected to survive?</p>
PROMPT_B1D9_8333
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B1D9_8333_CHOICE_1';
76
LITERAL_B1D9_8333_CHOICE_1
$choice_2 = <<'LITERAL_B1D9_8333_CHOICE_2';
40
LITERAL_B1D9_8333_CHOICE_2
$choice_3 = <<'LITERAL_B1D9_8333_CHOICE_3';
80
LITERAL_B1D9_8333_CHOICE_3
$choice_4 = <<'LITERAL_B1D9_8333_CHOICE_4';
84
LITERAL_B1D9_8333_CHOICE_4
$choice_5 = <<'LITERAL_B1D9_8333_CHOICE_5';
60
LITERAL_B1D9_8333_CHOICE_5
$correct_1 = <<'LITERAL_B1D9_8333_CORRECT_1';
80
LITERAL_B1D9_8333_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
