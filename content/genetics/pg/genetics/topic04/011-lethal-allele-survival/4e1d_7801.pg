## DESCRIPTION
## Imported Genetics source row 4e1d_7801; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4E1D_7801';
<p>4e1d_7801</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). Two heterozygous individuals are crossed.</p><p>If 120 conceptions occur, how many are expected to show tailless?</p>
PROMPT_4E1D_7801
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4E1D_7801_CHOICE_1';
60
LITERAL_4E1D_7801_CHOICE_1
$choice_2 = <<'LITERAL_4E1D_7801_CHOICE_2';
120
LITERAL_4E1D_7801_CHOICE_2
$choice_3 = <<'LITERAL_4E1D_7801_CHOICE_3';
64
LITERAL_4E1D_7801_CHOICE_3
$choice_4 = <<'LITERAL_4E1D_7801_CHOICE_4';
56
LITERAL_4E1D_7801_CHOICE_4
$choice_5 = <<'LITERAL_4E1D_7801_CHOICE_5';
30
LITERAL_4E1D_7801_CHOICE_5
$correct_1 = <<'LITERAL_4E1D_7801_CORRECT_1';
60
LITERAL_4E1D_7801_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
