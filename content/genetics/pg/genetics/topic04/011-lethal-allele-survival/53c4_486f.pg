DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_53C4_486F';
<p>53c4_486f</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). Two heterozygous individuals are crossed.</p><p>If 80 conceptions occur, how many are expected to be lethal?</p>
PROMPT_53C4_486F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_53C4_486F_CHOICE_1';
24
LITERAL_53C4_486F_CHOICE_1
$choice_2 = <<'LITERAL_53C4_486F_CHOICE_2';
16
LITERAL_53C4_486F_CHOICE_2
$choice_3 = <<'LITERAL_53C4_486F_CHOICE_3';
20
LITERAL_53C4_486F_CHOICE_3
$choice_4 = <<'LITERAL_53C4_486F_CHOICE_4';
80
LITERAL_53C4_486F_CHOICE_4
$choice_5 = <<'LITERAL_53C4_486F_CHOICE_5';
40
LITERAL_53C4_486F_CHOICE_5
$correct_1 = <<'LITERAL_53C4_486F_CORRECT_1';
20
LITERAL_53C4_486F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
