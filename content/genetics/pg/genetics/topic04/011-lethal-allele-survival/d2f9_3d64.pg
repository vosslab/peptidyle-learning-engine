DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D2F9_3D64';
<p>d2f9_3d64</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). The parental cross is Yy x Yy.</p><p>Among surviving offspring, what is the ratio of normal phenotype to yellow coat?</p>
PROMPT_D2F9_3D64
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D2F9_3D64_CHOICE_1';
3 to 2
LITERAL_D2F9_3D64_CHOICE_1
$choice_2 = <<'LITERAL_D2F9_3D64_CHOICE_2';
1 to 1
LITERAL_D2F9_3D64_CHOICE_2
$choice_3 = <<'LITERAL_D2F9_3D64_CHOICE_3';
1 to 2
LITERAL_D2F9_3D64_CHOICE_3
$choice_4 = <<'LITERAL_D2F9_3D64_CHOICE_4';
3 to 1
LITERAL_D2F9_3D64_CHOICE_4
$choice_5 = <<'LITERAL_D2F9_3D64_CHOICE_5';
2 to 1
LITERAL_D2F9_3D64_CHOICE_5
$correct_1 = <<'LITERAL_D2F9_3D64_CORRECT_1';
1 to 2
LITERAL_D2F9_3D64_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
