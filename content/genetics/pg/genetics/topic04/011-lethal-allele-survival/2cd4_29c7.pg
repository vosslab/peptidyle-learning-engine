## DESCRIPTION
## Imported Genetics source row 2cd4_29c7; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2CD4_29C7';
<p>2cd4_29c7</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what fraction are expected to show yellow coat?</p>
PROMPT_2CD4_29C7
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2CD4_29C7_CHOICE_1';
All, 100%
LITERAL_2CD4_29C7_CHOICE_1
$choice_2 = <<'LITERAL_2CD4_29C7_CHOICE_2';
3/4, 75%
LITERAL_2CD4_29C7_CHOICE_2
$choice_3 = <<'LITERAL_2CD4_29C7_CHOICE_3';
None, 0%
LITERAL_2CD4_29C7_CHOICE_3
$choice_4 = <<'LITERAL_2CD4_29C7_CHOICE_4';
2/3, 66.7%
LITERAL_2CD4_29C7_CHOICE_4
$choice_5 = <<'LITERAL_2CD4_29C7_CHOICE_5';
1/2, 50%
LITERAL_2CD4_29C7_CHOICE_5
$correct_1 = <<'LITERAL_2CD4_29C7_CORRECT_1';
2/3, 66.7%
LITERAL_2CD4_29C7_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
