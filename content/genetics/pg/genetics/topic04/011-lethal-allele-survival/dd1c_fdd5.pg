## DESCRIPTION
## Imported Genetics source row dd1c_fdd5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_DD1C_FDD5';
<p>dd1c_fdd5</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>What fraction of all conceptions are expected to have the normal phenotype?</p>
PROMPT_DD1C_FDD5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_DD1C_FDD5_CHOICE_1';
1/3, 33.3%
LITERAL_DD1C_FDD5_CHOICE_1
$choice_2 = <<'LITERAL_DD1C_FDD5_CHOICE_2';
1/4, 25%
LITERAL_DD1C_FDD5_CHOICE_2
$choice_3 = <<'LITERAL_DD1C_FDD5_CHOICE_3';
1/2, 50%
LITERAL_DD1C_FDD5_CHOICE_3
$choice_4 = <<'LITERAL_DD1C_FDD5_CHOICE_4';
All, 100%
LITERAL_DD1C_FDD5_CHOICE_4
$choice_5 = <<'LITERAL_DD1C_FDD5_CHOICE_5';
None, 0%
LITERAL_DD1C_FDD5_CHOICE_5
$correct_1 = <<'LITERAL_DD1C_FDD5_CORRECT_1';
1/2, 50%
LITERAL_DD1C_FDD5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
