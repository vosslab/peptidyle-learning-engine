## DESCRIPTION
## Imported Genetics source row 6385_26f9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6385_26F9';
<p>6385_26f9</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x tt.</p><p>What fraction of all conceptions are expected to be lethal?</p>
PROMPT_6385_26F9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6385_26F9_CHOICE_1';
All, 100%
LITERAL_6385_26F9_CHOICE_1
$choice_2 = <<'LITERAL_6385_26F9_CHOICE_2';
None, 0%
LITERAL_6385_26F9_CHOICE_2
$choice_3 = <<'LITERAL_6385_26F9_CHOICE_3';
1/2, 50%
LITERAL_6385_26F9_CHOICE_3
$choice_4 = <<'LITERAL_6385_26F9_CHOICE_4';
2/3, 66.7%
LITERAL_6385_26F9_CHOICE_4
$choice_5 = <<'LITERAL_6385_26F9_CHOICE_5';
1/3, 33.3%
LITERAL_6385_26F9_CHOICE_5
$correct_1 = <<'LITERAL_6385_26F9_CORRECT_1';
None, 0%
LITERAL_6385_26F9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
