## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3161_7151';
<p>3161_7151</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x tt.</p><p>If 120 conceptions occur, how many are expected to be lethal?</p>
PROMPT_3161_7151
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3161_7151_CHOICE_1';
120
LITERAL_3161_7151_CHOICE_1
$choice_2 = <<'LITERAL_3161_7151_CHOICE_2';
30
LITERAL_3161_7151_CHOICE_2
$choice_3 = <<'LITERAL_3161_7151_CHOICE_3';
4
LITERAL_3161_7151_CHOICE_3
$choice_4 = <<'LITERAL_3161_7151_CHOICE_4';
90
LITERAL_3161_7151_CHOICE_4
$choice_5 = <<'LITERAL_3161_7151_CHOICE_5';
0
LITERAL_3161_7151_CHOICE_5
$correct_1 = <<'LITERAL_3161_7151_CORRECT_1';
0
LITERAL_3161_7151_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
