## DESCRIPTION
## Imported Genetics source row 2b4d_8afc; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2B4D_8AFC';
<p>2b4d_8afc</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>If 160 conceptions occur, how many are expected to show tailless?</p>
PROMPT_2B4D_8AFC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2B4D_8AFC_CHOICE_1';
160
LITERAL_2B4D_8AFC_CHOICE_1
$choice_2 = <<'LITERAL_2B4D_8AFC_CHOICE_2';
120
LITERAL_2B4D_8AFC_CHOICE_2
$choice_3 = <<'LITERAL_2B4D_8AFC_CHOICE_3';
80
LITERAL_2B4D_8AFC_CHOICE_3
$choice_4 = <<'LITERAL_2B4D_8AFC_CHOICE_4';
84
LITERAL_2B4D_8AFC_CHOICE_4
$choice_5 = <<'LITERAL_2B4D_8AFC_CHOICE_5';
76
LITERAL_2B4D_8AFC_CHOICE_5
$correct_1 = <<'LITERAL_2B4D_8AFC_CORRECT_1';
80
LITERAL_2B4D_8AFC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
