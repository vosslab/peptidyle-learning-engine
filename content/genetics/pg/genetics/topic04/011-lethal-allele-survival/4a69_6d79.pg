DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4A69_6D79';
<p>4a69_6d79</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>If 120 conceptions occur, how many are expected to show yellow coat?</p>
PROMPT_4A69_6D79
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4A69_6D79_CHOICE_1';
30
LITERAL_4A69_6D79_CHOICE_1
$choice_2 = <<'LITERAL_4A69_6D79_CHOICE_2';
56
LITERAL_4A69_6D79_CHOICE_2
$choice_3 = <<'LITERAL_4A69_6D79_CHOICE_3';
120
LITERAL_4A69_6D79_CHOICE_3
$choice_4 = <<'LITERAL_4A69_6D79_CHOICE_4';
60
LITERAL_4A69_6D79_CHOICE_4
$choice_5 = <<'LITERAL_4A69_6D79_CHOICE_5';
90
LITERAL_4A69_6D79_CHOICE_5
$correct_1 = <<'LITERAL_4A69_6D79_CORRECT_1';
60
LITERAL_4A69_6D79_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
