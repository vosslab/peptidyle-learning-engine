## DESCRIPTION
## Imported Genetics source row 20fc_b296; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_20FC_B296';
<p>20fc_b296</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x tt.</p><p>Among surviving offspring, what fraction are expected to show tailless?</p>
PROMPT_20FC_B296
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_20FC_B296_CHOICE_1';
3/4, 75%
LITERAL_20FC_B296_CHOICE_1
$choice_2 = <<'LITERAL_20FC_B296_CHOICE_2';
None, 0%
LITERAL_20FC_B296_CHOICE_2
$choice_3 = <<'LITERAL_20FC_B296_CHOICE_3';
1/2, 50%
LITERAL_20FC_B296_CHOICE_3
$choice_4 = <<'LITERAL_20FC_B296_CHOICE_4';
All, 100%
LITERAL_20FC_B296_CHOICE_4
$choice_5 = <<'LITERAL_20FC_B296_CHOICE_5';
2/3, 66.7%
LITERAL_20FC_B296_CHOICE_5
$correct_1 = <<'LITERAL_20FC_B296_CORRECT_1';
1/2, 50%
LITERAL_20FC_B296_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
