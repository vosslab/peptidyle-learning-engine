## DESCRIPTION
## Imported Genetics source row b709_3490; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B709_3490';
<p>b709_3490</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). The parental cross is Cc x cc.</p><p>If 120 conceptions occur, how many are expected to survive?</p>
PROMPT_B709_3490
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B709_3490_CHOICE_1';
124
LITERAL_B709_3490_CHOICE_1
$choice_2 = <<'LITERAL_B709_3490_CHOICE_2';
120
LITERAL_B709_3490_CHOICE_2
$choice_3 = <<'LITERAL_B709_3490_CHOICE_3';
116
LITERAL_B709_3490_CHOICE_3
$choice_4 = <<'LITERAL_B709_3490_CHOICE_4';
90
LITERAL_B709_3490_CHOICE_4
$choice_5 = <<'LITERAL_B709_3490_CHOICE_5';
30
LITERAL_B709_3490_CHOICE_5
$correct_1 = <<'LITERAL_B709_3490_CORRECT_1';
120
LITERAL_B709_3490_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
