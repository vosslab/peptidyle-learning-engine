## DESCRIPTION
## Imported Genetics source row ef42_3243; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EF42_3243';
<p>ef42_3243</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what is the ratio of normal phenotype to dwarf legs?</p>
PROMPT_EF42_3243
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_EF42_3243_CHOICE_1';
1 to 1
LITERAL_EF42_3243_CHOICE_1
$choice_2 = <<'LITERAL_EF42_3243_CHOICE_2';
3 to 2
LITERAL_EF42_3243_CHOICE_2
$choice_3 = <<'LITERAL_EF42_3243_CHOICE_3';
2 to 1
LITERAL_EF42_3243_CHOICE_3
$choice_4 = <<'LITERAL_EF42_3243_CHOICE_4';
1 to 2
LITERAL_EF42_3243_CHOICE_4
$choice_5 = <<'LITERAL_EF42_3243_CHOICE_5';
3 to 1
LITERAL_EF42_3243_CHOICE_5
$correct_1 = <<'LITERAL_EF42_3243_CORRECT_1';
1 to 2
LITERAL_EF42_3243_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
