## DESCRIPTION
## Imported Genetics source row bed3_e77f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BED3_E77F';
<p>bed3_e77f</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). The parental cross is Dd x dd.</p><p>If 80 conceptions occur, how many are expected to show dwarf legs?</p>
PROMPT_BED3_E77F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BED3_E77F_CHOICE_1';
20
LITERAL_BED3_E77F_CHOICE_1
$choice_2 = <<'LITERAL_BED3_E77F_CHOICE_2';
36
LITERAL_BED3_E77F_CHOICE_2
$choice_3 = <<'LITERAL_BED3_E77F_CHOICE_3';
40
LITERAL_BED3_E77F_CHOICE_3
$choice_4 = <<'LITERAL_BED3_E77F_CHOICE_4';
60
LITERAL_BED3_E77F_CHOICE_4
$choice_5 = <<'LITERAL_BED3_E77F_CHOICE_5';
80
LITERAL_BED3_E77F_CHOICE_5
$correct_1 = <<'LITERAL_BED3_E77F_CORRECT_1';
40
LITERAL_BED3_E77F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
