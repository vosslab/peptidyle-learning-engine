## DESCRIPTION
## Imported Genetics source row 2ae9_48f5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2AE9_48F5';
<p>2ae9_48f5</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>What fraction of all conceptions are expected to survive?</p>
PROMPT_2AE9_48F5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2AE9_48F5_CHOICE_1';
3/4, 75%
LITERAL_2AE9_48F5_CHOICE_1
$choice_2 = <<'LITERAL_2AE9_48F5_CHOICE_2';
1/3, 33.3%
LITERAL_2AE9_48F5_CHOICE_2
$choice_3 = <<'LITERAL_2AE9_48F5_CHOICE_3';
All, 100%
LITERAL_2AE9_48F5_CHOICE_3
$choice_4 = <<'LITERAL_2AE9_48F5_CHOICE_4';
1/2, 50%
LITERAL_2AE9_48F5_CHOICE_4
$choice_5 = <<'LITERAL_2AE9_48F5_CHOICE_5';
1/4, 25%
LITERAL_2AE9_48F5_CHOICE_5
$correct_1 = <<'LITERAL_2AE9_48F5_CORRECT_1';
All, 100%
LITERAL_2AE9_48F5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
