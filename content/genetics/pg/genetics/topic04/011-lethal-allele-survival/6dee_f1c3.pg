## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6DEE_F1C3';
<p>6dee_f1c3</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). The parental cross is Dd x dd.</p><p>If 40 conceptions occur, how many are expected to be lethal?</p>
PROMPT_6DEE_F1C3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6DEE_F1C3_CHOICE_1';
0
LITERAL_6DEE_F1C3_CHOICE_1
$choice_2 = <<'LITERAL_6DEE_F1C3_CHOICE_2';
40
LITERAL_6DEE_F1C3_CHOICE_2
$choice_3 = <<'LITERAL_6DEE_F1C3_CHOICE_3';
4
LITERAL_6DEE_F1C3_CHOICE_3
$choice_4 = <<'LITERAL_6DEE_F1C3_CHOICE_4';
30
LITERAL_6DEE_F1C3_CHOICE_4
$choice_5 = <<'LITERAL_6DEE_F1C3_CHOICE_5';
10
LITERAL_6DEE_F1C3_CHOICE_5
$correct_1 = <<'LITERAL_6DEE_F1C3_CORRECT_1';
0
LITERAL_6DEE_F1C3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
