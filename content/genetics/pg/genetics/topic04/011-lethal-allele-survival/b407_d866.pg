## DESCRIPTION
## Imported Genetics source row b407_d866; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B407_D866';
<p>b407_d866</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>Among surviving offspring, what fraction are expected to have the normal phenotype?</p>
PROMPT_B407_D866
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B407_D866_CHOICE_1';
All, 100%
LITERAL_B407_D866_CHOICE_1
$choice_2 = <<'LITERAL_B407_D866_CHOICE_2';
None, 0%
LITERAL_B407_D866_CHOICE_2
$choice_3 = <<'LITERAL_B407_D866_CHOICE_3';
2/3, 66.7%
LITERAL_B407_D866_CHOICE_3
$choice_4 = <<'LITERAL_B407_D866_CHOICE_4';
1/2, 50%
LITERAL_B407_D866_CHOICE_4
$choice_5 = <<'LITERAL_B407_D866_CHOICE_5';
3/4, 75%
LITERAL_B407_D866_CHOICE_5
$correct_1 = <<'LITERAL_B407_D866_CORRECT_1';
1/2, 50%
LITERAL_B407_D866_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
