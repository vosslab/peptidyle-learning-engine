## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1EA5_62E1';
<p>1ea5_62e1</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). Two heterozygous individuals are crossed.</p><p>If 40 conceptions occur, how many are expected to have the normal phenotype?</p>
PROMPT_1EA5_62E1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1EA5_62E1_CHOICE_1';
20
LITERAL_1EA5_62E1_CHOICE_1
$choice_2 = <<'LITERAL_1EA5_62E1_CHOICE_2';
30
LITERAL_1EA5_62E1_CHOICE_2
$choice_3 = <<'LITERAL_1EA5_62E1_CHOICE_3';
10
LITERAL_1EA5_62E1_CHOICE_3
$choice_4 = <<'LITERAL_1EA5_62E1_CHOICE_4';
40
LITERAL_1EA5_62E1_CHOICE_4
$choice_5 = <<'LITERAL_1EA5_62E1_CHOICE_5';
14
LITERAL_1EA5_62E1_CHOICE_5
$correct_1 = <<'LITERAL_1EA5_62E1_CORRECT_1';
10
LITERAL_1EA5_62E1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
