## DESCRIPTION
## Imported Genetics source row a2a2_6829; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A2A2_6829';
<p>a2a2_6829</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>Among surviving offspring, what is the ratio of normal phenotype to dwarf legs?</p>
PROMPT_A2A2_6829
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A2A2_6829_CHOICE_1';
3 to 2
LITERAL_A2A2_6829_CHOICE_1
$choice_2 = <<'LITERAL_A2A2_6829_CHOICE_2';
1 to 2
LITERAL_A2A2_6829_CHOICE_2
$choice_3 = <<'LITERAL_A2A2_6829_CHOICE_3';
1 to 1
LITERAL_A2A2_6829_CHOICE_3
$choice_4 = <<'LITERAL_A2A2_6829_CHOICE_4';
3 to 1
LITERAL_A2A2_6829_CHOICE_4
$choice_5 = <<'LITERAL_A2A2_6829_CHOICE_5';
2 to 1
LITERAL_A2A2_6829_CHOICE_5
$correct_1 = <<'LITERAL_A2A2_6829_CORRECT_1';
1 to 1
LITERAL_A2A2_6829_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
