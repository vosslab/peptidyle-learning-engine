## DESCRIPTION
## Imported Genetics source row ae65_a36c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AE65_A36C';
<p>ae65_a36c</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). Two heterozygous individuals are crossed.</p><p>If 120 conceptions occur, how many are expected to have the normal phenotype?</p>
PROMPT_AE65_A36C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AE65_A36C_CHOICE_1';
26
LITERAL_AE65_A36C_CHOICE_1
$choice_2 = <<'LITERAL_AE65_A36C_CHOICE_2';
90
LITERAL_AE65_A36C_CHOICE_2
$choice_3 = <<'LITERAL_AE65_A36C_CHOICE_3';
60
LITERAL_AE65_A36C_CHOICE_3
$choice_4 = <<'LITERAL_AE65_A36C_CHOICE_4';
34
LITERAL_AE65_A36C_CHOICE_4
$choice_5 = <<'LITERAL_AE65_A36C_CHOICE_5';
30
LITERAL_AE65_A36C_CHOICE_5
$correct_1 = <<'LITERAL_AE65_A36C_CORRECT_1';
30
LITERAL_AE65_A36C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
