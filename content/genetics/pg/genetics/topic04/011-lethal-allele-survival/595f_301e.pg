## DESCRIPTION
## Imported Genetics source row 595f_301e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_595F_301E';
<p>595f_301e</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>If 160 conceptions occur, how many are expected to survive?</p>
PROMPT_595F_301E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_595F_301E_CHOICE_1';
40
LITERAL_595F_301E_CHOICE_1
$choice_2 = <<'LITERAL_595F_301E_CHOICE_2';
80
LITERAL_595F_301E_CHOICE_2
$choice_3 = <<'LITERAL_595F_301E_CHOICE_3';
156
LITERAL_595F_301E_CHOICE_3
$choice_4 = <<'LITERAL_595F_301E_CHOICE_4';
120
LITERAL_595F_301E_CHOICE_4
$choice_5 = <<'LITERAL_595F_301E_CHOICE_5';
160
LITERAL_595F_301E_CHOICE_5
$correct_1 = <<'LITERAL_595F_301E_CORRECT_1';
160
LITERAL_595F_301E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
