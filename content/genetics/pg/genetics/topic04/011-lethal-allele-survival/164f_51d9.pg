DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_164F_51D9';
<p>164f_51d9</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). The parental cross is Cc x cc.</p><p>If 80 conceptions occur, how many are expected to show curly wings?</p>
PROMPT_164F_51D9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_164F_51D9_CHOICE_1';
60
LITERAL_164F_51D9_CHOICE_1
$choice_2 = <<'LITERAL_164F_51D9_CHOICE_2';
36
LITERAL_164F_51D9_CHOICE_2
$choice_3 = <<'LITERAL_164F_51D9_CHOICE_3';
44
LITERAL_164F_51D9_CHOICE_3
$choice_4 = <<'LITERAL_164F_51D9_CHOICE_4';
80
LITERAL_164F_51D9_CHOICE_4
$choice_5 = <<'LITERAL_164F_51D9_CHOICE_5';
40
LITERAL_164F_51D9_CHOICE_5
$correct_1 = <<'LITERAL_164F_51D9_CORRECT_1';
40
LITERAL_164F_51D9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
