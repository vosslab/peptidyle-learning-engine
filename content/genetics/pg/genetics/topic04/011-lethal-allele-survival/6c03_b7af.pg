## DESCRIPTION
## Imported Genetics source row 6c03_b7af; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6C03_B7AF';
<p>6c03_b7af</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). The parental cross is Yy x Yy.</p><p>Among surviving offspring, what fraction are expected to show yellow coat?</p>
PROMPT_6C03_B7AF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6C03_B7AF_CHOICE_1';
None, 0%
LITERAL_6C03_B7AF_CHOICE_1
$choice_2 = <<'LITERAL_6C03_B7AF_CHOICE_2';
1/4, 25%
LITERAL_6C03_B7AF_CHOICE_2
$choice_3 = <<'LITERAL_6C03_B7AF_CHOICE_3';
1/2, 50%
LITERAL_6C03_B7AF_CHOICE_3
$choice_4 = <<'LITERAL_6C03_B7AF_CHOICE_4';
2/3, 66.7%
LITERAL_6C03_B7AF_CHOICE_4
$choice_5 = <<'LITERAL_6C03_B7AF_CHOICE_5';
1/3, 33.3%
LITERAL_6C03_B7AF_CHOICE_5
$correct_1 = <<'LITERAL_6C03_B7AF_CORRECT_1';
2/3, 66.7%
LITERAL_6C03_B7AF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
