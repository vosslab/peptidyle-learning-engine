## DESCRIPTION
## Imported Genetics source row d66f_3482; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D66F_3482';
<p>d66f_3482</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x tt.</p><p>What fraction of all conceptions are expected to survive?</p>
PROMPT_D66F_3482
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D66F_3482_CHOICE_1';
All, 100%
LITERAL_D66F_3482_CHOICE_1
$choice_2 = <<'LITERAL_D66F_3482_CHOICE_2';
None, 0%
LITERAL_D66F_3482_CHOICE_2
$choice_3 = <<'LITERAL_D66F_3482_CHOICE_3';
3/4, 75%
LITERAL_D66F_3482_CHOICE_3
$choice_4 = <<'LITERAL_D66F_3482_CHOICE_4';
1/4, 25%
LITERAL_D66F_3482_CHOICE_4
$choice_5 = <<'LITERAL_D66F_3482_CHOICE_5';
2/3, 66.7%
LITERAL_D66F_3482_CHOICE_5
$correct_1 = <<'LITERAL_D66F_3482_CORRECT_1';
All, 100%
LITERAL_D66F_3482_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
