## DESCRIPTION
## Imported Genetics source row b98a_9441; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B98A_9441';
<p>b98a_9441</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). Two heterozygous individuals are crossed.</p><p>If 160 conceptions occur, how many are expected to have the normal phenotype?</p>
PROMPT_B98A_9441
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B98A_9441_CHOICE_1';
160
LITERAL_B98A_9441_CHOICE_1
$choice_2 = <<'LITERAL_B98A_9441_CHOICE_2';
44
LITERAL_B98A_9441_CHOICE_2
$choice_3 = <<'LITERAL_B98A_9441_CHOICE_3';
40
LITERAL_B98A_9441_CHOICE_3
$choice_4 = <<'LITERAL_B98A_9441_CHOICE_4';
36
LITERAL_B98A_9441_CHOICE_4
$choice_5 = <<'LITERAL_B98A_9441_CHOICE_5';
80
LITERAL_B98A_9441_CHOICE_5
$correct_1 = <<'LITERAL_B98A_9441_CORRECT_1';
40
LITERAL_B98A_9441_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
