## DESCRIPTION
## Imported Genetics source row d23f_2300; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D23F_2300';
<p>d23f_2300</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x Tt.</p><p>What fraction of all conceptions are expected to survive?</p>
PROMPT_D23F_2300
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D23F_2300_CHOICE_1';
2/3, 66.7%
LITERAL_D23F_2300_CHOICE_1
$choice_2 = <<'LITERAL_D23F_2300_CHOICE_2';
3/4, 75%
LITERAL_D23F_2300_CHOICE_2
$choice_3 = <<'LITERAL_D23F_2300_CHOICE_3';
1/2, 50%
LITERAL_D23F_2300_CHOICE_3
$choice_4 = <<'LITERAL_D23F_2300_CHOICE_4';
1/3, 33.3%
LITERAL_D23F_2300_CHOICE_4
$choice_5 = <<'LITERAL_D23F_2300_CHOICE_5';
All, 100%
LITERAL_D23F_2300_CHOICE_5
$correct_1 = <<'LITERAL_D23F_2300_CORRECT_1';
3/4, 75%
LITERAL_D23F_2300_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
