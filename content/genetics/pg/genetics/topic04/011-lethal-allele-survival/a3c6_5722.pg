## DESCRIPTION
## Imported Genetics source row a3c6_5722; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A3C6_5722';
<p>a3c6_5722</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what fraction are expected to have the normal phenotype?</p>
PROMPT_A3C6_5722
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A3C6_5722_CHOICE_1';
2/3, 66.7%
LITERAL_A3C6_5722_CHOICE_1
$choice_2 = <<'LITERAL_A3C6_5722_CHOICE_2';
3/4, 75%
LITERAL_A3C6_5722_CHOICE_2
$choice_3 = <<'LITERAL_A3C6_5722_CHOICE_3';
1/3, 33.3%
LITERAL_A3C6_5722_CHOICE_3
$choice_4 = <<'LITERAL_A3C6_5722_CHOICE_4';
None, 0%
LITERAL_A3C6_5722_CHOICE_4
$choice_5 = <<'LITERAL_A3C6_5722_CHOICE_5';
All, 100%
LITERAL_A3C6_5722_CHOICE_5
$correct_1 = <<'LITERAL_A3C6_5722_CORRECT_1';
1/3, 33.3%
LITERAL_A3C6_5722_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
