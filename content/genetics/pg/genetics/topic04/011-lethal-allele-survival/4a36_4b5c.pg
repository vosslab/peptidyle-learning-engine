## DESCRIPTION
## Imported Genetics source row 4a36_4b5c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4A36_4B5C';
<p>4a36_4b5c</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what fraction are expected to show dwarf legs?</p>
PROMPT_4A36_4B5C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4A36_4B5C_CHOICE_1';
1/3, 33.3%
LITERAL_4A36_4B5C_CHOICE_1
$choice_2 = <<'LITERAL_4A36_4B5C_CHOICE_2';
1/4, 25%
LITERAL_4A36_4B5C_CHOICE_2
$choice_3 = <<'LITERAL_4A36_4B5C_CHOICE_3';
2/3, 66.7%
LITERAL_4A36_4B5C_CHOICE_3
$choice_4 = <<'LITERAL_4A36_4B5C_CHOICE_4';
All, 100%
LITERAL_4A36_4B5C_CHOICE_4
$choice_5 = <<'LITERAL_4A36_4B5C_CHOICE_5';
3/4, 75%
LITERAL_4A36_4B5C_CHOICE_5
$correct_1 = <<'LITERAL_4A36_4B5C_CORRECT_1';
2/3, 66.7%
LITERAL_4A36_4B5C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
