DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9D7E_AB98';
<p>9d7e_ab98</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). The parental cross is Tt x Tt.</p><p>What fraction of all conceptions are expected to have the normal phenotype?</p>
PROMPT_9D7E_AB98
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9D7E_AB98_CHOICE_1';
1/4, 25%
LITERAL_9D7E_AB98_CHOICE_1
$choice_2 = <<'LITERAL_9D7E_AB98_CHOICE_2';
None, 0%
LITERAL_9D7E_AB98_CHOICE_2
$choice_3 = <<'LITERAL_9D7E_AB98_CHOICE_3';
1/3, 33.3%
LITERAL_9D7E_AB98_CHOICE_3
$choice_4 = <<'LITERAL_9D7E_AB98_CHOICE_4';
2/3, 66.7%
LITERAL_9D7E_AB98_CHOICE_4
$choice_5 = <<'LITERAL_9D7E_AB98_CHOICE_5';
3/4, 75%
LITERAL_9D7E_AB98_CHOICE_5
$correct_1 = <<'LITERAL_9D7E_AB98_CORRECT_1';
1/4, 25%
LITERAL_9D7E_AB98_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
