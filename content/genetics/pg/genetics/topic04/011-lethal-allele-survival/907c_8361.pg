## DESCRIPTION
## Imported Genetics source row 907c_8361; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_907C_8361';
<p>907c_8361</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). The parental cross is Cc x Cc.</p><p>If 160 conceptions occur, how many are expected to have the normal phenotype?</p>
PROMPT_907C_8361
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_907C_8361_CHOICE_1';
40
LITERAL_907C_8361_CHOICE_1
$choice_2 = <<'LITERAL_907C_8361_CHOICE_2';
120
LITERAL_907C_8361_CHOICE_2
$choice_3 = <<'LITERAL_907C_8361_CHOICE_3';
160
LITERAL_907C_8361_CHOICE_3
$choice_4 = <<'LITERAL_907C_8361_CHOICE_4';
36
LITERAL_907C_8361_CHOICE_4
$choice_5 = <<'LITERAL_907C_8361_CHOICE_5';
44
LITERAL_907C_8361_CHOICE_5
$correct_1 = <<'LITERAL_907C_8361_CORRECT_1';
40
LITERAL_907C_8361_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
