## DESCRIPTION
## Imported Genetics source row 60a3_5982; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_60A3_5982';
<p>60a3_5982</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). The parental cross is Dd x Dd.</p><p>Among surviving offspring, what is the ratio of dwarf legs to normal phenotype?</p>
PROMPT_60A3_5982
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_60A3_5982_CHOICE_1';
3 to 1
LITERAL_60A3_5982_CHOICE_1
$choice_2 = <<'LITERAL_60A3_5982_CHOICE_2';
1 to 2
LITERAL_60A3_5982_CHOICE_2
$choice_3 = <<'LITERAL_60A3_5982_CHOICE_3';
1 to 1
LITERAL_60A3_5982_CHOICE_3
$choice_4 = <<'LITERAL_60A3_5982_CHOICE_4';
2 to 1
LITERAL_60A3_5982_CHOICE_4
$choice_5 = <<'LITERAL_60A3_5982_CHOICE_5';
3 to 2
LITERAL_60A3_5982_CHOICE_5
$correct_1 = <<'LITERAL_60A3_5982_CORRECT_1';
2 to 1
LITERAL_60A3_5982_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
