## DESCRIPTION
## Imported Genetics source row 0d6e_c716; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0D6E_C716';
<p>0d6e_c716</p> <p>In cats, allele T causes tailless in heterozygotes (Tt) but is lethal in homozygotes (TT). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>What fraction of all conceptions are expected to show tailless?</p>
PROMPT_0D6E_C716
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0D6E_C716_CHOICE_1';
None, 0%
LITERAL_0D6E_C716_CHOICE_1
$choice_2 = <<'LITERAL_0D6E_C716_CHOICE_2';
1/4, 25%
LITERAL_0D6E_C716_CHOICE_2
$choice_3 = <<'LITERAL_0D6E_C716_CHOICE_3';
All, 100%
LITERAL_0D6E_C716_CHOICE_3
$choice_4 = <<'LITERAL_0D6E_C716_CHOICE_4';
1/2, 50%
LITERAL_0D6E_C716_CHOICE_4
$choice_5 = <<'LITERAL_0D6E_C716_CHOICE_5';
1/3, 33.3%
LITERAL_0D6E_C716_CHOICE_5
$correct_1 = <<'LITERAL_0D6E_C716_CORRECT_1';
1/2, 50%
LITERAL_0D6E_C716_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
