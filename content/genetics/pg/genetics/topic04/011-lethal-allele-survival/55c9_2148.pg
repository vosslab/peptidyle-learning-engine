DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_55C9_2148';
<p>55c9_2148</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). Two heterozygous individuals are crossed.</p><p>Among surviving offspring, what is the ratio of curly wings to normal phenotype?</p>
PROMPT_55C9_2148
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_55C9_2148_CHOICE_1';
2 to 1
LITERAL_55C9_2148_CHOICE_1
$choice_2 = <<'LITERAL_55C9_2148_CHOICE_2';
3 to 2
LITERAL_55C9_2148_CHOICE_2
$choice_3 = <<'LITERAL_55C9_2148_CHOICE_3';
1 to 1
LITERAL_55C9_2148_CHOICE_3
$choice_4 = <<'LITERAL_55C9_2148_CHOICE_4';
3 to 1
LITERAL_55C9_2148_CHOICE_4
$choice_5 = <<'LITERAL_55C9_2148_CHOICE_5';
1 to 2
LITERAL_55C9_2148_CHOICE_5
$correct_1 = <<'LITERAL_55C9_2148_CORRECT_1';
2 to 1
LITERAL_55C9_2148_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
