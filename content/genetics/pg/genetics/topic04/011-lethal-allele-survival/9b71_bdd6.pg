## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9B71_BDD6';
<p>9b71_bdd6</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>If 120 conceptions occur, how many are expected to survive?</p>
PROMPT_9B71_BDD6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9B71_BDD6_CHOICE_1';
120
LITERAL_9B71_BDD6_CHOICE_1
$choice_2 = <<'LITERAL_9B71_BDD6_CHOICE_2';
116
LITERAL_9B71_BDD6_CHOICE_2
$choice_3 = <<'LITERAL_9B71_BDD6_CHOICE_3';
30
LITERAL_9B71_BDD6_CHOICE_3
$choice_4 = <<'LITERAL_9B71_BDD6_CHOICE_4';
60
LITERAL_9B71_BDD6_CHOICE_4
$choice_5 = <<'LITERAL_9B71_BDD6_CHOICE_5';
124
LITERAL_9B71_BDD6_CHOICE_5
$correct_1 = <<'LITERAL_9B71_BDD6_CORRECT_1';
120
LITERAL_9B71_BDD6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
