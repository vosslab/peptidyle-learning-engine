DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_211F_14AB';
<p>211f_14ab</p> <p>In fruit flies, allele C causes curly wings in heterozygotes (Cc) but is lethal in homozygotes (CC). The parental cross is Cc x cc.</p><p>If 160 conceptions occur, how many are expected to be lethal?</p>
PROMPT_211F_14AB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_211F_14AB_CHOICE_1';
4
LITERAL_211F_14AB_CHOICE_1
$choice_2 = <<'LITERAL_211F_14AB_CHOICE_2';
0
LITERAL_211F_14AB_CHOICE_2
$choice_3 = <<'LITERAL_211F_14AB_CHOICE_3';
120
LITERAL_211F_14AB_CHOICE_3
$choice_4 = <<'LITERAL_211F_14AB_CHOICE_4';
40
LITERAL_211F_14AB_CHOICE_4
$choice_5 = <<'LITERAL_211F_14AB_CHOICE_5';
80
LITERAL_211F_14AB_CHOICE_5
$correct_1 = <<'LITERAL_211F_14AB_CORRECT_1';
0
LITERAL_211F_14AB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
