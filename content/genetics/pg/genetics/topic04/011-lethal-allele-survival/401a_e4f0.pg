## DESCRIPTION
## Imported Genetics source row 401a_e4f0; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_401A_E4F0';
<p>401a_e4f0</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). A heterozygous individual is crossed with a normal homozygous recessive individual.</p><p>Among surviving offspring, what is the ratio of dwarf legs to normal phenotype?</p>
PROMPT_401A_E4F0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_401A_E4F0_CHOICE_1';
3 to 1
LITERAL_401A_E4F0_CHOICE_1
$choice_2 = <<'LITERAL_401A_E4F0_CHOICE_2';
2 to 1
LITERAL_401A_E4F0_CHOICE_2
$choice_3 = <<'LITERAL_401A_E4F0_CHOICE_3';
3 to 2
LITERAL_401A_E4F0_CHOICE_3
$choice_4 = <<'LITERAL_401A_E4F0_CHOICE_4';
1 to 2
LITERAL_401A_E4F0_CHOICE_4
$choice_5 = <<'LITERAL_401A_E4F0_CHOICE_5';
1 to 1
LITERAL_401A_E4F0_CHOICE_5
$correct_1 = <<'LITERAL_401A_E4F0_CORRECT_1';
1 to 1
LITERAL_401A_E4F0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
