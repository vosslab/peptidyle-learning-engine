## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8017_8FA5';
<p>8017_8fa5</p> <p>In mice, allele Y causes yellow coat in heterozygotes (Yy) but is lethal in homozygotes (YY). Two heterozygous individuals are crossed.</p><p>If 160 conceptions occur, how many are expected to show yellow coat?</p>
PROMPT_8017_8FA5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8017_8FA5_CHOICE_1';
80
LITERAL_8017_8FA5_CHOICE_1
$choice_2 = <<'LITERAL_8017_8FA5_CHOICE_2';
76
LITERAL_8017_8FA5_CHOICE_2
$choice_3 = <<'LITERAL_8017_8FA5_CHOICE_3';
160
LITERAL_8017_8FA5_CHOICE_3
$choice_4 = <<'LITERAL_8017_8FA5_CHOICE_4';
120
LITERAL_8017_8FA5_CHOICE_4
$choice_5 = <<'LITERAL_8017_8FA5_CHOICE_5';
84
LITERAL_8017_8FA5_CHOICE_5
$correct_1 = <<'LITERAL_8017_8FA5_CORRECT_1';
80
LITERAL_8017_8FA5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
