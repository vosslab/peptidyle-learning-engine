## DESCRIPTION
## Imported Genetics source row f0ab_ffad; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-lethal_allele_survival-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F0AB_FFAD';
<p>f0ab_ffad</p> <p>In cattle, allele D causes dwarf legs in heterozygotes (Dd) but is lethal in homozygotes (DD). Two heterozygous individuals are crossed.</p><p>If 40 conceptions occur, how many are expected to be lethal?</p>
PROMPT_F0AB_FFAD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F0AB_FFAD_CHOICE_1';
10
LITERAL_F0AB_FFAD_CHOICE_1
$choice_2 = <<'LITERAL_F0AB_FFAD_CHOICE_2';
30
LITERAL_F0AB_FFAD_CHOICE_2
$choice_3 = <<'LITERAL_F0AB_FFAD_CHOICE_3';
20
LITERAL_F0AB_FFAD_CHOICE_3
$choice_4 = <<'LITERAL_F0AB_FFAD_CHOICE_4';
6
LITERAL_F0AB_FFAD_CHOICE_4
$choice_5 = <<'LITERAL_F0AB_FFAD_CHOICE_5';
40
LITERAL_F0AB_FFAD_CHOICE_5
$correct_1 = <<'LITERAL_F0AB_FFAD_CORRECT_1';
10
LITERAL_F0AB_FFAD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
