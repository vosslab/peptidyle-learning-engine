## DESCRIPTION
## Imported Genetics source row 8b22_3375; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-MATCH-genetics_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8B22_3375';
<p>8b22_3375</p> <p>Match each of the following <strong><span style="color: #a719db;">genetic terms</span></strong> with their corresponding definitions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_8B22_3375
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_8B22_3375_MATCH_TERM_0';
<strong><span style="color: #007a00;">genetics</span></strong>
LITERAL_8B22_3375_MATCH_TERM_0
$match_term_1 = <<'LITERAL_8B22_3375_MATCH_TERM_1';
<strong><span style="color: #003fff;">genetic code</span></strong>
LITERAL_8B22_3375_MATCH_TERM_1
$match_term_2 = <<'LITERAL_8B22_3375_MATCH_TERM_2';
<strong><span style="color: #6c6c00;">genome</span> </strong>
LITERAL_8B22_3375_MATCH_TERM_2
$match_term_3 = <<'LITERAL_8B22_3375_MATCH_TERM_3';
<strong><span style="color: #b74300;">gene</span> </strong>
LITERAL_8B22_3375_MATCH_TERM_3
$match_term_4 = <<'LITERAL_8B22_3375_MATCH_TERM_4';
<strong><span style="color: #3b7600;">single nucleotide polymorphism (SNP)</span></strong>
LITERAL_8B22_3375_MATCH_TERM_4
$match_choice_0 = <<'LITERAL_8B22_3375_MATCH_CHOICE_0';
the study of heredity and how genes control the inherited characteristics
LITERAL_8B22_3375_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_8B22_3375_MATCH_CHOICE_1';
the code our body uses to convert the instructions contained in our DNA the essential materials of life
LITERAL_8B22_3375_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_8B22_3375_MATCH_CHOICE_2';
complete set of DNA in an organism
LITERAL_8B22_3375_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_8B22_3375_MATCH_CHOICE_3';
the main elements of heredity
LITERAL_8B22_3375_MATCH_CHOICE_3
$match_choice_4 = <<'LITERAL_8B22_3375_MATCH_CHOICE_4';
a substitution of a single nucleotide at a specific position in the genome
LITERAL_8B22_3375_MATCH_CHOICE_4
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D", "E"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D", "E"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D", "E"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D", "E"], 4);
$match_dropdown_4 = make_popup(['', "A", "B", "C", "D", "E"], 5);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*

[_]{$match_dropdown_4} *5.* [$match_term_4]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*

*E.* [$match_choice_4]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
