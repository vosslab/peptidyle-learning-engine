## DESCRIPTION
## Imported Genetics source row 3861_b0f9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendel_cross_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3861_B0F9';
<p>3861_b0f9</p> <p>Which one of the following Mendelian crosses and generational stages correspond to the description <span style='font-size: 1em;'><strong>'a mating event that pairs two <strong><span style="color: #6c6c00;">homozygous</span></strong> individuals with different characteristics'</strong></span>.</p>
PROMPT_3861_B0F9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3861_B0F9_CHOICE_1';
<strong><span style="color: #c80085;">P generation</span></strong>
LITERAL_3861_B0F9_CHOICE_1
$choice_2 = <<'LITERAL_3861_B0F9_CHOICE_2';
<strong><span style="color: #007576;">hybrid cross</span></strong>
LITERAL_3861_B0F9_CHOICE_2
$choice_3 = <<'LITERAL_3861_B0F9_CHOICE_3';
<strong><span style="color: #a719db;">reciprocal cross</span></strong>
LITERAL_3861_B0F9_CHOICE_3
$choice_4 = <<'LITERAL_3861_B0F9_CHOICE_4';
<strong><span style="color: #d40000;">test cross</span></strong>
LITERAL_3861_B0F9_CHOICE_4
$correct_1 = <<'LITERAL_3861_B0F9_CORRECT_1';
<strong><span style="color: #007576;">hybrid cross</span></strong>
LITERAL_3861_B0F9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
