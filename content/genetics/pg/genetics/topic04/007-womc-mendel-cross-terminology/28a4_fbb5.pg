## DESCRIPTION
## Imported Genetics source row 28a4_fbb5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendel_cross_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_28A4_FBB5';
<p>28a4_fbb5</p> <p>Which one of the following Mendelian crosses and generational stages correspond to the description <span style='font-size: 1em;'><strong>'two distinct crosses where the male and female <strong><span style="color: #0067cc;">parental</span></strong> traits are reversed in the subsequent cross'</strong></span>.</p>
PROMPT_28A4_FBB5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_28A4_FBB5_CHOICE_1';
<strong><span style="color: #007a00;">F<sub>2</sub> generation</span></strong>
LITERAL_28A4_FBB5_CHOICE_1
$choice_2 = <<'LITERAL_28A4_FBB5_CHOICE_2';
<strong><span style="color: #3b7600;">backcross</span></strong>
LITERAL_28A4_FBB5_CHOICE_2
$choice_3 = <<'LITERAL_28A4_FBB5_CHOICE_3';
<strong><span style="color: #a719db;">reciprocal cross</span></strong>
LITERAL_28A4_FBB5_CHOICE_3
$choice_4 = <<'LITERAL_28A4_FBB5_CHOICE_4';
<strong><span style="color: #d40000;">test cross</span></strong>
LITERAL_28A4_FBB5_CHOICE_4
$correct_1 = <<'LITERAL_28A4_FBB5_CORRECT_1';
<strong><span style="color: #a719db;">reciprocal cross</span></strong>
LITERAL_28A4_FBB5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
