## DESCRIPTION
## Imported Genetics source row f4c4_2a33; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic04/bbq-WOMC-mendel_cross_terminology-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F4C4_2A33';
<p>f4c4_2a33</p> <p>Which one of the following Mendelian crosses and generational stages correspond to the description <span style='font-size: 1em;'><strong>'the first generation derived from a genetic cross between members of the <strong><span style="color: #0067cc;">parental</span></strong> generation'</strong></span>.</p>
PROMPT_F4C4_2A33
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F4C4_2A33_CHOICE_1';
<strong><span style="color: #b74300;">F<sub>1</sub> generation</span></strong>
LITERAL_F4C4_2A33_CHOICE_1
$choice_2 = <<'LITERAL_F4C4_2A33_CHOICE_2';
<strong><span style="color: #007a00;">F<sub>2</sub> generation</span></strong>
LITERAL_F4C4_2A33_CHOICE_2
$choice_3 = <<'LITERAL_F4C4_2A33_CHOICE_3';
<strong><span style="color: #3b7600;">backcross</span></strong>
LITERAL_F4C4_2A33_CHOICE_3
$choice_4 = <<'LITERAL_F4C4_2A33_CHOICE_4';
<strong><span style="color: #a719db;">reciprocal cross</span></strong>
LITERAL_F4C4_2A33_CHOICE_4
$correct_1 = <<'LITERAL_F4C4_2A33_CORRECT_1';
<strong><span style="color: #b74300;">F<sub>1</sub> generation</span></strong>
LITERAL_F4C4_2A33_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
