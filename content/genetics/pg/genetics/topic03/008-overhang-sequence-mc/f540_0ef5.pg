## DESCRIPTION
## Imported Genetics source row f540_0ef5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic03/bbq-overhang_sequence-mc-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F540_0EF5';
<p>f540_0ef5</p> <p>Restriction enzymes are proteins that cut DNA at specific sequences to produce fragments for further study. These enzymes are obtained from various types of bacteria and have the ability to recognize short nucleotide sequences within a larger DNA molecule.</p><p>The restriction enzyme we are focusing on is <strong><i><code>PalAI</code></i></strong>, which is derived from the bacterium Pseudomonas alcaligenes BS17.</p><p><strong><i><code>PalAI</code></i></strong> cuts the DNA sequence as follows: <code>5'-GG|CGCGCC-3'</code>, where the '|' indicates the cleavage site.</p><p>Based on this information, which one of the following sequences below corresponds to the overhang region of the DNA after cleavage by the restriction enzyme <strong><i><code>PalAI</code></i></strong>?</p>
PROMPT_F540_0EF5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F540_0EF5_CHOICE_1';
5'-CCGCGC-3'
LITERAL_F540_0EF5_CHOICE_1
$choice_2 = <<'LITERAL_F540_0EF5_CHOICE_2';
5'-CGCG-3'
LITERAL_F540_0EF5_CHOICE_2
$choice_3 = <<'LITERAL_F540_0EF5_CHOICE_3';
5'-CGCGCC-3'
LITERAL_F540_0EF5_CHOICE_3
$choice_4 = <<'LITERAL_F540_0EF5_CHOICE_4';
5'-GCGC-3'
LITERAL_F540_0EF5_CHOICE_4
$choice_5 = <<'LITERAL_F540_0EF5_CHOICE_5';
5'-GCGCGG-3'
LITERAL_F540_0EF5_CHOICE_5
$choice_6 = <<'LITERAL_F540_0EF5_CHOICE_6';
5'-GGCGCG-3'
LITERAL_F540_0EF5_CHOICE_6
$correct_1 = <<'LITERAL_F540_0EF5_CORRECT_1';
5'-CGCG-3'
LITERAL_F540_0EF5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
