## DESCRIPTION
## Imported Genetics source row ed96_6598; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic03/bbq-overhang_sequence-mc-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_ED96_6598';
<p>ed96_6598</p> <p>Restriction enzymes are proteins that cut DNA at specific sequences to produce fragments for further study. These enzymes are obtained from various types of bacteria and have the ability to recognize short nucleotide sequences within a larger DNA molecule.</p><p>The restriction enzyme we are focusing on is <strong><i><code>TaqI</code></i></strong>, which is derived from the bacterium Thermus aquaticus YTI.</p><p><strong><i><code>TaqI</code></i></strong> cuts the DNA sequence as follows: <code>5'-T|CGA-3'</code>, where the '|' indicates the cleavage site.</p><p>Based on this information, which one of the following sequences below corresponds to the overhang region of the DNA after cleavage by the restriction enzyme <strong><i><code>TaqI</code></i></strong>?</p>
PROMPT_ED96_6598
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_ED96_6598_CHOICE_1';
5'-AGC-3'
LITERAL_ED96_6598_CHOICE_1
$choice_2 = <<'LITERAL_ED96_6598_CHOICE_2';
5'-CG-3'
LITERAL_ED96_6598_CHOICE_2
$choice_3 = <<'LITERAL_ED96_6598_CHOICE_3';
5'-CGA-3'
LITERAL_ED96_6598_CHOICE_3
$choice_4 = <<'LITERAL_ED96_6598_CHOICE_4';
5'-GC-3'
LITERAL_ED96_6598_CHOICE_4
$choice_5 = <<'LITERAL_ED96_6598_CHOICE_5';
5'-GCT-3'
LITERAL_ED96_6598_CHOICE_5
$choice_6 = <<'LITERAL_ED96_6598_CHOICE_6';
5'-TCG-3'
LITERAL_ED96_6598_CHOICE_6
$correct_1 = <<'LITERAL_ED96_6598_CORRECT_1';
5'-CG-3'
LITERAL_ED96_6598_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
