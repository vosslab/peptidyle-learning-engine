er: 0px solid white; ">3</td><td align="center" colspan="2" style="border: 0px solid white; ">4</td><td align="center" colspan="2" style="border: 0px solid white; ">5</td><td align="center" colspan="2" style="border: 0px solid white; ">6</td><td align="center" colspan="2" style="border: 0px solid white; ">7</td><td align="center" colspan="2" style="border: 0px solid white; ">8</td><td style="border: 0px solid white; "></td></tr></tbody></table><p>Two (2) distinct types of restriction enzyme recognition sites, <i>CciI</i> and <i>KspI</i>, are labeled at the top of this DNA segment.</p><h6><strong>Determine the sizes of the DNA bands</strong> that would appear on an agarose gel after digestion with <i>CciI</i> only.</h6>
PROMPT_17B8_3635
loadMacros('parserCheckboxList.pl');
$choice_1 = <<'LITERAL_17B8_3635_CHOICE_1';
1 kb
LITERAL_17B8_3635_CHOICE_1
$choice_2 = <<'LITERAL_17B8_3635_CHOICE_2';
2 kb
LITERAL_17B8_3635_CHOICE_2
$choice_3 = <<'LITERAL_17B8_3635_CHOICE_3';
3 kb
LITERAL_17B8_3635_CHOICE_3
$choice_4 = <<'LITERAL_17B8_3635_CHOICE_4';
4 kb
LITERAL_17B8_3635_CHOICE_4
$choice_5 = <<'LITERAL_17B8_3635_CHOICE_5';
5 kb
LITERAL_17B8_3635_CHOICE_5
$correct_1 = <<'LITERAL_17B8_3635_CORRECT_1';
2 kb
LITERAL_17B8_3635_CORRECT_1
$correct_2 = <<'LITERAL_17B8_3635_CORRECT_2';
3 kb
LITERAL_17B8_3635_CORRECT_2
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
@correct = ($correct_1, $correct_2);
$answer = CheckboxList([@choices], [@correct], labels => 'ABC', displayLabels => 1, randomize => 0, separator => '<div style="margin-bottom: 0.7em;"></div>');
