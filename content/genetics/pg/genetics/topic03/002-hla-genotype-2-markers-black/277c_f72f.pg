DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_277C_F72F';
<p>277c_f72f</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong>A8,B2</strong> on one chromosome and <strong>A7,B6</strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong>A1,B5</strong> on one chromosome and <strong>A6,B8</strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_277C_F72F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_277C_F72F_CHOICE_1';
A6,A8,B2,B8
LITERAL_277C_F72F_CHOICE_1
$choice_2 = <<'LITERAL_277C_F72F_CHOICE_2';
A1,A7,B2,B8
LITERAL_277C_F72F_CHOICE_2
$choice_3 = <<'LITERAL_277C_F72F_CHOICE_3';
A1,A8,B6,B8
LITERAL_277C_F72F_CHOICE_3
$choice_4 = <<'LITERAL_277C_F72F_CHOICE_4';
A7,A8,B2,B6
LITERAL_277C_F72F_CHOICE_4
$choice_5 = <<'LITERAL_277C_F72F_CHOICE_5';
A1,A6,B5,B8
LITERAL_277C_F72F_CHOICE_5
$correct_1 = <<'LITERAL_277C_F72F_CORRECT_1';
A6,A8,B2,B8
LITERAL_277C_F72F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
