DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C4E9_2A31';
<p>c4e9_2a31</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong>A2,B2</strong> on one chromosome and <strong>A6,B7</strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong>A8,B9</strong> on one chromosome and <strong>A1,B8</strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_C4E9_2A31
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C4E9_2A31_CHOICE_1';
A2,A8,B2,B9
LITERAL_C4E9_2A31_CHOICE_1
$choice_2 = <<'LITERAL_C4E9_2A31_CHOICE_2';
A6,A8,B2,B8
LITERAL_C4E9_2A31_CHOICE_2
$choice_3 = <<'LITERAL_C4E9_2A31_CHOICE_3';
A2,A6,B2,B7
LITERAL_C4E9_2A31_CHOICE_3
$choice_4 = <<'LITERAL_C4E9_2A31_CHOICE_4';
A1,A8,B8,B9
LITERAL_C4E9_2A31_CHOICE_4
$choice_5 = <<'LITERAL_C4E9_2A31_CHOICE_5';
A1,A2,B7,B9
LITERAL_C4E9_2A31_CHOICE_5
$correct_1 = <<'LITERAL_C4E9_2A31_CORRECT_1';
A2,A8,B2,B9
LITERAL_C4E9_2A31_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
