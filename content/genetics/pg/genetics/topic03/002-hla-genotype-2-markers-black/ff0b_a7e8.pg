DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FF0B_A7E8';
<p>ff0b_a7e8</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong>A9,B9</strong> on one chromosome and <strong>A6,B5</strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong>A2,B6</strong> on one chromosome and <strong>A8,B1</strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_FF0B_A7E8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FF0B_A7E8_CHOICE_1';
A2,A8,B1,B6
LITERAL_FF0B_A7E8_CHOICE_1
$choice_2 = <<'LITERAL_FF0B_A7E8_CHOICE_2';
A2,A9,B6,B9
LITERAL_FF0B_A7E8_CHOICE_2
$choice_3 = <<'LITERAL_FF0B_A7E8_CHOICE_3';
A6,A9,B5,B9
LITERAL_FF0B_A7E8_CHOICE_3
$choice_4 = <<'LITERAL_FF0B_A7E8_CHOICE_4';
A2,A6,B1,B9
LITERAL_FF0B_A7E8_CHOICE_4
$correct_1 = <<'LITERAL_FF0B_A7E8_CORRECT_1';
A2,A9,B6,B9
LITERAL_FF0B_A7E8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
