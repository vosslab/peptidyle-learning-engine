DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8741_FF04';
<p>8741_ff04</p> Which one of the following English words is a palindrome?
PROMPT_8741_FF04
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8741_FF04_CHOICE_1';
joy
LITERAL_8741_FF04_CHOICE_1
$choice_2 = <<'LITERAL_8741_FF04_CHOICE_2';
civil
LITERAL_8741_FF04_CHOICE_2
$choice_3 = <<'LITERAL_8741_FF04_CHOICE_3';
mali
LITERAL_8741_FF04_CHOICE_3
$choice_4 = <<'LITERAL_8741_FF04_CHOICE_4';
dob
LITERAL_8741_FF04_CHOICE_4
$choice_5 = <<'LITERAL_8741_FF04_CHOICE_5';
Rotor
LITERAL_8741_FF04_CHOICE_5
$correct_1 = <<'LITERAL_8741_FF04_CORRECT_1';
Rotor
LITERAL_8741_FF04_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
