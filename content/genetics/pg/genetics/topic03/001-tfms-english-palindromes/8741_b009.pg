DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8741_B009';
<p>8741_b009</p> Which one of the following English words is a palindrome?
PROMPT_8741_B009
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8741_B009_CHOICE_1';
lulu
LITERAL_8741_B009_CHOICE_1
$choice_2 = <<'LITERAL_8741_B009_CHOICE_2';
roto
LITERAL_8741_B009_CHOICE_2
$choice_3 = <<'LITERAL_8741_B009_CHOICE_3';
Sos
LITERAL_8741_B009_CHOICE_3
$choice_4 = <<'LITERAL_8741_B009_CHOICE_4';
solo
LITERAL_8741_B009_CHOICE_4
$choice_5 = <<'LITERAL_8741_B009_CHOICE_5';
Stat
LITERAL_8741_B009_CHOICE_5
$correct_1 = <<'LITERAL_8741_B009_CORRECT_1';
Sos
LITERAL_8741_B009_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
