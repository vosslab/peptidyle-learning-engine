DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8E8B_5601';
<p>8e8b_5601</p> Which one of the following English words is <strong>NOT</strong> a palindrome?
PROMPT_8E8B_5601
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8E8B_5601_CHOICE_1';
Noon
LITERAL_8E8B_5601_CHOICE_1
$choice_2 = <<'LITERAL_8E8B_5601_CHOICE_2';
Refer
LITERAL_8E8B_5601_CHOICE_2
$choice_3 = <<'LITERAL_8E8B_5601_CHOICE_3';
stand
LITERAL_8E8B_5601_CHOICE_3
$choice_4 = <<'LITERAL_8E8B_5601_CHOICE_4';
Rotator
LITERAL_8E8B_5601_CHOICE_4
$choice_5 = <<'LITERAL_8E8B_5601_CHOICE_5';
Solos
LITERAL_8E8B_5601_CHOICE_5
$correct_1 = <<'LITERAL_8E8B_5601_CORRECT_1';
stand
LITERAL_8E8B_5601_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
