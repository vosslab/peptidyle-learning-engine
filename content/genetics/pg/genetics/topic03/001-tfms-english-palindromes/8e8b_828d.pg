DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8E8B_828D';
<p>8e8b_828d</p> Which one of the following English words is <strong>NOT</strong> a palindrome?
PROMPT_8E8B_828D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8E8B_828D_CHOICE_1';
mirror
LITERAL_8E8B_828D_CHOICE_1
$choice_2 = <<'LITERAL_8E8B_828D_CHOICE_2';
Noon
LITERAL_8E8B_828D_CHOICE_2
$choice_3 = <<'LITERAL_8E8B_828D_CHOICE_3';
Mom
LITERAL_8E8B_828D_CHOICE_3
$choice_4 = <<'LITERAL_8E8B_828D_CHOICE_4';
Kayak
LITERAL_8E8B_828D_CHOICE_4
$choice_5 = <<'LITERAL_8E8B_828D_CHOICE_5';
Sos
LITERAL_8E8B_828D_CHOICE_5
$correct_1 = <<'LITERAL_8E8B_828D_CORRECT_1';
mirror
LITERAL_8E8B_828D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
