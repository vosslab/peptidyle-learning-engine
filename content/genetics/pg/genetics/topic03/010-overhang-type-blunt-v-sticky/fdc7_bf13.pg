## DESCRIPTION
## Imported Genetics source row fdc7_bf13; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic03/bbq-overhang_type-blunt_v_sticky-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FDC7_BF13';
<p>fdc7_bf13</p> <p>Restriction enzymes are proteins that cut DNA at specific sequences to produce fragments for further study. These enzymes are obtained from various types of bacteria and have the ability to recognize short nucleotide sequences within a larger DNA molecule.</p> <p>The restriction enzyme we are focusing on is <strong><i><code>SgfI</code></i></strong> and is obtained from the bacteria Streptomyces griseoruber.</p> <p><strong><i><code>SgfI</code></i></strong> cuts the DNA sequence as follows: <code>5'-GCGAT|CGC-3'</code> where the '|' indicates the cut location.</p> <p>Based on this info, can you identify the type of cut this enzyme makes?</p>
PROMPT_FDC7_BF13
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FDC7_BF13_CHOICE_1';
<span style="color: #b30077;">sticky end</span>
LITERAL_FDC7_BF13_CHOICE_1
$choice_2 = <<'LITERAL_FDC7_BF13_CHOICE_2';
<span style="color: #009900;">blunt end</span>
LITERAL_FDC7_BF13_CHOICE_2
$choice_3 = <<'LITERAL_FDC7_BF13_CHOICE_3';
<span style="color: #e65400;">overhang end</span>
LITERAL_FDC7_BF13_CHOICE_3
$choice_4 = <<'LITERAL_FDC7_BF13_CHOICE_4';
<span style="color: #0a9bf5;">hanger end</span>
LITERAL_FDC7_BF13_CHOICE_4
$choice_5 = <<'LITERAL_FDC7_BF13_CHOICE_5';
<span style="color: #004d99;">straight edge</span>
LITERAL_FDC7_BF13_CHOICE_5
$correct_1 = <<'LITERAL_FDC7_BF13_CORRECT_1';
<span style="color: #b30077;">sticky end</span>
LITERAL_FDC7_BF13_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
