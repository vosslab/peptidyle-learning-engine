## DESCRIPTION
## Imported Genetics source row c4cf_d46f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic03/bbq-overhang_type-blunt_v_sticky-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C4CF_D46F';
<p>c4cf_d46f</p> <p>Restriction enzymes are proteins that cut DNA at specific sequences to produce fragments for further study. These enzymes are obtained from various types of bacteria and have the ability to recognize short nucleotide sequences within a larger DNA molecule.</p> <p>The restriction enzyme we are focusing on is <strong><i><code>EsaBC3I</code></i></strong> and is obtained from the bacteria Environmental sample BC3.</p> <p><strong><i><code>EsaBC3I</code></i></strong> cuts the DNA sequence as follows: <code>5'-TC|GA-3'</code> where the '|' indicates the cut location.</p> <p>Based on this info, can you identify the type of cut this enzyme makes?</p>
PROMPT_C4CF_D46F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C4CF_D46F_CHOICE_1';
<span style="color: #b30077;">sticky end</span>
LITERAL_C4CF_D46F_CHOICE_1
$choice_2 = <<'LITERAL_C4CF_D46F_CHOICE_2';
<span style="color: #0a9bf5;">hanger end</span>
LITERAL_C4CF_D46F_CHOICE_2
$choice_3 = <<'LITERAL_C4CF_D46F_CHOICE_3';
<span style="color: #e65400;">overhang end</span>
LITERAL_C4CF_D46F_CHOICE_3
$choice_4 = <<'LITERAL_C4CF_D46F_CHOICE_4';
<span style="color: #009900;">blunt end</span>
LITERAL_C4CF_D46F_CHOICE_4
$choice_5 = <<'LITERAL_C4CF_D46F_CHOICE_5';
<span style="color: #004d99;">straight edge</span>
LITERAL_C4CF_D46F_CHOICE_5
$correct_1 = <<'LITERAL_C4CF_D46F_CORRECT_1';
<span style="color: #009900;">blunt end</span>
LITERAL_C4CF_D46F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
