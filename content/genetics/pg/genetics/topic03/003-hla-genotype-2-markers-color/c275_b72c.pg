DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C275_B72C';
<p>c275_b72c</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong><span style="color: #974015;">A5</span>,<span style="color: #974015;">B3</span></strong> on one chromosome and <strong><span style="color: #436b06;">A9</span>,<span style="color: #436b06;">B9</span></strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong><span style="color: #2d5ca9;">A3</span>,<span style="color: #2d5ca9;">B4</span></strong> on one chromosome and <strong><span style="color: #893987;">A2</span>,<span style="color: #893987;">B6</span></strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_C275_B72C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C275_B72C_CHOICE_1';
<span style="color: #2d5ca9;">A3</span>,<span style="color: #436b06;">A9</span>,<span style="color: #893987;">B6</span>,<span style="color: #974015;">B3</span>
LITERAL_C275_B72C_CHOICE_1
$choice_2 = <<'LITERAL_C275_B72C_CHOICE_2';
<span style="color: #436b06;">A9</span>,<span style="color: #436b06;">B9</span>,<span style="color: #974015;">A5</span>,<span style="color: #974015;">B3</span>
LITERAL_C275_B72C_CHOICE_2
$choice_3 = <<'LITERAL_C275_B72C_CHOICE_3';
<span style="color: #2d5ca9;">A3</span>,<span style="color: #2d5ca9;">B4</span>,<span style="color: #893987;">A2</span>,<span style="color: #893987;">B6</span>
LITERAL_C275_B72C_CHOICE_3
$choice_4 = <<'LITERAL_C275_B72C_CHOICE_4';
<span style="color: #2d5ca9;">A3</span>,<span style="color: #2d5ca9;">B4</span>,<span style="color: #436b06;">A9</span>,<span style="color: #436b06;">B9</span>
LITERAL_C275_B72C_CHOICE_4
$correct_1 = <<'LITERAL_C275_B72C_CORRECT_1';
<span style="color: #2d5ca9;">A3</span>,<span style="color: #2d5ca9;">B4</span>,<span style="color: #436b06;">A9</span>,<span style="color: #436b06;">B9</span>
LITERAL_C275_B72C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
