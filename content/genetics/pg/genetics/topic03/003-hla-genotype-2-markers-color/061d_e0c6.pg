DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_061D_E0C6';
<p>061d_e0c6</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong><span style="color: #646100;">A3</span>,<span style="color: #646100;">B4</span></strong> on one chromosome and <strong><span style="color: #00697f;">A8</span>,<span style="color: #00697f;">B9</span></strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong><span style="color: #5148c5;">A1</span>,<span style="color: #5148c5;">B6</span></strong> on one chromosome and <strong><span style="color: #993164;">A6</span>,<span style="color: #993164;">B1</span></strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_061D_E0C6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_061D_E0C6_CHOICE_1';
<span style="color: #5148c5;">A1</span>,<span style="color: #5148c5;">B6</span>,<span style="color: #993164;">A6</span>,<span style="color: #993164;">B1</span>
LITERAL_061D_E0C6_CHOICE_1
$choice_2 = <<'LITERAL_061D_E0C6_CHOICE_2';
<span style="color: #00697f;">A8</span>,<span style="color: #00697f;">B9</span>,<span style="color: #646100;">A3</span>,<span style="color: #646100;">B4</span>
LITERAL_061D_E0C6_CHOICE_2
$choice_3 = <<'LITERAL_061D_E0C6_CHOICE_3';
<span style="color: #646100;">A3</span>,<span style="color: #646100;">B4</span>,<span style="color: #993164;">A6</span>,<span style="color: #993164;">B1</span>
LITERAL_061D_E0C6_CHOICE_3
$choice_4 = <<'LITERAL_061D_E0C6_CHOICE_4';
<span style="color: #00697f;">A8</span>,<span style="color: #5148c5;">B6</span>,<span style="color: #646100;">B4</span>,<span style="color: #993164;">A6</span>
LITERAL_061D_E0C6_CHOICE_4
$correct_1 = <<'LITERAL_061D_E0C6_CORRECT_1';
<span style="color: #646100;">A3</span>,<span style="color: #646100;">B4</span>,<span style="color: #993164;">A6</span>,<span style="color: #993164;">B1</span>
LITERAL_061D_E0C6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
