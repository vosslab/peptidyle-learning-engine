DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2AD5_0DB2';
<p>2ad5_0db2</p> <p>HLA genotyping serves as a key component in the field of immunogenetics. It is used for understanding individual variations in immune responses. This molecular technique identifies unique alleles on paired chromosomes. It's particularly vital in organ transplantation for matching donors and recipients. Finding a correct match reduces the chance for graft rejection. </p><p>A mother has a HLA genotype of <strong><span style="color: #974018;">A5</span>,<span style="color: #974018;">B1</span>,<span style="color: #974018;">C4</span></strong> on one chromosome and <strong><span style="color: #2d6d40;">A7</span>,<span style="color: #2d6d40;">B3</span>,<span style="color: #2d6d40;">C8</span></strong> on the other chromosome. </p><p>The father has a HLA genotype of <strong><span style="color: #00697e;">A8</span>,<span style="color: #00697e;">B4</span>,<span style="color: #00697e;">C3</span></strong> on one chromosome and <strong><span style="color: #504ac1;">A9</span>,<span style="color: #504ac1;">B2</span>,<span style="color: #504ac1;">C7</span></strong> on the other chromosome. </p><p>Which one of the following combinations is a possible genotype for their offspring?</p>
PROMPT_2AD5_0DB2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2AD5_0DB2_CHOICE_1';
<span style="color: #00697e;">B4</span>,<span style="color: #2d6d40;">A7</span>,<span style="color: #2d6d40;">C8</span>,<span style="color: #504ac1;">A9</span>,<span style="color: #504ac1;">C7</span>,<span style="color: #974018;">B1</span>
LITERAL_2AD5_0DB2_CHOICE_1
$choice_2 = <<'LITERAL_2AD5_0DB2_CHOICE_2';
<span style="color: #2d6d40;">A7</span>,<span style="color: #2d6d40;">B3</span>,<span style="color: #2d6d40;">C8</span>,<span style="color: #974018;">A5</span>,<span style="color: #974018;">B1</span>,<span style="color: #974018;">C4</span>
LITERAL_2AD5_0DB2_CHOICE_2
$choice_3 = <<'LITERAL_2AD5_0DB2_CHOICE_3';
<span style="color: #00697e;">A8</span>,<span style="color: #00697e;">B4</span>,<span style="color: #00697e;">C3</span>,<span style="color: #504ac1;">A9</span>,<span style="color: #504ac1;">B2</span>,<span style="color: #504ac1;">C7</span>
LITERAL_2AD5_0DB2_CHOICE_3
$choice_4 = <<'LITERAL_2AD5_0DB2_CHOICE_4';
<span style="color: #00697e;">A8</span>,<span style="color: #00697e;">B4</span>,<span style="color: #2d6d40;">B3</span>,<span style="color: #2d6d40;">C8</span>,<span style="color: #504ac1;">C7</span>,<span style="color: #974018;">A5</span>
LITERAL_2AD5_0DB2_CHOICE_4
$choice_5 = <<'LITERAL_2AD5_0DB2_CHOICE_5';
<span style="color: #00697e;">A8</span>,<span style="color: #00697e;">B4</span>,<span style="color: #00697e;">C3</span>,<span style="color: #2d6d40;">A7</span>,<span style="color: #2d6d40;">B3</span>,<span style="color: #2d6d40;">C8</span>
LITERAL_2AD5_0DB2_CHOICE_5
$correct_1 = <<'LITERAL_2AD5_0DB2_CORRECT_1';
<span style="color: #00697e;">A8</span>,<span style="color: #00697e;">B4</span>,<span style="color: #00697e;">C3</span>,<span style="color: #2d6d40;">A7</span>,<span style="color: #2d6d40;">B3</span>,<span style="color: #2d6d40;">C8</span>
LITERAL_2AD5_0DB2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
