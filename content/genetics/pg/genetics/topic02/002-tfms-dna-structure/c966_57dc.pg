## DESCRIPTION
## Imported Genetics source row c966_57dc; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C966_57DC';
<p>c966_57dc</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C966_57DC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C966_57DC_CHOICE_1';
the DNA strands are uniformly negatively charged
LITERAL_C966_57DC_CHOICE_1
$choice_2 = <<'LITERAL_C966_57DC_CHOICE_2';
base pairings create unequal spacing between the two DNA strands
LITERAL_C966_57DC_CHOICE_2
$choice_3 = <<'LITERAL_C966_57DC_CHOICE_3';
the helix is made of nucleotides
LITERAL_C966_57DC_CHOICE_3
$choice_4 = <<'LITERAL_C966_57DC_CHOICE_4';
the DNA double helix has ten nucleotides between each turn
LITERAL_C966_57DC_CHOICE_4
$choice_5 = <<'LITERAL_C966_57DC_CHOICE_5';
the two strands of DNA are anti-parallel
LITERAL_C966_57DC_CHOICE_5
$correct_1 = <<'LITERAL_C966_57DC_CORRECT_1';
base pairings create unequal spacing between the two DNA strands
LITERAL_C966_57DC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
