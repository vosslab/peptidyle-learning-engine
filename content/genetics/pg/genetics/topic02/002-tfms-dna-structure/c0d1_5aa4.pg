## DESCRIPTION
## Imported Genetics source row c0d1_5aa4; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_5AA4';
<p>c0d1_5aa4</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_5AA4
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_5AA4_CHOICE_1';
the phosphate groups are on the inside of the DNA double helix
LITERAL_C0D1_5AA4_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_5AA4_CHOICE_2';
the two strands of DNA are parallel
LITERAL_C0D1_5AA4_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_5AA4_CHOICE_3';
base pairings create unequal spacing between the two DNA strands
LITERAL_C0D1_5AA4_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_5AA4_CHOICE_4';
A-T base pairs are weaker than G-C base pairs
LITERAL_C0D1_5AA4_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_5AA4_CHOICE_5';
one strand is positively charged and the other is negatively charged
LITERAL_C0D1_5AA4_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_5AA4_CORRECT_1';
A-T base pairs are weaker than G-C base pairs
LITERAL_C0D1_5AA4_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
