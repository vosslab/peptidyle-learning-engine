## DESCRIPTION
## Imported Genetics source row c0d1_cf0e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_CF0E';
<p>c0d1_cf0e</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_CF0E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_CF0E_CHOICE_1';
A-T base pairs have three hydrogen bonds, whereas G-C base pairs only have two hydrogen bonds
LITERAL_C0D1_CF0E_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_CF0E_CHOICE_2';
the DNA double helix has a consistent diameter
LITERAL_C0D1_CF0E_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_CF0E_CHOICE_3';
pyrimidine bases pair up with like pyrimidine bases
LITERAL_C0D1_CF0E_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_CF0E_CHOICE_4';
the backbone contains only nucleobase and sugar
LITERAL_C0D1_CF0E_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_CF0E_CHOICE_5';
base pairings create unequal spacing between the two DNA strands
LITERAL_C0D1_CF0E_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_CF0E_CORRECT_1';
the DNA double helix has a consistent diameter
LITERAL_C0D1_CF0E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
