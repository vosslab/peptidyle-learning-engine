## DESCRIPTION
## Imported Genetics source row 9578_dd9a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_DD9A';
<p>9578_dd9a</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_DD9A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_DD9A_CHOICE_1';
the helix is made of amino acids
LITERAL_9578_DD9A_CHOICE_1
$choice_2 = <<'LITERAL_9578_DD9A_CHOICE_2';
base pairings create unequal spacing between the two DNA strands
LITERAL_9578_DD9A_CHOICE_2
$choice_3 = <<'LITERAL_9578_DD9A_CHOICE_3';
disulfide bonds hold the two strands together
LITERAL_9578_DD9A_CHOICE_3
$choice_4 = <<'LITERAL_9578_DD9A_CHOICE_4';
the DNA strands are uniformly negatively charged
LITERAL_9578_DD9A_CHOICE_4
$choice_5 = <<'LITERAL_9578_DD9A_CHOICE_5';
A-T base pairs are stronger than G-C base pairs
LITERAL_9578_DD9A_CHOICE_5
$correct_1 = <<'LITERAL_9578_DD9A_CORRECT_1';
the DNA strands are uniformly negatively charged
LITERAL_9578_DD9A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
