## DESCRIPTION
## Imported Genetics source row c966_e554; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C966_E554';
<p>c966_e554</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C966_E554
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C966_E554_CHOICE_1';
hydrogen bonds hold the two strands together
LITERAL_C966_E554_CHOICE_1
$choice_2 = <<'LITERAL_C966_E554_CHOICE_2';
G-C base pairs are stronger than A-T base pairs
LITERAL_C966_E554_CHOICE_2
$choice_3 = <<'LITERAL_C966_E554_CHOICE_3';
purine bases pair up with like purine bases
LITERAL_C966_E554_CHOICE_3
$choice_4 = <<'LITERAL_C966_E554_CHOICE_4';
the phosphate groups are on the outside of the DNA double helix
LITERAL_C966_E554_CHOICE_4
$choice_5 = <<'LITERAL_C966_E554_CHOICE_5';
the DNA strands are uniformly negatively charged
LITERAL_C966_E554_CHOICE_5
$correct_1 = <<'LITERAL_C966_E554_CORRECT_1';
purine bases pair up with like purine bases
LITERAL_C966_E554_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
