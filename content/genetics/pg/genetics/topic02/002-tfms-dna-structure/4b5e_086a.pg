## DESCRIPTION
## Imported Genetics source row 4b5e_086a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4B5E_086A';
<p>4b5e_086a</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of the structure of DNA?</p>
PROMPT_4B5E_086A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4B5E_086A_CHOICE_1';
the DNA bases for each strand face the outside of the helix
LITERAL_4B5E_086A_CHOICE_1
$choice_2 = <<'LITERAL_4B5E_086A_CHOICE_2';
the phosphate groups are on the outside of the DNA double helix
LITERAL_4B5E_086A_CHOICE_2
$choice_3 = <<'LITERAL_4B5E_086A_CHOICE_3';
DNA contains two strands, with each strand running in opposite directions
LITERAL_4B5E_086A_CHOICE_3
$choice_4 = <<'LITERAL_4B5E_086A_CHOICE_4';
the DNA double helix has a consistent diameter
LITERAL_4B5E_086A_CHOICE_4
$choice_5 = <<'LITERAL_4B5E_086A_CHOICE_5';
the helix is made of nucleotides
LITERAL_4B5E_086A_CHOICE_5
$correct_1 = <<'LITERAL_4B5E_086A_CORRECT_1';
the DNA bases for each strand face the outside of the helix
LITERAL_4B5E_086A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
