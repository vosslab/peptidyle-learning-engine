## DESCRIPTION
## Imported Genetics source row c0d1_b8f2; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_B8F2';
<p>c0d1_b8f2</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_B8F2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_B8F2_CHOICE_1';
the DNA strands are uniformly positively charged
LITERAL_C0D1_B8F2_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_B8F2_CHOICE_2';
the DNA double helix has a consistent diameter
LITERAL_C0D1_B8F2_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_B8F2_CHOICE_3';
the DNA bases for each strand face the outside of the helix
LITERAL_C0D1_B8F2_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_B8F2_CHOICE_4';
the helix is made of amino acids
LITERAL_C0D1_B8F2_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_B8F2_CHOICE_5';
G-C base pairs are weaker than A-T base pairs
LITERAL_C0D1_B8F2_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_B8F2_CORRECT_1';
the DNA double helix has a consistent diameter
LITERAL_C0D1_B8F2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
