DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_A1E3';
<p>9578_a1e3</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_A1E3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_A1E3_CHOICE_1';
pyrimidine bases pair up with like pyrimidine bases
LITERAL_9578_A1E3_CHOICE_1
$choice_2 = <<'LITERAL_9578_A1E3_CHOICE_2';
the backbone contains only nucleobase and sugar
LITERAL_9578_A1E3_CHOICE_2
$choice_3 = <<'LITERAL_9578_A1E3_CHOICE_3';
one strand is positively charged and the other is negatively charged
LITERAL_9578_A1E3_CHOICE_3
$choice_4 = <<'LITERAL_9578_A1E3_CHOICE_4';
DNA contains two strands, with each strand running in opposite directions
LITERAL_9578_A1E3_CHOICE_4
$choice_5 = <<'LITERAL_9578_A1E3_CHOICE_5';
peptide bonds hold the two strands together
LITERAL_9578_A1E3_CHOICE_5
$correct_1 = <<'LITERAL_9578_A1E3_CORRECT_1';
DNA contains two strands, with each strand running in opposite directions
LITERAL_9578_A1E3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
