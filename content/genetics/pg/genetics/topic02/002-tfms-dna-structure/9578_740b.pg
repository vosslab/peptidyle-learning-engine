## DESCRIPTION
## Imported Genetics source row 9578_740b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_740B';
<p>9578_740b</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_740B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_740B_CHOICE_1';
the backbone contains only phosphate and nucleobase
LITERAL_9578_740B_CHOICE_1
$choice_2 = <<'LITERAL_9578_740B_CHOICE_2';
A-T base pairs have three hydrogen bonds, whereas G-C base pairs only have two hydrogen bonds
LITERAL_9578_740B_CHOICE_2
$choice_3 = <<'LITERAL_9578_740B_CHOICE_3';
the phosphate groups are on the outside of the DNA double helix
LITERAL_9578_740B_CHOICE_3
$choice_4 = <<'LITERAL_9578_740B_CHOICE_4';
hydrophobic contacts hold the two strands together
LITERAL_9578_740B_CHOICE_4
$choice_5 = <<'LITERAL_9578_740B_CHOICE_5';
base pairings create unequal spacing between the two DNA strands
LITERAL_9578_740B_CHOICE_5
$correct_1 = <<'LITERAL_9578_740B_CORRECT_1';
the phosphate groups are on the outside of the DNA double helix
LITERAL_9578_740B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
