## DESCRIPTION
## Imported Genetics source row 9578_ccd2; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_CCD2';
<p>9578_ccd2</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_CCD2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_CCD2_CHOICE_1';
DNA contains two strands, with both strands running the same direction
LITERAL_9578_CCD2_CHOICE_1
$choice_2 = <<'LITERAL_9578_CCD2_CHOICE_2';
one strand is positively charged and the other is negatively charged
LITERAL_9578_CCD2_CHOICE_2
$choice_3 = <<'LITERAL_9578_CCD2_CHOICE_3';
the DNA double helix has ten nucleotides between each turn
LITERAL_9578_CCD2_CHOICE_3
$choice_4 = <<'LITERAL_9578_CCD2_CHOICE_4';
base pairings create unequal spacing between the two DNA strands
LITERAL_9578_CCD2_CHOICE_4
$choice_5 = <<'LITERAL_9578_CCD2_CHOICE_5';
the DNA bases for each strand face the outside of the helix
LITERAL_9578_CCD2_CHOICE_5
$correct_1 = <<'LITERAL_9578_CCD2_CORRECT_1';
the DNA double helix has ten nucleotides between each turn
LITERAL_9578_CCD2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
