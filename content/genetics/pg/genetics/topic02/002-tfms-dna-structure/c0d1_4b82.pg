## DESCRIPTION
## Imported Genetics source row c0d1_4b82; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_4B82';
<p>c0d1_4b82</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_4B82
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_4B82_CHOICE_1';
the backbone contains only nucleobase and sugar
LITERAL_C0D1_4B82_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_4B82_CHOICE_2';
DNA contains two strands, with each strand running in opposite directions
LITERAL_C0D1_4B82_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_4B82_CHOICE_3';
peptide bonds hold the two strands together
LITERAL_C0D1_4B82_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_4B82_CHOICE_4';
the DNA bases for each strand face the outside of the helix
LITERAL_C0D1_4B82_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_4B82_CHOICE_5';
pyrimidine bases pair up with like pyrimidine bases
LITERAL_C0D1_4B82_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_4B82_CORRECT_1';
DNA contains two strands, with each strand running in opposite directions
LITERAL_C0D1_4B82_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
