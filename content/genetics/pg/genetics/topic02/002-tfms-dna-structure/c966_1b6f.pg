## DESCRIPTION
## Imported Genetics source row c966_1b6f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C966_1B6F';
<p>c966_1b6f</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C966_1B6F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C966_1B6F_CHOICE_1';
the helix is made of nucleotides
LITERAL_C966_1B6F_CHOICE_1
$choice_2 = <<'LITERAL_C966_1B6F_CHOICE_2';
the backbone contains only phosphate and sugar
LITERAL_C966_1B6F_CHOICE_2
$choice_3 = <<'LITERAL_C966_1B6F_CHOICE_3';
purine bases pair up with pyrimidine bases
LITERAL_C966_1B6F_CHOICE_3
$choice_4 = <<'LITERAL_C966_1B6F_CHOICE_4';
the DNA double helix has ten nucleotides between each turn
LITERAL_C966_1B6F_CHOICE_4
$choice_5 = <<'LITERAL_C966_1B6F_CHOICE_5';
one strand is positively charged and the other is negatively charged
LITERAL_C966_1B6F_CHOICE_5
$correct_1 = <<'LITERAL_C966_1B6F_CORRECT_1';
one strand is positively charged and the other is negatively charged
LITERAL_C966_1B6F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
