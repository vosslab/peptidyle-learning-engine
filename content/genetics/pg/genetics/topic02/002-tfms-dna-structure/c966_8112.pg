## DESCRIPTION
## Imported Genetics source row c966_8112; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C966_8112';
<p>c966_8112</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C966_8112
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C966_8112_CHOICE_1';
the backbone contains only phosphate and sugar
LITERAL_C966_8112_CHOICE_1
$choice_2 = <<'LITERAL_C966_8112_CHOICE_2';
the DNA strands are uniformly negatively charged
LITERAL_C966_8112_CHOICE_2
$choice_3 = <<'LITERAL_C966_8112_CHOICE_3';
phosphodiester bonds hold the two strands together
LITERAL_C966_8112_CHOICE_3
$choice_4 = <<'LITERAL_C966_8112_CHOICE_4';
the DNA bases for each strand face the inside of the helix
LITERAL_C966_8112_CHOICE_4
$choice_5 = <<'LITERAL_C966_8112_CHOICE_5';
purine bases pair up with pyrimidine bases
LITERAL_C966_8112_CHOICE_5
$correct_1 = <<'LITERAL_C966_8112_CORRECT_1';
phosphodiester bonds hold the two strands together
LITERAL_C966_8112_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
