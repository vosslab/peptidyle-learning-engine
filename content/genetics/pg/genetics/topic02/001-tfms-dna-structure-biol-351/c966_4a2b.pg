DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C966_4A2B';
<p>c966_4a2b</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C966_4A2B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C966_4A2B_CHOICE_1';
DNA contains two strands, with each strand running in opposite directions
LITERAL_C966_4A2B_CHOICE_1
$choice_2 = <<'LITERAL_C966_4A2B_CHOICE_2';
the helix is made of nucleotides
LITERAL_C966_4A2B_CHOICE_2
$choice_3 = <<'LITERAL_C966_4A2B_CHOICE_3';
the phosphate groups are on the inside of the DNA double helix
LITERAL_C966_4A2B_CHOICE_3
$choice_4 = <<'LITERAL_C966_4A2B_CHOICE_4';
purine bases pair up with pyrimidine bases
LITERAL_C966_4A2B_CHOICE_4
$choice_5 = <<'LITERAL_C966_4A2B_CHOICE_5';
hydrogen bonds hold the two strands together
LITERAL_C966_4A2B_CHOICE_5
$correct_1 = <<'LITERAL_C966_4A2B_CORRECT_1';
the phosphate groups are on the inside of the DNA double helix
LITERAL_C966_4A2B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
