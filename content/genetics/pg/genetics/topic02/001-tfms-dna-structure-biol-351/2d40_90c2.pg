## DESCRIPTION
## Imported Genetics source row 2d40_90c2; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2D40_90C2';
<p>2d40_90c2</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> of the structure of DNA?</p>
PROMPT_2D40_90C2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2D40_90C2_CHOICE_1';
the backbone contains only phosphate and nucleobase
LITERAL_2D40_90C2_CHOICE_1
$choice_2 = <<'LITERAL_2D40_90C2_CHOICE_2';
DNA exists as a parallel double helix
LITERAL_2D40_90C2_CHOICE_2
$choice_3 = <<'LITERAL_2D40_90C2_CHOICE_3';
A-T base pairs are stronger than G-C base pairs
LITERAL_2D40_90C2_CHOICE_3
$choice_4 = <<'LITERAL_2D40_90C2_CHOICE_4';
hydrogen bonds hold the two strands together
LITERAL_2D40_90C2_CHOICE_4
$choice_5 = <<'LITERAL_2D40_90C2_CHOICE_5';
the phosphate groups are on the inside of the DNA double helix
LITERAL_2D40_90C2_CHOICE_5
$correct_1 = <<'LITERAL_2D40_90C2_CORRECT_1';
hydrogen bonds hold the two strands together
LITERAL_2D40_90C2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
