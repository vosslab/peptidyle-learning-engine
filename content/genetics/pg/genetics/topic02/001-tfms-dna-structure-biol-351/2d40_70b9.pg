## DESCRIPTION
## Imported Genetics source row 2d40_70b9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2D40_70B9';
<p>2d40_70b9</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> of the structure of DNA?</p>
PROMPT_2D40_70B9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2D40_70B9_CHOICE_1';
the DNA bases for each strand face the outside of the helix
LITERAL_2D40_70B9_CHOICE_1
$choice_2 = <<'LITERAL_2D40_70B9_CHOICE_2';
G-C base pairs are stronger than A-T base pairs
LITERAL_2D40_70B9_CHOICE_2
$choice_3 = <<'LITERAL_2D40_70B9_CHOICE_3';
the phosphate groups are on the inside of the DNA double helix
LITERAL_2D40_70B9_CHOICE_3
$choice_4 = <<'LITERAL_2D40_70B9_CHOICE_4';
the helix is made of amino acids
LITERAL_2D40_70B9_CHOICE_4
$choice_5 = <<'LITERAL_2D40_70B9_CHOICE_5';
purine bases pair up with like purine bases
LITERAL_2D40_70B9_CHOICE_5
$correct_1 = <<'LITERAL_2D40_70B9_CORRECT_1';
G-C base pairs are stronger than A-T base pairs
LITERAL_2D40_70B9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
