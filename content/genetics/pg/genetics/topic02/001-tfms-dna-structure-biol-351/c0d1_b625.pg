## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_B625';
<p>c0d1_b625</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_B625
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_B625_CHOICE_1';
DNA contains two strands, with both strands running the same direction
LITERAL_C0D1_B625_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_B625_CHOICE_2';
the helix is made of amino acids
LITERAL_C0D1_B625_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_B625_CHOICE_3';
the DNA bases for each strand face the outside of the helix
LITERAL_C0D1_B625_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_B625_CHOICE_4';
G-C base pairs have three hydrogen bonds, whereas A-T base pairs only have two hydrogen bonds
LITERAL_C0D1_B625_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_B625_CHOICE_5';
the backbone contains only nucleobase and sugar
LITERAL_C0D1_B625_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_B625_CORRECT_1';
G-C base pairs have three hydrogen bonds, whereas A-T base pairs only have two hydrogen bonds
LITERAL_C0D1_B625_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
