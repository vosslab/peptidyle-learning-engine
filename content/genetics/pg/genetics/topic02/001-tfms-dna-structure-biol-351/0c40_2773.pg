DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0C40_2773';
<p>0c40_2773</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> concerning the structure of DNA?</p>
PROMPT_0C40_2773
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0C40_2773_CHOICE_1';
DNA contains two strands, with each strand running in opposite directions
LITERAL_0C40_2773_CHOICE_1
$choice_2 = <<'LITERAL_0C40_2773_CHOICE_2';
the backbone contains only phosphate and sugar
LITERAL_0C40_2773_CHOICE_2
$choice_3 = <<'LITERAL_0C40_2773_CHOICE_3';
the DNA bases for each strand face the inside of the helix
LITERAL_0C40_2773_CHOICE_3
$choice_4 = <<'LITERAL_0C40_2773_CHOICE_4';
G-C base pairs are stronger than A-T base pairs
LITERAL_0C40_2773_CHOICE_4
$choice_5 = <<'LITERAL_0C40_2773_CHOICE_5';
purine bases pair up with like purine bases
LITERAL_0C40_2773_CHOICE_5
$correct_1 = <<'LITERAL_0C40_2773_CORRECT_1';
purine bases pair up with like purine bases
LITERAL_0C40_2773_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
