## DESCRIPTION
## Imported Genetics source row 2d40_d0ce; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2D40_D0CE';
<p>2d40_d0ce</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> of the structure of DNA?</p>
PROMPT_2D40_D0CE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2D40_D0CE_CHOICE_1';
DNA exists as a parallel double helix
LITERAL_2D40_D0CE_CHOICE_1
$choice_2 = <<'LITERAL_2D40_D0CE_CHOICE_2';
A-T base pairs are weaker than G-C base pairs
LITERAL_2D40_D0CE_CHOICE_2
$choice_3 = <<'LITERAL_2D40_D0CE_CHOICE_3';
covalent bonds hold the two strands together
LITERAL_2D40_D0CE_CHOICE_3
$choice_4 = <<'LITERAL_2D40_D0CE_CHOICE_4';
the phosphate groups are on the inside of the DNA double helix
LITERAL_2D40_D0CE_CHOICE_4
$choice_5 = <<'LITERAL_2D40_D0CE_CHOICE_5';
the backbone contains only nucleobase and sugar
LITERAL_2D40_D0CE_CHOICE_5
$correct_1 = <<'LITERAL_2D40_D0CE_CORRECT_1';
A-T base pairs are weaker than G-C base pairs
LITERAL_2D40_D0CE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
