## DESCRIPTION
## Imported Genetics source row 0c40_ec61; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0C40_EC61';
<p>0c40_ec61</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> concerning the structure of DNA?</p>
PROMPT_0C40_EC61
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0C40_EC61_CHOICE_1';
the two strands of DNA are parallel
LITERAL_0C40_EC61_CHOICE_1
$choice_2 = <<'LITERAL_0C40_EC61_CHOICE_2';
the backbone contains only phosphate and sugar
LITERAL_0C40_EC61_CHOICE_2
$choice_3 = <<'LITERAL_0C40_EC61_CHOICE_3';
the helix is made of nucleotides
LITERAL_0C40_EC61_CHOICE_3
$choice_4 = <<'LITERAL_0C40_EC61_CHOICE_4';
the phosphate groups are on the outside of the DNA double helix
LITERAL_0C40_EC61_CHOICE_4
$choice_5 = <<'LITERAL_0C40_EC61_CHOICE_5';
hydrogen bonds hold the two strands together
LITERAL_0C40_EC61_CHOICE_5
$correct_1 = <<'LITERAL_0C40_EC61_CORRECT_1';
the two strands of DNA are parallel
LITERAL_0C40_EC61_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
