DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_0178';
<p>9578_0178</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_0178
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_0178_CHOICE_1';
purine bases pair up with like purine bases
LITERAL_9578_0178_CHOICE_1
$choice_2 = <<'LITERAL_9578_0178_CHOICE_2';
A-T base pairs are stronger than G-C base pairs
LITERAL_9578_0178_CHOICE_2
$choice_3 = <<'LITERAL_9578_0178_CHOICE_3';
the two strands of DNA are anti-parallel
LITERAL_9578_0178_CHOICE_3
$choice_4 = <<'LITERAL_9578_0178_CHOICE_4';
the helix is made of amino acids
LITERAL_9578_0178_CHOICE_4
$choice_5 = <<'LITERAL_9578_0178_CHOICE_5';
the DNA bases for each strand face the outside of the helix
LITERAL_9578_0178_CHOICE_5
$correct_1 = <<'LITERAL_9578_0178_CORRECT_1';
the two strands of DNA are anti-parallel
LITERAL_9578_0178_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
