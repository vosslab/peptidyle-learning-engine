DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9578_46D1';
<p>9578_46d1</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding the structure of DNA?</p>
PROMPT_9578_46D1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9578_46D1_CHOICE_1';
the phosphate groups are on the inside of the DNA double helix
LITERAL_9578_46D1_CHOICE_1
$choice_2 = <<'LITERAL_9578_46D1_CHOICE_2';
G-C base pairs are stronger than A-T base pairs
LITERAL_9578_46D1_CHOICE_2
$choice_3 = <<'LITERAL_9578_46D1_CHOICE_3';
covalent bonds hold the two strands together
LITERAL_9578_46D1_CHOICE_3
$choice_4 = <<'LITERAL_9578_46D1_CHOICE_4';
purine bases pair up with like purine bases
LITERAL_9578_46D1_CHOICE_4
$choice_5 = <<'LITERAL_9578_46D1_CHOICE_5';
DNA contains two strands, with both strands running the same direction
LITERAL_9578_46D1_CHOICE_5
$correct_1 = <<'LITERAL_9578_46D1_CORRECT_1';
G-C base pairs are stronger than A-T base pairs
LITERAL_9578_46D1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
