## DESCRIPTION
## Imported Genetics source row c0d1_b44d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-dna_structure-biol_351-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C0D1_B44D';
<p>c0d1_b44d</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about the structure of DNA?</p>
PROMPT_C0D1_B44D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C0D1_B44D_CHOICE_1';
the helix is made of amino acids
LITERAL_C0D1_B44D_CHOICE_1
$choice_2 = <<'LITERAL_C0D1_B44D_CHOICE_2';
hydrogen bonds hold the two strands together
LITERAL_C0D1_B44D_CHOICE_2
$choice_3 = <<'LITERAL_C0D1_B44D_CHOICE_3';
the phosphate groups are on the inside of the DNA double helix
LITERAL_C0D1_B44D_CHOICE_3
$choice_4 = <<'LITERAL_C0D1_B44D_CHOICE_4';
the two strands of DNA are parallel
LITERAL_C0D1_B44D_CHOICE_4
$choice_5 = <<'LITERAL_C0D1_B44D_CHOICE_5';
the backbone contains only nucleobase and sugar
LITERAL_C0D1_B44D_CHOICE_5
$correct_1 = <<'LITERAL_C0D1_B44D_CORRECT_1';
hydrogen bonds hold the two strands together
LITERAL_C0D1_B44D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
