## DESCRIPTION
## Imported Genetics source row 7bcc_c803; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-melting_Tm_type_1-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7BCC_C803';
<p>7bcc_c803</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about melting temperature (T<sub>m</sub>) of DNA?</p>
PROMPT_7BCC_C803
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7BCC_C803_CHOICE_1';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>)</span></strong> <br/>when the <strong><span style="color: #007a00;"><strong><span style="color: #007a00;">adenine (A)</span></strong> (A)</span></strong> + <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">thymine (T)</span></strong> (T)</span></strong> base pairing content <strong><span style="color: #a719db;"><strong><span style="color: #a719db;">decreases</span></strong></span></strong>.
LITERAL_7BCC_C803_CHOICE_1
$choice_2 = <<'LITERAL_7BCC_C803_CHOICE_2';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;">increases</span></strong>)</span></strong> <br/>when the amount of pyrimidine nucleobases, <strong><span style="color: #003fff;">cytosine (C)</span></strong> + <strong><span style="color: #d40000;">thymine (T)</span></strong>, <strong><span style="color: #a719db;">decreases</span></strong>.
LITERAL_7BCC_C803_CHOICE_2
$choice_3 = <<'LITERAL_7BCC_C803_CHOICE_3';
The melting temperature (T<sub>m</sub>) of a DNA strand goes down <strong><span style="color: #a719db;">(<strong><span style="color: #a719db;">decreases</span></strong>)</span></strong> <br/>when the amount of nucleobases with amino groups, <strong><span style="color: #007a00;">adenine (A)</span></strong> + <strong><span style="color: #003fff;">cytosine (C)</span></strong>, <strong><span style="color: #b74300;">increases</span></strong>.
LITERAL_7BCC_C803_CHOICE_3
$choice_4 = <<'LITERAL_7BCC_C803_CHOICE_4';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;">increases</span></strong>)</span></strong> <br/>when the amount of purine nucleobases, <strong><span style="color: #007a00;">adenine (A)</span></strong> + <strong><span style="color: #000000;">guanine (G)</span></strong>, <strong><span style="color: #a719db;">decreases</span></strong>.
LITERAL_7BCC_C803_CHOICE_4
$choice_5 = <<'LITERAL_7BCC_C803_CHOICE_5';
The melting temperature (T<sub>m</sub>) of a DNA strand goes down <strong><span style="color: #a719db;">(<strong><span style="color: #a719db;">decreases</span></strong>)</span></strong> <br/>when the <strong><span style="color: #003fff;">cytosine (C)</span></strong> + <strong><span style="color: #000000;">guanine (G)</span></strong> base pairing content <strong><span style="color: #b74300;">increases</span></strong>.
LITERAL_7BCC_C803_CHOICE_5
$correct_1 = <<'LITERAL_7BCC_C803_CORRECT_1';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>)</span></strong> <br/>when the <strong><span style="color: #007a00;"><strong><span style="color: #007a00;">adenine (A)</span></strong> (A)</span></strong> + <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">thymine (T)</span></strong> (T)</span></strong> base pairing content <strong><span style="color: #a719db;"><strong><span style="color: #a719db;">decreases</span></strong></span></strong>.
LITERAL_7BCC_C803_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
