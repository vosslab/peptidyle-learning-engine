## DESCRIPTION
## Imported Genetics source row d988_7d87; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-melting_Tm_type_1-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D988_7D87';
<p>d988_7d87</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of melting temperature (T<sub>m</sub>) of DNA?</p>
PROMPT_D988_7D87
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D988_7D87_CHOICE_1';
The melting temperature (T<sub>m</sub>) of a DNA strand goes down <strong><span style="color: #a719db;">(<strong><span style="color: #a719db;">decreases</span></strong>)</span></strong> <br/>when the <strong><span style="color: #003fff;">cytosine (C)</span></strong> + <strong><span style="color: #000000;">guanine (G)</span></strong> base pairing content <strong><span style="color: #a719db;">decreases</span></strong>.
LITERAL_D988_7D87_CHOICE_1
$choice_2 = <<'LITERAL_D988_7D87_CHOICE_2';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>)</span></strong> <br/>when the amount of nucleobases with ketone groups, <strong><span style="color: #000000;"><strong><span style="color: #000000;">guanine (G)</span></strong> (G)</span></strong> + <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">thymine (T)</span></strong> (T)</span></strong>, <strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>.
LITERAL_D988_7D87_CHOICE_2
$choice_3 = <<'LITERAL_D988_7D87_CHOICE_3';
The melting temperature (T<sub>m</sub>) of a DNA strand is the temperature <br/>at which half of strands are single-stranded and the other half are double-stranded.
LITERAL_D988_7D87_CHOICE_3
$choice_4 = <<'LITERAL_D988_7D87_CHOICE_4';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;">increases</span></strong>)</span></strong> <br/>when the <strong><span style="color: #007a00;">adenine (A)</span></strong> + <strong><span style="color: #d40000;">thymine (T)</span></strong> base pairing content <strong><span style="color: #a719db;">decreases</span></strong>.
LITERAL_D988_7D87_CHOICE_4
$correct_1 = <<'LITERAL_D988_7D87_CORRECT_1';
The melting temperature (T<sub>m</sub>) of a DNA strand goes up <strong><span style="color: #b74300;">(<strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>)</span></strong> <br/>when the amount of nucleobases with ketone groups, <strong><span style="color: #000000;"><strong><span style="color: #000000;">guanine (G)</span></strong> (G)</span></strong> + <strong><span style="color: #d40000;"><strong><span style="color: #d40000;">thymine (T)</span></strong> (T)</span></strong>, <strong><span style="color: #b74300;"><strong><span style="color: #b74300;">increases</span></strong></span></strong>.
LITERAL_D988_7D87_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
