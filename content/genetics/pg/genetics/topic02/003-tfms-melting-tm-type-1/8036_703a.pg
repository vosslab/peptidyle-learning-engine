## DESCRIPTION
## Imported Genetics source row 8036_703a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-melting_Tm_type_1-questions.txt')
