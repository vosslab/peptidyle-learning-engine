DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5E95_7A96';
<p>5e95_7a96</p> <p>According to Chargaff's rules concerning the base pairing composition in double-stranded DNA, consider a sample where the percentage composition of <strong><span style='color: #2a2000;'>12% is guanine</span></strong>.</p><p>What are the percentages of the other three bases?</p>
PROMPT_5E95_7A96
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5E95_7A96_CHOICE_1';
<span style='color: #004d00;'>adenine (A): 38%</span> &mdash; <span style='color: #003566;'>cytosine (C): 38%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 12%</span>
LITERAL_5E95_7A96_CHOICE_1
$choice_2 = <<'LITERAL_5E95_7A96_CHOICE_2';
<span style='color: #004d00;'>adenine (A): 25%</span> &mdash; <span style='color: #003566;'>cytosine (C): 38%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 25%</span>
LITERAL_5E95_7A96_CHOICE_2
$choice_3 = <<'LITERAL_5E95_7A96_CHOICE_3';
<span style='color: #004d00;'>adenine (A): 38%</span> &mdash; <span style='color: #003566;'>cytosine (C): 12%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 38%</span>
LITERAL_5E95_7A96_CHOICE_3
$choice_4 = <<'LITERAL_5E95_7A96_CHOICE_4';
<span style='color: #004d00;'>adenine (A): 38%</span> &mdash; <span style='color: #003566;'>cytosine (C): 25%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 25%</span>
LITERAL_5E95_7A96_CHOICE_4
$choice_5 = <<'LITERAL_5E95_7A96_CHOICE_5';
<span style='color: #004d00;'>adenine (A): 12%</span> &mdash; <span style='color: #003566;'>cytosine (C): 38%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 38%</span>
LITERAL_5E95_7A96_CHOICE_5
$correct_1 = <<'LITERAL_5E95_7A96_CORRECT_1';
<span style='color: #004d00;'>adenine (A): 38%</span> &mdash; <span style='color: #003566;'>cytosine (C): 12%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 38%</span>
LITERAL_5E95_7A96_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
