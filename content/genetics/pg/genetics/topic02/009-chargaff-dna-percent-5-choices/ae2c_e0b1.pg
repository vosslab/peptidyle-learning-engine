DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AE2C_E0B1';
<p>ae2c_e0b1</p> <p>According to Chargaff's rules concerning the base pairing composition in double-stranded DNA, consider a sample where the percentage composition of <strong><span style='color: #003566;'>28% is cytosine</span></strong>.</p><p>What are the percentages of the other three bases?</p>
PROMPT_AE2C_E0B1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AE2C_E0B1_CHOICE_1';
<span style='color: #004d00;'>adenine (A): 25%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 22%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 25%</span>
LITERAL_AE2C_E0B1_CHOICE_1
$choice_2 = <<'LITERAL_AE2C_E0B1_CHOICE_2';
<span style='color: #004d00;'>adenine (A): 22%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 28%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 22%</span>
LITERAL_AE2C_E0B1_CHOICE_2
$choice_3 = <<'LITERAL_AE2C_E0B1_CHOICE_3';
<span style='color: #004d00;'>adenine (A): 22%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 22%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 28%</span>
LITERAL_AE2C_E0B1_CHOICE_3
$choice_4 = <<'LITERAL_AE2C_E0B1_CHOICE_4';
<span style='color: #004d00;'>adenine (A): 28%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 22%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 22%</span>
LITERAL_AE2C_E0B1_CHOICE_4
$choice_5 = <<'LITERAL_AE2C_E0B1_CHOICE_5';
<span style='color: #004d00;'>adenine (A): 25%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 25%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 22%</span>
LITERAL_AE2C_E0B1_CHOICE_5
$correct_1 = <<'LITERAL_AE2C_E0B1_CORRECT_1';
<span style='color: #004d00;'>adenine (A): 22%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 28%</span> &mdash; <span style='color: #6e1212;'>thymine (T): 22%</span>
LITERAL_AE2C_E0B1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
