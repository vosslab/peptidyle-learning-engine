DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1999_9BF2';
<p>1999_9bf2</p> <p>According to Chargaff's rules concerning the base pairing composition in double-stranded DNA, consider a sample where the percentage composition of <strong><span style='color: #6e1212;'>30% is thymine</span></strong>.</p><p>What are the percentages of the other three bases?</p>
PROMPT_1999_9BF2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1999_9BF2_CHOICE_1';
<span style='color: #004d00;'>adenine (A): 20%</span> &mdash; <span style='color: #003566;'>cytosine (C): 30%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 20%</span>
LITERAL_1999_9BF2_CHOICE_1
$choice_2 = <<'LITERAL_1999_9BF2_CHOICE_2';
<span style='color: #004d00;'>adenine (A): 25%</span> &mdash; <span style='color: #003566;'>cytosine (C): 25%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 20%</span>
LITERAL_1999_9BF2_CHOICE_2
$choice_3 = <<'LITERAL_1999_9BF2_CHOICE_3';
<span style='color: #004d00;'>adenine (A): 20%</span> &mdash; <span style='color: #003566;'>cytosine (C): 20%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 30%</span>
LITERAL_1999_9BF2_CHOICE_3
$choice_4 = <<'LITERAL_1999_9BF2_CHOICE_4';
<span style='color: #004d00;'>adenine (A): 20%</span> &mdash; <span style='color: #003566;'>cytosine (C): 25%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 25%</span>
LITERAL_1999_9BF2_CHOICE_4
$choice_5 = <<'LITERAL_1999_9BF2_CHOICE_5';
<span style='color: #004d00;'>adenine (A): 30%</span> &mdash; <span style='color: #003566;'>cytosine (C): 20%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 20%</span>
LITERAL_1999_9BF2_CHOICE_5
$correct_1 = <<'LITERAL_1999_9BF2_CORRECT_1';
<span style='color: #004d00;'>adenine (A): 30%</span> &mdash; <span style='color: #003566;'>cytosine (C): 20%</span> &mdash; <span style='color: #2a2000;'>guanine (G): 20%</span>
LITERAL_1999_9BF2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
