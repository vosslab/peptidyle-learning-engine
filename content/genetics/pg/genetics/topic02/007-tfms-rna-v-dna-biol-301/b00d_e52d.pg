## DESCRIPTION
## Imported Genetics source row b00d_e52d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-rna_v_dna-biol_301-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B00D_E52D';
<p>b00d_e52d</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> about differences between <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong>?</p>
PROMPT_B00D_E52D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B00D_E52D_CHOICE_1';
uracil in <strong><span style="color: OrangeRed;">RNA</span></strong> takes the place of thymine in <strong><span style="color: MediumBlue;">DNA</span></strong>
LITERAL_B00D_E52D_CHOICE_1
$choice_2 = <<'LITERAL_B00D_E52D_CHOICE_2';
<strong><span style="color: OrangeRed;">RNA</span></strong> can sometimes form a double-stranded helix
LITERAL_B00D_E52D_CHOICE_2
$choice_3 = <<'LITERAL_B00D_E52D_CHOICE_3';
the <strong><span style="color: MediumBlue;">DNA</span></strong> sugar is dexoyribose, <strong><span style="color: OrangeRed;">RNA</span></strong> has a different sugar
LITERAL_B00D_E52D_CHOICE_3
$choice_4 = <<'LITERAL_B00D_E52D_CHOICE_4';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> nucleotides are missing the 2&prime; hydroxide (-OH) group compared to <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong>
LITERAL_B00D_E52D_CHOICE_4
$choice_5 = <<'LITERAL_B00D_E52D_CHOICE_5';
<strong><span style="color: MediumBlue;">DNA</span></strong> has a regular consistent structure and does<strong> <strong>NOT</strong> </strong>adopt a wide variety of tertiary structures
LITERAL_B00D_E52D_CHOICE_5
$correct_1 = <<'LITERAL_B00D_E52D_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> nucleotides are missing the 2&prime; hydroxide (-OH) group compared to <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong>
LITERAL_B00D_E52D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
