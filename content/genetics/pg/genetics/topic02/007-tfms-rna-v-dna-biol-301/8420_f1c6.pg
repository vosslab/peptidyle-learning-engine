## DESCRIPTION
## Imported Genetics source row 8420_f1c6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-rna_v_dna-biol_301-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8420_F1C6';
<p>8420_f1c6</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> concerning differences between <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong>?</p>
PROMPT_8420_F1C6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8420_F1C6_CHOICE_1';
<strong><span style="color: OrangeRed;">RNA</span></strong> adopts a wide variety of tertiary structures
LITERAL_8420_F1C6_CHOICE_1
$choice_2 = <<'LITERAL_8420_F1C6_CHOICE_2';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong> nucleotides have a 2&prime; hydroxide (-OH) group, <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> does not
LITERAL_8420_F1C6_CHOICE_2
$choice_3 = <<'LITERAL_8420_F1C6_CHOICE_3';
<strong><span style="color: OrangeRed;">RNA</span></strong> can sometimes form a double-stranded helix
LITERAL_8420_F1C6_CHOICE_3
$choice_4 = <<'LITERAL_8420_F1C6_CHOICE_4';
<strong><span style="color: MediumBlue;">DNA</span></strong> is usually double-stranded (duplex), whereas <strong><span style="color: OrangeRed;">RNA</span></strong> is usually single-stranded (simplex)
LITERAL_8420_F1C6_CHOICE_4
$choice_5 = <<'LITERAL_8420_F1C6_CHOICE_5';
uracil in <strong><span style="color: OrangeRed;">RNA</span></strong> takes the place of thymine in <strong><span style="color: MediumBlue;">DNA</span></strong>
LITERAL_8420_F1C6_CHOICE_5
$correct_1 = <<'LITERAL_8420_F1C6_CORRECT_1';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong> nucleotides have a 2&prime; hydroxide (-OH) group, <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> does not
LITERAL_8420_F1C6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
