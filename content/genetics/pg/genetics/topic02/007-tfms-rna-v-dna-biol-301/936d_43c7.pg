## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-rna_v_dna-biol_301-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_936D_43C7';
<p>936d_43c7</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> concerning differences between <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong>?</p>
PROMPT_936D_43C7
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_936D_43C7_CHOICE_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> can sometimes form a double-stranded helix
LITERAL_936D_43C7_CHOICE_1
$choice_2 = <<'LITERAL_936D_43C7_CHOICE_2';
the <strong><span style="color: OrangeRed;">RNA</span></strong> sugar is deoxyribose, <strong><span style="color: MediumBlue;">DNA</span></strong> has a different sugar
LITERAL_936D_43C7_CHOICE_2
$choice_3 = <<'LITERAL_936D_43C7_CHOICE_3';
<strong><span style="color: OrangeRed;">RNA</span></strong> has a sugar-phosphate backbone, <strong><span style="color: MediumBlue;">DNA</span></strong> does not
LITERAL_936D_43C7_CHOICE_3
$choice_4 = <<'LITERAL_936D_43C7_CHOICE_4';
<strong><span style="color: MediumBlue;">DNA</span></strong> nucleotides have a 2&prime; hydroxide (-OH) group, <strong><span style="color: OrangeRed;">RNA</span></strong> does not
LITERAL_936D_43C7_CHOICE_4
$choice_5 = <<'LITERAL_936D_43C7_CHOICE_5';
uracil in <strong><span style="color: OrangeRed;">RNA</span></strong> takes the place of guanine in <strong><span style="color: MediumBlue;">DNA</span></strong>
LITERAL_936D_43C7_CHOICE_5
$correct_1 = <<'LITERAL_936D_43C7_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> can sometimes form a double-stranded helix
LITERAL_936D_43C7_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
