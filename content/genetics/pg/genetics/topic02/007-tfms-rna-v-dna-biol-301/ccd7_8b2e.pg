## DESCRIPTION
## Imported Genetics source row ccd7_8b2e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic02/bbq-TFMS-rna_v_dna-biol_301-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CCD7_8B2E';
<p>ccd7_8b2e</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> about differences between <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong>?</p>
PROMPT_CCD7_8B2E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CCD7_8B2E_CHOICE_1';
<strong><span style="color: MediumBlue;">DNA</span></strong> can form a double-stranded helix, but <strong><span style="color: OrangeRed;">RNA</span></strong> is unable to form it
LITERAL_CCD7_8B2E_CHOICE_1
$choice_2 = <<'LITERAL_CCD7_8B2E_CHOICE_2';
<strong><span style="color: OrangeRed;">RNA</span></strong> has a regular consistent structure and does<strong> <strong>NOT</strong> </strong>adopt a wide variety of tertiary structures
LITERAL_CCD7_8B2E_CHOICE_2
$choice_3 = <<'LITERAL_CCD7_8B2E_CHOICE_3';
the <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> sugar is ribose, <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong> has a different sugar
LITERAL_CCD7_8B2E_CHOICE_3
$choice_4 = <<'LITERAL_CCD7_8B2E_CHOICE_4';
<strong><span style="color: OrangeRed;">RNA</span></strong> is usually double-stranded (duplex), whereas <strong><span style="color: MediumBlue;">DNA</span></strong> is usually single-stranded (simplex)
LITERAL_CCD7_8B2E_CHOICE_4
$choice_5 = <<'LITERAL_CCD7_8B2E_CHOICE_5';
<strong><span style="color: MediumBlue;">DNA</span></strong> has a sugar-phosphate backbone, <strong><span style="color: OrangeRed;">RNA</span></strong> does not
LITERAL_CCD7_8B2E_CHOICE_5
$correct_1 = <<'LITERAL_CCD7_8B2E_CORRECT_1';
the <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">RNA</span></strong></span></strong> sugar is ribose, <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">DNA</span></strong></span></strong> has a different sugar
LITERAL_CCD7_8B2E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
