## DESCRIPTION
## Select the parental genotypes in a monohybrid cross that corresponds to the given description of the progeny.
## ENDDESCRIPTION
## KEYWORDS('parental genotypes in monohybrid crosses','descriptions of the progeny','which one','multiple choice')
## DBsubject('Genetics')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
    'PGstandard.pl',
    'PGML.pl',
    'PGchoicemacros.pl',
    'parserRadioButtons.pl',
    'PGcourse.pl',
