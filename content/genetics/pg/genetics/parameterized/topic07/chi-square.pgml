## TITLE('Chi-square (&chi;&sup2;) Tests')
## DESCRIPTION
## Select the statement that is TRUE or FALSE about chi-square (&chi;&sup2;) tests.
## ENDDESCRIPTION
## KEYWORDS('chi-square (&chi;&sup2;) tests','true/false','multiple choice')
## DBsubject('Biostatistics')
## DBchapter('')
## DBsection('')
## Date('2026-08-19')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "PGchoicemacros.pl",
  "parserRadioButtons.pl",
  "PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

#==========================================================
# AUTO-GENERATED GROUPS FROM YAML
#==========================================================

@true_groups = (
  [
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the chi-square (&chi;&sup2;) statistic is less than the critical value',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the chi-square (&chi;&sup2;) statistic is larger than the critical value',
  ],
  [
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the p-value is larger than the level of significance, &alpha;',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the p-value is less than the level of significance, &alpha;',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the chi-square (&chi;&sup2;) statistic is larger than the critical value',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the chi-square (&chi;&sup2;) statistic is less than the critical value',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the p-value is less than the level of significance, &alpha;',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the p-value is larger than the level of significance, &alpha;',
  ],
);
@false_groups = (
  [
    'the null hypothesis, H<sub>0</sub> is REJECTED if the chi-square (&chi;&sup2;) statistic is less than the critical value',
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the chi-square (&chi;&sup2;) statistic is larger than the critical value',
  ],
  [
    'the null hypothesis, H<sub>0</sub> is REJECTED if the p-value is larger than the level of significance, &alpha;',
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the p-value is less than the level of significance, &alpha;',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the chi-square (&chi;&sup2;) statistic is less than the critical value',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the p-value is larger than the level of significance, &alpha;',
  ],
  [
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the chi-square (&chi;&sup2;) statistic is less than the level of significance, &alpha;',
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the chi-square (&chi;&sup2;) statistic is larger than the level of significance, &alpha;',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the chi-square (&chi;&sup2;) statistic is larger than the level of significance, &alpha;',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the chi-square (&chi;&sup2;) statistic is less than the level of significance, &alpha;',
  ],
  [
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the p-value is larger than the critical value',
    'the null hypothesis, H<sub>0</sub> is NOT REJECTED if the p-value is less than the critical value',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the p-value is larger than the critical value',
    'the null hypothesis, H<sub>0</sub> is REJECTED if the p-value is less than the critical value',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the chi-square (&chi;&sup2;) statistic is less than the level of significance, &alpha;',
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the chi-square (&chi;&sup2;) statistic is larger than the level of significance, &alpha;',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the chi-square (&chi;&sup2;) statistic is less than the level of significance, &alpha;',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the chi-square (&chi;&sup2;) statistic is larger than the level of significance, &alpha;',
  ],
  [
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the p-value is less than the critical value',
    'the alternative hypothesis, H<sub>a</sub> is SUPPORTED if the p-value is larger than the critical value',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the p-value is less than the critical value',
    'the alternative hypothesis, H<sub>a</sub> is NOT SUPPORTED if the p-value is larger than the critical value',
  ],
);

#==========================================================
# GLOBAL SETTINGS
#==========================================================

$topic = 'chi-square (&chi;&sup2;) tests';
my $local_random = PGrandom->new();
$local_random->srand($problemSeed);
my @mode_choices = ("TRUE", "FALSE");
$mode = $mode_choices[$local_random->random(0, $#mode_choices, 1)];
$num_distractors = 4;
#==========================================================
# SELECT GROUP
#==========================================================

my (@selected_group, @opposite_groups);

if ($mode eq "TRUE") {
  $group_index      = $local_random->random(0, scalar(@true_groups)-1, 1);
  @selected_group   = @{ $true_groups[$group_index] };
  @opposite_groups  = @false_groups;
} else {
  $group_index      = $local_random->random(0, scalar(@false_groups)-1, 1);
  @selected_group   = @{ $false_groups[$group_index] };
  @opposite_groups  = @true_groups;
}

#==========================================================
# PICK CORRECT + DISTRACTORS
#==========================================================

my $correct_index = $local_random->random(0, $#selected_group, 1);
$correct = $selected_group[$correct_index];

my @available_group_indices = (0 .. $#opposite_groups);
my @selected_distractor_indices = ();

while (@selected_distractor_indices < $num_distractors && @available_group_indices > 0) {
  my $random_index = $local_random->random(0, scalar(@available_group_indices)-1, 1);
  push @selected_distractor_indices, splice(@available_group_indices, $random_index, 1);
}

@distractors = ();
foreach my $group_idx (@selected_distractor_indices) {
  my @group = @{ $opposite_groups[$group_idx] };
  my $distractor_index = $local_random->random(0, $#group, 1);
  my $distractor = $group[$distractor_index];
  push @distractors, $distractor;
}

@choices = ($correct, @distractors);

#==========================================================
# SHUFFLE CHOICES (SEED-STABLE)
#==========================================================

my @choice_indices = (0 .. $#choices);
my @choice_shuffled = ();
while (@choice_indices) {
  my $pick = $local_random->random(0, $#choice_indices, 1);
  push @choice_shuffled, splice(@choice_indices, $pick, 1);
}
@choices = @choices[@choice_shuffled];

#==========================================================
# RADIO BUTTONS WITH A/B/C/D/E LABELS
#==========================================================

$rb = RadioButtons(
  [@choices],
  $correct,
  labels        => ['A','B','C','D','E'],
  displayLabels => 1,
  randomize     => 0,
  separator     => '<div style="margin-bottom: 0.7em;"></div>',
);

#==========================================================
# PGML
#==========================================================

BEGIN_PGML

[@ $mode eq "TRUE" ? "Which one of the following statements is <span style='color: #127663;'><strong>TRUE</strong></span> about $topic?" : "Which one of the following statements is <span style='color: #ba372a;'><strong>FALSE</strong></span> about $topic?" @]*

[_]{$rb}

END_PGML

ENDDOCUMENT();
