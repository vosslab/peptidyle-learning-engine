## DESCRIPTION
## Imported Genetics source row 1977_8384; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-WOMC-population_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1977_8384';
<p>1977_8384</p> <p>Which one of the following population <strong><span style="color: #b74300;">genetic</span></strong> terms correspond to the definition <span style='font-size: 1em;'><strong>'stronger in small populations and decrease the overall fitness of that population'</strong></span>.</p>
PROMPT_1977_8384
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1977_8384_CHOICE_1';
assortative mating
LITERAL_1977_8384_CHOICE_1
$choice_2 = <<'LITERAL_1977_8384_CHOICE_2';
consanguineous mating
LITERAL_1977_8384_CHOICE_2
$choice_3 = <<'LITERAL_1977_8384_CHOICE_3';
<strong><span style="color: #b74300;">genetic</span></strong> drift
LITERAL_1977_8384_CHOICE_3
$choice_4 = <<'LITERAL_1977_8384_CHOICE_4';
mutation
LITERAL_1977_8384_CHOICE_4
$choice_5 = <<'LITERAL_1977_8384_CHOICE_5';
random mating
LITERAL_1977_8384_CHOICE_5
$correct_1 = <<'LITERAL_1977_8384_CORRECT_1';
<strong><span style="color: #b74300;">genetic</span></strong> drift
LITERAL_1977_8384_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
