## DESCRIPTION
## Imported Genetics source row 07b9_431b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-MATCH-population_genetics_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_07B9_431B';
<p>07b9_431b</p> <p>Match each of the following population <strong><span style="color: #b74300;">genetic</span></strong> terms with their corresponding definitions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_07B9_431B
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_07B9_431B_MATCH_TERM_0';
mutation
LITERAL_07B9_431B_MATCH_TERM_0
$match_term_1 = <<'LITERAL_07B9_431B_MATCH_TERM_1';
random mating
LITERAL_07B9_431B_MATCH_TERM_1
$match_term_2 = <<'LITERAL_07B9_431B_MATCH_TERM_2';
assortative mating
LITERAL_07B9_431B_MATCH_TERM_2
$match_term_3 = <<'LITERAL_07B9_431B_MATCH_TERM_3';
consanguineous mating
LITERAL_07B9_431B_MATCH_TERM_3
$match_term_4 = <<'LITERAL_07B9_431B_MATCH_TERM_4';
<strong><span style="color: #b74300;">genetic</span></strong> drift
LITERAL_07B9_431B_MATCH_TERM_4
$match_choice_0 = <<'LITERAL_07B9_431B_MATCH_CHOICE_0';
unpredictable changes in the nucleotides that form a DNA sequence
LITERAL_07B9_431B_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_07B9_431B_MATCH_CHOICE_1';
mating in which partner choice is independent of genotype and phenotype
LITERAL_07B9_431B_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_07B9_431B_MATCH_CHOICE_2';
mating between individuals with similar phenotypes
LITERAL_07B9_431B_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_07B9_431B_MATCH_CHOICE_3';
type of mating that reduces heterozygotes and increases homozygotes
LITERAL_07B9_431B_MATCH_CHOICE_3
$match_choice_4 = <<'LITERAL_07B9_431B_MATCH_CHOICE_4';
stronger in small populations and decrease the overall fitness of that population
LITERAL_07B9_431B_MATCH_CHOICE_4
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D", "E"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D", "E"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D", "E"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D", "E"], 4);
$match_dropdown_4 = make_popup(['', "A", "B", "C", "D", "E"], 5);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*

[_]{$match_dropdown_4} *5.* [$match_term_4]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*

*E.* [$match_choice_4]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
