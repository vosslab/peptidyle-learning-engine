## DESCRIPTION
## Imported Genetics source row 952a_d014; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_mc_type-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_952A_D014';
<p>952a_d014</p> <p>In the forest population of deer, there is a display of incomplete dominance in antler shape. Individuals with two E alleles exhibit heavily branched, those with one E allele and one e allele exhibit less branched, and those with two e alleles exhibit straight.</p> <p>A group of 2500 deer were observed. 651 had either <strong>less branched or straight</strong> antler shape, and did NOT have heavily branched antler shape.</p> <p>Which Hardy-Weinberg variable is represented by the fraction&nbsp;<table style="display: inline-table; border-collapse: collapse; line-height: 1; vertical-align: middle;"> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;651&nbsp;</td> </tr> <tr> <td style="border: none; padding: 0; height: 2px; background-color: black;"></td> </tr> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;2,500&nbsp;</td> </tr></table>&nbsp;? </p>
PROMPT_952A_D014
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_952A_D014_CHOICE_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_952A_D014_CHOICE_1
$choice_2 = <<'LITERAL_952A_D014_CHOICE_2';
<strong>q</strong> &mdash; Frequency of the recessive allele
LITERAL_952A_D014_CHOICE_2
$choice_3 = <<'LITERAL_952A_D014_CHOICE_3';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_952A_D014_CHOICE_3
$choice_4 = <<'LITERAL_952A_D014_CHOICE_4';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_952A_D014_CHOICE_4
$choice_5 = <<'LITERAL_952A_D014_CHOICE_5';
<strong>q&sup2;</strong> &mdash; Frequency of homozygous recessive individuals
LITERAL_952A_D014_CHOICE_5
$choice_6 = <<'LITERAL_952A_D014_CHOICE_6';
<strong>p&sup2; + 2pq</strong> &mdash; Frequency of individuals with the dominant phenotype
LITERAL_952A_D014_CHOICE_6
$choice_7 = <<'LITERAL_952A_D014_CHOICE_7';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_952A_D014_CHOICE_7
$correct_1 = <<'LITERAL_952A_D014_CORRECT_1';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_952A_D014_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
