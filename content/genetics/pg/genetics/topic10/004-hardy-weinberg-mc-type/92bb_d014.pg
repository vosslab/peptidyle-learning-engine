DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_92BB_D014';
<p>92bb_d014</p> <p><strong>Hemophilia A (HemA) </strong> is an X-linked recessive genetic disorder that is caused by a mutation in the HEMA gene. This results in blood cannot clot properly due to a deficiency of a clotting factor. The disorder affects 1 in 1,000 American males. Individuals affected with HemA have prolonged bleeding from common injuries. The defective gene for HemA is located on the long arm of chromosome X at position 28. </p><br/><p>In a study of HemA, an X-linked recessive disorder, in a population of 1100 male humans, 781 did NOT have the disorder.</p> <p>Which Hardy-Weinberg variable is represented by the fraction &nbsp;<table style="display: inline-table; border-collapse: collapse; line-height: 1; vertical-align: middle;"> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;781&nbsp;</td> </tr> <tr> <td style="border: none; padding: 0; height: 2px; background-color: black;"></td> </tr> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;1,100&nbsp;</td> </tr></table>&nbsp;?</p>
PROMPT_92BB_D014
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_92BB_D014_CHOICE_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_92BB_D014_CHOICE_1
$choice_2 = <<'LITERAL_92BB_D014_CHOICE_2';
<strong>q</strong> &mdash; Frequency of the recessive allele
LITERAL_92BB_D014_CHOICE_2
$choice_3 = <<'LITERAL_92BB_D014_CHOICE_3';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_92BB_D014_CHOICE_3
$choice_4 = <<'LITERAL_92BB_D014_CHOICE_4';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_92BB_D014_CHOICE_4
$choice_5 = <<'LITERAL_92BB_D014_CHOICE_5';
<strong>q&sup2;</strong> &mdash; Frequency of homozygous recessive individuals
LITERAL_92BB_D014_CHOICE_5
$choice_6 = <<'LITERAL_92BB_D014_CHOICE_6';
<strong>p&sup2; + 2pq</strong> &mdash; Frequency of individuals with the dominant phenotype
LITERAL_92BB_D014_CHOICE_6
$choice_7 = <<'LITERAL_92BB_D014_CHOICE_7';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_92BB_D014_CHOICE_7
$correct_1 = <<'LITERAL_92BB_D014_CORRECT_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_92BB_D014_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
