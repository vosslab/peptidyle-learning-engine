## DESCRIPTION
## Imported Genetics source row a08d_d014; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_mc_type-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A08D_D014';
<p>a08d_d014</p> <p>In the mountainous area population of lizards, there is a display of incomplete dominance in scale pattern. Individuals with two S alleles exhibit spotted pattern, those with one S allele and one s allele exhibit striped pattern, and those with two s alleles exhibit solid color.</p> <p>A group of 1200 lizards were observed. 867 exhibited the spotted pattern scale pattern, 306 had the striped pattern scale pattern, and 27 showed the recessive form of solid color scale pattern.</p> <p>Which Hardy-Weinberg variable is represented by the fraction&nbsp;<table style="display: inline-table; border-collapse: collapse; line-height: 1; vertical-align: middle;"> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;867&nbsp;</td> </tr> <tr> <td style="border: none; padding: 0; height: 2px; background-color: black;"></td> </tr> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;1,200&nbsp;</td> </tr></table>&nbsp;? </p><p>Which Hardy-Weinberg variable is represented by the fraction 867/1200?</p>
PROMPT_A08D_D014
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A08D_D014_CHOICE_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_A08D_D014_CHOICE_1
$choice_2 = <<'LITERAL_A08D_D014_CHOICE_2';
<strong>q</strong> &mdash; Frequency of the recessive allele
LITERAL_A08D_D014_CHOICE_2
$choice_3 = <<'LITERAL_A08D_D014_CHOICE_3';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_A08D_D014_CHOICE_3
$choice_4 = <<'LITERAL_A08D_D014_CHOICE_4';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_A08D_D014_CHOICE_4
$choice_5 = <<'LITERAL_A08D_D014_CHOICE_5';
<strong>q&sup2;</strong> &mdash; Frequency of homozygous recessive individuals
LITERAL_A08D_D014_CHOICE_5
$choice_6 = <<'LITERAL_A08D_D014_CHOICE_6';
<strong>p&sup2; + 2pq</strong> &mdash; Frequency of individuals with the dominant phenotype
LITERAL_A08D_D014_CHOICE_6
$choice_7 = <<'LITERAL_A08D_D014_CHOICE_7';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_A08D_D014_CHOICE_7
$correct_1 = <<'LITERAL_A08D_D014_CORRECT_1';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_A08D_D014_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
