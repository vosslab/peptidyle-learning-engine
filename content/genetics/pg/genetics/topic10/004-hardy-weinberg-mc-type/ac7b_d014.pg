## DESCRIPTION
## Imported Genetics source row ac7b_d014; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_mc_type-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AC7B_D014';
<p>ac7b_d014</p> <p>In the lake population of fish, there is a display of incomplete dominance in scale color. Individuals with two V alleles exhibit red, those with one V allele and one v allele exhibit pink, and those with two v alleles exhibit white.</p> <p>A group of 10000 fish were observed. 8649 exhibited the red scale color, 1302 had the pink scale color, and 49 showed the recessive form of white scale color.</p> <p>Which Hardy-Weinberg variable is represented by the fraction&nbsp;<table style="display: inline-table; border-collapse: collapse; line-height: 1; vertical-align: middle;"> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;1,302&nbsp;</td> </tr> <tr> <td style="border: none; padding: 0; height: 2px; background-color: black;"></td> </tr> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;10,000&nbsp;</td> </tr></table>&nbsp;? </p>
PROMPT_AC7B_D014
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AC7B_D014_CHOICE_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_AC7B_D014_CHOICE_1
$choice_2 = <<'LITERAL_AC7B_D014_CHOICE_2';
<strong>q</strong> &mdash; Frequency of the recessive allele
LITERAL_AC7B_D014_CHOICE_2
$choice_3 = <<'LITERAL_AC7B_D014_CHOICE_3';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_AC7B_D014_CHOICE_3
$choice_4 = <<'LITERAL_AC7B_D014_CHOICE_4';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_AC7B_D014_CHOICE_4
$choice_5 = <<'LITERAL_AC7B_D014_CHOICE_5';
<strong>q&sup2;</strong> &mdash; Frequency of homozygous recessive individuals
LITERAL_AC7B_D014_CHOICE_5
$choice_6 = <<'LITERAL_AC7B_D014_CHOICE_6';
<strong>p&sup2; + 2pq</strong> &mdash; Frequency of individuals with the dominant phenotype
LITERAL_AC7B_D014_CHOICE_6
$choice_7 = <<'LITERAL_AC7B_D014_CHOICE_7';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_AC7B_D014_CHOICE_7
$correct_1 = <<'LITERAL_AC7B_D014_CORRECT_1';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_AC7B_D014_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
