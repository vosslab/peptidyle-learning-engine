DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3167_D014';
<p>3167_d014</p> <p><strong>Duchenne muscular dystrophy (DMD) </strong> is an X-linked recessive genetic disorder that is caused by mutations in the DMD gene. This results in dystrophin is responsible for connecting the actin cytoskeleton to the extracellular matrix (ECM) in muscle cells. The disorder affects 1 in 20,000 males. Individuals affected with DMD have muscle weakness, trouble standing up, which eventually leads to loss of skeletal muscle control, respiratory failure, and death. The defective gene for DMD is located on the short arm of chromosome X at position 21.2. </p><br/><p>In a study of DMD, an X-linked recessive disorder, in a population of 1300 male humans, 559 did NOT have the disorder.</p> <p>Which Hardy-Weinberg variable is represented by the fraction &nbsp;<table style="display: inline-table; border-collapse: collapse; line-height: 1; vertical-align: middle;"> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;559&nbsp;</td> </tr> <tr> <td style="border: none; padding: 0; height: 2px; background-color: black;"></td> </tr> <tr> <td style="border: none; font-size: 90%; padding: 2px; text-align: center;">&nbsp;1,300&nbsp;</td> </tr></table>&nbsp;?</p>
PROMPT_3167_D014
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3167_D014_CHOICE_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_3167_D014_CHOICE_1
$choice_2 = <<'LITERAL_3167_D014_CHOICE_2';
<strong>q</strong> &mdash; Frequency of the recessive allele
LITERAL_3167_D014_CHOICE_2
$choice_3 = <<'LITERAL_3167_D014_CHOICE_3';
<strong>p&sup2;</strong> &mdash; Frequency of homozygous dominant individuals
LITERAL_3167_D014_CHOICE_3
$choice_4 = <<'LITERAL_3167_D014_CHOICE_4';
<strong>2pq</strong> &mdash; Frequency of heterozygous individuals
LITERAL_3167_D014_CHOICE_4
$choice_5 = <<'LITERAL_3167_D014_CHOICE_5';
<strong>q&sup2;</strong> &mdash; Frequency of homozygous recessive individuals
LITERAL_3167_D014_CHOICE_5
$choice_6 = <<'LITERAL_3167_D014_CHOICE_6';
<strong>p&sup2; + 2pq</strong> &mdash; Frequency of individuals with the dominant phenotype
LITERAL_3167_D014_CHOICE_6
$choice_7 = <<'LITERAL_3167_D014_CHOICE_7';
<strong>2pq + q&sup2;</strong> &mdash; Frequency of individuals that are NOT homozygous dominant
LITERAL_3167_D014_CHOICE_7
$correct_1 = <<'LITERAL_3167_D014_CORRECT_1';
<strong>p</strong> &mdash; Frequency of the dominant allele
LITERAL_3167_D014_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
