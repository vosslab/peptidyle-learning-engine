DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0494_2E19';
<p>0494_2e19</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_0494_2E19
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0494_2E19_CHOICE_1';
alleles are<strong> <strong>NOT</strong> </strong>moving into and out of the population
LITERAL_0494_2E19_CHOICE_1
$choice_2 = <<'LITERAL_0494_2E19_CHOICE_2';
no selective mating is actively occuring
LITERAL_0494_2E19_CHOICE_2
$choice_3 = <<'LITERAL_0494_2E19_CHOICE_3';
genes are actively being duplicated or deleted due to chromosomal alterations
LITERAL_0494_2E19_CHOICE_3
$choice_4 = <<'LITERAL_0494_2E19_CHOICE_4';
the population size is extremely large
LITERAL_0494_2E19_CHOICE_4
$choice_5 = <<'LITERAL_0494_2E19_CHOICE_5';
there are no genotype-based differences in survival rates of individuals
LITERAL_0494_2E19_CHOICE_5
$correct_1 = <<'LITERAL_0494_2E19_CORRECT_1';
genes are actively being duplicated or deleted due to chromosomal alterations
LITERAL_0494_2E19_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
