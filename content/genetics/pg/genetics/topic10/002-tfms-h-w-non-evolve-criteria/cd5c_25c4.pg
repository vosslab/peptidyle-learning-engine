## DESCRIPTION
## Imported Genetics source row cd5c_25c4; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CD5C_25C4';
<p>cd5c_25c4</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_CD5C_25C4
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CD5C_25C4_CHOICE_1';
there exists an extremely small population size
LITERAL_CD5C_25C4_CHOICE_1
$choice_2 = <<'LITERAL_CD5C_25C4_CHOICE_2';
all genotypes are equally likely to survive
LITERAL_CD5C_25C4_CHOICE_2
$choice_3 = <<'LITERAL_CD5C_25C4_CHOICE_3';
genes are actively being duplicated or deleted due to chromosomal alterations
LITERAL_CD5C_25C4_CHOICE_3
$choice_4 = <<'LITERAL_CD5C_25C4_CHOICE_4';
a significant amount of migration is actively occuring
LITERAL_CD5C_25C4_CHOICE_4
$choice_5 = <<'LITERAL_CD5C_25C4_CHOICE_5';
selective mating is actively occuring
LITERAL_CD5C_25C4_CHOICE_5
$correct_1 = <<'LITERAL_CD5C_25C4_CORRECT_1';
all genotypes are equally likely to survive
LITERAL_CD5C_25C4_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
