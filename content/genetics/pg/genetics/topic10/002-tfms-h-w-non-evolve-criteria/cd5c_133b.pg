## DESCRIPTION
## Imported Genetics source row cd5c_133b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CD5C_133B';
<p>cd5c_133b</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_CD5C_133B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CD5C_133B_CHOICE_1';
some genotypes are more likely to survive than others
LITERAL_CD5C_133B_CHOICE_1
$choice_2 = <<'LITERAL_CD5C_133B_CHOICE_2';
a significant amount of inbreeding is actively occuring
LITERAL_CD5C_133B_CHOICE_2
$choice_3 = <<'LITERAL_CD5C_133B_CHOICE_3';
a significant amount of migration is actively occuring
LITERAL_CD5C_133B_CHOICE_3
$choice_4 = <<'LITERAL_CD5C_133B_CHOICE_4';
no genetic drift is actively occuring
LITERAL_CD5C_133B_CHOICE_4
$choice_5 = <<'LITERAL_CD5C_133B_CHOICE_5';
mutations are actively occuring across generations
LITERAL_CD5C_133B_CHOICE_5
$correct_1 = <<'LITERAL_CD5C_133B_CORRECT_1';
no genetic drift is actively occuring
LITERAL_CD5C_133B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
