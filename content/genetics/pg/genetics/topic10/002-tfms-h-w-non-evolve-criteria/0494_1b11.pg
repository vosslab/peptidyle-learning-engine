## DESCRIPTION
## Imported Genetics source row 0494_1b11; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0494_1B11';
<p>0494_1b11</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_0494_1B11
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0494_1B11_CHOICE_1';
all individuals are equally likely to survive
LITERAL_0494_1B11_CHOICE_1
$choice_2 = <<'LITERAL_0494_1B11_CHOICE_2';
selective mating is actively occuring
LITERAL_0494_1B11_CHOICE_2
$choice_3 = <<'LITERAL_0494_1B11_CHOICE_3';
no new alleles are being added to the gene pool
LITERAL_0494_1B11_CHOICE_3
$choice_4 = <<'LITERAL_0494_1B11_CHOICE_4';
no emigration and no immgration is actively occuring
LITERAL_0494_1B11_CHOICE_4
$choice_5 = <<'LITERAL_0494_1B11_CHOICE_5';
the population size is extremely large
LITERAL_0494_1B11_CHOICE_5
$correct_1 = <<'LITERAL_0494_1B11_CORRECT_1';
selective mating is actively occuring
LITERAL_0494_1B11_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
