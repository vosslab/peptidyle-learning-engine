## DESCRIPTION
## Imported Genetics source row 0494_c8d9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0494_C8D9';
<p>0494_c8d9</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_0494_C8D9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0494_C8D9_CHOICE_1';
no gene flow is actively occuring
LITERAL_0494_C8D9_CHOICE_1
$choice_2 = <<'LITERAL_0494_C8D9_CHOICE_2';
some genotypes are more likely to survive than others
LITERAL_0494_C8D9_CHOICE_2
$choice_3 = <<'LITERAL_0494_C8D9_CHOICE_3';
there exists an extremely large population size
LITERAL_0494_C8D9_CHOICE_3
$choice_4 = <<'LITERAL_0494_C8D9_CHOICE_4';
no inbreeding is actively occuring
LITERAL_0494_C8D9_CHOICE_4
$choice_5 = <<'LITERAL_0494_C8D9_CHOICE_5';
the gene copy number is<strong> <strong>NOT</strong> </strong>changing due to chromosomal alterations
LITERAL_0494_C8D9_CHOICE_5
$correct_1 = <<'LITERAL_0494_C8D9_CORRECT_1';
some genotypes are more likely to survive than others
LITERAL_0494_C8D9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
