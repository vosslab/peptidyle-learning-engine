## DESCRIPTION
## Imported Genetics source row 5fbb_16b0; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5FBB_16B0';
<p>5fbb_16b0</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> concerning Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_5FBB_16B0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5FBB_16B0_CHOICE_1';
no natural selection is actively occuring
LITERAL_5FBB_16B0_CHOICE_1
$choice_2 = <<'LITERAL_5FBB_16B0_CHOICE_2';
the gene copy number is<strong> <strong>NOT</strong> </strong>changing due to chromosomal alterations
LITERAL_5FBB_16B0_CHOICE_2
$choice_3 = <<'LITERAL_5FBB_16B0_CHOICE_3';
it is an isolated population
LITERAL_5FBB_16B0_CHOICE_3
$choice_4 = <<'LITERAL_5FBB_16B0_CHOICE_4';
allele frequecies remain constant across generations
LITERAL_5FBB_16B0_CHOICE_4
$choice_5 = <<'LITERAL_5FBB_16B0_CHOICE_5';
a significant amount of inbreeding is actively occuring
LITERAL_5FBB_16B0_CHOICE_5
$correct_1 = <<'LITERAL_5FBB_16B0_CORRECT_1';
a significant amount of inbreeding is actively occuring
LITERAL_5FBB_16B0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
