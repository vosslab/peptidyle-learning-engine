## DESCRIPTION
## Imported Genetics source row 5fbb_7f01; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5FBB_7F01';
<p>5fbb_7f01</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> concerning Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_5FBB_7F01
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5FBB_7F01_CHOICE_1';
there exists an extremely large population size
LITERAL_5FBB_7F01_CHOICE_1
$choice_2 = <<'LITERAL_5FBB_7F01_CHOICE_2';
all genotypes have equal chance at surviving
LITERAL_5FBB_7F01_CHOICE_2
$choice_3 = <<'LITERAL_5FBB_7F01_CHOICE_3';
alleles are becoming actively modified across generations
LITERAL_5FBB_7F01_CHOICE_3
$choice_4 = <<'LITERAL_5FBB_7F01_CHOICE_4';
random mixing of gametes is actively occuring
LITERAL_5FBB_7F01_CHOICE_4
$choice_5 = <<'LITERAL_5FBB_7F01_CHOICE_5';
no emigration and no immgration is actively occuring
LITERAL_5FBB_7F01_CHOICE_5
$correct_1 = <<'LITERAL_5FBB_7F01_CORRECT_1';
alleles are becoming actively modified across generations
LITERAL_5FBB_7F01_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
