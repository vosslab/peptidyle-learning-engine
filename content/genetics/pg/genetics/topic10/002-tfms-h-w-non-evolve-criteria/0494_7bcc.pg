DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0494_7BCC';
<p>0494_7bcc</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_0494_7BCC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0494_7BCC_CHOICE_1';
no natural selection is actively occuring
LITERAL_0494_7BCC_CHOICE_1
$choice_2 = <<'LITERAL_0494_7BCC_CHOICE_2';
alleles remain the same across generations
LITERAL_0494_7BCC_CHOICE_2
$choice_3 = <<'LITERAL_0494_7BCC_CHOICE_3';
random mixing of gametes is actively occuring
LITERAL_0494_7BCC_CHOICE_3
$choice_4 = <<'LITERAL_0494_7BCC_CHOICE_4';
allele frequecies change constant across generations
LITERAL_0494_7BCC_CHOICE_4
$choice_5 = <<'LITERAL_0494_7BCC_CHOICE_5';
allele frequecies remain constant across generations
LITERAL_0494_7BCC_CHOICE_5
$correct_1 = <<'LITERAL_0494_7BCC_CORRECT_1';
allele frequecies change constant across generations
LITERAL_0494_7BCC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
