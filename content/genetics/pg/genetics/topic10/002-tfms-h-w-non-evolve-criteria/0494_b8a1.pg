## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0494_B8A1';
<p>0494_b8a1</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> of Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_0494_B8A1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0494_B8A1_CHOICE_1';
alleles remain the same across generations
LITERAL_0494_B8A1_CHOICE_1
$choice_2 = <<'LITERAL_0494_B8A1_CHOICE_2';
no genetic drift is actively occuring
LITERAL_0494_B8A1_CHOICE_2
$choice_3 = <<'LITERAL_0494_B8A1_CHOICE_3';
alleles are<strong> <strong>NOT</strong> </strong>moving into and out of the population
LITERAL_0494_B8A1_CHOICE_3
$choice_4 = <<'LITERAL_0494_B8A1_CHOICE_4';
all genotypes have equal chance at surviving
LITERAL_0494_B8A1_CHOICE_4
$choice_5 = <<'LITERAL_0494_B8A1_CHOICE_5';
mating is<strong> <strong>NOT</strong> </strong>completly random
LITERAL_0494_B8A1_CHOICE_5
$correct_1 = <<'LITERAL_0494_B8A1_CORRECT_1';
mating is<strong> <strong>NOT</strong> </strong>completly random
LITERAL_0494_B8A1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
