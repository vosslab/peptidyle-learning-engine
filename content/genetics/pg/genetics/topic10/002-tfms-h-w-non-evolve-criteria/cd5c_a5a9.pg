## DESCRIPTION
## Imported Genetics source row cd5c_a5a9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-TFMS-h-w_non-evolve_criteria-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CD5C_A5A9';
<p>cd5c_a5a9</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding Hardy-Weinberg equilibrium conditions for non-evolving populations?</p>
PROMPT_CD5C_A5A9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CD5C_A5A9_CHOICE_1';
alleles are moving into and out of the population
LITERAL_CD5C_A5A9_CHOICE_1
$choice_2 = <<'LITERAL_CD5C_A5A9_CHOICE_2';
genes are actively being duplicated or deleted due to chromosomal alterations
LITERAL_CD5C_A5A9_CHOICE_2
$choice_3 = <<'LITERAL_CD5C_A5A9_CHOICE_3';
allele frequecies remain constant across generations
LITERAL_CD5C_A5A9_CHOICE_3
$choice_4 = <<'LITERAL_CD5C_A5A9_CHOICE_4';
there are genotype-based differences in survival rates of individuals
LITERAL_CD5C_A5A9_CHOICE_4
$choice_5 = <<'LITERAL_CD5C_A5A9_CHOICE_5';
mating is<strong> <strong>NOT</strong> </strong>completly random
LITERAL_CD5C_A5A9_CHOICE_5
$correct_1 = <<'LITERAL_CD5C_A5A9_CORRECT_1';
allele frequecies remain constant across generations
LITERAL_CD5C_A5A9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
