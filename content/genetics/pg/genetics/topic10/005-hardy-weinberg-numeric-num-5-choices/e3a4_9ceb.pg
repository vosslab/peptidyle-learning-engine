## DESCRIPTION
## Imported Genetics source row e3a4_9ceb; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_numeric-NUM-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E3A4_9CEB';
<table style="border-collapse: collapse; border: 2px solid black;"><tr>  <th colspan="3" align="center">flowers</th></tr><tr>  <th align="center">genotype</th>  <th align="center">phenotype</th>  <th align="center">count</th></tr><tr>  <td align="center">homozygous<br/>dominant</td>  <td align="center">red</td>  <td align="right">20,597</td></tr><tr>  <td align="center">heterozygous</td>  <td align="center">orange</td>  <td align="right">1,806</td></tr><tr>  <td align="center">homozygous<br/>recessive</td>  <td align="center">yellow</td>  <td align="right">2,597</td></tr><tr>  <th colspan="2" align="right">SUM</th>  <th align="right">25,000</th></tr></table>  <p>In a field there are 20,597 red flowers, 1,806 orange flowers, and 2,597 yellow flowers that show incomplete dominance. What is the frequency of the <b>dominant</b> allele?</p><p>Note: Do not enter a percentage on the blank. For example, if the answer is 53.8%, enter 0.538 on the blank. Your answer will be a decimal value between 0 and 1.</p>
PROMPT_E3A4_9CEB
$tolerance = "0.0099";
$answer = Real("0.86")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "0.8501";
$upper_bound = "0.8699";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
