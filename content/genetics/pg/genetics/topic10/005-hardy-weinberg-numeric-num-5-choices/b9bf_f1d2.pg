## DESCRIPTION
## Imported Genetics source row b9bf_f1d2; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_numeric-NUM-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B9BF_F1D2';
<table style="border-collapse: collapse; border: 2px solid black;"><tr>  <th colspan="3" align="center">beetles</th></tr><tr>  <th align="center">genotype</th>  <th align="center">phenotype</th>  <th align="center">count</th></tr><tr>  <td align="center">homozygous<br/>dominant</td>  <td align="center">blue</td>  <td align="right">57,399</td></tr><tr>  <td align="center">heterozygous</td>  <td align="center">green</td>  <td align="right">25,200</td></tr><tr>  <td align="center">homozygous<br/>recessive</td>  <td align="center">yellow</td>  <td align="right">17,400</td></tr><tr>  <th colspan="2" align="right">SUM</th>  <th align="right">99,999</th></tr></table>  <p>In a field there are 57,399 blue beetles, 25,200 green beetles, and 17,400 yellow beetles that show incomplete dominance. What is the frequency of the <b>dominant</b> allele?</p><p>Note: Do not enter a percentage on the blank. For example, if the answer is 78.4%, enter 0.784 on the blank. Your answer will be a decimal value between 0 and 1.</p>
PROMPT_B9BF_F1D2
$tolerance = "0.0099";
$answer = Real("0.70")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "0.6901";
$upper_bound = "0.7099";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
