## DESCRIPTION
## Imported Genetics source row 22bb_ec1e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_numeric-NUM-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_22BB_EC1E';
<table style="border-collapse: collapse; border: 2px solid black;"><tr>  <th colspan="3" align="center">frogs</th></tr><tr>  <th align="center">genotype</th>  <th align="center">phenotype</th>  <th align="center">count</th></tr><tr>  <td align="center">homozygous<br/>dominant</td>  <td align="center">black</td>  <td align="right">528</td></tr><tr>  <td align="center">heterozygous</td>  <td align="center">gray</td>  <td align="right">1,694</td></tr><tr>  <td align="center">homozygous<br/>recessive</td>  <td align="center">white</td>  <td align="right">903</td></tr><tr>  <th colspan="2" align="right">SUM</th>  <th align="right">3,125</th></tr></table>  <p>In a field there are 528 black frogs, 1,694 gray frogs, and 903 white frogs that show incomplete dominance. What is the frequency of the <b>dominant</b> allele?</p><p>Note: Do not enter a percentage on the blank. For example, if the answer is 65.8%, enter 0.658 on the blank. Your answer will be a decimal value between 0 and 1.</p>
PROMPT_22BB_EC1E
$tolerance = "0.0099";
$answer = Real("0.44")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "0.4301";
$upper_bound = "0.4499";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
