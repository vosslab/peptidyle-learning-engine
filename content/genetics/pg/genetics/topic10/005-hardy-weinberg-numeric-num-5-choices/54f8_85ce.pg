## DESCRIPTION
## Imported Genetics source row 54f8_85ce; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_numeric-NUM-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_54F8_85CE';
<table style="border-collapse: collapse; border: 2px solid black;"><tr>  <th colspan="3" align="center">fish</th></tr><tr>  <th align="center">genotype</th>  <th align="center">phenotype</th>  <th align="center">count</th></tr><tr>  <td align="center">homozygous<br/>dominant</td>  <td align="center">blue</td>  <td align="right">222</td></tr><tr>  <td align="center">heterozygous</td>  <td align="center">green</td>  <td align="right">156</td></tr><tr>  <td align="center">homozygous<br/>recessive</td>  <td align="center">yellow</td>  <td align="right">247</td></tr><tr>  <th colspan="2" align="right">SUM</th>  <th align="right">625</th></tr></table>  <p>In a field there are 222 blue fish, 156 green fish, and 247 yellow fish that show incomplete dominance. What is the frequency of the <b>dominant</b> allele?</p><p>Note: Do not enter a percentage on the blank. For example, if the answer is 72.8%, enter 0.728 on the blank. Your answer will be a decimal value between 0 and 1.</p>
PROMPT_54F8_85CE
$tolerance = "0.0099";
$answer = Real("0.48")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "0.4701";
$upper_bound = "0.4899";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
