## DESCRIPTION
## Imported Genetics source row 8496_96da; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic10/bbq-hardy_weinberg_numeric-NUM-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8496_96DA';
<table style="border-collapse: collapse; border: 2px solid black;"><tr>  <th colspan="3" align="center">flowers</th></tr><tr>  <th align="center">genotype</th>  <th align="center">phenotype</th>  <th align="center">count</th></tr><tr>  <td align="center">homozygous<br/>dominant</td>  <td align="center">blue</td>  <td align="right">82,800</td></tr><tr>  <td align="center">heterozygous</td>  <td align="center">green</td>  <td align="right">14,399</td></tr><tr>  <td align="center">homozygous<br/>recessive</td>  <td align="center">yellow</td>  <td align="right">2,800</td></tr><tr>  <th colspan="2" align="right">SUM</th>  <th align="right">99,999</th></tr></table>  <p>In a field there are 82,800 blue flowers, 14,399 green flowers, and 2,800 yellow flowers that show incomplete dominance. What is the frequency of the <b>dominant</b> allele?</p><p>Note: Do not enter a percentage on the blank. For example, if the answer is 34.2%, enter 0.342 on the blank. Your answer will be a decimal value between 0 and 1.</p>
PROMPT_8496_96DA
$tolerance = "0.0099";
$answer = Real("0.90")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "0.8901";
$upper_bound = "0.9099";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
