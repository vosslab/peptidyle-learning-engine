DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E662_6B5E';
<p>e662_6b5e</p> <p>The <span style='color: #595959; font-weight: 600;'>white-eyed (mutant)</span> phenotype is an X-linked recessive disorder in fruit flies. The <span style='color: #8b0000; font-weight: 600;'>red-eyed (wildtype)</span> allele, <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+</span>, is dominant to the white (<span style='color: #595959; font-weight: 600;'>mutant</span>) allele, <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>w</span>. The offspring of size 400 from the mating of a single <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> and a single <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> are shown in the table below:</p><table cellpadding="2" cellspacing="2" style="border-collapse: collapse; text-align:center; border: 1px solid black; font-size: 14px;"><tr><th>phenotype</th><th><span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span></th><th><span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span></th></tr> <tr><td><span style='color: darkred;'>red-eyed (wildtype)</span></td> <td align='center'>193</td><td align='center'>0</td></tr> <tr><td><span style='color: #595959; font-weight: 600;'>white-eyed (mutant)</span></td> <td align='center'>0</td><td align='center'>207</td></tr> </table><br/><p><strong>What are the genotypes of the parents in this cross?</strong></p>
PROMPT_E662_6B5E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E662_6B5E_CHOICE_1';
heterozygous <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+w</span> and <span style='color: #595959; font-weight: 600;'>mutant</span> <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>w-</span>
LITERAL_E662_6B5E_CHOICE_1
$choice_2 = <<'LITERAL_E662_6B5E_CHOICE_2';
heterozygous <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+w</span> and <span style='color: #8b0000; font-weight: 600;'>wildtype</span> <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+-</span>
LITERAL_E662_6B5E_CHOICE_2
$choice_3 = <<'LITERAL_E662_6B5E_CHOICE_3';
homozygous <span style='color: #595959; font-weight: 600;'>mutant</span> <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>ww</span> and <span style='color: #595959; font-weight: 600;'>mutant</span> <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>w-</span>
LITERAL_E662_6B5E_CHOICE_3
$choice_4 = <<'LITERAL_E662_6B5E_CHOICE_4';
homozygous <span style='color: #595959; font-weight: 600;'>mutant</span> <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>ww</span> and <span style='color: #8b0000; font-weight: 600;'>wildtype</span> <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+-</span>
LITERAL_E662_6B5E_CHOICE_4
$choice_5 = <<'LITERAL_E662_6B5E_CHOICE_5';
homozygous <span style='color: #8b0000; font-weight: 600;'>wildtype</span> <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>++</span> and <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> of unknown genotype
LITERAL_E662_6B5E_CHOICE_5
$correct_1 = <<'LITERAL_E662_6B5E_CORRECT_1';
homozygous <span style='color: #595959; font-weight: 600;'>mutant</span> <span style='color: #990070; font-weight: 600;'>female</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&female;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>ww</span> and <span style='color: #8b0000; font-weight: 600;'>wildtype</span> <span style='color: #002499; font-weight: 600;'>male</span> <span style='font-weight: 400;'>(</span><span style='font-weight: 400;'>&male;</span><span style='font-weight: 400;'>)</span> <span style='font-family: monospace; font-size: 0.95em; font-weight: 600; text-transform: none; font-variant: normal;'>+-</span>
LITERAL_E662_6B5E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
