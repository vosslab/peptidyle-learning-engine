## DESCRIPTION
## Imported Genetics source row c2f7_536e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-WOMC-meiosis_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C2F7_536E';
<p>c2f7_536e</p> <p>Which one of the following Meiosis terms correspond to the definition <span style='font-size: 1em;'><strong>'chromosome pairs (one from each parent) that are similar in length, gene position, and centromere location'</strong></span>.</p>
PROMPT_C2F7_536E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C2F7_536E_CHOICE_1';
chiasmata
LITERAL_C2F7_536E_CHOICE_1
$choice_2 = <<'LITERAL_C2F7_536E_CHOICE_2';
crossing over
LITERAL_C2F7_536E_CHOICE_2
$choice_3 = <<'LITERAL_C2F7_536E_CHOICE_3';
<strong><span style="color: #d40000;">homologous chromosomes</span></strong>
LITERAL_C2F7_536E_CHOICE_3
$choice_4 = <<'LITERAL_C2F7_536E_CHOICE_4';
sister chromatids
LITERAL_C2F7_536E_CHOICE_4
$correct_1 = <<'LITERAL_C2F7_536E_CORRECT_1';
<strong><span style="color: #d40000;">homologous chromosomes</span></strong>
LITERAL_C2F7_536E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
