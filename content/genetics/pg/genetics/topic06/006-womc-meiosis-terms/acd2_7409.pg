## DESCRIPTION
## Imported Genetics source row acd2_7409; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-WOMC-meiosis_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_ACD2_7409';
<p>acd2_7409</p> <p>Which one of the following Meiosis terms correspond to the definition <span style='font-size: 1em;'><strong>'having a similar position, structure, value, or purpose'</strong></span>.</p>
PROMPT_ACD2_7409
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_ACD2_7409_CHOICE_1';
chiasmata
LITERAL_ACD2_7409_CHOICE_1
$choice_2 = <<'LITERAL_ACD2_7409_CHOICE_2';
<strong><span style="color: #007576;">homologous</span></strong>
LITERAL_ACD2_7409_CHOICE_2
$choice_3 = <<'LITERAL_ACD2_7409_CHOICE_3';
sister chromatids
LITERAL_ACD2_7409_CHOICE_3
$choice_4 = <<'LITERAL_ACD2_7409_CHOICE_4';
synapsis
LITERAL_ACD2_7409_CHOICE_4
$correct_1 = <<'LITERAL_ACD2_7409_CORRECT_1';
<strong><span style="color: #007576;">homologous</span></strong>
LITERAL_ACD2_7409_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
