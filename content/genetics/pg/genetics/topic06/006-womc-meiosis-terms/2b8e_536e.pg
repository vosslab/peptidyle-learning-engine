## DESCRIPTION
## Imported Genetics source row 2b8e_536e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-WOMC-meiosis_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2B8E_536E';
<p>2b8e_536e</p> <p>Which one of the following Meiosis terms correspond to the definition <span style='font-size: 1em;'><strong>'the region where <strong><span style="color: #d40000;">homologous chromosomes</span></strong> stay connected after crossing over'</strong></span>.</p>
PROMPT_2B8E_536E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2B8E_536E_CHOICE_1';
chiasmata
LITERAL_2B8E_536E_CHOICE_1
$choice_2 = <<'LITERAL_2B8E_536E_CHOICE_2';
crossing over
LITERAL_2B8E_536E_CHOICE_2
$choice_3 = <<'LITERAL_2B8E_536E_CHOICE_3';
<strong><span style="color: #d40000;">homologous chromosomes</span></strong>
LITERAL_2B8E_536E_CHOICE_3
$choice_4 = <<'LITERAL_2B8E_536E_CHOICE_4';
sister chromatids
LITERAL_2B8E_536E_CHOICE_4
$correct_1 = <<'LITERAL_2B8E_536E_CORRECT_1';
chiasmata
LITERAL_2B8E_536E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
