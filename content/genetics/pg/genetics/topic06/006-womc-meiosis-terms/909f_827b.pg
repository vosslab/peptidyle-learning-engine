DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_909F_827B';
<p>909f_827b</p> <p>Which one of the following Meiosis terms correspond to the definition <span style='font-size: 1em;'><strong>'<strong><span style="color: #d40000;">homologous chromosomes</span></strong> pair with their counterparts and remain bound'</strong></span>.</p>
PROMPT_909F_827B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_909F_827B_CHOICE_1';
chiasmata
LITERAL_909F_827B_CHOICE_1
$choice_2 = <<'LITERAL_909F_827B_CHOICE_2';
<strong><span style="color: #d40000;">homologous chromosomes</span></strong>
LITERAL_909F_827B_CHOICE_2
$choice_3 = <<'LITERAL_909F_827B_CHOICE_3';
<strong><span style="color: #007576;">homologous</span></strong>
LITERAL_909F_827B_CHOICE_3
$choice_4 = <<'LITERAL_909F_827B_CHOICE_4';
synapsis
LITERAL_909F_827B_CHOICE_4
$correct_1 = <<'LITERAL_909F_827B_CORRECT_1';
synapsis
LITERAL_909F_827B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
