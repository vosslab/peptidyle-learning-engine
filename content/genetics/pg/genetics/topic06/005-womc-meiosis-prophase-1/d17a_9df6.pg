## DESCRIPTION
## Imported Genetics source row d17a_9df6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-WOMC-meiosis_prophase_1-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D17A_9DF6';
<p>d17a_9df6</p> <p>Which one of the following stages of meiosis prophase I correspond to the partial description <span style='font-size: 1em;'><strong>'chromosomes reach near-maximal condensation in late prophase I'</strong></span>.</p>
PROMPT_D17A_9DF6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D17A_9DF6_CHOICE_1';
<strong><span style="color: #cc0066;">Diplotene or Diakinesis, combined</span></strong>
LITERAL_D17A_9DF6_CHOICE_1
$choice_2 = <<'LITERAL_D17A_9DF6_CHOICE_2';
<strong><span style="color: #b74300;">Leptotene</span></strong>
LITERAL_D17A_9DF6_CHOICE_2
$choice_3 = <<'LITERAL_D17A_9DF6_CHOICE_3';
<strong><span style="color: #0067cc;">Pachytene, early or late</span></strong>
LITERAL_D17A_9DF6_CHOICE_3
$choice_4 = <<'LITERAL_D17A_9DF6_CHOICE_4';
<strong><span style="color: #00775f;">Zygotene</span></strong>
LITERAL_D17A_9DF6_CHOICE_4
$correct_1 = <<'LITERAL_D17A_9DF6_CORRECT_1';
<strong><span style="color: #cc0066;">Diplotene or Diakinesis, combined</span></strong>
LITERAL_D17A_9DF6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
