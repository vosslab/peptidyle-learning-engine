$choice_3 = <<'LITERAL_7421_E69F_CHOICE_3';
1/2, 50%
LITERAL_7421_E69F_CHOICE_3
$choice_4 = <<'LITERAL_7421_E69F_CHOICE_4';
3/4, 75%
LITERAL_7421_E69F_CHOICE_4
$choice_5 = <<'LITERAL_7421_E69F_CHOICE_5';
All, 100%
LITERAL_7421_E69F_CHOICE_5
$correct_1 = <<'LITERAL_7421_E69F_CORRECT_1';
None, 0%
LITERAL_7421_E69F_CORRECT_1
