## DESCRIPTION
## Imported Genetics source row f953_2304; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F953_2304';
<p>f953_2304</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_F953_2304
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F953_2304_CHOICE_1';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> goes through cytokinesis cell division twice
LITERAL_F953_2304_CHOICE_1
$choice_2 = <<'LITERAL_F953_2304_CHOICE_2';
Both sexual and asexual organisms go through the process of <strong><span style="color: OrangeRed;">mitosis</span></strong>
LITERAL_F953_2304_CHOICE_2
$choice_3 = <<'LITERAL_F953_2304_CHOICE_3';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> produces new cells to help organisms grow in size and repair damaged tissue
LITERAL_F953_2304_CHOICE_3
$choice_4 = <<'LITERAL_F953_2304_CHOICE_4';
The daughter cells produced at the end of <strong><span style="color: MediumBlue;">meiosis</span></strong> are genetically different from the original parent cell
LITERAL_F953_2304_CHOICE_4
$choice_5 = <<'LITERAL_F953_2304_CHOICE_5';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_F953_2304_CHOICE_5
$correct_1 = <<'LITERAL_F953_2304_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_F953_2304_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
