DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8913_264D';
<p>8913_264d</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_8913_264D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8913_264D_CHOICE_1';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has half the number of chromosomes as the parent cell
LITERAL_8913_264D_CHOICE_1
$choice_2 = <<'LITERAL_8913_264D_CHOICE_2';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> goes through cytokinesis cell division twice
LITERAL_8913_264D_CHOICE_2
$choice_3 = <<'LITERAL_8913_264D_CHOICE_3';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> normally occurs in somatic cells of organisms and facilitates growth and development
LITERAL_8913_264D_CHOICE_3
$choice_4 = <<'LITERAL_8913_264D_CHOICE_4';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> produces new cells to help organisms grow in size and repair damaged tissue
LITERAL_8913_264D_CHOICE_4
$choice_5 = <<'LITERAL_8913_264D_CHOICE_5';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;">mitosis</span></strong> cell division are haploid
LITERAL_8913_264D_CHOICE_5
$correct_1 = <<'LITERAL_8913_264D_CORRECT_1';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has half the number of chromosomes as the parent cell
LITERAL_8913_264D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
