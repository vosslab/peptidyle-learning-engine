## DESCRIPTION
## Imported Genetics source row c407_0c4f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C407_0C4F';
<p>c407_0c4f</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_C407_0C4F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C407_0C4F_CHOICE_1';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_C407_0C4F_CHOICE_1
$choice_2 = <<'LITERAL_C407_0C4F_CHOICE_2';
Both sexual and asexual organisms go through the process of <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong>
LITERAL_C407_0C4F_CHOICE_2
$choice_3 = <<'LITERAL_C407_0C4F_CHOICE_3';
Cross-over regularly happens in <strong><span style="color: OrangeRed;">mitosis</span></strong>, but<strong> <strong>NOT</strong> </strong>in <strong><span style="color: MediumBlue;">meiosis</span></strong>
LITERAL_C407_0C4F_CHOICE_3
$choice_4 = <<'LITERAL_C407_0C4F_CHOICE_4';
Each daughter cell formed by <strong><span style="color: MediumBlue;">meiosis</span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_C407_0C4F_CHOICE_4
$choice_5 = <<'LITERAL_C407_0C4F_CHOICE_5';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> is cell division that produces four (4) daughter cells
LITERAL_C407_0C4F_CHOICE_5
$correct_1 = <<'LITERAL_C407_0C4F_CORRECT_1';
Both sexual and asexual organisms go through the process of <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong>
LITERAL_C407_0C4F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
