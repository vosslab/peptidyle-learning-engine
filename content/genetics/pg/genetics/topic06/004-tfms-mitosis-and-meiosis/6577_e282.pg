## DESCRIPTION
## Imported Genetics source row 6577_e282; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6577_E282';
<p>6577_e282</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_6577_E282
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6577_E282_CHOICE_1';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> starts with two cells and <strong><span style="color: OrangeRed;">mitosis</span></strong> starts with only one cell
LITERAL_6577_E282_CHOICE_1
$choice_2 = <<'LITERAL_6577_E282_CHOICE_2';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> normally occurs in somatic cells of organisms and facilitates growth and development
LITERAL_6577_E282_CHOICE_2
$choice_3 = <<'LITERAL_6577_E282_CHOICE_3';
Each daughter cell formed by <strong><span style="color: MediumBlue;">meiosis</span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_6577_E282_CHOICE_3
$choice_4 = <<'LITERAL_6577_E282_CHOICE_4';
In diploid organisms, the final cells resulting from <strong><span style="color: MediumBlue;">meiosis</span></strong> cell division are diploid
LITERAL_6577_E282_CHOICE_4
$choice_5 = <<'LITERAL_6577_E282_CHOICE_5';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> occurs in two phases, that is, <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong> I</span></strong> and <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong> I</span></strong>I</span></strong>
LITERAL_6577_E282_CHOICE_5
$correct_1 = <<'LITERAL_6577_E282_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> normally occurs in somatic cells of organisms and facilitates growth and development
LITERAL_6577_E282_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
