## DESCRIPTION
## Imported Genetics source row ff9f_2f79; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FF9F_2F79';
<p>ff9f_2f79</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_FF9F_2F79
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FF9F_2F79_CHOICE_1';
In <strong><span style="color: OrangeRed;">mitosis</span></strong>, the parent cell and the daughter cells are genetically identical
LITERAL_FF9F_2F79_CHOICE_1
$choice_2 = <<'LITERAL_FF9F_2F79_CHOICE_2';
Both <strong><span style="color: MediumBlue;">meiosis</span></strong> and <strong><span style="color: OrangeRed;">mitosis</span></strong> start with one cell
LITERAL_FF9F_2F79_CHOICE_2
$choice_3 = <<'LITERAL_FF9F_2F79_CHOICE_3';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_FF9F_2F79_CHOICE_3
$choice_4 = <<'LITERAL_FF9F_2F79_CHOICE_4';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong> I</span></strong> is the only stage where homologous chromosomes pair up and exchange genetic material
LITERAL_FF9F_2F79_CHOICE_4
$choice_5 = <<'LITERAL_FF9F_2F79_CHOICE_5';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> goes through cytokinesis cell division twice
LITERAL_FF9F_2F79_CHOICE_5
$correct_1 = <<'LITERAL_FF9F_2F79_CORRECT_1';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_FF9F_2F79_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
