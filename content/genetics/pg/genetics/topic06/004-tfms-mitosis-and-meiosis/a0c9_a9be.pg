DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A0C9_A9BE';
<p>a0c9_a9be</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_A0C9_A9BE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A0C9_A9BE_CHOICE_1';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> almost never involves crossing over of the chromosomes
LITERAL_A0C9_A9BE_CHOICE_1
$choice_2 = <<'LITERAL_A0C9_A9BE_CHOICE_2';
In <strong><span style="color: OrangeRed;">mitosis</span></strong>, the parent cell and the daughter cells are genetically identical
LITERAL_A0C9_A9BE_CHOICE_2
$choice_3 = <<'LITERAL_A0C9_A9BE_CHOICE_3';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> produces new cells to help organisms grow in size and repair damaged tissue
LITERAL_A0C9_A9BE_CHOICE_3
$choice_4 = <<'LITERAL_A0C9_A9BE_CHOICE_4';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs in two phases, that is, <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> I</span></strong> and <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> I</span></strong>I</span></strong>
LITERAL_A0C9_A9BE_CHOICE_4
$choice_5 = <<'LITERAL_A0C9_A9BE_CHOICE_5';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> is cell division that produces two (2) daughter cells
LITERAL_A0C9_A9BE_CHOICE_5
$correct_1 = <<'LITERAL_A0C9_A9BE_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs in two phases, that is, <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> I</span></strong> and <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> I</span></strong>I</span></strong>
LITERAL_A0C9_A9BE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
