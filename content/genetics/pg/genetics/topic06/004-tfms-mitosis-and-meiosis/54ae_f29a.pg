## DESCRIPTION
## Imported Genetics source row 54ae_f29a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_54AE_F29A';
<p>54ae_f29a</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_54AE_F29A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_54AE_F29A_CHOICE_1';
In <strong><span style="color: MediumBlue;">meiosis</span></strong>, the parent cell and the daughter cells are genetically identical
LITERAL_54AE_F29A_CHOICE_1
$choice_2 = <<'LITERAL_54AE_F29A_CHOICE_2';
Each daughter cell formed by <strong><span style="color: OrangeRed;">mitosis</span></strong> has half the number of chromosomes as the parent cell
LITERAL_54AE_F29A_CHOICE_2
$choice_3 = <<'LITERAL_54AE_F29A_CHOICE_3';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> normally occurs in somatic cells of organisms and facilitates growth and development
LITERAL_54AE_F29A_CHOICE_3
$choice_4 = <<'LITERAL_54AE_F29A_CHOICE_4';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> goes through cytokinesis cell division twice
LITERAL_54AE_F29A_CHOICE_4
$choice_5 = <<'LITERAL_54AE_F29A_CHOICE_5';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong></span></strong> is cell division that produces four (4) daughter cells
LITERAL_54AE_F29A_CHOICE_5
$correct_1 = <<'LITERAL_54AE_F29A_CORRECT_1';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong></span></strong> is cell division that produces four (4) daughter cells
LITERAL_54AE_F29A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
