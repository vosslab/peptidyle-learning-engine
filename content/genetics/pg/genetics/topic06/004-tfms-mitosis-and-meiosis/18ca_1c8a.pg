## DESCRIPTION
## Imported Genetics source row 18ca_1c8a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_18CA_1C8A';
<p>18ca_1c8a</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong> cell division?</p>
PROMPT_18CA_1C8A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_18CA_1C8A_CHOICE_1';
Both <strong><span style="color: MediumBlue;">meiosis</span></strong> and <strong><span style="color: OrangeRed;">mitosis</span></strong> start with one cell
LITERAL_18CA_1C8A_CHOICE_1
$choice_2 = <<'LITERAL_18CA_1C8A_CHOICE_2';
In diploid organisms, the final cells resulting from <strong><span style="color: MediumBlue;">meiosis</span></strong> cell division are haploid
LITERAL_18CA_1C8A_CHOICE_2
$choice_3 = <<'LITERAL_18CA_1C8A_CHOICE_3';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_18CA_1C8A_CHOICE_3
$choice_4 = <<'LITERAL_18CA_1C8A_CHOICE_4';
Only sexually reproductive organisms utilize <strong><span style="color: MediumBlue;">meiosis</span></strong>
LITERAL_18CA_1C8A_CHOICE_4
$choice_5 = <<'LITERAL_18CA_1C8A_CHOICE_5';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> is cell division that produces two (2) daughter cells
LITERAL_18CA_1C8A_CHOICE_5
$correct_1 = <<'LITERAL_18CA_1C8A_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_18CA_1C8A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
