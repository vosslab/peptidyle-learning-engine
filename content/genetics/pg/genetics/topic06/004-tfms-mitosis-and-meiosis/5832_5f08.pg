DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5832_5F08';
<p>5832_5f08</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_5832_5F08
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5832_5F08_CHOICE_1';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> is cell division that produces two (2) daughter cells
LITERAL_5832_5F08_CHOICE_1
$choice_2 = <<'LITERAL_5832_5F08_CHOICE_2';
During the process of <strong><span style="color: OrangeRed;">mitosis</span></strong> several processes occur that cause genetic variation among organisms
LITERAL_5832_5F08_CHOICE_2
$choice_3 = <<'LITERAL_5832_5F08_CHOICE_3';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_5832_5F08_CHOICE_3
$choice_4 = <<'LITERAL_5832_5F08_CHOICE_4';
Only sexually reproductive organisms utilize <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong>
LITERAL_5832_5F08_CHOICE_4
$choice_5 = <<'LITERAL_5832_5F08_CHOICE_5';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong> I</span></strong>I</span></strong> is the only stage where sister chromatids pair up and exchange genetic material
LITERAL_5832_5F08_CHOICE_5
$correct_1 = <<'LITERAL_5832_5F08_CORRECT_1';
Only sexually reproductive organisms utilize <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong>
LITERAL_5832_5F08_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
