## DESCRIPTION
## Imported Genetics source row 8487_1619; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8487_1619';
<p>8487_1619</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_8487_1619
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8487_1619_CHOICE_1';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> produces new cells to help organisms grow in size and repair damaged tissue
LITERAL_8487_1619_CHOICE_1
$choice_2 = <<'LITERAL_8487_1619_CHOICE_2';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> cell division are haploid
LITERAL_8487_1619_CHOICE_2
$choice_3 = <<'LITERAL_8487_1619_CHOICE_3';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> is cell division that produces four (4) daughter cells
LITERAL_8487_1619_CHOICE_3
$choice_4 = <<'LITERAL_8487_1619_CHOICE_4';
Each daughter cell formed by <strong><span style="color: MediumBlue;">meiosis</span></strong> has half the number of chromosomes as the parent cell
LITERAL_8487_1619_CHOICE_4
$choice_5 = <<'LITERAL_8487_1619_CHOICE_5';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> almost never involves crossing over of the chromosomes
LITERAL_8487_1619_CHOICE_5
$correct_1 = <<'LITERAL_8487_1619_CORRECT_1';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> cell division are haploid
LITERAL_8487_1619_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
