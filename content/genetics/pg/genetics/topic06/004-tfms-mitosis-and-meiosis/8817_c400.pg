## DESCRIPTION
## Imported Genetics source row 8817_c400; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8817_C400';
<p>8817_c400</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_8817_C400
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8817_C400_CHOICE_1';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;">mitosis</span></strong> cell division are diploid
LITERAL_8817_C400_CHOICE_1
$choice_2 = <<'LITERAL_8817_C400_CHOICE_2';
During the process of <strong><span style="color: MediumBlue;">meiosis</span></strong> several processes occur that cause genetic variation among organisms
LITERAL_8817_C400_CHOICE_2
$choice_3 = <<'LITERAL_8817_C400_CHOICE_3';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> produces new gamete cells, such as sperm and egg
LITERAL_8817_C400_CHOICE_3
$choice_4 = <<'LITERAL_8817_C400_CHOICE_4';
In <strong><span style="color: OrangeRed;">mitosis</span></strong>, the parent cell and the daughter cells are genetically identical
LITERAL_8817_C400_CHOICE_4
$choice_5 = <<'LITERAL_8817_C400_CHOICE_5';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> is a special type of cell division that produces sex cells for reproduction
LITERAL_8817_C400_CHOICE_5
$correct_1 = <<'LITERAL_8817_C400_CORRECT_1';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong></span></strong> produces new gamete cells, such as sperm and egg
LITERAL_8817_C400_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
