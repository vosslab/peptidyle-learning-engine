## DESCRIPTION
## Imported Genetics source row f953_febf; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F953_FEBF';
<p>f953_febf</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_F953_FEBF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F953_FEBF_CHOICE_1';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> occurs in two phases, that is, <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong> I</span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong> I</span></strong>I</span></strong>
LITERAL_F953_FEBF_CHOICE_1
$choice_2 = <<'LITERAL_F953_FEBF_CHOICE_2';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> goes through cytokinesis cell division once
LITERAL_F953_FEBF_CHOICE_2
$choice_3 = <<'LITERAL_F953_FEBF_CHOICE_3';
Each daughter cell formed by <strong><span style="color: OrangeRed;">mitosis</span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_F953_FEBF_CHOICE_3
$choice_4 = <<'LITERAL_F953_FEBF_CHOICE_4';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> is cell division that produces four (4) daughter cells
LITERAL_F953_FEBF_CHOICE_4
$choice_5 = <<'LITERAL_F953_FEBF_CHOICE_5';
Cross-over regularly happens in <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong>, but<strong> <strong>NOT</strong> </strong>in <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong>
LITERAL_F953_FEBF_CHOICE_5
$correct_1 = <<'LITERAL_F953_FEBF_CORRECT_1';
Cross-over regularly happens in <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong>, but<strong> <strong>NOT</strong> </strong>in <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong>
LITERAL_F953_FEBF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
