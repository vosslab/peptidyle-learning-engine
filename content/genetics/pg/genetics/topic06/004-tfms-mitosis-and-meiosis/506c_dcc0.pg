## DESCRIPTION
## Imported Genetics source row 506c_dcc0; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_506C_DCC0';
<p>506c_dcc0</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_506C_DCC0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_506C_DCC0_CHOICE_1';
Both <strong><span style="color: MediumBlue;">meiosis</span></strong> and <strong><span style="color: OrangeRed;">mitosis</span></strong> start with one cell
LITERAL_506C_DCC0_CHOICE_1
$choice_2 = <<'LITERAL_506C_DCC0_CHOICE_2';
The daughter cells produced at the end of <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> are completely different from the original parent cell
LITERAL_506C_DCC0_CHOICE_2
$choice_3 = <<'LITERAL_506C_DCC0_CHOICE_3';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> produces new gamete cells, such as sperm and egg
LITERAL_506C_DCC0_CHOICE_3
$choice_4 = <<'LITERAL_506C_DCC0_CHOICE_4';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> is a special type of cell division that produces sex cells for reproduction
LITERAL_506C_DCC0_CHOICE_4
$choice_5 = <<'LITERAL_506C_DCC0_CHOICE_5';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_506C_DCC0_CHOICE_5
$correct_1 = <<'LITERAL_506C_DCC0_CORRECT_1';
The daughter cells produced at the end of <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> are completely different from the original parent cell
LITERAL_506C_DCC0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
