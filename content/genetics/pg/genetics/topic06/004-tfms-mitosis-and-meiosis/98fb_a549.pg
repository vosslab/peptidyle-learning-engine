## DESCRIPTION
## Imported Genetics source row 98fb_a549; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_98FB_A549';
<p>98fb_a549</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_98FB_A549
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_98FB_A549_CHOICE_1';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> produces new cells to help organisms grow in size and repair damaged tissue
LITERAL_98FB_A549_CHOICE_1
$choice_2 = <<'LITERAL_98FB_A549_CHOICE_2';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> normally occurs in somatic cells of organisms and facilitates growth and development
LITERAL_98FB_A549_CHOICE_2
$choice_3 = <<'LITERAL_98FB_A549_CHOICE_3';
During the process of <strong><span style="color: MediumBlue;">meiosis</span></strong> several processes occur that cause genetic variation among organisms
LITERAL_98FB_A549_CHOICE_3
$choice_4 = <<'LITERAL_98FB_A549_CHOICE_4';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_98FB_A549_CHOICE_4
$choice_5 = <<'LITERAL_98FB_A549_CHOICE_5';
Both sexual and asexual organisms go through the process of <strong><span style="color: OrangeRed;">mitosis</span></strong>
LITERAL_98FB_A549_CHOICE_5
$correct_1 = <<'LITERAL_98FB_A549_CORRECT_1';
Each daughter cell formed by <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_98FB_A549_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
