## DESCRIPTION
## Imported Genetics source row 98fb_fca5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_98FB_FCA5';
<p>98fb_fca5</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_98FB_FCA5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_98FB_FCA5_CHOICE_1';
Both <strong><span style="color: MediumBlue;">meiosis</span></strong> and <strong><span style="color: OrangeRed;">mitosis</span></strong> start with one cell
LITERAL_98FB_FCA5_CHOICE_1
$choice_2 = <<'LITERAL_98FB_FCA5_CHOICE_2';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong></span></strong> is cell division that produces two (2) daughter cells
LITERAL_98FB_FCA5_CHOICE_2
$choice_3 = <<'LITERAL_98FB_FCA5_CHOICE_3';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> daughter cells contain half of the genetic material which is a mix of both the maternal and paternal genes
LITERAL_98FB_FCA5_CHOICE_3
$choice_4 = <<'LITERAL_98FB_FCA5_CHOICE_4';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> goes through cytokinesis cell division once
LITERAL_98FB_FCA5_CHOICE_4
$choice_5 = <<'LITERAL_98FB_FCA5_CHOICE_5';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong> I</span></strong> is the only stage where homologous chromosomes pair up and exchange genetic material
LITERAL_98FB_FCA5_CHOICE_5
$correct_1 = <<'LITERAL_98FB_FCA5_CORRECT_1';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong></span></strong> is cell division that produces two (2) daughter cells
LITERAL_98FB_FCA5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
