## DESCRIPTION
## Imported Genetics source row 1631_11c5; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1631_11C5';
<p>1631_11c5</p> <p>Which one of the following statements is<strong> <span style="color: #ba372a;"><strong>FALSE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong> cell division?</p>
PROMPT_1631_11C5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1631_11C5_CHOICE_1';
<strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">Meiosis</span></strong> I</span></strong> is the only stage where homologous chromosomes pair up and exchange genetic material
LITERAL_1631_11C5_CHOICE_1
$choice_2 = <<'LITERAL_1631_11C5_CHOICE_2';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_1631_11C5_CHOICE_2
$choice_3 = <<'LITERAL_1631_11C5_CHOICE_3';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> cell division are haploid
LITERAL_1631_11C5_CHOICE_3
$choice_4 = <<'LITERAL_1631_11C5_CHOICE_4';
Cross-over regularly happens in <strong><span style="color: MediumBlue;">meiosis</span></strong>, but<strong> <strong>NOT</strong> </strong>in <strong><span style="color: OrangeRed;">mitosis</span></strong>
LITERAL_1631_11C5_CHOICE_4
$choice_5 = <<'LITERAL_1631_11C5_CHOICE_5';
Each daughter cell formed by <strong><span style="color: MediumBlue;">meiosis</span></strong> has half the number of chromosomes as the parent cell
LITERAL_1631_11C5_CHOICE_5
$correct_1 = <<'LITERAL_1631_11C5_CORRECT_1';
In diploid organisms, the final cells resulting from <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> cell division are haploid
LITERAL_1631_11C5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
