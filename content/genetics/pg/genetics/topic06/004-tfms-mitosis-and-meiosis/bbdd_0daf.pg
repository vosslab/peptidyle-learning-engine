## DESCRIPTION
## Imported Genetics source row bbdd_0daf; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BBDD_0DAF';
<p>bbdd_0daf</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_BBDD_0DAF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BBDD_0DAF_CHOICE_1';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> goes through cytokinesis cell division once
LITERAL_BBDD_0DAF_CHOICE_1
$choice_2 = <<'LITERAL_BBDD_0DAF_CHOICE_2';
The daughter cells produced at the end of <strong><span style="color: OrangeRed;">mitosis</span></strong> are completely different from the original parent cell
LITERAL_BBDD_0DAF_CHOICE_2
$choice_3 = <<'LITERAL_BBDD_0DAF_CHOICE_3';
Each daughter cell formed by <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_BBDD_0DAF_CHOICE_3
$choice_4 = <<'LITERAL_BBDD_0DAF_CHOICE_4';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> occurs only in specialized germline cells and facilitates sexual reproduction
LITERAL_BBDD_0DAF_CHOICE_4
$choice_5 = <<'LITERAL_BBDD_0DAF_CHOICE_5';
Both sexual and asexual organisms go through the process of <strong><span style="color: MediumBlue;">meiosis</span></strong>
LITERAL_BBDD_0DAF_CHOICE_5
$correct_1 = <<'LITERAL_BBDD_0DAF_CORRECT_1';
Each daughter cell formed by <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_BBDD_0DAF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
