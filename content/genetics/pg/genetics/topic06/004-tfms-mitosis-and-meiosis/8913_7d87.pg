## DESCRIPTION
## Imported Genetics source row 8913_7d87; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-TFMS-mitosis_and_meiosis-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8913_7D87';
<p>8913_7d87</p> <p>Which one of the following statements is<strong> <span style="color: #127663;"><strong>TRUE</strong></span> </strong> regarding <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> and <strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;"><strong><span style="color: MediumBlue;">meiosis</span></strong></span></strong></span></strong></span></strong></span></strong></span></strong></span></strong> cell division?</p>
PROMPT_8913_7D87
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8913_7D87_CHOICE_1';
Each daughter cell formed by <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_8913_7D87_CHOICE_1
$choice_2 = <<'LITERAL_8913_7D87_CHOICE_2';
<strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">Mitosis</span></strong> I</span></strong> is the only stage where homologous chromosomes pair up and exchange genetic material
LITERAL_8913_7D87_CHOICE_2
$choice_3 = <<'LITERAL_8913_7D87_CHOICE_3';
<strong><span style="color: OrangeRed;">Mitosis</span></strong> is cell division that produces four (4) daughter cells
LITERAL_8913_7D87_CHOICE_3
$choice_4 = <<'LITERAL_8913_7D87_CHOICE_4';
In <strong><span style="color: MediumBlue;">meiosis</span></strong>, the parent cell and the daughter cells are genetically identical
LITERAL_8913_7D87_CHOICE_4
$choice_5 = <<'LITERAL_8913_7D87_CHOICE_5';
<strong><span style="color: MediumBlue;">Meiosis</span></strong> does<strong> <strong>NOT</strong> </strong>involve crossing over of the chromosomes
LITERAL_8913_7D87_CHOICE_5
$correct_1 = <<'LITERAL_8913_7D87_CORRECT_1';
Each daughter cell formed by <strong><span style="color: OrangeRed;"><strong><span style="color: OrangeRed;">mitosis</span></strong></span></strong> has the same kinds of chromosomes as the parent cell
LITERAL_8913_7D87_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
