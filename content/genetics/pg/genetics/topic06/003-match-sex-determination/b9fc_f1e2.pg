## DESCRIPTION
## Imported Genetics source row b9fc_f1e2; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-MATCH-sex_determination-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B9FC_F1E2';
<p>b9fc_f1e2</p> <p>Match each of the following sex determination systems with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_B9FC_F1E2
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_B9FC_F1E2_MATCH_TERM_0';
<strong><span style="color: #a719db;">Haplo-Diploid system</span></strong>
LITERAL_B9FC_F1E2_MATCH_TERM_0
$match_term_1 = <<'LITERAL_B9FC_F1E2_MATCH_TERM_1';
<strong><span style="color: #b74300;">X-Y system</span></strong>
LITERAL_B9FC_F1E2_MATCH_TERM_1
$match_term_2 = <<'LITERAL_B9FC_F1E2_MATCH_TERM_2';
<strong><span style="color: #0067cc;">Z-W system</span></strong>
LITERAL_B9FC_F1E2_MATCH_TERM_2
$match_term_3 = <<'LITERAL_B9FC_F1E2_MATCH_TERM_3';
<strong><span style="color: #3b7600;">X-O system</span></strong>
LITERAL_B9FC_F1E2_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_B9FC_F1E2_MATCH_CHOICE_0';
<strong> <span style="color: #076dad;">males &male;</span></strong> develop from unfertilized eggs and thus have no fathers
LITERAL_B9FC_F1E2_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_B9FC_F1E2_MATCH_CHOICE_1';
<strong><span style="color: #cc0066;">females &female;</span> </strong> are homogametic and <strong> <span style="color: #076dad;">males &male;</span></strong> are heterogametic
LITERAL_B9FC_F1E2_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_B9FC_F1E2_MATCH_CHOICE_2';
<strong> <span style="color: #076dad;">males &male;</span></strong> are homogametic and <strong><span style="color: #cc0066;">females &female;</span> </strong> are heterogametic
LITERAL_B9FC_F1E2_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_B9FC_F1E2_MATCH_CHOICE_3';
<strong> <span style="color: #076dad;">male &male;</span> </strong><strong><span style="color: #007576;">sperm</span></strong> normally contain either one <strong><span style="color: #00775f;">sex chromosome</span></strong> or no <strong><span style="color: #00775f;">sex&nbsp;chromosomes</span></strong> at all
LITERAL_B9FC_F1E2_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
