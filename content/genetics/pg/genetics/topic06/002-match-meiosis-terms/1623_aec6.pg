## DESCRIPTION
## Imported Genetics source row 1623_aec6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic06/bbq-MATCH-meiosis_terms-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1623_AEC6';
<p>1623_aec6</p> <p>Match each of the following Meiosis terms with their corresponding definitions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_1623_AEC6
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_1623_AEC6_MATCH_TERM_0';
<strong><span style="color: #d40000;">homologous chromosomes</span></strong>
LITERAL_1623_AEC6_MATCH_TERM_0
$match_term_1 = <<'LITERAL_1623_AEC6_MATCH_TERM_1';
crossing over
LITERAL_1623_AEC6_MATCH_TERM_1
$match_term_2 = <<'LITERAL_1623_AEC6_MATCH_TERM_2';
<strong><span style="color: #007576;">homologous</span></strong>
LITERAL_1623_AEC6_MATCH_TERM_2
$match_term_3 = <<'LITERAL_1623_AEC6_MATCH_TERM_3';
sister chromatids
LITERAL_1623_AEC6_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_1623_AEC6_MATCH_CHOICE_0';
two chromosomes containing identical genetic loci although possibly different allelic forms
LITERAL_1623_AEC6_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_1623_AEC6_MATCH_CHOICE_1';
a process by which parts of <strong><span style="color: #d40000;">homologous chromosomes</span></strong> are interchanged
LITERAL_1623_AEC6_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_1623_AEC6_MATCH_CHOICE_2';
similar in structure and evolutionary origin, though<strong> <strong>NOT</strong> </strong>necessarily in function
LITERAL_1623_AEC6_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_1623_AEC6_MATCH_CHOICE_3';
two identical chromatids that are formed by replication of a chromosome
LITERAL_1623_AEC6_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
