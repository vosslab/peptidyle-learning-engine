<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">t(15; 16), +16</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="29.6"></colgroup><colgroup width="32"></colgroup><colgroup width="92.8"></colgroup><colgroup width="56.8"></colgroup><tr><td bgcolor="crimson" style="border: 2px solid black;" align="center"><span style="font-size: large"></span></td><td bgcolor="lightsalmon" style="border: 4px solid black;" align="center">15</td><td bgcolor="crimson" style="border: 2px solid black; border-right: 1px dashed black" align="center"><span style="font-size: large"></span></td><td bgcolor="royalblue" style="border: 2px solid black; border-left: 1px dashed black" align="center"><span style="font-size: large"></span></td></tr></table></td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="72.8"></colgroup><colgroup width="32"></colgroup><colgroup width="113.6"></colgroup><tr><td bgcolor="royalblue" style="border: 2px solid black;" align="center"><span style="font-size: small"></span></td><td bgcolor="lightskyblue" style="border: 4px solid black;" align="center">16</td><td bgcolor="royalblue" style="border: 2px solid black;" align="center"><span style="font-size: large"></span></td></tr></table></td></tr></table><p></p><hr/><p></p>
