## DESCRIPTION
## Imported Genetics source row 53d2_9596; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-aneuploidy-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_53D2_9596';
<p>53d2_9596</p> In cytogenetic terms, what is meant by the human karyotype <span style="font-family: monospace; font-weight: bold; background-color: #eef3fa; padding: 2px 5px; ">47,+12,XY</span>?
PROMPT_53D2_9596
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_53D2_9596_CHOICE_1';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #994d00;">with an absent</span> chromosome 12.
LITERAL_53D2_9596_CHOICE_1
$choice_2 = <<'LITERAL_53D2_9596_CHOICE_2';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with a partial duplication of</span> chromosome 12.
LITERAL_53D2_9596_CHOICE_2
$choice_3 = <<'LITERAL_53D2_9596_CHOICE_3';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #00994d;">with an added</span> chromosome 12.
LITERAL_53D2_9596_CHOICE_3
$choice_4 = <<'LITERAL_53D2_9596_CHOICE_4';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">lacking</span> copy of chromosome 12.
LITERAL_53D2_9596_CHOICE_4
$choice_5 = <<'LITERAL_53D2_9596_CHOICE_5';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #00994d;">with an extra</span> copy of chromosome 12.
LITERAL_53D2_9596_CHOICE_5
$correct_1 = <<'LITERAL_53D2_9596_CORRECT_1';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #00994d;">with an extra</span> copy of chromosome 12.
LITERAL_53D2_9596_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
