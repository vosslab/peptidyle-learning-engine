DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D3E1_64A6';
<p>d3e1_64a6</p> What does <span style="font-family: monospace; font-weight: bold; background-color: #eef3fa; padding: 2px 5px; ">45,-12,XX</span> imply in terms of human chromosome structure?
PROMPT_D3E1_64A6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D3E1_64A6_CHOICE_1';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #4d0099;">with an extra pair of</span> chromosome 12.
LITERAL_D3E1_64A6_CHOICE_1
$choice_2 = <<'LITERAL_D3E1_64A6_CHOICE_2';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #994d00;">with an absent</span> chromosome 12.
LITERAL_D3E1_64A6_CHOICE_2
$choice_3 = <<'LITERAL_D3E1_64A6_CHOICE_3';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with a partial deletion of</span> chromosome 12.
LITERAL_D3E1_64A6_CHOICE_3
$choice_4 = <<'LITERAL_D3E1_64A6_CHOICE_4';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">with an absent</span> copy of chromosome 12.
LITERAL_D3E1_64A6_CHOICE_4
$choice_5 = <<'LITERAL_D3E1_64A6_CHOICE_5';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #00994d;">with an additional</span> chromosome 12.
LITERAL_D3E1_64A6_CHOICE_5
$correct_1 = <<'LITERAL_D3E1_64A6_CORRECT_1';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #994d00;">with an absent</span> chromosome 12.
LITERAL_D3E1_64A6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
