## DESCRIPTION
## Imported Genetics source row 3b6e_25aa; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-aneuploidy-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3B6E_25AA';
<p>3b6e_25aa</p> In the context of human karyotypes, what does <span style="font-family: monospace; font-weight: bold; background-color: #eef3fa; padding: 2px 5px; ">45,-21,XY</span> mean?
PROMPT_3B6E_25AA
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3B6E_25AA_CHOICE_1';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #4d0099;">with a partial duplication of</span> chromosome 21.
LITERAL_3B6E_25AA_CHOICE_1
$choice_2 = <<'LITERAL_3B6E_25AA_CHOICE_2';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #994d00;">with a missing</span> chromosome 21.
LITERAL_3B6E_25AA_CHOICE_2
$choice_3 = <<'LITERAL_3B6E_25AA_CHOICE_3';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with a partial duplication of</span> chromosome 21.
LITERAL_3B6E_25AA_CHOICE_3
$choice_4 = <<'LITERAL_3B6E_25AA_CHOICE_4';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">with an absent</span> copy of chromosome 21.
LITERAL_3B6E_25AA_CHOICE_4
$choice_5 = <<'LITERAL_3B6E_25AA_CHOICE_5';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with a partial deletion of</span> chromosome 21.
LITERAL_3B6E_25AA_CHOICE_5
$correct_1 = <<'LITERAL_3B6E_25AA_CORRECT_1';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">with an absent</span> copy of chromosome 21.
LITERAL_3B6E_25AA_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
