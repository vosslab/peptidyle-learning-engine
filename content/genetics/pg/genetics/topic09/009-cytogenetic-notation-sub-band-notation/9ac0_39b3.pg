## DESCRIPTION
## Imported Genetics source row 9ac0_39b3; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-sub-band_notation-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9AC0_39B3';
<p>9ac0_39b3</p> In cytogenetic notation, what does "45,-5,XY" refer to?
PROMPT_9AC0_39B3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9AC0_39B3_CHOICE_1';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #00994d;">with an added</span> chromosome 5.
LITERAL_9AC0_39B3_CHOICE_1
$choice_2 = <<'LITERAL_9AC0_39B3_CHOICE_2';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with an extra pair of</span> chromosome 5.
LITERAL_9AC0_39B3_CHOICE_2
$choice_3 = <<'LITERAL_9AC0_39B3_CHOICE_3';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #00994d;">with an extra</span> chromosome 5.
LITERAL_9AC0_39B3_CHOICE_3
$choice_4 = <<'LITERAL_9AC0_39B3_CHOICE_4';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">with a missing</span> copy of chromosome 5.
LITERAL_9AC0_39B3_CHOICE_4
$choice_5 = <<'LITERAL_9AC0_39B3_CHOICE_5';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #994d00;">with an absent</span> copy of chromosome 5.
LITERAL_9AC0_39B3_CHOICE_5
$correct_1 = <<'LITERAL_9AC0_39B3_CORRECT_1';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #994d00;">with a missing</span> copy of chromosome 5.
LITERAL_9AC0_39B3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
