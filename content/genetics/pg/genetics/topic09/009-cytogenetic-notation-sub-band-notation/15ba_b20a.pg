DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_15BA_B20A';
<p>15ba_b20a</p> In cytogenetic notation, what does "47,+9,XX" refer to?
PROMPT_15BA_B20A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_15BA_B20A_CHOICE_1';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with an extra pair of</span> chromosome 9.
LITERAL_15BA_B20A_CHOICE_1
$choice_2 = <<'LITERAL_15BA_B20A_CHOICE_2';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #4d0099;">with two extra copies of</span> chromosome 9.
LITERAL_15BA_B20A_CHOICE_2
$choice_3 = <<'LITERAL_15BA_B20A_CHOICE_3';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #4d0099;">with a partial deletion of</span> chromosome 9.
LITERAL_15BA_B20A_CHOICE_3
$choice_4 = <<'LITERAL_15BA_B20A_CHOICE_4';
This indicates a <span style="color: #004d99;">male (&male;)</span> human karyotype <span style="color: #00994d;">with an added</span> copy of chromosome 9.
LITERAL_15BA_B20A_CHOICE_4
$choice_5 = <<'LITERAL_15BA_B20A_CHOICE_5';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #00994d;">with an additional</span> copy of chromosome 9.
LITERAL_15BA_B20A_CHOICE_5
$correct_1 = <<'LITERAL_15BA_B20A_CORRECT_1';
This indicates a <span style="color: #99004d;">female (&female;)</span> human karyotype <span style="color: #00994d;">with an additional</span> copy of chromosome 9.
LITERAL_15BA_B20A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
