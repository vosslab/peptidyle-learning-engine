## DESCRIPTION
## Imported Genetics source row 15ba_b20a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-sub-band_notation-questions.txt')
