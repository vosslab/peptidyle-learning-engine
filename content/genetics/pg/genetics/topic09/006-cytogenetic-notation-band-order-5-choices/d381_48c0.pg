## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D381_48C0';
<p>d381_48c0</p> Which band is most distal (farthest from the centromere) on chromosome 16p?
PROMPT_D381_48C0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D381_48C0_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>16p35.3</span>
LITERAL_D381_48C0_CHOICE_1
$choice_2 = <<'LITERAL_D381_48C0_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>16p32</span>
LITERAL_D381_48C0_CHOICE_2
$choice_3 = <<'LITERAL_D381_48C0_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>16p21.3</span>
LITERAL_D381_48C0_CHOICE_3
$choice_4 = <<'LITERAL_D381_48C0_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>16p15.3</span>
LITERAL_D381_48C0_CHOICE_4
$choice_5 = <<'LITERAL_D381_48C0_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>16p25.1</span>
LITERAL_D381_48C0_CHOICE_5
$correct_1 = <<'LITERAL_D381_48C0_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>16p35.3</span>
LITERAL_D381_48C0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
