PROMPT_B9A7_E57E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B9A7_E57E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>1q46.3</span>
LITERAL_B9A7_E57E_CHOICE_1
$choice_2 = <<'LITERAL_B9A7_E57E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>1q39</span>
LITERAL_B9A7_E57E_CHOICE_2
$choice_3 = <<'LITERAL_B9A7_E57E_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>1q12.2</span>
LITERAL_B9A7_E57E_CHOICE_3
$choice_4 = <<'LITERAL_B9A7_E57E_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>1q27.2</span>
LITERAL_B9A7_E57E_CHOICE_4
$choice_5 = <<'LITERAL_B9A7_E57E_CHOICE_5';
