DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0F41_89A8';
<p>0f41_89a8</p> Which band is most distal (farthest from the centromere) on chromosome 12p?
PROMPT_0F41_89A8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0F41_89A8_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>12p28.3</span>
LITERAL_0F41_89A8_CHOICE_1
$choice_2 = <<'LITERAL_0F41_89A8_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>12p49.1</span>
LITERAL_0F41_89A8_CHOICE_2
$choice_3 = <<'LITERAL_0F41_89A8_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>12p36.3</span>
LITERAL_0F41_89A8_CHOICE_3
$choice_4 = <<'LITERAL_0F41_89A8_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>12p34.3</span>
LITERAL_0F41_89A8_CHOICE_4
$choice_5 = <<'LITERAL_0F41_89A8_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>12p33</span>
LITERAL_0F41_89A8_CHOICE_5
$correct_1 = <<'LITERAL_0F41_89A8_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>12p49.1</span>
LITERAL_0F41_89A8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
