DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5AAC_E09E';
<p>5aac_e09e</p> Which band is most proximal (closest to the centromere) on chromosome 22p?
PROMPT_5AAC_E09E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5AAC_E09E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>22p39.2</span>
LITERAL_5AAC_E09E_CHOICE_1
$choice_2 = <<'LITERAL_5AAC_E09E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>22p32.3</span>
LITERAL_5AAC_E09E_CHOICE_2
$choice_3 = <<'LITERAL_5AAC_E09E_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>22p46.1</span>
LITERAL_5AAC_E09E_CHOICE_3
$choice_4 = <<'LITERAL_5AAC_E09E_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>22p24.3</span>
LITERAL_5AAC_E09E_CHOICE_4
$choice_5 = <<'LITERAL_5AAC_E09E_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>22p39.1</span>
LITERAL_5AAC_E09E_CHOICE_5
$correct_1 = <<'LITERAL_5AAC_E09E_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>22p24.3</span>
LITERAL_5AAC_E09E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
