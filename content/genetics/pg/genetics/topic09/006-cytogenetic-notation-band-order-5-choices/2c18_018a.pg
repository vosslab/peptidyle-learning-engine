DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2C18_018A';
<p>2c18_018a</p> For chromosome 18q, which band lies most proximal (closest to the centromere)?
PROMPT_2C18_018A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2C18_018A_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>18q18</span>
LITERAL_2C18_018A_CHOICE_1
$choice_2 = <<'LITERAL_2C18_018A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>18q19.2</span>
LITERAL_2C18_018A_CHOICE_2
$choice_3 = <<'LITERAL_2C18_018A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>18q39.1</span>
LITERAL_2C18_018A_CHOICE_3
$choice_4 = <<'LITERAL_2C18_018A_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>18q41.3</span>
LITERAL_2C18_018A_CHOICE_4
$choice_5 = <<'LITERAL_2C18_018A_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>18q17.2</span>
LITERAL_2C18_018A_CHOICE_5
$correct_1 = <<'LITERAL_2C18_018A_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>18q17.2</span>
LITERAL_2C18_018A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
