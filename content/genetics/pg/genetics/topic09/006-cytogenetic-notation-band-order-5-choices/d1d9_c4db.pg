DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D1D9_C4DB';
<p>d1d9_c4db</p> On chromosome 6p, which band is most distal (farthest from the centromere)?
PROMPT_D1D9_C4DB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D1D9_C4DB_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>6p47.1</span>
LITERAL_D1D9_C4DB_CHOICE_1
$choice_2 = <<'LITERAL_D1D9_C4DB_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>6p22</span>
LITERAL_D1D9_C4DB_CHOICE_2
$choice_3 = <<'LITERAL_D1D9_C4DB_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>6p44.3</span>
LITERAL_D1D9_C4DB_CHOICE_3
$choice_4 = <<'LITERAL_D1D9_C4DB_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>6p18</span>
LITERAL_D1D9_C4DB_CHOICE_4
$choice_5 = <<'LITERAL_D1D9_C4DB_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>6p31.3</span>
LITERAL_D1D9_C4DB_CHOICE_5
$correct_1 = <<'LITERAL_D1D9_C4DB_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>6p47.1</span>
LITERAL_D1D9_C4DB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
