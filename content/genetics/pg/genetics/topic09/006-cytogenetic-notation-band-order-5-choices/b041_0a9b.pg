DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B041_0A9B';
<p>b041_0a9b</p> On chromosome 5p, which band is most proximal (closest to the centromere)?
PROMPT_B041_0A9B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B041_0A9B_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>5p21.2</span>
LITERAL_B041_0A9B_CHOICE_1
$choice_2 = <<'LITERAL_B041_0A9B_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>5p42.3</span>
LITERAL_B041_0A9B_CHOICE_2
$choice_3 = <<'LITERAL_B041_0A9B_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>5p24.1</span>
LITERAL_B041_0A9B_CHOICE_3
$choice_4 = <<'LITERAL_B041_0A9B_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>5p19</span>
LITERAL_B041_0A9B_CHOICE_4
$choice_5 = <<'LITERAL_B041_0A9B_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>5p22.1</span>
LITERAL_B041_0A9B_CHOICE_5
$correct_1 = <<'LITERAL_B041_0A9B_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>5p19</span>
LITERAL_B041_0A9B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
