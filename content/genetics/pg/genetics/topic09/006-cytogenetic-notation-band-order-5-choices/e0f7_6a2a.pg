LITERAL_E0F7_6A2A_CHOICE_1
$choice_2 = <<'LITERAL_E0F7_6A2A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11p42.2</span>
LITERAL_E0F7_6A2A_CHOICE_2
$choice_3 = <<'LITERAL_E0F7_6A2A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11p12.1</span>
LITERAL_E0F7_6A2A_CHOICE_3
