DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8046_47C1';
<p>8046_47c1</p> On chromosome 5q, which band is most distal (farthest from the centromere)?
PROMPT_8046_47C1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8046_47C1_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>5q47</span>
LITERAL_8046_47C1_CHOICE_1
$choice_2 = <<'LITERAL_8046_47C1_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>5q14.2</span>
LITERAL_8046_47C1_CHOICE_2
$choice_3 = <<'LITERAL_8046_47C1_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>5q23.3</span>
LITERAL_8046_47C1_CHOICE_3
$choice_4 = <<'LITERAL_8046_47C1_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>5q18.1</span>
LITERAL_8046_47C1_CHOICE_4
$choice_5 = <<'LITERAL_8046_47C1_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>5q22.3</span>
LITERAL_8046_47C1_CHOICE_5
$correct_1 = <<'LITERAL_8046_47C1_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>5q47</span>
LITERAL_8046_47C1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
