DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_699D_95A6';
<p>699d_95a6</p> Which band is most proximal (closest to the centromere) on chromosome 22q?
PROMPT_699D_95A6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_699D_95A6_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>22q19.1</span>
LITERAL_699D_95A6_CHOICE_1
$choice_2 = <<'LITERAL_699D_95A6_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>22q48.3</span>
LITERAL_699D_95A6_CHOICE_2
$choice_3 = <<'LITERAL_699D_95A6_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>22q26.3</span>
LITERAL_699D_95A6_CHOICE_3
$choice_4 = <<'LITERAL_699D_95A6_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>22q36</span>
LITERAL_699D_95A6_CHOICE_4
$choice_5 = <<'LITERAL_699D_95A6_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>22q17.2</span>
LITERAL_699D_95A6_CHOICE_5
$correct_1 = <<'LITERAL_699D_95A6_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>22q17.2</span>
LITERAL_699D_95A6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
