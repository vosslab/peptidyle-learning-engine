DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9F70_F567';
<p>9f70_f567</p> For chromosome 1p, which band lies most distal (farthest from the centromere)?
PROMPT_9F70_F567
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9F70_F567_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>1p32</span>
LITERAL_9F70_F567_CHOICE_1
$choice_2 = <<'LITERAL_9F70_F567_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>1p45.3</span>
LITERAL_9F70_F567_CHOICE_2
$choice_3 = <<'LITERAL_9F70_F567_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>1p11.2</span>
LITERAL_9F70_F567_CHOICE_3
$choice_4 = <<'LITERAL_9F70_F567_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>1p14.3</span>
LITERAL_9F70_F567_CHOICE_4
$choice_5 = <<'LITERAL_9F70_F567_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>1p14</span>
LITERAL_9F70_F567_CHOICE_5
$correct_1 = <<'LITERAL_9F70_F567_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>1p45.3</span>
LITERAL_9F70_F567_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
