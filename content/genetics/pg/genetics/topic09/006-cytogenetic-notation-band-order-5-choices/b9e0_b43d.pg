DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B9E0_B43D';
<p>b9e0_b43d</p> Which band is most distal (farthest from the centromere) on chromosome 15q?
PROMPT_B9E0_B43D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B9E0_B43D_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>15q26</span>
LITERAL_B9E0_B43D_CHOICE_1
$choice_2 = <<'LITERAL_B9E0_B43D_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>15q25.3</span>
LITERAL_B9E0_B43D_CHOICE_2
$choice_3 = <<'LITERAL_B9E0_B43D_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>15q43.2</span>
LITERAL_B9E0_B43D_CHOICE_3
$choice_4 = <<'LITERAL_B9E0_B43D_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>15q15</span>
LITERAL_B9E0_B43D_CHOICE_4
$choice_5 = <<'LITERAL_B9E0_B43D_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>15q13</span>
LITERAL_B9E0_B43D_CHOICE_5
$correct_1 = <<'LITERAL_B9E0_B43D_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>15q43.2</span>
LITERAL_B9E0_B43D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
