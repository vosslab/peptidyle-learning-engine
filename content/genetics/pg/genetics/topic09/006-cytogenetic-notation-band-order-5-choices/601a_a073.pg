DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_601A_A073';
<p>601a_a073</p> For chromosome 2p, which band lies most proximal (closest to the centromere)?
PROMPT_601A_A073
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_601A_A073_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>2p21.3</span>
LITERAL_601A_A073_CHOICE_1
$choice_2 = <<'LITERAL_601A_A073_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>2p22.1</span>
LITERAL_601A_A073_CHOICE_2
$choice_3 = <<'LITERAL_601A_A073_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>2p39.2</span>
LITERAL_601A_A073_CHOICE_3
$choice_4 = <<'LITERAL_601A_A073_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>2p32.2</span>
LITERAL_601A_A073_CHOICE_4
$choice_5 = <<'LITERAL_601A_A073_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>2p13</span>
LITERAL_601A_A073_CHOICE_5
$correct_1 = <<'LITERAL_601A_A073_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>2p13</span>
LITERAL_601A_A073_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
