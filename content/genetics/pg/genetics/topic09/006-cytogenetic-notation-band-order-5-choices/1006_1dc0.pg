DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1006_1DC0';
<p>1006_1dc0</p> Which band is most distal (farthest from the centromere) on chromosome 9q?
PROMPT_1006_1DC0
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1006_1DC0_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>9q21.2</span>
LITERAL_1006_1DC0_CHOICE_1
$choice_2 = <<'LITERAL_1006_1DC0_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>9q39.1</span>
LITERAL_1006_1DC0_CHOICE_2
$choice_3 = <<'LITERAL_1006_1DC0_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>9q41</span>
LITERAL_1006_1DC0_CHOICE_3
$choice_4 = <<'LITERAL_1006_1DC0_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>9q45.2</span>
LITERAL_1006_1DC0_CHOICE_4
$choice_5 = <<'LITERAL_1006_1DC0_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>9q36.3</span>
LITERAL_1006_1DC0_CHOICE_5
$correct_1 = <<'LITERAL_1006_1DC0_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>9q45.2</span>
LITERAL_1006_1DC0_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
