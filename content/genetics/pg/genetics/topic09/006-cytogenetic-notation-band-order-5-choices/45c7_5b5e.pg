PROMPT_45C7_5B5E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_45C7_5B5E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>3q43.1</span>
LITERAL_45C7_5B5E_CHOICE_1
$choice_2 = <<'LITERAL_45C7_5B5E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>3q39</span>
LITERAL_45C7_5B5E_CHOICE_2
