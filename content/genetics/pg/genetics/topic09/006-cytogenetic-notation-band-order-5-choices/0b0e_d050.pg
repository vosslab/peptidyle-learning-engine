## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0B0E_D050';
<p>0b0e_d050</p> On chromosome 4p, which band is most proximal (closest to the centromere)?
PROMPT_0B0E_D050
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0B0E_D050_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>4p45.2</span>
LITERAL_0B0E_D050_CHOICE_1
$choice_2 = <<'LITERAL_0B0E_D050_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>4p35</span>
LITERAL_0B0E_D050_CHOICE_2
$choice_3 = <<'LITERAL_0B0E_D050_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>4p42</span>
LITERAL_0B0E_D050_CHOICE_3
$choice_4 = <<'LITERAL_0B0E_D050_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>4p13.3</span>
LITERAL_0B0E_D050_CHOICE_4
$choice_5 = <<'LITERAL_0B0E_D050_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>4p47</span>
LITERAL_0B0E_D050_CHOICE_5
$correct_1 = <<'LITERAL_0B0E_D050_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>4p13.3</span>
LITERAL_0B0E_D050_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
