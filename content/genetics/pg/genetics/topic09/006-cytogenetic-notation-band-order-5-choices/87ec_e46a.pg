DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_87EC_E46A';
<p>87ec_e46a</p> On chromosome 17p, which band is most distal (farthest from the centromere)?
PROMPT_87EC_E46A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_87EC_E46A_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>17p29.3</span>
LITERAL_87EC_E46A_CHOICE_1
$choice_2 = <<'LITERAL_87EC_E46A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>17p21.2</span>
LITERAL_87EC_E46A_CHOICE_2
$choice_3 = <<'LITERAL_87EC_E46A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>17p42.1</span>
LITERAL_87EC_E46A_CHOICE_3
$choice_4 = <<'LITERAL_87EC_E46A_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>17p24.3</span>
LITERAL_87EC_E46A_CHOICE_4
$choice_5 = <<'LITERAL_87EC_E46A_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>17p26.2</span>
LITERAL_87EC_E46A_CHOICE_5
$correct_1 = <<'LITERAL_87EC_E46A_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>17p42.1</span>
LITERAL_87EC_E46A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
