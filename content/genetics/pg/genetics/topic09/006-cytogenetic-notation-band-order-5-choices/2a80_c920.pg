## DESCRIPTION
## Imported Genetics source row 2a80_c920; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2A80_C920';
<p>2a80_c920</p> Which band is most proximal (closest to the centromere) on chromosome 17p?
PROMPT_2A80_C920
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2A80_C920_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>17p42.3</span>
LITERAL_2A80_C920_CHOICE_1
$choice_2 = <<'LITERAL_2A80_C920_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>17p16</span>
LITERAL_2A80_C920_CHOICE_2
$choice_3 = <<'LITERAL_2A80_C920_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>17p14.1</span>
LITERAL_2A80_C920_CHOICE_3
$choice_4 = <<'LITERAL_2A80_C920_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>17p36.3</span>
LITERAL_2A80_C920_CHOICE_4
$choice_5 = <<'LITERAL_2A80_C920_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>17p35.3</span>
LITERAL_2A80_C920_CHOICE_5
$correct_1 = <<'LITERAL_2A80_C920_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>17p14.1</span>
LITERAL_2A80_C920_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
