DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5A64_64C5';
<p>5a64_64c5</p> On chromosome 11p, which band is most proximal (closest to the centromere)?
PROMPT_5A64_64C5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5A64_64C5_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>11p26.3</span>
LITERAL_5A64_64C5_CHOICE_1
$choice_2 = <<'LITERAL_5A64_64C5_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11p27.3</span>
LITERAL_5A64_64C5_CHOICE_2
$choice_3 = <<'LITERAL_5A64_64C5_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11p46.3</span>
LITERAL_5A64_64C5_CHOICE_3
$choice_4 = <<'LITERAL_5A64_64C5_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>11p22.2</span>
LITERAL_5A64_64C5_CHOICE_4
$choice_5 = <<'LITERAL_5A64_64C5_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>11p42.1</span>
LITERAL_5A64_64C5_CHOICE_5
$correct_1 = <<'LITERAL_5A64_64C5_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>11p22.2</span>
LITERAL_5A64_64C5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
