DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9BB1_4A14';
<p>9bb1_4a14</p> Which band is most proximal (closest to the centromere) on chromosome Yq?
PROMPT_9BB1_4A14
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9BB1_4A14_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>Yq31.1</span>
LITERAL_9BB1_4A14_CHOICE_1
$choice_2 = <<'LITERAL_9BB1_4A14_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>Yq21.2</span>
LITERAL_9BB1_4A14_CHOICE_2
$choice_3 = <<'LITERAL_9BB1_4A14_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>Yq42.1</span>
LITERAL_9BB1_4A14_CHOICE_3
$choice_4 = <<'LITERAL_9BB1_4A14_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>Yq42.3</span>
LITERAL_9BB1_4A14_CHOICE_4
$choice_5 = <<'LITERAL_9BB1_4A14_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>Yq46.3</span>
LITERAL_9BB1_4A14_CHOICE_5
$correct_1 = <<'LITERAL_9BB1_4A14_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>Yq21.2</span>
LITERAL_9BB1_4A14_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
