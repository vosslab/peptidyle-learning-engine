DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_68B0_36BD';
<p>68b0_36bd</p> For chromosome 8q, which band lies most distal (farthest from the centromere)?
PROMPT_68B0_36BD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_68B0_36BD_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>8q25.1</span>
LITERAL_68B0_36BD_CHOICE_1
$choice_2 = <<'LITERAL_68B0_36BD_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>8q34.1</span>
LITERAL_68B0_36BD_CHOICE_2
$choice_3 = <<'LITERAL_68B0_36BD_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>8q12.3</span>
LITERAL_68B0_36BD_CHOICE_3
$choice_4 = <<'LITERAL_68B0_36BD_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>8q15.2</span>
LITERAL_68B0_36BD_CHOICE_4
$choice_5 = <<'LITERAL_68B0_36BD_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>8q41.2</span>
LITERAL_68B0_36BD_CHOICE_5
$correct_1 = <<'LITERAL_68B0_36BD_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>8q41.2</span>
LITERAL_68B0_36BD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
