DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C31A_45F3';
<p>c31a_45f3</p> Which band is most proximal (closest to the centromere) on chromosome 2p?
PROMPT_C31A_45F3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C31A_45F3_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>2p46.3</span>
LITERAL_C31A_45F3_CHOICE_1
$choice_2 = <<'LITERAL_C31A_45F3_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>2p26.2</span>
LITERAL_C31A_45F3_CHOICE_2
$choice_3 = <<'LITERAL_C31A_45F3_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>2p32.1</span>
LITERAL_C31A_45F3_CHOICE_3
$choice_4 = <<'LITERAL_C31A_45F3_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>2p17</span>
LITERAL_C31A_45F3_CHOICE_4
$choice_5 = <<'LITERAL_C31A_45F3_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>2p25.2</span>
LITERAL_C31A_45F3_CHOICE_5
$correct_1 = <<'LITERAL_C31A_45F3_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>2p17</span>
LITERAL_C31A_45F3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
