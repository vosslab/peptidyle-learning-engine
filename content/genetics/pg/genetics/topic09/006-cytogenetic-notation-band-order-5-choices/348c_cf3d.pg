## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_348C_CF3D';
<p>348c_cf3d</p> On chromosome 15p, which band is most distal (farthest from the centromere)?
PROMPT_348C_CF3D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_348C_CF3D_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>15p39</span>
LITERAL_348C_CF3D_CHOICE_1
$choice_2 = <<'LITERAL_348C_CF3D_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>15p44.1</span>
LITERAL_348C_CF3D_CHOICE_2
$choice_3 = <<'LITERAL_348C_CF3D_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>15p41.2</span>
LITERAL_348C_CF3D_CHOICE_3
$choice_4 = <<'LITERAL_348C_CF3D_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>15p11.1</span>
LITERAL_348C_CF3D_CHOICE_4
$choice_5 = <<'LITERAL_348C_CF3D_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>15p13.1</span>
LITERAL_348C_CF3D_CHOICE_5
$correct_1 = <<'LITERAL_348C_CF3D_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>15p44.1</span>
LITERAL_348C_CF3D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
