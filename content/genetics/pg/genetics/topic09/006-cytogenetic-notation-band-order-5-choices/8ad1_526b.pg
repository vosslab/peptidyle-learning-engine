DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8AD1_526B';
<p>8ad1_526b</p> Which band is most distal (farthest from the centromere) on chromosome 15p?
PROMPT_8AD1_526B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8AD1_526B_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>15p12.2</span>
LITERAL_8AD1_526B_CHOICE_1
$choice_2 = <<'LITERAL_8AD1_526B_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>15p22</span>
LITERAL_8AD1_526B_CHOICE_2
$choice_3 = <<'LITERAL_8AD1_526B_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>15p17.3</span>
LITERAL_8AD1_526B_CHOICE_3
$choice_4 = <<'LITERAL_8AD1_526B_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>15p25.3</span>
LITERAL_8AD1_526B_CHOICE_4
$choice_5 = <<'LITERAL_8AD1_526B_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>15p38.2</span>
LITERAL_8AD1_526B_CHOICE_5
$correct_1 = <<'LITERAL_8AD1_526B_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>15p38.2</span>
LITERAL_8AD1_526B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
