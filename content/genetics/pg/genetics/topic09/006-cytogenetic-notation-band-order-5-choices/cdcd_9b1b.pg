## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CDCD_9B1B';
<p>cdcd_9b1b</p> Which band is most distal (farthest from the centromere) on chromosome 21p?
PROMPT_CDCD_9B1B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CDCD_9B1B_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>21p39.2</span>
LITERAL_CDCD_9B1B_CHOICE_1
$choice_2 = <<'LITERAL_CDCD_9B1B_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>21p33.2</span>
LITERAL_CDCD_9B1B_CHOICE_2
$choice_3 = <<'LITERAL_CDCD_9B1B_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>21p12.3</span>
LITERAL_CDCD_9B1B_CHOICE_3
$choice_4 = <<'LITERAL_CDCD_9B1B_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>21p37</span>
LITERAL_CDCD_9B1B_CHOICE_4
$choice_5 = <<'LITERAL_CDCD_9B1B_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>21p38</span>
LITERAL_CDCD_9B1B_CHOICE_5
$correct_1 = <<'LITERAL_CDCD_9B1B_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>21p39.2</span>
LITERAL_CDCD_9B1B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
