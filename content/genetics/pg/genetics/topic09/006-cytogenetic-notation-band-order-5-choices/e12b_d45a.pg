DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E12B_D45A';
<p>e12b_d45a</p> On chromosome 10p, which band is most proximal (closest to the centromere)?
PROMPT_E12B_D45A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E12B_D45A_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>10p36.2</span>
LITERAL_E12B_D45A_CHOICE_1
$choice_2 = <<'LITERAL_E12B_D45A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>10p34.2</span>
LITERAL_E12B_D45A_CHOICE_2
$choice_3 = <<'LITERAL_E12B_D45A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>10p38.3</span>
LITERAL_E12B_D45A_CHOICE_3
$choice_4 = <<'LITERAL_E12B_D45A_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>10p19</span>
LITERAL_E12B_D45A_CHOICE_4
$choice_5 = <<'LITERAL_E12B_D45A_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>10p45</span>
LITERAL_E12B_D45A_CHOICE_5
$correct_1 = <<'LITERAL_E12B_D45A_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>10p19</span>
LITERAL_E12B_D45A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
