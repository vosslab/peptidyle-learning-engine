## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C81A_42AC';
<p>c81a_42ac</p> On chromosome 22q, which band is most proximal (closest to the centromere)?
PROMPT_C81A_42AC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C81A_42AC_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>22q42.2</span>
LITERAL_C81A_42AC_CHOICE_1
$choice_2 = <<'LITERAL_C81A_42AC_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>22q22.3</span>
LITERAL_C81A_42AC_CHOICE_2
$choice_3 = <<'LITERAL_C81A_42AC_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>22q11.2</span>
LITERAL_C81A_42AC_CHOICE_3
$choice_4 = <<'LITERAL_C81A_42AC_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>22q49.2</span>
LITERAL_C81A_42AC_CHOICE_4
$choice_5 = <<'LITERAL_C81A_42AC_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>22q35.3</span>
LITERAL_C81A_42AC_CHOICE_5
$correct_1 = <<'LITERAL_C81A_42AC_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>22q11.2</span>
LITERAL_C81A_42AC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
