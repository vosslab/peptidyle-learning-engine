DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B8A0_E97A';
<p>b8a0_e97a</p> For chromosome 4q, which band lies most distal (farthest from the centromere)?
PROMPT_B8A0_E97A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B8A0_E97A_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>4q28.1</span>
LITERAL_B8A0_E97A_CHOICE_1
$choice_2 = <<'LITERAL_B8A0_E97A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>4q22.1</span>
LITERAL_B8A0_E97A_CHOICE_2
$choice_3 = <<'LITERAL_B8A0_E97A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>4q21.3</span>
LITERAL_B8A0_E97A_CHOICE_3
$choice_4 = <<'LITERAL_B8A0_E97A_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>4q27.3</span>
LITERAL_B8A0_E97A_CHOICE_4
$choice_5 = <<'LITERAL_B8A0_E97A_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>4q43</span>
LITERAL_B8A0_E97A_CHOICE_5
