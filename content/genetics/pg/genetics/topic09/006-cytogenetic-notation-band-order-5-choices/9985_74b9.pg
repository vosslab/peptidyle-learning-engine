DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9985_74B9';
<p>9985_74b9</p> On chromosome 13q, which band is most proximal (closest to the centromere)?
PROMPT_9985_74B9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9985_74B9_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>13q37</span>
LITERAL_9985_74B9_CHOICE_1
$choice_2 = <<'LITERAL_9985_74B9_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>13q33</span>
LITERAL_9985_74B9_CHOICE_2
$choice_3 = <<'LITERAL_9985_74B9_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>13q32</span>
LITERAL_9985_74B9_CHOICE_3
$choice_4 = <<'LITERAL_9985_74B9_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>13q38.2</span>
LITERAL_9985_74B9_CHOICE_4
$choice_5 = <<'LITERAL_9985_74B9_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>13q22</span>
LITERAL_9985_74B9_CHOICE_5
$correct_1 = <<'LITERAL_9985_74B9_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>13q22</span>
LITERAL_9985_74B9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

