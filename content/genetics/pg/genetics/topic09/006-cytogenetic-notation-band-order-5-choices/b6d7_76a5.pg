DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B6D7_76A5';
<p>b6d7_76a5</p> For chromosome 20p, which band lies most distal (farthest from the centromere)?
PROMPT_B6D7_76A5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B6D7_76A5_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>20p12</span>
LITERAL_B6D7_76A5_CHOICE_1
$choice_2 = <<'LITERAL_B6D7_76A5_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>20p17.2</span>
LITERAL_B6D7_76A5_CHOICE_2
$choice_3 = <<'LITERAL_B6D7_76A5_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>20p25.3</span>
LITERAL_B6D7_76A5_CHOICE_3
$choice_4 = <<'LITERAL_B6D7_76A5_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>20p42</span>
LITERAL_B6D7_76A5_CHOICE_4
$choice_5 = <<'LITERAL_B6D7_76A5_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>20p16.3</span>
LITERAL_B6D7_76A5_CHOICE_5
