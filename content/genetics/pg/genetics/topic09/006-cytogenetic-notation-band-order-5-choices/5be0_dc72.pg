DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5BE0_DC72';
<p>5be0_dc72</p> For chromosome 18p, which band lies most distal (farthest from the centromere)?
PROMPT_5BE0_DC72
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5BE0_DC72_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>18p37.3</span>
LITERAL_5BE0_DC72_CHOICE_1
$choice_2 = <<'LITERAL_5BE0_DC72_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>18p17.3</span>
LITERAL_5BE0_DC72_CHOICE_2
$choice_3 = <<'LITERAL_5BE0_DC72_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>18p48.2</span>
LITERAL_5BE0_DC72_CHOICE_3
$choice_4 = <<'LITERAL_5BE0_DC72_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>18p37</span>
LITERAL_5BE0_DC72_CHOICE_4
$choice_5 = <<'LITERAL_5BE0_DC72_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>18p31</span>
LITERAL_5BE0_DC72_CHOICE_5
$correct_1 = <<'LITERAL_5BE0_DC72_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>18p48.2</span>
LITERAL_5BE0_DC72_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
