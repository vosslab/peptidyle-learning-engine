DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_97B9_1A52';
<p>97b9_1a52</p> On chromosome 20p, which band is most distal (farthest from the centromere)?
PROMPT_97B9_1A52
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_97B9_1A52_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>20p26.3</span>
LITERAL_97B9_1A52_CHOICE_1
$choice_2 = <<'LITERAL_97B9_1A52_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>20p31</span>
LITERAL_97B9_1A52_CHOICE_2
$choice_3 = <<'LITERAL_97B9_1A52_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>20p16.1</span>
LITERAL_97B9_1A52_CHOICE_3
$choice_4 = <<'LITERAL_97B9_1A52_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>20p21</span>
LITERAL_97B9_1A52_CHOICE_4
$choice_5 = <<'LITERAL_97B9_1A52_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>20p29.1</span>
LITERAL_97B9_1A52_CHOICE_5
