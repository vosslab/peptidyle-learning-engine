DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2736_6242';
<p>2736_6242</p> Which band is most distal (farthest from the centromere) on chromosome 8q?
PROMPT_2736_6242
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2736_6242_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>8q18.3</span>
LITERAL_2736_6242_CHOICE_1
$choice_2 = <<'LITERAL_2736_6242_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>8q34.1</span>
LITERAL_2736_6242_CHOICE_2
$choice_3 = <<'LITERAL_2736_6242_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>8q38.1</span>
LITERAL_2736_6242_CHOICE_3
$choice_4 = <<'LITERAL_2736_6242_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>8q12.3</span>
LITERAL_2736_6242_CHOICE_4
$choice_5 = <<'LITERAL_2736_6242_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>8q15.2</span>
LITERAL_2736_6242_CHOICE_5
$correct_1 = <<'LITERAL_2736_6242_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>8q38.1</span>
LITERAL_2736_6242_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
