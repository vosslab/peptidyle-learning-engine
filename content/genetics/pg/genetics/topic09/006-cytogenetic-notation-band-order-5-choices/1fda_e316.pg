DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1FDA_E316';
<p>1fda_e316</p> Which band is most proximal (closest to the centromere) on chromosome 6p?
PROMPT_1FDA_E316
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1FDA_E316_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>6p23.2</span>
LITERAL_1FDA_E316_CHOICE_1
$choice_2 = <<'LITERAL_1FDA_E316_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>6p41.2</span>
LITERAL_1FDA_E316_CHOICE_2
$choice_3 = <<'LITERAL_1FDA_E316_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>6p35.1</span>
LITERAL_1FDA_E316_CHOICE_3
$choice_4 = <<'LITERAL_1FDA_E316_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>6p43.1</span>
LITERAL_1FDA_E316_CHOICE_4
$choice_5 = <<'LITERAL_1FDA_E316_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>6p27.1</span>
LITERAL_1FDA_E316_CHOICE_5
$correct_1 = <<'LITERAL_1FDA_E316_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>6p23.2</span>
LITERAL_1FDA_E316_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
