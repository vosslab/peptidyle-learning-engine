DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E0B0_0FF3';
<p>e0b0_0ff3</p> Which band is most distal (farthest from the centromere) on chromosome 16q?
PROMPT_E0B0_0FF3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E0B0_0FF3_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>16q23.1</span>
LITERAL_E0B0_0FF3_CHOICE_1
$choice_2 = <<'LITERAL_E0B0_0FF3_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>16q47.2</span>
LITERAL_E0B0_0FF3_CHOICE_2
$choice_3 = <<'LITERAL_E0B0_0FF3_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>16q17</span>
LITERAL_E0B0_0FF3_CHOICE_3
$choice_4 = <<'LITERAL_E0B0_0FF3_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>16q22.1</span>
LITERAL_E0B0_0FF3_CHOICE_4
$choice_5 = <<'LITERAL_E0B0_0FF3_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>16q35.2</span>
LITERAL_E0B0_0FF3_CHOICE_5
$correct_1 = <<'LITERAL_E0B0_0FF3_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>16q47.2</span>
LITERAL_E0B0_0FF3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
