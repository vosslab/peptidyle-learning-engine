DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_71BA_ADDE';
<p>71ba_adde</p> Which band is most proximal (closest to the centromere) on chromosome 4p?
PROMPT_71BA_ADDE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_71BA_ADDE_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>4p11.1</span>
LITERAL_71BA_ADDE_CHOICE_1
$choice_2 = <<'LITERAL_71BA_ADDE_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>4p41.3</span>
LITERAL_71BA_ADDE_CHOICE_2
$choice_3 = <<'LITERAL_71BA_ADDE_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>4p31.2</span>
LITERAL_71BA_ADDE_CHOICE_3
$choice_4 = <<'LITERAL_71BA_ADDE_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>4p34.3</span>
LITERAL_71BA_ADDE_CHOICE_4
$choice_5 = <<'LITERAL_71BA_ADDE_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>4p47.2</span>
LITERAL_71BA_ADDE_CHOICE_5
$correct_1 = <<'LITERAL_71BA_ADDE_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>4p11.1</span>
LITERAL_71BA_ADDE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
