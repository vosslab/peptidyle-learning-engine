DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F99A_3DC9';
<p>f99a_3dc9</p> On chromosome 8p, which band is most distal (farthest from the centromere)?
PROMPT_F99A_3DC9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F99A_3DC9_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>8p37.2</span>
LITERAL_F99A_3DC9_CHOICE_1
$choice_2 = <<'LITERAL_F99A_3DC9_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>8p34.1</span>
LITERAL_F99A_3DC9_CHOICE_2
$choice_3 = <<'LITERAL_F99A_3DC9_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>8p23.2</span>
LITERAL_F99A_3DC9_CHOICE_3
$choice_4 = <<'LITERAL_F99A_3DC9_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>8p25.2</span>
LITERAL_F99A_3DC9_CHOICE_4
$choice_5 = <<'LITERAL_F99A_3DC9_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>8p26</span>
LITERAL_F99A_3DC9_CHOICE_5
$correct_1 = <<'LITERAL_F99A_3DC9_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>8p37.2</span>
LITERAL_F99A_3DC9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
