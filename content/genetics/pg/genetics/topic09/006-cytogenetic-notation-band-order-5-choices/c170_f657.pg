## DESCRIPTION
## Imported Genetics source row c170_f657; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C170_F657';
<p>c170_f657</p> Which band is most proximal (closest to the centromere) on chromosome 12p?
PROMPT_C170_F657
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C170_F657_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>12p21.1</span>
LITERAL_C170_F657_CHOICE_1
$choice_2 = <<'LITERAL_C170_F657_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>12p47</span>
LITERAL_C170_F657_CHOICE_2
$choice_3 = <<'LITERAL_C170_F657_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>12p13</span>
LITERAL_C170_F657_CHOICE_3
$choice_4 = <<'LITERAL_C170_F657_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>12p32.2</span>
LITERAL_C170_F657_CHOICE_4
$choice_5 = <<'LITERAL_C170_F657_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>12p34.1</span>
LITERAL_C170_F657_CHOICE_5
$correct_1 = <<'LITERAL_C170_F657_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>12p13</span>
LITERAL_C170_F657_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
