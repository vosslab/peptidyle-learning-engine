DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2C55_EE5A';
<p>2c55_ee5a</p> On chromosome 14p, which band is most proximal (closest to the centromere)?
PROMPT_2C55_EE5A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2C55_EE5A_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>14p41.2</span>
LITERAL_2C55_EE5A_CHOICE_1
$choice_2 = <<'LITERAL_2C55_EE5A_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>14p49</span>
LITERAL_2C55_EE5A_CHOICE_2
$choice_3 = <<'LITERAL_2C55_EE5A_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>14p15.3</span>
LITERAL_2C55_EE5A_CHOICE_3
$choice_4 = <<'LITERAL_2C55_EE5A_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>14p24.1</span>
LITERAL_2C55_EE5A_CHOICE_4
$choice_5 = <<'LITERAL_2C55_EE5A_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>14p36.1</span>
LITERAL_2C55_EE5A_CHOICE_5
$correct_1 = <<'LITERAL_2C55_EE5A_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>14p15.3</span>
LITERAL_2C55_EE5A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
