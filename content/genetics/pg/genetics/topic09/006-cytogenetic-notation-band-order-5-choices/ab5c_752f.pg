DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AB5C_752F';
<p>ab5c_752f</p> For chromosome 5q, which band lies most distal (farthest from the centromere)?
PROMPT_AB5C_752F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AB5C_752F_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>5q22.2</span>
LITERAL_AB5C_752F_CHOICE_1
$choice_2 = <<'LITERAL_AB5C_752F_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>5q32.3</span>
LITERAL_AB5C_752F_CHOICE_2
$choice_3 = <<'LITERAL_AB5C_752F_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>5q14</span>
LITERAL_AB5C_752F_CHOICE_3
$choice_4 = <<'LITERAL_AB5C_752F_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>5q18.1</span>
LITERAL_AB5C_752F_CHOICE_4
$choice_5 = <<'LITERAL_AB5C_752F_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>5q21.1</span>
LITERAL_AB5C_752F_CHOICE_5
$correct_1 = <<'LITERAL_AB5C_752F_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>5q32.3</span>
LITERAL_AB5C_752F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
