DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A0CF_AAAE';
<p>a0cf_aaae</p> On chromosome 2p, which band is most proximal (closest to the centromere)?
PROMPT_A0CF_AAAE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A0CF_AAAE_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>2p39.2</span>
LITERAL_A0CF_AAAE_CHOICE_1
$choice_2 = <<'LITERAL_A0CF_AAAE_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>2p46.2</span>
LITERAL_A0CF_AAAE_CHOICE_2
$choice_3 = <<'LITERAL_A0CF_AAAE_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>2p22.2</span>
LITERAL_A0CF_AAAE_CHOICE_3
$choice_4 = <<'LITERAL_A0CF_AAAE_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>2p12.2</span>
LITERAL_A0CF_AAAE_CHOICE_4
$choice_5 = <<'LITERAL_A0CF_AAAE_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>2p38.2</span>
LITERAL_A0CF_AAAE_CHOICE_5
$correct_1 = <<'LITERAL_A0CF_AAAE_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>2p12.2</span>
LITERAL_A0CF_AAAE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
