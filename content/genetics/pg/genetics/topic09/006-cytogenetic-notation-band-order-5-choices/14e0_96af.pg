DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_14E0_96AF';
<p>14e0_96af</p> On chromosome 19q, which band is most distal (farthest from the centromere)?
PROMPT_14E0_96AF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_14E0_96AF_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>19q45.1</span>
LITERAL_14E0_96AF_CHOICE_1
$choice_2 = <<'LITERAL_14E0_96AF_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>19q36.3</span>
LITERAL_14E0_96AF_CHOICE_2
$choice_3 = <<'LITERAL_14E0_96AF_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>19q37.1</span>
LITERAL_14E0_96AF_CHOICE_3
$choice_4 = <<'LITERAL_14E0_96AF_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>19q21.2</span>
LITERAL_14E0_96AF_CHOICE_4
$choice_5 = <<'LITERAL_14E0_96AF_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>19q33</span>
LITERAL_14E0_96AF_CHOICE_5
$correct_1 = <<'LITERAL_14E0_96AF_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>19q45.1</span>
LITERAL_14E0_96AF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
