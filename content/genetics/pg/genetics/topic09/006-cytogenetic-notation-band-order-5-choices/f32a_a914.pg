DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F32A_A914';
<p>f32a_a914</p> For chromosome Xp, which band lies most distal (farthest from the centromere)?
PROMPT_F32A_A914
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F32A_A914_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>Xp35</span>
LITERAL_F32A_A914_CHOICE_1
$choice_2 = <<'LITERAL_F32A_A914_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>Xp29.2</span>
LITERAL_F32A_A914_CHOICE_2
$choice_3 = <<'LITERAL_F32A_A914_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>Xp22.3</span>
LITERAL_F32A_A914_CHOICE_3
$choice_4 = <<'LITERAL_F32A_A914_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>Xp43.1</span>
LITERAL_F32A_A914_CHOICE_4
$choice_5 = <<'LITERAL_F32A_A914_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>Xp37.1</span>
LITERAL_F32A_A914_CHOICE_5
$correct_1 = <<'LITERAL_F32A_A914_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>Xp43.1</span>
LITERAL_F32A_A914_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
