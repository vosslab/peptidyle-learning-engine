PROMPT_971A_E6F5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_971A_E6F5_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>15p38.3</span>
LITERAL_971A_E6F5_CHOICE_1
$choice_2 = <<'LITERAL_971A_E6F5_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>15p16.2</span>
LITERAL_971A_E6F5_CHOICE_2
$choice_3 = <<'LITERAL_971A_E6F5_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>15p26</span>
LITERAL_971A_E6F5_CHOICE_3
$choice_4 = <<'LITERAL_971A_E6F5_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>15p18.1</span>
LITERAL_971A_E6F5_CHOICE_4
$choice_5 = <<'LITERAL_971A_E6F5_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>15p46.2</span>
LITERAL_971A_E6F5_CHOICE_5
