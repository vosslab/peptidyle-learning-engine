DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3DCA_9B59';
<p>3dca_9b59</p> For chromosome 14q, which band lies most proximal (closest to the centromere)?
PROMPT_3DCA_9B59
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3DCA_9B59_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>14q31.1</span>
LITERAL_3DCA_9B59_CHOICE_1
$choice_2 = <<'LITERAL_3DCA_9B59_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>14q26.2</span>
LITERAL_3DCA_9B59_CHOICE_2
$choice_3 = <<'LITERAL_3DCA_9B59_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>14q32.2</span>
LITERAL_3DCA_9B59_CHOICE_3
$choice_4 = <<'LITERAL_3DCA_9B59_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>14q34.1</span>
LITERAL_3DCA_9B59_CHOICE_4
$choice_5 = <<'LITERAL_3DCA_9B59_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>14q41.1</span>
LITERAL_3DCA_9B59_CHOICE_5
$correct_1 = <<'LITERAL_3DCA_9B59_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>14q26.2</span>
LITERAL_3DCA_9B59_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
