DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E4B1_E0F5';
<p>e4b1_e0f5</p> Which band is most distal (farthest from the centromere) on chromosome 17p?
PROMPT_E4B1_E0F5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E4B1_E0F5_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>17p33</span>
LITERAL_E4B1_E0F5_CHOICE_1
$choice_2 = <<'LITERAL_E4B1_E0F5_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>17p49.1</span>
LITERAL_E4B1_E0F5_CHOICE_2
$choice_3 = <<'LITERAL_E4B1_E0F5_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>17p45.3</span>
LITERAL_E4B1_E0F5_CHOICE_3
$choice_4 = <<'LITERAL_E4B1_E0F5_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>17p28.2</span>
LITERAL_E4B1_E0F5_CHOICE_4
$choice_5 = <<'LITERAL_E4B1_E0F5_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>17p16.2</span>
LITERAL_E4B1_E0F5_CHOICE_5
$correct_1 = <<'LITERAL_E4B1_E0F5_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>17p49.1</span>
LITERAL_E4B1_E0F5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
