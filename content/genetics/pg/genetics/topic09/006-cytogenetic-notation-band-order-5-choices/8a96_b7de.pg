DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8A96_B7DE';
<p>8a96_b7de</p> Which band is most distal (farthest from the centromere) on chromosome 1p?
PROMPT_8A96_B7DE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8A96_B7DE_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>1p29</span>
LITERAL_8A96_B7DE_CHOICE_1
$choice_2 = <<'LITERAL_8A96_B7DE_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>1p21.3</span>
LITERAL_8A96_B7DE_CHOICE_2
$choice_3 = <<'LITERAL_8A96_B7DE_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>1p25.3</span>
LITERAL_8A96_B7DE_CHOICE_3
$choice_4 = <<'LITERAL_8A96_B7DE_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>1p16.1</span>
LITERAL_8A96_B7DE_CHOICE_4
$choice_5 = <<'LITERAL_8A96_B7DE_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>1p34.2</span>
LITERAL_8A96_B7DE_CHOICE_5
$correct_1 = <<'LITERAL_8A96_B7DE_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>1p34.2</span>
LITERAL_8A96_B7DE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
