DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A8BD_8581';
<p>a8bd_8581</p> On chromosome 12p, which band is most distal (farthest from the centromere)?
PROMPT_A8BD_8581
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A8BD_8581_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>12p44.3</span>
LITERAL_A8BD_8581_CHOICE_1
$choice_2 = <<'LITERAL_A8BD_8581_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>12p45.1</span>
LITERAL_A8BD_8581_CHOICE_2
$choice_3 = <<'LITERAL_A8BD_8581_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>12p25.1</span>
LITERAL_A8BD_8581_CHOICE_3
$choice_4 = <<'LITERAL_A8BD_8581_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>12p14.1</span>
LITERAL_A8BD_8581_CHOICE_4
$choice_5 = <<'LITERAL_A8BD_8581_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>12p33.2</span>
LITERAL_A8BD_8581_CHOICE_5
$correct_1 = <<'LITERAL_A8BD_8581_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>12p45.1</span>
LITERAL_A8BD_8581_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
