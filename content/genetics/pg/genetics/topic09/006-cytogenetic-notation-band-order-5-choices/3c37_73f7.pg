DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3C37_73F7';
<p>3c37_73f7</p> Which band is most distal (farthest from the centromere) on chromosome 6q?
PROMPT_3C37_73F7
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3C37_73F7_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>6q28</span>
LITERAL_3C37_73F7_CHOICE_1
$choice_2 = <<'LITERAL_3C37_73F7_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>6q49.2</span>
LITERAL_3C37_73F7_CHOICE_2
$choice_3 = <<'LITERAL_3C37_73F7_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>6q42.2</span>
LITERAL_3C37_73F7_CHOICE_3
$choice_4 = <<'LITERAL_3C37_73F7_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>6q34</span>
LITERAL_3C37_73F7_CHOICE_4
$choice_5 = <<'LITERAL_3C37_73F7_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>6q16.2</span>
LITERAL_3C37_73F7_CHOICE_5
$correct_1 = <<'LITERAL_3C37_73F7_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>6q49.2</span>
LITERAL_3C37_73F7_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
