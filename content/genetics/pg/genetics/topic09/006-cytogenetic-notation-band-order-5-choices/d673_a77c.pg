DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D673_A77C';
<p>d673_a77c</p> On chromosome 14q, which band is most distal (farthest from the centromere)?
PROMPT_D673_A77C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D673_A77C_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>14q43.2</span>
LITERAL_D673_A77C_CHOICE_1
$choice_2 = <<'LITERAL_D673_A77C_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>14q26</span>
LITERAL_D673_A77C_CHOICE_2
$choice_3 = <<'LITERAL_D673_A77C_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>14q18</span>
LITERAL_D673_A77C_CHOICE_3
$choice_4 = <<'LITERAL_D673_A77C_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>14q12.2</span>
LITERAL_D673_A77C_CHOICE_4
$choice_5 = <<'LITERAL_D673_A77C_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>14q41</span>
LITERAL_D673_A77C_CHOICE_5
$correct_1 = <<'LITERAL_D673_A77C_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>14q43.2</span>
LITERAL_D673_A77C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
