DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6520_84AC';
<p>6520_84ac</p> Which band is most distal (farthest from the centromere) on chromosome 11q?
PROMPT_6520_84AC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6520_84AC_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>11q39</span>
LITERAL_6520_84AC_CHOICE_1
$choice_2 = <<'LITERAL_6520_84AC_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11q19</span>
LITERAL_6520_84AC_CHOICE_2
$choice_3 = <<'LITERAL_6520_84AC_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11q33.2</span>
LITERAL_6520_84AC_CHOICE_3
$choice_4 = <<'LITERAL_6520_84AC_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>11q34</span>
LITERAL_6520_84AC_CHOICE_4
$choice_5 = <<'LITERAL_6520_84AC_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>11q38.3</span>
LITERAL_6520_84AC_CHOICE_5
$correct_1 = <<'LITERAL_6520_84AC_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>11q39</span>
LITERAL_6520_84AC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
