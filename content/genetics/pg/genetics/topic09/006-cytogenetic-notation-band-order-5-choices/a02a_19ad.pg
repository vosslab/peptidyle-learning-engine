DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A02A_19AD';
<p>a02a_19ad</p> On chromosome 9p, which band is most distal (farthest from the centromere)?
PROMPT_A02A_19AD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A02A_19AD_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>9p46.2</span>
LITERAL_A02A_19AD_CHOICE_1
$choice_2 = <<'LITERAL_A02A_19AD_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>9p22.2</span>
LITERAL_A02A_19AD_CHOICE_2
$choice_3 = <<'LITERAL_A02A_19AD_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>9p42.2</span>
LITERAL_A02A_19AD_CHOICE_3
$choice_4 = <<'LITERAL_A02A_19AD_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>9p37.1</span>
LITERAL_A02A_19AD_CHOICE_4
$choice_5 = <<'LITERAL_A02A_19AD_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>9p29</span>
LITERAL_A02A_19AD_CHOICE_5
$correct_1 = <<'LITERAL_A02A_19AD_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>9p46.2</span>
LITERAL_A02A_19AD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
