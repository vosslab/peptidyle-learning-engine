DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_02B0_1FE2';
<p>02b0_1fe2</p> Which band is most proximal (closest to the centromere) on chromosome 19q?
PROMPT_02B0_1FE2
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_02B0_1FE2_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>19q37.1</span>
LITERAL_02B0_1FE2_CHOICE_1
$choice_2 = <<'LITERAL_02B0_1FE2_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>19q22.2</span>
LITERAL_02B0_1FE2_CHOICE_2
$choice_3 = <<'LITERAL_02B0_1FE2_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>19q39.2</span>
LITERAL_02B0_1FE2_CHOICE_3
$choice_4 = <<'LITERAL_02B0_1FE2_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>19q22.3</span>
LITERAL_02B0_1FE2_CHOICE_4
$choice_5 = <<'LITERAL_02B0_1FE2_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>19q29.1</span>
LITERAL_02B0_1FE2_CHOICE_5
$correct_1 = <<'LITERAL_02B0_1FE2_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>19q22.2</span>
LITERAL_02B0_1FE2_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
