DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_DB49_2954';
<p>db49_2954</p> On chromosome Xq, which band is most distal (farthest from the centromere)?
PROMPT_DB49_2954
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_DB49_2954_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>Xq48.3</span>
LITERAL_DB49_2954_CHOICE_1
$choice_2 = <<'LITERAL_DB49_2954_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>Xq33.2</span>
LITERAL_DB49_2954_CHOICE_2
$choice_3 = <<'LITERAL_DB49_2954_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>Xq33.1</span>
LITERAL_DB49_2954_CHOICE_3
$choice_4 = <<'LITERAL_DB49_2954_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>Xq23.3</span>
LITERAL_DB49_2954_CHOICE_4
$choice_5 = <<'LITERAL_DB49_2954_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>Xq34.2</span>
LITERAL_DB49_2954_CHOICE_5
$correct_1 = <<'LITERAL_DB49_2954_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>Xq48.3</span>
LITERAL_DB49_2954_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
