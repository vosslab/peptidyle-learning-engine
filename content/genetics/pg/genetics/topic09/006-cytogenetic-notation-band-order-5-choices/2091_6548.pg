## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2091_6548';
<p>2091_6548</p> For chromosome 8q, which band lies most proximal (closest to the centromere)?
PROMPT_2091_6548
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2091_6548_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>8q42.1</span>
LITERAL_2091_6548_CHOICE_1
$choice_2 = <<'LITERAL_2091_6548_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>8q17.1</span>
LITERAL_2091_6548_CHOICE_2
$choice_3 = <<'LITERAL_2091_6548_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>8q44.3</span>
LITERAL_2091_6548_CHOICE_3
$choice_4 = <<'LITERAL_2091_6548_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>8q11</span>
LITERAL_2091_6548_CHOICE_4
$choice_5 = <<'LITERAL_2091_6548_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>8q37.3</span>
LITERAL_2091_6548_CHOICE_5
$correct_1 = <<'LITERAL_2091_6548_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>8q11</span>
LITERAL_2091_6548_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
