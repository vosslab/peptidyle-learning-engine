DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BFF4_E81B';
<p>bff4_e81b</p> For chromosome 17p, which band lies most distal (farthest from the centromere)?
PROMPT_BFF4_E81B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BFF4_E81B_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>17p21</span>
LITERAL_BFF4_E81B_CHOICE_1
$choice_2 = <<'LITERAL_BFF4_E81B_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>17p49.3</span>
LITERAL_BFF4_E81B_CHOICE_2
$choice_3 = <<'LITERAL_BFF4_E81B_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>17p25</span>
LITERAL_BFF4_E81B_CHOICE_3
$choice_4 = <<'LITERAL_BFF4_E81B_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>17p29.2</span>
LITERAL_BFF4_E81B_CHOICE_4
$choice_5 = <<'LITERAL_BFF4_E81B_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>17p18.2</span>
LITERAL_BFF4_E81B_CHOICE_5
$correct_1 = <<'LITERAL_BFF4_E81B_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>17p49.3</span>
LITERAL_BFF4_E81B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
