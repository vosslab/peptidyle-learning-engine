DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_428B_F465';
<p>428b_f465</p> Which band is most proximal (closest to the centromere) on chromosome 4q?
PROMPT_428B_F465
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_428B_F465_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>4q42</span>
LITERAL_428B_F465_CHOICE_1
$choice_2 = <<'LITERAL_428B_F465_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>4q48.1</span>
LITERAL_428B_F465_CHOICE_2
$choice_3 = <<'LITERAL_428B_F465_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>4q26.2</span>
LITERAL_428B_F465_CHOICE_3
$choice_4 = <<'LITERAL_428B_F465_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>4q32.3</span>
LITERAL_428B_F465_CHOICE_4
$choice_5 = <<'LITERAL_428B_F465_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>4q29.2</span>
LITERAL_428B_F465_CHOICE_5
$correct_1 = <<'LITERAL_428B_F465_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>4q26.2</span>
LITERAL_428B_F465_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
