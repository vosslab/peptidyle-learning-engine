## DESCRIPTION
## Imported Genetics source row ab11_d120; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AB11_D120';
<p>ab11_d120</p> Which band is most proximal (closest to the centromere) on chromosome 11q?
PROMPT_AB11_D120
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AB11_D120_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>11q44.1</span>
LITERAL_AB11_D120_CHOICE_1
$choice_2 = <<'LITERAL_AB11_D120_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11q16.1</span>
LITERAL_AB11_D120_CHOICE_2
$choice_3 = <<'LITERAL_AB11_D120_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11q14.2</span>
LITERAL_AB11_D120_CHOICE_3
$choice_4 = <<'LITERAL_AB11_D120_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>11q48.1</span>
LITERAL_AB11_D120_CHOICE_4
$choice_5 = <<'LITERAL_AB11_D120_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>11q29.2</span>
LITERAL_AB11_D120_CHOICE_5
$correct_1 = <<'LITERAL_AB11_D120_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>11q14.2</span>
LITERAL_AB11_D120_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
