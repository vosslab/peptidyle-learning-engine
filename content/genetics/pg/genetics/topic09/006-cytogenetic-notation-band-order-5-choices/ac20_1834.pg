## DESCRIPTION
## Imported Genetics source row ac20_1834; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_AC20_1834';
<p>ac20_1834</p> For chromosome 11q, which band lies most distal (farthest from the centromere)?
PROMPT_AC20_1834
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_AC20_1834_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>11q41</span>
LITERAL_AC20_1834_CHOICE_1
$choice_2 = <<'LITERAL_AC20_1834_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11q25.3</span>
LITERAL_AC20_1834_CHOICE_2
$choice_3 = <<'LITERAL_AC20_1834_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11q12.1</span>
LITERAL_AC20_1834_CHOICE_3
$choice_4 = <<'LITERAL_AC20_1834_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>11q21.1</span>
LITERAL_AC20_1834_CHOICE_4
$choice_5 = <<'LITERAL_AC20_1834_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>11q39</span>
LITERAL_AC20_1834_CHOICE_5
$correct_1 = <<'LITERAL_AC20_1834_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>11q41</span>
LITERAL_AC20_1834_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
