DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FF3A_3DAA';
<p>ff3a_3daa</p> On chromosome 11q, which band is most proximal (closest to the centromere)?
PROMPT_FF3A_3DAA
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FF3A_3DAA_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>11q15.1</span>
LITERAL_FF3A_3DAA_CHOICE_1
$choice_2 = <<'LITERAL_FF3A_3DAA_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>11q24.3</span>
LITERAL_FF3A_3DAA_CHOICE_2
$choice_3 = <<'LITERAL_FF3A_3DAA_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>11q42.3</span>
LITERAL_FF3A_3DAA_CHOICE_3
$choice_4 = <<'LITERAL_FF3A_3DAA_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>11q48.3</span>
LITERAL_FF3A_3DAA_CHOICE_4
$choice_5 = <<'LITERAL_FF3A_3DAA_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>11q34</span>
LITERAL_FF3A_3DAA_CHOICE_5
$correct_1 = <<'LITERAL_FF3A_3DAA_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>11q15.1</span>
LITERAL_FF3A_3DAA_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
