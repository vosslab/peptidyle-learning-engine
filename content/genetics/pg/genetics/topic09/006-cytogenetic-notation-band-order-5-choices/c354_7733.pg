DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C354_7733';
<p>c354_7733</p> For chromosome 3q, which band lies most distal (farthest from the centromere)?
PROMPT_C354_7733
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C354_7733_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>3q21</span>
LITERAL_C354_7733_CHOICE_1
$choice_2 = <<'LITERAL_C354_7733_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>3q23.2</span>
LITERAL_C354_7733_CHOICE_2
$choice_3 = <<'LITERAL_C354_7733_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>3q46.3</span>
LITERAL_C354_7733_CHOICE_3
$choice_4 = <<'LITERAL_C354_7733_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>3q17.3</span>
LITERAL_C354_7733_CHOICE_4
$choice_5 = <<'LITERAL_C354_7733_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>3q27.1</span>
LITERAL_C354_7733_CHOICE_5
$correct_1 = <<'LITERAL_C354_7733_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>3q46.3</span>
LITERAL_C354_7733_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
