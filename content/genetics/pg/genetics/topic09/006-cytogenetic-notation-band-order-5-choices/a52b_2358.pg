DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A52B_2358';
<p>a52b_2358</p> For chromosome 21p, which band lies most distal (farthest from the centromere)?
PROMPT_A52B_2358
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A52B_2358_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>21p41.1</span>
LITERAL_A52B_2358_CHOICE_1
$choice_2 = <<'LITERAL_A52B_2358_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>21p28</span>
LITERAL_A52B_2358_CHOICE_2
$choice_3 = <<'LITERAL_A52B_2358_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>21p46.3</span>
LITERAL_A52B_2358_CHOICE_3
$choice_4 = <<'LITERAL_A52B_2358_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>21p13.3</span>
LITERAL_A52B_2358_CHOICE_4
$choice_5 = <<'LITERAL_A52B_2358_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>21p29.1</span>
LITERAL_A52B_2358_CHOICE_5
$correct_1 = <<'LITERAL_A52B_2358_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>21p46.3</span>
LITERAL_A52B_2358_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
