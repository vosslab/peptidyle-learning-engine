DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_54FB_F8ED';
<p>54fb_f8ed</p> On chromosome 17q, which band is most proximal (closest to the centromere)?
PROMPT_54FB_F8ED
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_54FB_F8ED_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>17q43.2</span>
LITERAL_54FB_F8ED_CHOICE_1
$choice_2 = <<'LITERAL_54FB_F8ED_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>17q47</span>
LITERAL_54FB_F8ED_CHOICE_2
$choice_3 = <<'LITERAL_54FB_F8ED_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>17q23.3</span>
LITERAL_54FB_F8ED_CHOICE_3
$choice_4 = <<'LITERAL_54FB_F8ED_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>17q35.2</span>
LITERAL_54FB_F8ED_CHOICE_4
$choice_5 = <<'LITERAL_54FB_F8ED_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>17q34</span>
LITERAL_54FB_F8ED_CHOICE_5
$correct_1 = <<'LITERAL_54FB_F8ED_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>17q23.3</span>
LITERAL_54FB_F8ED_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
