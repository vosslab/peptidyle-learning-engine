## DESCRIPTION
## Imported Genetics source row ca72_cdbf; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CA72_CDBF';
<p>ca72_cdbf</p> For chromosome 16q, which band lies most proximal (closest to the centromere)?
PROMPT_CA72_CDBF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CA72_CDBF_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>16q27.2</span>
LITERAL_CA72_CDBF_CHOICE_1
$choice_2 = <<'LITERAL_CA72_CDBF_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>16q27</span>
LITERAL_CA72_CDBF_CHOICE_2
$choice_3 = <<'LITERAL_CA72_CDBF_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>16q31.1</span>
LITERAL_CA72_CDBF_CHOICE_3
$choice_4 = <<'LITERAL_CA72_CDBF_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>16q28.1</span>
LITERAL_CA72_CDBF_CHOICE_4
$choice_5 = <<'LITERAL_CA72_CDBF_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>16q12.1</span>
LITERAL_CA72_CDBF_CHOICE_5
$correct_1 = <<'LITERAL_CA72_CDBF_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>16q12.1</span>
LITERAL_CA72_CDBF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
