## DESCRIPTION
## Imported Genetics source row 3326_adad; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-band_order-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3326_ADAD';
<p>3326_adad</p> On chromosome 7q, which band is most distal (farthest from the centromere)?
PROMPT_3326_ADAD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3326_ADAD_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>7q41</span>
LITERAL_3326_ADAD_CHOICE_1
$choice_2 = <<'LITERAL_3326_ADAD_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>7q12</span>
LITERAL_3326_ADAD_CHOICE_2
$choice_3 = <<'LITERAL_3326_ADAD_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>7q23.2</span>
LITERAL_3326_ADAD_CHOICE_3
$choice_4 = <<'LITERAL_3326_ADAD_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>7q18.2</span>
LITERAL_3326_ADAD_CHOICE_4
$choice_5 = <<'LITERAL_3326_ADAD_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>7q13.1</span>
LITERAL_3326_ADAD_CHOICE_5
$correct_1 = <<'LITERAL_3326_ADAD_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>7q41</span>
LITERAL_3326_ADAD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
