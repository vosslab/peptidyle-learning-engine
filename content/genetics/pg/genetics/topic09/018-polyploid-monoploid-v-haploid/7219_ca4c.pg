## DESCRIPTION
## Imported Genetics source row 7219_ca4c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7219_CA4C';
<p>7219_ca4c</p> <p>A certain plant is found to be an octaploid (8n) with 72 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 72/2 = 36 and 72/8 = 9</i></p>
PROMPT_7219_CA4C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7219_CA4C_CHOICE_1';
<p>monoploid, m = 72 and haploid, h = 9</p>
LITERAL_7219_CA4C_CHOICE_1
$choice_2 = <<'LITERAL_7219_CA4C_CHOICE_2';
<p>monoploid, m = 36 and haploid, h = 9</p>
LITERAL_7219_CA4C_CHOICE_2
$choice_3 = <<'LITERAL_7219_CA4C_CHOICE_3';
<p>monoploid, m = 9 and haploid, h = 9</p>
LITERAL_7219_CA4C_CHOICE_3
$choice_4 = <<'LITERAL_7219_CA4C_CHOICE_4';
<p>monoploid, m = 9 and haploid, h = 36</p>
LITERAL_7219_CA4C_CHOICE_4
$choice_5 = <<'LITERAL_7219_CA4C_CHOICE_5';
<p>monoploid, m = 36 and haploid, h = 36</p>
LITERAL_7219_CA4C_CHOICE_5
$choice_6 = <<'LITERAL_7219_CA4C_CHOICE_6';
<p>monoploid, m = 72 and haploid, h = 36</p>
LITERAL_7219_CA4C_CHOICE_6
$correct_1 = <<'LITERAL_7219_CA4C_CORRECT_1';
<p>monoploid, m = 9 and haploid, h = 36</p>
LITERAL_7219_CA4C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
