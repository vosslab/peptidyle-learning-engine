## DESCRIPTION
## Imported Genetics source row b2ae_d81c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B2AE_D81C';
<p>b2ae_d81c</p> <p>A certain plant is found to be a tetradecaploid (14n) with 98 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 98/2 = 49 and 98/14 = 7</i></p>
PROMPT_B2AE_D81C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B2AE_D81C_CHOICE_1';
<p>monoploid, m = 7 and haploid, h = 49</p>
LITERAL_B2AE_D81C_CHOICE_1
$choice_2 = <<'LITERAL_B2AE_D81C_CHOICE_2';
<p>monoploid, m = 49 and haploid, h = 49</p>
LITERAL_B2AE_D81C_CHOICE_2
$choice_3 = <<'LITERAL_B2AE_D81C_CHOICE_3';
<p>monoploid, m = 7 and haploid, h = 7</p>
LITERAL_B2AE_D81C_CHOICE_3
$choice_4 = <<'LITERAL_B2AE_D81C_CHOICE_4';
<p>monoploid, m = 98 and haploid, h = 7</p>
LITERAL_B2AE_D81C_CHOICE_4
$choice_5 = <<'LITERAL_B2AE_D81C_CHOICE_5';
<p>monoploid, m = 98 and haploid, h = 49</p>
LITERAL_B2AE_D81C_CHOICE_5
$choice_6 = <<'LITERAL_B2AE_D81C_CHOICE_6';
<p>monoploid, m = 49 and haploid, h = 7</p>
LITERAL_B2AE_D81C_CHOICE_6
$correct_1 = <<'LITERAL_B2AE_D81C_CORRECT_1';
<p>monoploid, m = 7 and haploid, h = 49</p>
LITERAL_B2AE_D81C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
