## DESCRIPTION
## Imported Genetics source row 22e1_f2f3; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_22E1_F2F3';
<p>22e1_f2f3</p> <p>A certain plant is found to be an octaploid (8n) with 32 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 32/8 = 4 and 32/2 = 16</i></p>
PROMPT_22E1_F2F3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_22E1_F2F3_CHOICE_1';
<p>monoploid, m = 16 and haploid, h = 4</p>
LITERAL_22E1_F2F3_CHOICE_1
$choice_2 = <<'LITERAL_22E1_F2F3_CHOICE_2';
<p>monoploid, m = 32 and haploid, h = 4</p>
LITERAL_22E1_F2F3_CHOICE_2
$choice_3 = <<'LITERAL_22E1_F2F3_CHOICE_3';
<p>monoploid, m = 4 and haploid, h = 16</p>
LITERAL_22E1_F2F3_CHOICE_3
$choice_4 = <<'LITERAL_22E1_F2F3_CHOICE_4';
<p>monoploid, m = 32 and haploid, h = 16</p>
LITERAL_22E1_F2F3_CHOICE_4
$choice_5 = <<'LITERAL_22E1_F2F3_CHOICE_5';
<p>monoploid, m = 4 and haploid, h = 4</p>
LITERAL_22E1_F2F3_CHOICE_5
$choice_6 = <<'LITERAL_22E1_F2F3_CHOICE_6';
<p>monoploid, m = 16 and haploid, h = 16</p>
LITERAL_22E1_F2F3_CHOICE_6
$correct_1 = <<'LITERAL_22E1_F2F3_CORRECT_1';
<p>monoploid, m = 4 and haploid, h = 16</p>
LITERAL_22E1_F2F3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
