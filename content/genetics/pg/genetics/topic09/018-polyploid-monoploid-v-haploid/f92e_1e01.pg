## DESCRIPTION
## Imported Genetics source row f92e_1e01; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F92E_1E01';
<p>f92e_1e01</p> <p>A certain plant is found to be a hexadecaploid (16n) with 128 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 128/16 = 8 and 128/2 = 64</i></p>
PROMPT_F92E_1E01
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F92E_1E01_CHOICE_1';
<p>monoploid, m = 8 and haploid, h = 8</p>
LITERAL_F92E_1E01_CHOICE_1
$choice_2 = <<'LITERAL_F92E_1E01_CHOICE_2';
<p>monoploid, m = 128 and haploid, h = 64</p>
LITERAL_F92E_1E01_CHOICE_2
$choice_3 = <<'LITERAL_F92E_1E01_CHOICE_3';
<p>monoploid, m = 8 and haploid, h = 64</p>
LITERAL_F92E_1E01_CHOICE_3
$choice_4 = <<'LITERAL_F92E_1E01_CHOICE_4';
<p>monoploid, m = 64 and haploid, h = 64</p>
LITERAL_F92E_1E01_CHOICE_4
$choice_5 = <<'LITERAL_F92E_1E01_CHOICE_5';
<p>monoploid, m = 128 and haploid, h = 8</p>
LITERAL_F92E_1E01_CHOICE_5
$choice_6 = <<'LITERAL_F92E_1E01_CHOICE_6';
<p>monoploid, m = 64 and haploid, h = 8</p>
LITERAL_F92E_1E01_CHOICE_6
$correct_1 = <<'LITERAL_F92E_1E01_CORRECT_1';
<p>monoploid, m = 8 and haploid, h = 64</p>
LITERAL_F92E_1E01_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
