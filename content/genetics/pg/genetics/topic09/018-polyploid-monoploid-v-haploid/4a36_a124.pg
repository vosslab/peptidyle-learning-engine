## DESCRIPTION
## Imported Genetics source row 4a36_a124; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4A36_A124';
<p>4a36_a124</p> <p>A certain plant is found to be a decaploid (10n) with 60 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 60/10 = 6 and 60/2 = 30</i></p>
PROMPT_4A36_A124
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4A36_A124_CHOICE_1';
<p>monoploid, m = 60 and haploid, h = 30</p>
LITERAL_4A36_A124_CHOICE_1
$choice_2 = <<'LITERAL_4A36_A124_CHOICE_2';
<p>monoploid, m = 30 and haploid, h = 30</p>
LITERAL_4A36_A124_CHOICE_2
$choice_3 = <<'LITERAL_4A36_A124_CHOICE_3';
<p>monoploid, m = 30 and haploid, h = 6</p>
LITERAL_4A36_A124_CHOICE_3
$choice_4 = <<'LITERAL_4A36_A124_CHOICE_4';
<p>monoploid, m = 60 and haploid, h = 6</p>
LITERAL_4A36_A124_CHOICE_4
$choice_5 = <<'LITERAL_4A36_A124_CHOICE_5';
<p>monoploid, m = 6 and haploid, h = 6</p>
LITERAL_4A36_A124_CHOICE_5
$choice_6 = <<'LITERAL_4A36_A124_CHOICE_6';
<p>monoploid, m = 6 and haploid, h = 30</p>
LITERAL_4A36_A124_CHOICE_6
$correct_1 = <<'LITERAL_4A36_A124_CORRECT_1';
<p>monoploid, m = 6 and haploid, h = 30</p>
LITERAL_4A36_A124_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
