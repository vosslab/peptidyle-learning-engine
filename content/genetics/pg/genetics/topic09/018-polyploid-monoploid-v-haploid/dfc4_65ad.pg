## DESCRIPTION
## Imported Genetics source row dfc4_65ad; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_DFC4_65AD';
<p>dfc4_65ad</p> <p>A certain plant is found to be a decaploid (10n) with 40 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 40/2 = 20 and 40/10 = 4</i></p>
PROMPT_DFC4_65AD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_DFC4_65AD_CHOICE_1';
<p>monoploid, m = 4 and haploid, h = 20</p>
LITERAL_DFC4_65AD_CHOICE_1
$choice_2 = <<'LITERAL_DFC4_65AD_CHOICE_2';
<p>monoploid, m = 4 and haploid, h = 4</p>
LITERAL_DFC4_65AD_CHOICE_2
$choice_3 = <<'LITERAL_DFC4_65AD_CHOICE_3';
<p>monoploid, m = 40 and haploid, h = 4</p>
LITERAL_DFC4_65AD_CHOICE_3
$choice_4 = <<'LITERAL_DFC4_65AD_CHOICE_4';
<p>monoploid, m = 40 and haploid, h = 20</p>
LITERAL_DFC4_65AD_CHOICE_4
$choice_5 = <<'LITERAL_DFC4_65AD_CHOICE_5';
<p>monoploid, m = 20 and haploid, h = 4</p>
LITERAL_DFC4_65AD_CHOICE_5
$choice_6 = <<'LITERAL_DFC4_65AD_CHOICE_6';
<p>monoploid, m = 20 and haploid, h = 20</p>
LITERAL_DFC4_65AD_CHOICE_6
$correct_1 = <<'LITERAL_DFC4_65AD_CORRECT_1';
<p>monoploid, m = 4 and haploid, h = 20</p>
LITERAL_DFC4_65AD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
