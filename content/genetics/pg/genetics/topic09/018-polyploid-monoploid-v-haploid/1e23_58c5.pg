DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1E23_58C5';
<p>1e23_58c5</p> <p>A certain plant is found to be an octaploid (8n) with 88 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 88/8 = 11 and 88/2 = 44</i></p>
PROMPT_1E23_58C5
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1E23_58C5_CHOICE_1';
<p>monoploid, m = 88 and haploid, h = 44</p>
LITERAL_1E23_58C5_CHOICE_1
$choice_2 = <<'LITERAL_1E23_58C5_CHOICE_2';
<p>monoploid, m = 44 and haploid, h = 11</p>
LITERAL_1E23_58C5_CHOICE_2
$choice_3 = <<'LITERAL_1E23_58C5_CHOICE_3';
<p>monoploid, m = 11 and haploid, h = 11</p>
LITERAL_1E23_58C5_CHOICE_3
$choice_4 = <<'LITERAL_1E23_58C5_CHOICE_4';
<p>monoploid, m = 88 and haploid, h = 11</p>
LITERAL_1E23_58C5_CHOICE_4
$choice_5 = <<'LITERAL_1E23_58C5_CHOICE_5';
<p>monoploid, m = 44 and haploid, h = 44</p>
LITERAL_1E23_58C5_CHOICE_5
$choice_6 = <<'LITERAL_1E23_58C5_CHOICE_6';
<p>monoploid, m = 11 and haploid, h = 44</p>
LITERAL_1E23_58C5_CHOICE_6
$correct_1 = <<'LITERAL_1E23_58C5_CORRECT_1';
<p>monoploid, m = 11 and haploid, h = 44</p>
LITERAL_1E23_58C5_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
