DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_078C_6A5E';
<p>078c_6a5e</p> <p>A certain plant is found to be an octaploid (8n) with 64 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 64/8 = 8 and 64/2 = 32</i></p>
PROMPT_078C_6A5E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_078C_6A5E_CHOICE_1';
<p>monoploid, m = 32 and haploid, h = 8</p>
LITERAL_078C_6A5E_CHOICE_1
$choice_2 = <<'LITERAL_078C_6A5E_CHOICE_2';
<p>monoploid, m = 32 and haploid, h = 32</p>
LITERAL_078C_6A5E_CHOICE_2
$choice_3 = <<'LITERAL_078C_6A5E_CHOICE_3';
<p>monoploid, m = 8 and haploid, h = 8</p>
LITERAL_078C_6A5E_CHOICE_3
$choice_4 = <<'LITERAL_078C_6A5E_CHOICE_4';
<p>monoploid, m = 64 and haploid, h = 8</p>
LITERAL_078C_6A5E_CHOICE_4
$choice_5 = <<'LITERAL_078C_6A5E_CHOICE_5';
<p>monoploid, m = 8 and haploid, h = 32</p>
LITERAL_078C_6A5E_CHOICE_5
$choice_6 = <<'LITERAL_078C_6A5E_CHOICE_6';
<p>monoploid, m = 64 and haploid, h = 32</p>
LITERAL_078C_6A5E_CHOICE_6
$correct_1 = <<'LITERAL_078C_6A5E_CORRECT_1';
<p>monoploid, m = 8 and haploid, h = 32</p>
LITERAL_078C_6A5E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
