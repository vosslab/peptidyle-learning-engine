## DESCRIPTION
## Imported Genetics source row d2ae_1e1a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D2AE_1E1A';
<p>d2ae_1e1a</p> <p>A certain plant is found to be a hexaploid (6n) with 66 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 66/6 = 11 and 66/2 = 33</i></p>
PROMPT_D2AE_1E1A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D2AE_1E1A_CHOICE_1';
<p>monoploid, m = 11 and haploid, h = 33</p>
LITERAL_D2AE_1E1A_CHOICE_1
$choice_2 = <<'LITERAL_D2AE_1E1A_CHOICE_2';
<p>monoploid, m = 66 and haploid, h = 33</p>
LITERAL_D2AE_1E1A_CHOICE_2
$choice_3 = <<'LITERAL_D2AE_1E1A_CHOICE_3';
<p>monoploid, m = 11 and haploid, h = 11</p>
LITERAL_D2AE_1E1A_CHOICE_3
$choice_4 = <<'LITERAL_D2AE_1E1A_CHOICE_4';
<p>monoploid, m = 66 and haploid, h = 11</p>
LITERAL_D2AE_1E1A_CHOICE_4
$choice_5 = <<'LITERAL_D2AE_1E1A_CHOICE_5';
<p>monoploid, m = 33 and haploid, h = 11</p>
LITERAL_D2AE_1E1A_CHOICE_5
$choice_6 = <<'LITERAL_D2AE_1E1A_CHOICE_6';
<p>monoploid, m = 33 and haploid, h = 33</p>
LITERAL_D2AE_1E1A_CHOICE_6
$correct_1 = <<'LITERAL_D2AE_1E1A_CORRECT_1';
<p>monoploid, m = 11 and haploid, h = 33</p>
LITERAL_D2AE_1E1A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
