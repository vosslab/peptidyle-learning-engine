## DESCRIPTION
## Imported Genetics source row e442_3b8a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E442_3B8A';
<p>e442_3b8a</p> <p>A certain plant is found to be a tetradecaploid (14n) with 112 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 112/2 = 56 and 112/14 = 8</i></p>
PROMPT_E442_3B8A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E442_3B8A_CHOICE_1';
<p>monoploid, m = 112 and haploid, h = 8</p>
LITERAL_E442_3B8A_CHOICE_1
$choice_2 = <<'LITERAL_E442_3B8A_CHOICE_2';
<p>monoploid, m = 56 and haploid, h = 8</p>
LITERAL_E442_3B8A_CHOICE_2
$choice_3 = <<'LITERAL_E442_3B8A_CHOICE_3';
<p>monoploid, m = 56 and haploid, h = 56</p>
LITERAL_E442_3B8A_CHOICE_3
$choice_4 = <<'LITERAL_E442_3B8A_CHOICE_4';
<p>monoploid, m = 112 and haploid, h = 56</p>
LITERAL_E442_3B8A_CHOICE_4
$choice_5 = <<'LITERAL_E442_3B8A_CHOICE_5';
<p>monoploid, m = 8 and haploid, h = 56</p>
LITERAL_E442_3B8A_CHOICE_5
$choice_6 = <<'LITERAL_E442_3B8A_CHOICE_6';
<p>monoploid, m = 8 and haploid, h = 8</p>
LITERAL_E442_3B8A_CHOICE_6
$correct_1 = <<'LITERAL_E442_3B8A_CORRECT_1';
<p>monoploid, m = 8 and haploid, h = 56</p>
LITERAL_E442_3B8A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
