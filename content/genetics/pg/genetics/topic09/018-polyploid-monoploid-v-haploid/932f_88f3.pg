DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_932F_88F3';
<p>932f_88f3</p> <p>A certain plant is found to be a decaploid (10n) with 100 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 100/2 = 50 and 100/10 = 10</i></p>
PROMPT_932F_88F3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_932F_88F3_CHOICE_1';
<p>monoploid, m = 50 and haploid, h = 50</p>
LITERAL_932F_88F3_CHOICE_1
$choice_2 = <<'LITERAL_932F_88F3_CHOICE_2';
<p>monoploid, m = 100 and haploid, h = 50</p>
LITERAL_932F_88F3_CHOICE_2
$choice_3 = <<'LITERAL_932F_88F3_CHOICE_3';
<p>monoploid, m = 10 and haploid, h = 10</p>
LITERAL_932F_88F3_CHOICE_3
$choice_4 = <<'LITERAL_932F_88F3_CHOICE_4';
<p>monoploid, m = 10 and haploid, h = 50</p>
LITERAL_932F_88F3_CHOICE_4
$choice_5 = <<'LITERAL_932F_88F3_CHOICE_5';
<p>monoploid, m = 100 and haploid, h = 10</p>
LITERAL_932F_88F3_CHOICE_5
$choice_6 = <<'LITERAL_932F_88F3_CHOICE_6';
<p>monoploid, m = 50 and haploid, h = 10</p>
LITERAL_932F_88F3_CHOICE_6
$correct_1 = <<'LITERAL_932F_88F3_CORRECT_1';
<p>monoploid, m = 10 and haploid, h = 50</p>
LITERAL_932F_88F3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
