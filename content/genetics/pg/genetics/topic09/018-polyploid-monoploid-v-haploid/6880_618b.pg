## DESCRIPTION
## Imported Genetics source row 6880_618b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6880_618B';
<p>6880_618b</p> <p>A certain plant is found to be a dodecaploid (12n) with 132 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 132/12 = 11 and 132/2 = 66</i></p>
PROMPT_6880_618B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6880_618B_CHOICE_1';
<p>monoploid, m = 132 and haploid, h = 66</p>
LITERAL_6880_618B_CHOICE_1
$choice_2 = <<'LITERAL_6880_618B_CHOICE_2';
<p>monoploid, m = 11 and haploid, h = 66</p>
LITERAL_6880_618B_CHOICE_2
$choice_3 = <<'LITERAL_6880_618B_CHOICE_3';
<p>monoploid, m = 132 and haploid, h = 11</p>
LITERAL_6880_618B_CHOICE_3
$choice_4 = <<'LITERAL_6880_618B_CHOICE_4';
<p>monoploid, m = 11 and haploid, h = 11</p>
LITERAL_6880_618B_CHOICE_4
$choice_5 = <<'LITERAL_6880_618B_CHOICE_5';
<p>monoploid, m = 66 and haploid, h = 11</p>
LITERAL_6880_618B_CHOICE_5
$choice_6 = <<'LITERAL_6880_618B_CHOICE_6';
<p>monoploid, m = 66 and haploid, h = 66</p>
LITERAL_6880_618B_CHOICE_6
$correct_1 = <<'LITERAL_6880_618B_CORRECT_1';
<p>monoploid, m = 11 and haploid, h = 66</p>
LITERAL_6880_618B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
