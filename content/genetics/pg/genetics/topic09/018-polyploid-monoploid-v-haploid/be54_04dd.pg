## DESCRIPTION
## Imported Genetics source row be54_04dd; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BE54_04DD';
<p>be54_04dd</p> <p>A certain plant is found to be a tetraploid (4n) with 40 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 40/4 = 10 and 40/2 = 20</i></p>
PROMPT_BE54_04DD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BE54_04DD_CHOICE_1';
<p>monoploid, m = 40 and haploid, h = 10</p>
LITERAL_BE54_04DD_CHOICE_1
$choice_2 = <<'LITERAL_BE54_04DD_CHOICE_2';
<p>monoploid, m = 20 and haploid, h = 20</p>
LITERAL_BE54_04DD_CHOICE_2
$choice_3 = <<'LITERAL_BE54_04DD_CHOICE_3';
<p>monoploid, m = 10 and haploid, h = 10</p>
LITERAL_BE54_04DD_CHOICE_3
$choice_4 = <<'LITERAL_BE54_04DD_CHOICE_4';
<p>monoploid, m = 10 and haploid, h = 20</p>
LITERAL_BE54_04DD_CHOICE_4
$choice_5 = <<'LITERAL_BE54_04DD_CHOICE_5';
<p>monoploid, m = 40 and haploid, h = 20</p>
LITERAL_BE54_04DD_CHOICE_5
$choice_6 = <<'LITERAL_BE54_04DD_CHOICE_6';
<p>monoploid, m = 20 and haploid, h = 10</p>
LITERAL_BE54_04DD_CHOICE_6
$correct_1 = <<'LITERAL_BE54_04DD_CORRECT_1';
<p>monoploid, m = 10 and haploid, h = 20</p>
LITERAL_BE54_04DD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
