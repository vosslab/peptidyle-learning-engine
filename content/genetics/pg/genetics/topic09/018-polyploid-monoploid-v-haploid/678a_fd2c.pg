## DESCRIPTION
## Imported Genetics source row 678a_fd2c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-monoploid_v_haploid-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_678A_FD2C';
<p>678a_fd2c</p> <p>A certain plant is found to be a hexaploid (6n) with 42 chromosomes in total.</p><h5>What are the monoploid (m) and haploid (h) numbers for this plant?</h5><p><i>Note: 42/2 = 21 and 42/6 = 7</i></p>
PROMPT_678A_FD2C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_678A_FD2C_CHOICE_1';
<p>monoploid, m = 42 and haploid, h = 21</p>
LITERAL_678A_FD2C_CHOICE_1
$choice_2 = <<'LITERAL_678A_FD2C_CHOICE_2';
<p>monoploid, m = 21 and haploid, h = 7</p>
LITERAL_678A_FD2C_CHOICE_2
$choice_3 = <<'LITERAL_678A_FD2C_CHOICE_3';
<p>monoploid, m = 42 and haploid, h = 7</p>
LITERAL_678A_FD2C_CHOICE_3
$choice_4 = <<'LITERAL_678A_FD2C_CHOICE_4';
<p>monoploid, m = 7 and haploid, h = 7</p>
LITERAL_678A_FD2C_CHOICE_4
$choice_5 = <<'LITERAL_678A_FD2C_CHOICE_5';
<p>monoploid, m = 7 and haploid, h = 21</p>
LITERAL_678A_FD2C_CHOICE_5
$choice_6 = <<'LITERAL_678A_FD2C_CHOICE_6';
<p>monoploid, m = 21 and haploid, h = 21</p>
LITERAL_678A_FD2C_CHOICE_6
$correct_1 = <<'LITERAL_678A_FD2C_CORRECT_1';
<p>monoploid, m = 7 and haploid, h = 21</p>
LITERAL_678A_FD2C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
