## DESCRIPTION
## Imported Genetics source row c291_bd27; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_shapes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C291_BD27';
<p>c291_bd27</p> <p>Which one of the following categories of <strong><span style="color: #a719db;">chromosome</span> </strong>shape correspond to the shape description <span style='font-size: 1em;'><strong>'the <strong><span style="color: #a719db;">chromosome</span> </strong>most resembles the letter J after anaphase separation'</strong></span>.</p>
PROMPT_C291_BD27
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C291_BD27_CHOICE_1';
<strong><span style="color: #d40000;">Acentric</span></strong>
LITERAL_C291_BD27_CHOICE_1
$choice_2 = <<'LITERAL_C291_BD27_CHOICE_2';
<strong><span style="color: #007a00;">Acrocentric</span></strong>
LITERAL_C291_BD27_CHOICE_2
$choice_3 = <<'LITERAL_C291_BD27_CHOICE_3';
<strong><span style="color: #076dad;">Dicentric</span></strong>
LITERAL_C291_BD27_CHOICE_3
$choice_4 = <<'LITERAL_C291_BD27_CHOICE_4';
<strong><span style="color: #0067cc;">Metacentric</span></strong>
LITERAL_C291_BD27_CHOICE_4
$choice_5 = <<'LITERAL_C291_BD27_CHOICE_5';
<strong><span style="color: #c80085;">Submetacentric</span></strong>
LITERAL_C291_BD27_CHOICE_5
$correct_1 = <<'LITERAL_C291_BD27_CORRECT_1';
<strong><span style="color: #c80085;">Submetacentric</span></strong>
LITERAL_C291_BD27_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
