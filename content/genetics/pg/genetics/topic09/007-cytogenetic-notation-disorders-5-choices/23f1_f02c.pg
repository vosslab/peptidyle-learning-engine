## DESCRIPTION
## Imported Genetics source row 23f1_f02c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_23F1_F02C';
<p>23f1_f02c</p> A patient has findings consistent with Patau syndrome. The condition is caused by trisomy 13. The karyotype is best summarized as: male with mosaicism: a normal 46-chromosome line and a line with trisomy 13. Which notation matches this?
PROMPT_23F1_F02C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_23F1_F02C_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_23F1_F02C_CHOICE_1
$choice_2 = <<'LITERAL_23F1_F02C_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XY</span>
LITERAL_23F1_F02C_CHOICE_2
$choice_3 = <<'LITERAL_23F1_F02C_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(5)(p15.2)</span>
LITERAL_23F1_F02C_CHOICE_3
$choice_4 = <<'LITERAL_23F1_F02C_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+13</span>
LITERAL_23F1_F02C_CHOICE_4
$choice_5 = <<'LITERAL_23F1_F02C_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+21</span>
LITERAL_23F1_F02C_CHOICE_5
$correct_1 = <<'LITERAL_23F1_F02C_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+13</span>
LITERAL_23F1_F02C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
