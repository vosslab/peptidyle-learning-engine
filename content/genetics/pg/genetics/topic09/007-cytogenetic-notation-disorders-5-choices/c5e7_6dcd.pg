## DESCRIPTION
## Imported Genetics source row c5e7_6dcd; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C5E7_6DCD';
<p>c5e7_6dcd</p> A patient has findings consistent with Triple X syndrome. The condition is caused by extra X chromosome in a female. The karyotype is best summarized as: female with mosaicism: a normal 46-chromosome line and a line with . Which notation matches this?
PROMPT_C5E7_6DCD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C5E7_6DCD_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_C5E7_6DCD_CHOICE_1
$choice_2 = <<'LITERAL_C5E7_6DCD_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XXY</span>
LITERAL_C5E7_6DCD_CHOICE_2
$choice_3 = <<'LITERAL_C5E7_6DCD_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XXX</span>
LITERAL_C5E7_6DCD_CHOICE_3
$choice_4 = <<'LITERAL_C5E7_6DCD_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+21</span>
LITERAL_C5E7_6DCD_CHOICE_4
$choice_5 = <<'LITERAL_C5E7_6DCD_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>47,XXX</span>
LITERAL_C5E7_6DCD_CHOICE_5
$correct_1 = <<'LITERAL_C5E7_6DCD_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XXX</span>
LITERAL_C5E7_6DCD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
