DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BC7E_A53D';
<p>bc7e_a53d</p> A patient has findings consistent with CML with Philadelphia chromosome. The condition is caused by reciprocal translocation between 9q34 and 22q11.2. The karyotype is best summarized as: female with reciprocal translocation between chromosomes 9 and 22 at q34 and q11.2. Which notation matches this?
PROMPT_BC7E_A53D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BC7E_A53D_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;5)(q34;q11.2)</span>
LITERAL_BC7E_A53D_CHOICE_1
$choice_2 = <<'LITERAL_BC7E_A53D_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XX</span>
LITERAL_BC7E_A53D_CHOICE_2
$choice_3 = <<'LITERAL_BC7E_A53D_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;22)(q34;q11.2)</span>
LITERAL_BC7E_A53D_CHOICE_3
$choice_4 = <<'LITERAL_BC7E_A53D_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XXY</span>
LITERAL_BC7E_A53D_CHOICE_4
$choice_5 = <<'LITERAL_BC7E_A53D_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>47,XYY</span>
LITERAL_BC7E_A53D_CHOICE_5
$correct_1 = <<'LITERAL_BC7E_A53D_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;22)(q34;q11.2)</span>
LITERAL_BC7E_A53D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
