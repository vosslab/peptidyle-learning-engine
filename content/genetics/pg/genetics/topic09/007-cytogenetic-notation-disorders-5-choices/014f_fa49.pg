DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_014F_FA49';
<p>014f_fa49</p> A patient has findings consistent with DiGeorge syndrome. The condition is caused by microdeletion at 22q11.2. The karyotype is best summarized as: male with a deletion on chromosome 22q11.2. Which notation matches this?
PROMPT_014F_FA49
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_014F_FA49_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>47,XXY</span>
LITERAL_014F_FA49_CHOICE_1
$choice_2 = <<'LITERAL_014F_FA49_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY,dup(22)(q11.2)</span>
LITERAL_014F_FA49_CHOICE_2
$choice_3 = <<'LITERAL_014F_FA49_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>47,XY,+13</span>
LITERAL_014F_FA49_CHOICE_3
$choice_4 = <<'LITERAL_014F_FA49_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_014F_FA49_CHOICE_4
$choice_5 = <<'LITERAL_014F_FA49_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+21</span>
LITERAL_014F_FA49_CHOICE_5
$correct_1 = <<'LITERAL_014F_FA49_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_014F_FA49_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
