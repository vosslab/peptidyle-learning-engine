DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2887_EF96';
<p>2887_ef96</p> A patient has findings consistent with XYY syndrome. The condition is caused by extra Y chromosome in a male. The karyotype is best summarized as: male with mosaicism: a normal 46-chromosome line and a line with . Which notation matches this?
PROMPT_2887_EF96
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2887_EF96_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XX</span>
LITERAL_2887_EF96_CHOICE_1
$choice_2 = <<'LITERAL_2887_EF96_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XYY</span>
LITERAL_2887_EF96_CHOICE_2
$choice_3 = <<'LITERAL_2887_EF96_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>45,X</span>
LITERAL_2887_EF96_CHOICE_3
$choice_4 = <<'LITERAL_2887_EF96_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(22)(q11.2)</span>
LITERAL_2887_EF96_CHOICE_4
$choice_5 = <<'LITERAL_2887_EF96_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+21</span>
LITERAL_2887_EF96_CHOICE_5
$correct_1 = <<'LITERAL_2887_EF96_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XYY</span>
LITERAL_2887_EF96_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
