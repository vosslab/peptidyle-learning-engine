## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D5FC_961B';
<p>d5fc_961b</p> A patient has findings consistent with Klinefelter syndrome. The condition is caused by extra X chromosome in a male. The karyotype is best summarized as: male with mosaicism: a normal 46-chromosome line and a line with . Which notation matches this?
PROMPT_D5FC_961B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D5FC_961B_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XXY</span>
LITERAL_D5FC_961B_CHOICE_1
$choice_2 = <<'LITERAL_D5FC_961B_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(5)(p15.2)</span>
LITERAL_D5FC_961B_CHOICE_2
$choice_3 = <<'LITERAL_D5FC_961B_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+18</span>
LITERAL_D5FC_961B_CHOICE_3
$choice_4 = <<'LITERAL_D5FC_961B_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+18</span>
LITERAL_D5FC_961B_CHOICE_4
$choice_5 = <<'LITERAL_D5FC_961B_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+13</span>
LITERAL_D5FC_961B_CHOICE_5
$correct_1 = <<'LITERAL_D5FC_961B_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XXY</span>
LITERAL_D5FC_961B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
