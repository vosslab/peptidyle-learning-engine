## DESCRIPTION
## Imported Genetics source row 9560_227e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9560_227E';
<p>9560_227e</p> A patient has findings consistent with Down syndrome due to Robertsonian translocation. The condition is caused by unbalanced Robertsonian translocation involving chromosome 21. The karyotype is best summarized as: male with Robertsonian translocation involving chromosomes 14 and 21 with trisomy 21. Which notation matches this?
PROMPT_9560_227E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9560_227E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,rob(14;21)(q10;q10),+21</span>
LITERAL_9560_227E_CHOICE_1
$choice_2 = <<'LITERAL_9560_227E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XX</span>
LITERAL_9560_227E_CHOICE_2
$choice_3 = <<'LITERAL_9560_227E_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_9560_227E_CHOICE_3
$choice_4 = <<'LITERAL_9560_227E_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;22)(q34;q11.2)</span>
LITERAL_9560_227E_CHOICE_4
$choice_5 = <<'LITERAL_9560_227E_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>45,X</span>
LITERAL_9560_227E_CHOICE_5
$correct_1 = <<'LITERAL_9560_227E_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,rob(14;21)(q10;q10),+21</span>
LITERAL_9560_227E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
