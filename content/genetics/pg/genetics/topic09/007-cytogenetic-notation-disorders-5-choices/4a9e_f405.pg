DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4A9E_F405';
<p>4a9e_f405</p> A patient has findings consistent with DiGeorge syndrome. The condition is caused by microdeletion at 22q11.2. The karyotype is best summarized as: female with a deletion on chromosome 22q11.2. Which notation matches this?
PROMPT_4A9E_F405
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4A9E_F405_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,dup(22)(q11.2)</span>
LITERAL_4A9E_F405_CHOICE_1
$choice_2 = <<'LITERAL_4A9E_F405_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+13</span>
LITERAL_4A9E_F405_CHOICE_2
$choice_3 = <<'LITERAL_4A9E_F405_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(22)(q11.2)</span>
LITERAL_4A9E_F405_CHOICE_3
$choice_4 = <<'LITERAL_4A9E_F405_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XYY</span>
LITERAL_4A9E_F405_CHOICE_4
$choice_5 = <<'LITERAL_4A9E_F405_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XY,t(9;22)(q34;q11.2)</span>
LITERAL_4A9E_F405_CHOICE_5
$correct_1 = <<'LITERAL_4A9E_F405_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(22)(q11.2)</span>
LITERAL_4A9E_F405_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
