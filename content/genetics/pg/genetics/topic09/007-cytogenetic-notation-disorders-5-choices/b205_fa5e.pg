## DESCRIPTION
## Imported Genetics source row b205_fa5e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B205_FA5E';
<p>b205_fa5e</p> A patient has findings consistent with Cri-du-chat syndrome. The condition is caused by deletion of 5p. The karyotype is best summarized as: male with a deletion on chromosome 5p15.2. Which notation matches this?
PROMPT_B205_FA5E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B205_FA5E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+21</span>
LITERAL_B205_FA5E_CHOICE_1
$choice_2 = <<'LITERAL_B205_FA5E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>47,XXX</span>
LITERAL_B205_FA5E_CHOICE_2
$choice_3 = <<'LITERAL_B205_FA5E_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>47,XYY</span>
LITERAL_B205_FA5E_CHOICE_3
$choice_4 = <<'LITERAL_B205_FA5E_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(5)(p15.2)</span>
LITERAL_B205_FA5E_CHOICE_4
$choice_5 = <<'LITERAL_B205_FA5E_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;22)(q34;q11.2)</span>
LITERAL_B205_FA5E_CHOICE_5
$correct_1 = <<'LITERAL_B205_FA5E_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(5)(p15.2)</span>
LITERAL_B205_FA5E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
