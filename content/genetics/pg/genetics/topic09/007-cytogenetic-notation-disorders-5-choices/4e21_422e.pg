## DESCRIPTION
## Imported Genetics source row 4e21_422e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4E21_422E';
<p>4e21_422e</p> A patient has findings consistent with Down syndrome. The condition is caused by trisomy 21. The karyotype is best summarized as: male with mosaicism: a normal 46-chromosome line and a line with trisomy 21. Which notation matches this?
PROMPT_4E21_422E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4E21_422E_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+18</span>
LITERAL_4E21_422E_CHOICE_1
$choice_2 = <<'LITERAL_4E21_422E_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+19</span>
LITERAL_4E21_422E_CHOICE_2
$choice_3 = <<'LITERAL_4E21_422E_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XX</span>
LITERAL_4E21_422E_CHOICE_3
$choice_4 = <<'LITERAL_4E21_422E_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+21</span>
LITERAL_4E21_422E_CHOICE_4
$choice_5 = <<'LITERAL_4E21_422E_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+13</span>
LITERAL_4E21_422E_CHOICE_5
$correct_1 = <<'LITERAL_4E21_422E_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XY,+21</span>
LITERAL_4E21_422E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
