## DESCRIPTION
## Imported Genetics source row 369c_f251; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_369C_F251';
<p>369c_f251</p> A patient has findings consistent with Edwards syndrome. The condition is caused by trisomy 18. The karyotype is best summarized as: female with mosaicism: a normal 46-chromosome line and a line with trisomy 18. Which notation matches this?
PROMPT_369C_F251
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_369C_F251_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+18</span>
LITERAL_369C_F251_CHOICE_1
$choice_2 = <<'LITERAL_369C_F251_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XXY</span>
LITERAL_369C_F251_CHOICE_2
$choice_3 = <<'LITERAL_369C_F251_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>45,X/46,XX</span>
LITERAL_369C_F251_CHOICE_3
$choice_4 = <<'LITERAL_369C_F251_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+18</span>
LITERAL_369C_F251_CHOICE_4
$choice_5 = <<'LITERAL_369C_F251_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(4)(p16.3)</span>
LITERAL_369C_F251_CHOICE_5
$correct_1 = <<'LITERAL_369C_F251_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+18</span>
LITERAL_369C_F251_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
