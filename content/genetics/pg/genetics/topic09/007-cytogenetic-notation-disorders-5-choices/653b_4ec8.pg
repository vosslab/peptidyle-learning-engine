DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_653B_4EC8';
<p>653b_4ec8</p> A patient has findings consistent with Wolf-Hirschhorn syndrome. The condition is caused by deletion of 4p. The karyotype is best summarized as: female with a deletion on chromosome 4p16.3. Which notation matches this?
PROMPT_653B_4EC8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_653B_4EC8_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(22)(q11.2)</span>
LITERAL_653B_4EC8_CHOICE_1
$choice_2 = <<'LITERAL_653B_4EC8_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>47,XXY</span>
LITERAL_653B_4EC8_CHOICE_2
$choice_3 = <<'LITERAL_653B_4EC8_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XX/47,XX,+21</span>
LITERAL_653B_4EC8_CHOICE_3
$choice_4 = <<'LITERAL_653B_4EC8_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(4)(p16.3)</span>
LITERAL_653B_4EC8_CHOICE_4
$choice_5 = <<'LITERAL_653B_4EC8_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+18</span>
LITERAL_653B_4EC8_CHOICE_5
$correct_1 = <<'LITERAL_653B_4EC8_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,del(4)(p16.3)</span>
LITERAL_653B_4EC8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
