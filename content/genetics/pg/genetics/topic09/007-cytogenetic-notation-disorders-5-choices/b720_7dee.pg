## DESCRIPTION
## Imported Genetics source row b720_7dee; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-disorders-5_choices-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B720_7DEE';
<p>b720_7dee</p> A patient has findings consistent with CML with Philadelphia chromosome. The condition is caused by reciprocal translocation between 9q34 and 22q11.2. The karyotype is best summarized as: male with reciprocal translocation between chromosomes 9 and 22 at q34 and q11.2. Which notation matches this?
PROMPT_B720_7DEE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B720_7DEE_CHOICE_1';
<span style='font-family: monospace; font-weight: bold;'>46,XX,t(9;22)(q34;q11.2)</span>
LITERAL_B720_7DEE_CHOICE_1
$choice_2 = <<'LITERAL_B720_7DEE_CHOICE_2';
<span style='font-family: monospace; font-weight: bold;'>46,XY,del(4)(p16.3)</span>
LITERAL_B720_7DEE_CHOICE_2
$choice_3 = <<'LITERAL_B720_7DEE_CHOICE_3';
<span style='font-family: monospace; font-weight: bold;'>46,XY/47,XYY</span>
LITERAL_B720_7DEE_CHOICE_3
$choice_4 = <<'LITERAL_B720_7DEE_CHOICE_4';
<span style='font-family: monospace; font-weight: bold;'>46,XY,t(9;22)(q34;q11.2)</span>
LITERAL_B720_7DEE_CHOICE_4
$choice_5 = <<'LITERAL_B720_7DEE_CHOICE_5';
<span style='font-family: monospace; font-weight: bold;'>47,XX,+13</span>
LITERAL_B720_7DEE_CHOICE_5
$correct_1 = <<'LITERAL_B720_7DEE_CORRECT_1';
<span style='font-family: monospace; font-weight: bold;'>46,XY,t(9;22)(q34;q11.2)</span>
LITERAL_B720_7DEE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
