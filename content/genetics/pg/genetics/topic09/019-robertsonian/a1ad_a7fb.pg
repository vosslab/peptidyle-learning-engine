DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_A1AD_A7FB';
<p>a1ad_a7fb</p> <p>An individual has a Robertsonian translocation involving chromosomes 13 and 22.</p><h5>Which one of the following gametes was formed by <span style="color: darkred;">alternate</span> segregation in this individual?</h5><table style="border-collapse: collapse; border: 0px solid white;"><tr> <td align="left"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="42.0"></colgroup><colgroup width="24"></colgroup><colgroup width="279.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td></tr></table></td></tr><tr> <td align="left"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="33.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr><tr> <td align="left"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="279.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr></table><p>all of three of the chromosomes in a somatic cell are shown above.</p><p></p>
PROMPT_A1AD_A7FB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_A1AD_A7FB_CHOICE_1';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">rob(13; 22), +22</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="279.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="33.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CHOICE_1
$choice_2 = <<'LITERAL_A1AD_A7FB_CHOICE_2';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">rob(13; 22)</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="279.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CHOICE_2
$choice_3 = <<'LITERAL_A1AD_A7FB_CHOICE_3';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">&ndash;22</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="42.0"></colgroup><colgroup width="24"></colgroup><colgroup width="279.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CHOICE_3
$choice_4 = <<'LITERAL_A1AD_A7FB_CHOICE_4';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">rob(13; 22), +13</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="279.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="42.0"></colgroup><colgroup width="24"></colgroup><colgroup width="279.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CHOICE_4
$choice_5 = <<'LITERAL_A1AD_A7FB_CHOICE_5';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">&ndash;13</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="33.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22p</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CHOICE_5
$correct_1 = <<'LITERAL_A1AD_A7FB_CORRECT_1';
<table style="border-collapse: collapse; border: 1px solid silver;"><tr><td style="border: 0px solid white;">rob(13; 22)</td></tr><tr><td style="border: 0px solid white;"><table style="border-collapse: collapse; border: 0px solid white; height: 30px"><colgroup width="279.0"></colgroup><colgroup width="24"></colgroup><colgroup width="99.0"></colgroup><tr><td bgcolor="deepskyblue" style="border: 2px solid black;" align="center"><span style="font-size: small">13q</span></td><td bgcolor="SlateGray" style="border: 4px solid black;"></td><td bgcolor="coral" style="border: 2px solid black;" align="center"><span style="font-size: small">22q</span></td></tr></table></td></tr></table><p></p><p></p>
LITERAL_A1AD_A7FB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
