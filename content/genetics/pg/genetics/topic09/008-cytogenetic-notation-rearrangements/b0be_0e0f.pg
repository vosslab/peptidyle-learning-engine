DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B0BE_0E0F';
<p>b0be_0e0f</p> In cytogenetic terms, what is meant by the human karyotype "46,XY,del(2q8)"?
PROMPT_B0BE_0E0F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B0BE_0E0F_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>2</span> at band <span style='color: #e69100;'>8</span>
LITERAL_B0BE_0E0F_CHOICE_1
$choice_2 = <<'LITERAL_B0BE_0E0F_CHOICE_2';
<span style='color: #7b12a1;'>A deletion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>2</span> at band <span style='color: #e69100;'>8</span>
LITERAL_B0BE_0E0F_CHOICE_2
$choice_3 = <<'LITERAL_B0BE_0E0F_CHOICE_3';
<span style='color: #7b12a1;'>A deletion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>8</span> at band <span style='color: #e69100;'>2</span>
LITERAL_B0BE_0E0F_CHOICE_3
$choice_4 = <<'LITERAL_B0BE_0E0F_CHOICE_4';
<span style='color: #7b12a1;'>A deletion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>2</span> at band <span style='color: #e69100;'>8</span>
LITERAL_B0BE_0E0F_CHOICE_4
$choice_5 = <<'LITERAL_B0BE_0E0F_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>2</span> at band <span style='color: #e69100;'>8</span>
LITERAL_B0BE_0E0F_CHOICE_5
$correct_1 = <<'LITERAL_B0BE_0E0F_CORRECT_1';
<span style='color: #7b12a1;'>A deletion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>2</span> at band <span style='color: #e69100;'>8</span>
LITERAL_B0BE_0E0F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
