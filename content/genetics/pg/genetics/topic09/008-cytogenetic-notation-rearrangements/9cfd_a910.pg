DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9CFD_A910';
<p>9cfd_a910</p> In human genetics, what does the notation "46,XX,dup(18q6)" indicate?
PROMPT_9CFD_A910
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9CFD_A910_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>18</span> at band <span style='color: #e69100;'>6</span>
LITERAL_9CFD_A910_CHOICE_1
$choice_2 = <<'LITERAL_9CFD_A910_CHOICE_2';
<span style='color: #7b12a1;'>A deletion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>6</span> at band <span style='color: #e69100;'>18</span>
LITERAL_9CFD_A910_CHOICE_2
$choice_3 = <<'LITERAL_9CFD_A910_CHOICE_3';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>18</span> at band <span style='color: #e69100;'>6</span>
LITERAL_9CFD_A910_CHOICE_3
$choice_4 = <<'LITERAL_9CFD_A910_CHOICE_4';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>6</span> at band <span style='color: #e69100;'>18</span>
LITERAL_9CFD_A910_CHOICE_4
$choice_5 = <<'LITERAL_9CFD_A910_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>6</span> at band <span style='color: #e69100;'>18</span>
LITERAL_9CFD_A910_CHOICE_5
$correct_1 = <<'LITERAL_9CFD_A910_CORRECT_1';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>18</span> at band <span style='color: #e69100;'>6</span>
LITERAL_9CFD_A910_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
