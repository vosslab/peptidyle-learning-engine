## DESCRIPTION
## Imported Genetics source row cadf_3b75; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-rearrangements-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CADF_3B75';
<p>cadf_3b75</p> What does the notation "46,XY,t(20;8)(q10;p16)" describe in human karyotypes?
PROMPT_CADF_3B75
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CADF_3B75_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 20</span> at <span style='color: #e69100;'>band 8</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 16</span> at <span style='color: #b3b300;'>band 10</span>
LITERAL_CADF_3B75_CHOICE_1
$choice_2 = <<'LITERAL_CADF_3B75_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 20</span> at <span style='color: #e69100;'>band 10</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 8</span> at <span style='color: #b3b300;'>band 16</span>
LITERAL_CADF_3B75_CHOICE_2
$choice_3 = <<'LITERAL_CADF_3B75_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 20</span> at <span style='color: #e69100;'>band 10</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 8</span> at <span style='color: #b3b300;'>band 16</span>
LITERAL_CADF_3B75_CHOICE_3
$choice_4 = <<'LITERAL_CADF_3B75_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 10</span> at <span style='color: #e69100;'>band 20</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 16</span> at <span style='color: #b3b300;'>band 8</span>
LITERAL_CADF_3B75_CHOICE_4
$choice_5 = <<'LITERAL_CADF_3B75_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 10</span> at <span style='color: #e69100;'>band 16</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 20</span> at <span style='color: #b3b300;'>band 8</span>
LITERAL_CADF_3B75_CHOICE_5
$correct_1 = <<'LITERAL_CADF_3B75_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 20</span> at <span style='color: #e69100;'>band 10</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 8</span> at <span style='color: #b3b300;'>band 16</span>
LITERAL_CADF_3B75_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
