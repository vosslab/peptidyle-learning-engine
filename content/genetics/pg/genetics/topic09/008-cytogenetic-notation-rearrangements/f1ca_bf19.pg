## DESCRIPTION
## Imported Genetics source row f1ca_bf19; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-cytogenetic_notation-rearrangements-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F1CA_BF19';
<p>f1ca_bf19</p> What does "46,XX,inv(15q22)" imply in terms of human chromosome structure?
PROMPT_F1CA_BF19
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F1CA_BF19_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>15</span> at band <span style='color: #e69100;'>22</span>
LITERAL_F1CA_BF19_CHOICE_1
$choice_2 = <<'LITERAL_F1CA_BF19_CHOICE_2';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>15</span> at band <span style='color: #e69100;'>22</span>
LITERAL_F1CA_BF19_CHOICE_2
$choice_3 = <<'LITERAL_F1CA_BF19_CHOICE_3';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>22</span> at band <span style='color: #e69100;'>15</span>
LITERAL_F1CA_BF19_CHOICE_3
$choice_4 = <<'LITERAL_F1CA_BF19_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>22</span> at band <span style='color: #e69100;'>15</span>
LITERAL_F1CA_BF19_CHOICE_4
$choice_5 = <<'LITERAL_F1CA_BF19_CHOICE_5';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>15</span> at band <span style='color: #e69100;'>22</span>
LITERAL_F1CA_BF19_CHOICE_5
$correct_1 = <<'LITERAL_F1CA_BF19_CORRECT_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>15</span> at band <span style='color: #e69100;'>22</span>
LITERAL_F1CA_BF19_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
