DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0A9F_A358';
<p>0a9f_a358</p> In the context of human karyotypes, what does "46,XY,inv(17p11)" mean?
PROMPT_0A9F_A358
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0A9F_A358_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>11</span> at band <span style='color: #e69100;'>17</span>
LITERAL_0A9F_A358_CHOICE_1
$choice_2 = <<'LITERAL_0A9F_A358_CHOICE_2';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>11</span> at band <span style='color: #e69100;'>17</span>
LITERAL_0A9F_A358_CHOICE_2
$choice_3 = <<'LITERAL_0A9F_A358_CHOICE_3';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>17</span> at band <span style='color: #e69100;'>11</span>
LITERAL_0A9F_A358_CHOICE_3
$choice_4 = <<'LITERAL_0A9F_A358_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>17</span> at band <span style='color: #e69100;'>11</span>
LITERAL_0A9F_A358_CHOICE_4
$choice_5 = <<'LITERAL_0A9F_A358_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>17</span> at band <span style='color: #e69100;'>11</span>
LITERAL_0A9F_A358_CHOICE_5
$correct_1 = <<'LITERAL_0A9F_A358_CORRECT_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>17</span> at band <span style='color: #e69100;'>11</span>
LITERAL_0A9F_A358_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
