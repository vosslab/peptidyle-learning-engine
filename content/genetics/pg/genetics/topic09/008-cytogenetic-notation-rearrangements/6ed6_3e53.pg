DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6ED6_3E53';
<p>6ed6_3e53</p> In the context of human karyotypes, what does "46,XX,t(11;16)(q17;q14)" mean?
PROMPT_6ED6_3E53
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6ED6_3E53_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 16</span> at <span style='color: #e69100;'>band 14</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 17</span> at <span style='color: #b3b300;'>band 11</span>
LITERAL_6ED6_3E53_CHOICE_1
$choice_2 = <<'LITERAL_6ED6_3E53_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 11</span> at <span style='color: #e69100;'>band 17</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 16</span> at <span style='color: #b3b300;'>band 14</span>
LITERAL_6ED6_3E53_CHOICE_2
$choice_3 = <<'LITERAL_6ED6_3E53_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 11</span> at <span style='color: #e69100;'>band 16</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 14</span> at <span style='color: #b3b300;'>band 17</span>
LITERAL_6ED6_3E53_CHOICE_3
$choice_4 = <<'LITERAL_6ED6_3E53_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 14</span> at <span style='color: #e69100;'>band 11</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 17</span> at <span style='color: #b3b300;'>band 16</span>
LITERAL_6ED6_3E53_CHOICE_4
$choice_5 = <<'LITERAL_6ED6_3E53_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 11</span> at <span style='color: #e69100;'>band 16</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 14</span> at <span style='color: #b3b300;'>band 17</span>
LITERAL_6ED6_3E53_CHOICE_5
$correct_1 = <<'LITERAL_6ED6_3E53_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 11</span> at <span style='color: #e69100;'>band 17</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 16</span> at <span style='color: #b3b300;'>band 14</span>
LITERAL_6ED6_3E53_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
