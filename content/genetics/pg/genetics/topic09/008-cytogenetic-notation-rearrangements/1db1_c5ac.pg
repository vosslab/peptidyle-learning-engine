DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1DB1_C5AC';
<p>1db1_c5ac</p> What does "46,XX,inv(14q3)" imply in terms of human chromosome structure?
PROMPT_1DB1_C5AC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1DB1_C5AC_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>14</span> at band <span style='color: #e69100;'>3</span>
LITERAL_1DB1_C5AC_CHOICE_1
$choice_2 = <<'LITERAL_1DB1_C5AC_CHOICE_2';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>3</span> at band <span style='color: #e69100;'>14</span>
LITERAL_1DB1_C5AC_CHOICE_2
$choice_3 = <<'LITERAL_1DB1_C5AC_CHOICE_3';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>3</span> at band <span style='color: #e69100;'>14</span>
LITERAL_1DB1_C5AC_CHOICE_3
$choice_4 = <<'LITERAL_1DB1_C5AC_CHOICE_4';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>3</span> at band <span style='color: #e69100;'>14</span>
LITERAL_1DB1_C5AC_CHOICE_4
$choice_5 = <<'LITERAL_1DB1_C5AC_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>3</span> at band <span style='color: #e69100;'>14</span>
LITERAL_1DB1_C5AC_CHOICE_5
$correct_1 = <<'LITERAL_1DB1_C5AC_CORRECT_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>14</span> at band <span style='color: #e69100;'>3</span>
LITERAL_1DB1_C5AC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
