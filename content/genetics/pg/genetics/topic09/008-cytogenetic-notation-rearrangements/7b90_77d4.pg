DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7B90_77D4';
<p>7b90_77d4</p> What does "46,XX,dup(7p10)" signify in a human karyotype?
PROMPT_7B90_77D4
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7B90_77D4_CHOICE_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>7</span> at band <span style='color: #e69100;'>10</span>
LITERAL_7B90_77D4_CHOICE_1
$choice_2 = <<'LITERAL_7B90_77D4_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>7</span> at band <span style='color: #e69100;'>10</span>
LITERAL_7B90_77D4_CHOICE_2
$choice_3 = <<'LITERAL_7B90_77D4_CHOICE_3';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of chromosome <span style='color: #004d99;'>10</span> at band <span style='color: #e69100;'>7</span>
LITERAL_7B90_77D4_CHOICE_3
$choice_4 = <<'LITERAL_7B90_77D4_CHOICE_4';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>10</span> at band <span style='color: #e69100;'>7</span>
LITERAL_7B90_77D4_CHOICE_4
$choice_5 = <<'LITERAL_7B90_77D4_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>7</span> at band <span style='color: #e69100;'>10</span>
LITERAL_7B90_77D4_CHOICE_5
$correct_1 = <<'LITERAL_7B90_77D4_CORRECT_1';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of chromosome <span style='color: #004d99;'>7</span> at band <span style='color: #e69100;'>10</span>
LITERAL_7B90_77D4_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
