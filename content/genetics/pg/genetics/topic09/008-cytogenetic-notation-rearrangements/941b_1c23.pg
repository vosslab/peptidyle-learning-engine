DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_941B_1C23';
<p>941b_1c23</p> What does the notation "46,XY,t(22;13)(q3;q6)" describe in human karyotypes?
PROMPT_941B_1C23
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_941B_1C23_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 6</span> at <span style='color: #e69100;'>band 13</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 3</span> at <span style='color: #b3b300;'>band 22</span>
LITERAL_941B_1C23_CHOICE_1
$choice_2 = <<'LITERAL_941B_1C23_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 22</span> at <span style='color: #e69100;'>band 3</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 6</span>
LITERAL_941B_1C23_CHOICE_2
$choice_3 = <<'LITERAL_941B_1C23_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 22</span> at <span style='color: #e69100;'>band 6</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 3</span> at <span style='color: #b3b300;'>band 13</span>
LITERAL_941B_1C23_CHOICE_3
$choice_4 = <<'LITERAL_941B_1C23_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 6</span> at <span style='color: #e69100;'>band 22</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 3</span>
LITERAL_941B_1C23_CHOICE_4
$choice_5 = <<'LITERAL_941B_1C23_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 3</span> at <span style='color: #e69100;'>band 6</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 22</span>
LITERAL_941B_1C23_CHOICE_5
$correct_1 = <<'LITERAL_941B_1C23_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 22</span> at <span style='color: #e69100;'>band 3</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 6</span>
LITERAL_941B_1C23_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
