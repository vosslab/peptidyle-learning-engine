DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1A06_9B1C';
<p>1a06_9b1c</p> How is the notation "46,XY,t(5;9)(q3;q22)" interpreted in human genetics?
PROMPT_1A06_9B1C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1A06_9B1C_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 3</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 22</span> at <span style='color: #b3b300;'>band 5</span>
LITERAL_1A06_9B1C_CHOICE_1
$choice_2 = <<'LITERAL_1A06_9B1C_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 22</span> at <span style='color: #e69100;'>band 5</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 3</span> at <span style='color: #b3b300;'>band 9</span>
LITERAL_1A06_9B1C_CHOICE_2
$choice_3 = <<'LITERAL_1A06_9B1C_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 5</span> at <span style='color: #e69100;'>band 3</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 9</span> at <span style='color: #b3b300;'>band 22</span>
LITERAL_1A06_9B1C_CHOICE_3
$choice_4 = <<'LITERAL_1A06_9B1C_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 5</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 22</span> at <span style='color: #b3b300;'>band 3</span>
LITERAL_1A06_9B1C_CHOICE_4
$choice_5 = <<'LITERAL_1A06_9B1C_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 5</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 3</span> at <span style='color: #b3b300;'>band 22</span>
LITERAL_1A06_9B1C_CHOICE_5
$correct_1 = <<'LITERAL_1A06_9B1C_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 5</span> at <span style='color: #e69100;'>band 3</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 9</span> at <span style='color: #b3b300;'>band 22</span>
LITERAL_1A06_9B1C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
