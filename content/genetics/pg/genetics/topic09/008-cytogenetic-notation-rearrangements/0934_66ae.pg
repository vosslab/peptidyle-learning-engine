DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0934_66AE';
<p>0934_66ae</p> In cytogenetic terms, what is meant by the human karyotype "46,XX,t(9;13)(q21;p2)"?
PROMPT_0934_66AE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0934_66AE_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 13</span> at <span style='color: #e69100;'>band 9</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 21</span> at <span style='color: #b3b300;'>band 2</span>
LITERAL_0934_66AE_CHOICE_1
$choice_2 = <<'LITERAL_0934_66AE_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 2</span> at <span style='color: #e69100;'>band 9</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 21</span>
LITERAL_0934_66AE_CHOICE_2
$choice_3 = <<'LITERAL_0934_66AE_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 21</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 2</span> at <span style='color: #b3b300;'>band 13</span>
LITERAL_0934_66AE_CHOICE_3
$choice_4 = <<'LITERAL_0934_66AE_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 21</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 2</span>
LITERAL_0934_66AE_CHOICE_4
$choice_5 = <<'LITERAL_0934_66AE_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 21</span> at <span style='color: #e69100;'>band 2</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 9</span> at <span style='color: #b3b300;'>band 13</span>
LITERAL_0934_66AE_CHOICE_5
$correct_1 = <<'LITERAL_0934_66AE_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 9</span> at <span style='color: #e69100;'>band 21</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 13</span> at <span style='color: #b3b300;'>band 2</span>
LITERAL_0934_66AE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
