DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5192_A33B';
<p>5192_a33b</p> For human karyotypes, what does the cytogenetic notation "46,XX,t(12;2)(p1;p19)" refer to?
PROMPT_5192_A33B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5192_A33B_CHOICE_1';
<span style='color: #00b38f;'>An inversion</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 19</span> at <span style='color: #e69100;'>band 12</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 1</span> at <span style='color: #b3b300;'>band 2</span>
LITERAL_5192_A33B_CHOICE_1
$choice_2 = <<'LITERAL_5192_A33B_CHOICE_2';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 1</span> at <span style='color: #e69100;'>band 12</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 19</span> at <span style='color: #b3b300;'>band 2</span>
LITERAL_5192_A33B_CHOICE_2
$choice_3 = <<'LITERAL_5192_A33B_CHOICE_3';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 12</span> at <span style='color: #e69100;'>band 1</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 2</span> at <span style='color: #b3b300;'>band 19</span>
LITERAL_5192_A33B_CHOICE_3
$choice_4 = <<'LITERAL_5192_A33B_CHOICE_4';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 12</span> at <span style='color: #e69100;'>band 2</span> and the <span style='color: #0039e6;'>long arm</span> of <span style='color: #0a9bf5;'>chromosome 19</span> at <span style='color: #b3b300;'>band 1</span>
LITERAL_5192_A33B_CHOICE_4
$choice_5 = <<'LITERAL_5192_A33B_CHOICE_5';
<span style='color: #e65400;'>A duplication</span> involving the <span style='color: #0039e6;'>long arm</span> of <span style='color: #004d99;'>chromosome 2</span> at <span style='color: #e69100;'>band 1</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 19</span> at <span style='color: #b3b300;'>band 12</span>
LITERAL_5192_A33B_CHOICE_5
$correct_1 = <<'LITERAL_5192_A33B_CORRECT_1';
<span style='color: #e60000;'>A translocation</span> involving the <span style='color: #59b300;'>short arm</span> of <span style='color: #004d99;'>chromosome 12</span> at <span style='color: #e69100;'>band 1</span> and the <span style='color: #59b300;'>short arm</span> of <span style='color: #0a9bf5;'>chromosome 2</span> at <span style='color: #b3b300;'>band 19</span>
LITERAL_5192_A33B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
