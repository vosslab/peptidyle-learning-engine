$choice_2 = <<'LITERAL_ECEA_CF38_CHOICE_2';
<strong><span style='font-family: monospace;'>PADRES</span></strong>:&nbsp;&nbsp; <i>gene order of P, A, D, R, E, and S</i>
LITERAL_ECEA_CF38_CHOICE_2
$choice_3 = <<'LITERAL_ECEA_CF38_CHOICE_3';
<strong><span style='font-family: monospace;'>PARSED</span></strong>:&nbsp;&nbsp; <i>gene order of P, A, R, S, E, and D</i>
