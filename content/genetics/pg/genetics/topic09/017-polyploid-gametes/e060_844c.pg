## DESCRIPTION
## Imported Genetics source row e060_844c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E060_844C';
<p>e060_844c</p> <p>A a tetraploid plant species is found to be 4n = 44 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 44/2 = 22 and 44/4 = 11</i></p>
PROMPT_E060_844C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E060_844C_CHOICE_1';
2 chromosomes
LITERAL_E060_844C_CHOICE_1
$choice_2 = <<'LITERAL_E060_844C_CHOICE_2';
4 chromosomes
LITERAL_E060_844C_CHOICE_2
$choice_3 = <<'LITERAL_E060_844C_CHOICE_3';
8 chromosomes
LITERAL_E060_844C_CHOICE_3
$choice_4 = <<'LITERAL_E060_844C_CHOICE_4';
11 chromosomes
LITERAL_E060_844C_CHOICE_4
$choice_5 = <<'LITERAL_E060_844C_CHOICE_5';
22 chromosomes
LITERAL_E060_844C_CHOICE_5
$correct_1 = <<'LITERAL_E060_844C_CORRECT_1';
22 chromosomes
LITERAL_E060_844C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
