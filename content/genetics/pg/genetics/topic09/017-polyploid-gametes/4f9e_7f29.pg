## DESCRIPTION
## Imported Genetics source row 4f9e_7f29; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4F9E_7F29';
<p>4f9e_7f29</p> <p>A a decaploid plant species is found to be 10n = 100 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 100/2 = 50 and 100/10 = 10</i></p>
PROMPT_4F9E_7F29
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4F9E_7F29_CHOICE_1';
10 chromosomes
LITERAL_4F9E_7F29_CHOICE_1
$choice_2 = <<'LITERAL_4F9E_7F29_CHOICE_2';
20 chromosomes
LITERAL_4F9E_7F29_CHOICE_2
$choice_3 = <<'LITERAL_4F9E_7F29_CHOICE_3';
25 chromosomes
LITERAL_4F9E_7F29_CHOICE_3
$choice_4 = <<'LITERAL_4F9E_7F29_CHOICE_4';
50 chromosomes
LITERAL_4F9E_7F29_CHOICE_4
$choice_5 = <<'LITERAL_4F9E_7F29_CHOICE_5';
200 chromosomes
LITERAL_4F9E_7F29_CHOICE_5
$correct_1 = <<'LITERAL_4F9E_7F29_CORRECT_1';
50 chromosomes
LITERAL_4F9E_7F29_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
