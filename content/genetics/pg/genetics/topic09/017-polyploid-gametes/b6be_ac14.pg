## DESCRIPTION
## Imported Genetics source row b6be_ac14; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B6BE_AC14';
<p>b6be_ac14</p> <p>A a decaploid plant species is found to be 10n = 90 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 90/2 = 45 and 90/10 = 9</i></p>
PROMPT_B6BE_AC14
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B6BE_AC14_CHOICE_1';
9 chromosomes
LITERAL_B6BE_AC14_CHOICE_1
$choice_2 = <<'LITERAL_B6BE_AC14_CHOICE_2';
10 chromosomes
LITERAL_B6BE_AC14_CHOICE_2
$choice_3 = <<'LITERAL_B6BE_AC14_CHOICE_3';
18 chromosomes
LITERAL_B6BE_AC14_CHOICE_3
$choice_4 = <<'LITERAL_B6BE_AC14_CHOICE_4';
22 chromosomes
LITERAL_B6BE_AC14_CHOICE_4
$choice_5 = <<'LITERAL_B6BE_AC14_CHOICE_5';
45 chromosomes
LITERAL_B6BE_AC14_CHOICE_5
$correct_1 = <<'LITERAL_B6BE_AC14_CORRECT_1';
45 chromosomes
LITERAL_B6BE_AC14_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
