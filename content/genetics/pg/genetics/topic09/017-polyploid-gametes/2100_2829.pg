## DESCRIPTION
## Imported Genetics source row 2100_2829; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2100_2829';
<p>2100_2829</p> <p>A a dodecaploid plant species is found to be 12n = 84 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 84/12 = 7 and 84/2 = 42</i></p>
PROMPT_2100_2829
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2100_2829_CHOICE_1';
6 chromosomes
LITERAL_2100_2829_CHOICE_1
$choice_2 = <<'LITERAL_2100_2829_CHOICE_2';
7 chromosomes
LITERAL_2100_2829_CHOICE_2
$choice_3 = <<'LITERAL_2100_2829_CHOICE_3';
14 chromosomes
LITERAL_2100_2829_CHOICE_3
$choice_4 = <<'LITERAL_2100_2829_CHOICE_4';
24 chromosomes
LITERAL_2100_2829_CHOICE_4
$choice_5 = <<'LITERAL_2100_2829_CHOICE_5';
42 chromosomes
LITERAL_2100_2829_CHOICE_5
$correct_1 = <<'LITERAL_2100_2829_CORRECT_1';
42 chromosomes
LITERAL_2100_2829_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
