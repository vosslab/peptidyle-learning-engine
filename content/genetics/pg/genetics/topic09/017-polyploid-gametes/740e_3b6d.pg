## DESCRIPTION
## Imported Genetics source row 740e_3b6d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_740E_3B6D';
<p>740e_3b6d</p> <p>A a hexaploid plant species is found to be 6n = 30 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 30/6 = 5 and 30/2 = 15</i></p>
PROMPT_740E_3B6D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_740E_3B6D_CHOICE_1';
5 chromosomes
LITERAL_740E_3B6D_CHOICE_1
$choice_2 = <<'LITERAL_740E_3B6D_CHOICE_2';
6 chromosomes
LITERAL_740E_3B6D_CHOICE_2
$choice_3 = <<'LITERAL_740E_3B6D_CHOICE_3';
10 chromosomes
LITERAL_740E_3B6D_CHOICE_3
$choice_4 = <<'LITERAL_740E_3B6D_CHOICE_4';
15 chromosomes
LITERAL_740E_3B6D_CHOICE_4
$choice_5 = <<'LITERAL_740E_3B6D_CHOICE_5';
60 chromosomes
LITERAL_740E_3B6D_CHOICE_5
$correct_1 = <<'LITERAL_740E_3B6D_CORRECT_1';
15 chromosomes
LITERAL_740E_3B6D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
