## DESCRIPTION
## Imported Genetics source row 01b2_61ec; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_01B2_61EC';
<p>01b2_61ec</p> <p>A a hexadecaploid plant species is found to be 16n = 144 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 144/2 = 72 and 144/16 = 9</i></p>
PROMPT_01B2_61EC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_01B2_61EC_CHOICE_1';
8 chromosomes
LITERAL_01B2_61EC_CHOICE_1
$choice_2 = <<'LITERAL_01B2_61EC_CHOICE_2';
18 chromosomes
LITERAL_01B2_61EC_CHOICE_2
$choice_3 = <<'LITERAL_01B2_61EC_CHOICE_3';
36 chromosomes
LITERAL_01B2_61EC_CHOICE_3
$choice_4 = <<'LITERAL_01B2_61EC_CHOICE_4';
72 chromosomes
LITERAL_01B2_61EC_CHOICE_4
$choice_5 = <<'LITERAL_01B2_61EC_CHOICE_5';
144 chromosomes
LITERAL_01B2_61EC_CHOICE_5
$correct_1 = <<'LITERAL_01B2_61EC_CORRECT_1';
72 chromosomes
LITERAL_01B2_61EC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
