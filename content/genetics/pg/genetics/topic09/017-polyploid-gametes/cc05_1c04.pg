## DESCRIPTION
## Imported Genetics source row cc05_1c04; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CC05_1C04';
<p>cc05_1c04</p> <p>A a hexadecaploid plant species is found to be 16n = 112 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 112/2 = 56 and 112/16 = 7</i></p>
PROMPT_CC05_1C04
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CC05_1C04_CHOICE_1';
7 chromosomes
LITERAL_CC05_1C04_CHOICE_1
$choice_2 = <<'LITERAL_CC05_1C04_CHOICE_2';
16 chromosomes
LITERAL_CC05_1C04_CHOICE_2
$choice_3 = <<'LITERAL_CC05_1C04_CHOICE_3';
32 chromosomes
LITERAL_CC05_1C04_CHOICE_3
$choice_4 = <<'LITERAL_CC05_1C04_CHOICE_4';
56 chromosomes
LITERAL_CC05_1C04_CHOICE_4
$choice_5 = <<'LITERAL_CC05_1C04_CHOICE_5';
112 chromosomes
LITERAL_CC05_1C04_CHOICE_5
$correct_1 = <<'LITERAL_CC05_1C04_CORRECT_1';
56 chromosomes
LITERAL_CC05_1C04_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
