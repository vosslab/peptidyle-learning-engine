## DESCRIPTION
## Imported Genetics source row 6900_fc4f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6900_FC4F';
<p>6900_fc4f</p> <p>A a dodecaploid plant species is found to be 12n = 108 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 108/12 = 9 and 108/2 = 54</i></p>
PROMPT_6900_FC4F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6900_FC4F_CHOICE_1';
6 chromosomes
LITERAL_6900_FC4F_CHOICE_1
$choice_2 = <<'LITERAL_6900_FC4F_CHOICE_2';
9 chromosomes
LITERAL_6900_FC4F_CHOICE_2
$choice_3 = <<'LITERAL_6900_FC4F_CHOICE_3';
54 chromosomes
LITERAL_6900_FC4F_CHOICE_3
$choice_4 = <<'LITERAL_6900_FC4F_CHOICE_4';
108 chromosomes
LITERAL_6900_FC4F_CHOICE_4
$choice_5 = <<'LITERAL_6900_FC4F_CHOICE_5';
216 chromosomes
LITERAL_6900_FC4F_CHOICE_5
$correct_1 = <<'LITERAL_6900_FC4F_CORRECT_1';
54 chromosomes
LITERAL_6900_FC4F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
