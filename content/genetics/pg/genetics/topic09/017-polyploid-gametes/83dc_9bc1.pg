## DESCRIPTION
## Imported Genetics source row 83dc_9bc1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_83DC_9BC1';
<p>83dc_9bc1</p> <p>A a tetraploid plant species is found to be 4n = 28 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 28/2 = 14 and 28/4 = 7</i></p>
PROMPT_83DC_9BC1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_83DC_9BC1_CHOICE_1';
4 chromosomes
LITERAL_83DC_9BC1_CHOICE_1
$choice_2 = <<'LITERAL_83DC_9BC1_CHOICE_2';
8 chromosomes
LITERAL_83DC_9BC1_CHOICE_2
$choice_3 = <<'LITERAL_83DC_9BC1_CHOICE_3';
14 chromosomes
LITERAL_83DC_9BC1_CHOICE_3
$choice_4 = <<'LITERAL_83DC_9BC1_CHOICE_4';
28 chromosomes
LITERAL_83DC_9BC1_CHOICE_4
$choice_5 = <<'LITERAL_83DC_9BC1_CHOICE_5';
56 chromosomes
LITERAL_83DC_9BC1_CHOICE_5
$correct_1 = <<'LITERAL_83DC_9BC1_CORRECT_1';
14 chromosomes
LITERAL_83DC_9BC1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
