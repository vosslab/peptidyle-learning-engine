## DESCRIPTION
## Imported Genetics source row 08bd_6e22; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_08BD_6E22';
<p>08bd_6e22</p> <p>A a hexadecaploid plant species is found to be 16n = 160 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 160/16 = 10 and 160/2 = 80</i></p>
PROMPT_08BD_6E22
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_08BD_6E22_CHOICE_1';
8 chromosomes
LITERAL_08BD_6E22_CHOICE_1
$choice_2 = <<'LITERAL_08BD_6E22_CHOICE_2';
32 chromosomes
LITERAL_08BD_6E22_CHOICE_2
$choice_3 = <<'LITERAL_08BD_6E22_CHOICE_3';
40 chromosomes
LITERAL_08BD_6E22_CHOICE_3
$choice_4 = <<'LITERAL_08BD_6E22_CHOICE_4';
80 chromosomes
LITERAL_08BD_6E22_CHOICE_4
$choice_5 = <<'LITERAL_08BD_6E22_CHOICE_5';
320 chromosomes
LITERAL_08BD_6E22_CHOICE_5
$correct_1 = <<'LITERAL_08BD_6E22_CORRECT_1';
80 chromosomes
LITERAL_08BD_6E22_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
