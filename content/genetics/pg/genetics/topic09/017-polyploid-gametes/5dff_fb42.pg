## DESCRIPTION
## Imported Genetics source row 5dff_fb42; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5DFF_FB42';
<p>5dff_fb42</p> <p>A a hexaploid plant species is found to be 6n = 30 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 30/2 = 15 and 30/6 = 5</i></p>
PROMPT_5DFF_FB42
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5DFF_FB42_CHOICE_1';
3 chromosomes
LITERAL_5DFF_FB42_CHOICE_1
$choice_2 = <<'LITERAL_5DFF_FB42_CHOICE_2';
5 chromosomes
LITERAL_5DFF_FB42_CHOICE_2
$choice_3 = <<'LITERAL_5DFF_FB42_CHOICE_3';
6 chromosomes
LITERAL_5DFF_FB42_CHOICE_3
$choice_4 = <<'LITERAL_5DFF_FB42_CHOICE_4';
15 chromosomes
LITERAL_5DFF_FB42_CHOICE_4
$choice_5 = <<'LITERAL_5DFF_FB42_CHOICE_5';
30 chromosomes
LITERAL_5DFF_FB42_CHOICE_5
$correct_1 = <<'LITERAL_5DFF_FB42_CORRECT_1';
15 chromosomes
LITERAL_5DFF_FB42_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
