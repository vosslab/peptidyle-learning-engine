## DESCRIPTION
## Imported Genetics source row 642d_92ce; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_642D_92CE';
<p>642d_92ce</p> <p>A a hexaploid plant species is found to be 6n = 60 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 60/6 = 10 and 60/2 = 30</i></p>
PROMPT_642D_92CE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_642D_92CE_CHOICE_1';
6 chromosomes
LITERAL_642D_92CE_CHOICE_1
$choice_2 = <<'LITERAL_642D_92CE_CHOICE_2';
12 chromosomes
LITERAL_642D_92CE_CHOICE_2
$choice_3 = <<'LITERAL_642D_92CE_CHOICE_3';
15 chromosomes
LITERAL_642D_92CE_CHOICE_3
$choice_4 = <<'LITERAL_642D_92CE_CHOICE_4';
20 chromosomes
LITERAL_642D_92CE_CHOICE_4
$choice_5 = <<'LITERAL_642D_92CE_CHOICE_5';
30 chromosomes
LITERAL_642D_92CE_CHOICE_5
$correct_1 = <<'LITERAL_642D_92CE_CORRECT_1';
30 chromosomes
LITERAL_642D_92CE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
