## DESCRIPTION
## Imported Genetics source row de14_f00d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_DE14_F00D';
<p>de14_f00d</p> <p>A a tetradecaploid plant species is found to be 14n = 98 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 98/2 = 49 and 98/14 = 7</i></p>
PROMPT_DE14_F00D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_DE14_F00D_CHOICE_1';
7 chromosomes
LITERAL_DE14_F00D_CHOICE_1
$choice_2 = <<'LITERAL_DE14_F00D_CHOICE_2';
14 chromosomes
LITERAL_DE14_F00D_CHOICE_2
$choice_3 = <<'LITERAL_DE14_F00D_CHOICE_3';
24 chromosomes
LITERAL_DE14_F00D_CHOICE_3
$choice_4 = <<'LITERAL_DE14_F00D_CHOICE_4';
49 chromosomes
LITERAL_DE14_F00D_CHOICE_4
$choice_5 = <<'LITERAL_DE14_F00D_CHOICE_5';
196 chromosomes
LITERAL_DE14_F00D_CHOICE_5
$correct_1 = <<'LITERAL_DE14_F00D_CORRECT_1';
49 chromosomes
LITERAL_DE14_F00D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
