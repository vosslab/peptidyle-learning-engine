## DESCRIPTION
## Imported Genetics source row b7a0_5038; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B7A0_5038';
<p>b7a0_5038</p> <p>A a tetradecaploid plant species is found to be 14n = 56 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 56/2 = 28 and 56/14 = 4</i></p>
PROMPT_B7A0_5038
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B7A0_5038_CHOICE_1';
4 chromosomes
LITERAL_B7A0_5038_CHOICE_1
$choice_2 = <<'LITERAL_B7A0_5038_CHOICE_2';
7 chromosomes
LITERAL_B7A0_5038_CHOICE_2
$choice_3 = <<'LITERAL_B7A0_5038_CHOICE_3';
8 chromosomes
LITERAL_B7A0_5038_CHOICE_3
$choice_4 = <<'LITERAL_B7A0_5038_CHOICE_4';
28 chromosomes
LITERAL_B7A0_5038_CHOICE_4
$choice_5 = <<'LITERAL_B7A0_5038_CHOICE_5';
56 chromosomes
LITERAL_B7A0_5038_CHOICE_5
$correct_1 = <<'LITERAL_B7A0_5038_CORRECT_1';
28 chromosomes
LITERAL_B7A0_5038_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
