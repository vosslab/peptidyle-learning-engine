## DESCRIPTION
## Imported Genetics source row c6a2_b6a9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C6A2_B6A9';
<p>c6a2_b6a9</p> <p>A an octaploid plant species is found to be 8n = 80 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 80/2 = 40 and 80/8 = 10</i></p>
PROMPT_C6A2_B6A9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C6A2_B6A9_CHOICE_1';
4 chromosomes
LITERAL_C6A2_B6A9_CHOICE_1
$choice_2 = <<'LITERAL_C6A2_B6A9_CHOICE_2';
10 chromosomes
LITERAL_C6A2_B6A9_CHOICE_2
$choice_3 = <<'LITERAL_C6A2_B6A9_CHOICE_3';
16 chromosomes
LITERAL_C6A2_B6A9_CHOICE_3
$choice_4 = <<'LITERAL_C6A2_B6A9_CHOICE_4';
40 chromosomes
LITERAL_C6A2_B6A9_CHOICE_4
$choice_5 = <<'LITERAL_C6A2_B6A9_CHOICE_5';
160 chromosomes
LITERAL_C6A2_B6A9_CHOICE_5
$correct_1 = <<'LITERAL_C6A2_B6A9_CORRECT_1';
40 chromosomes
LITERAL_C6A2_B6A9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
