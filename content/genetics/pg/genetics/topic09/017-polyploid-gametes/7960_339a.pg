## DESCRIPTION
## Imported Genetics source row 7960_339a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7960_339A';
<p>7960_339a</p> <p>A a dodecaploid plant species is found to be 12n = 132 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 132/2 = 66 and 132/12 = 11</i></p>
PROMPT_7960_339A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7960_339A_CHOICE_1';
11 chromosomes
LITERAL_7960_339A_CHOICE_1
$choice_2 = <<'LITERAL_7960_339A_CHOICE_2';
12 chromosomes
LITERAL_7960_339A_CHOICE_2
$choice_3 = <<'LITERAL_7960_339A_CHOICE_3';
22 chromosomes
LITERAL_7960_339A_CHOICE_3
$choice_4 = <<'LITERAL_7960_339A_CHOICE_4';
66 chromosomes
LITERAL_7960_339A_CHOICE_4
$choice_5 = <<'LITERAL_7960_339A_CHOICE_5';
132 chromosomes
LITERAL_7960_339A_CHOICE_5
$correct_1 = <<'LITERAL_7960_339A_CORRECT_1';
66 chromosomes
LITERAL_7960_339A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
