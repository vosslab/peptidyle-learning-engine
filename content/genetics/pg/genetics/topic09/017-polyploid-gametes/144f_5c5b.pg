## DESCRIPTION
## Imported Genetics source row 144f_5c5b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_144F_5C5B';
<p>144f_5c5b</p> <p>A a hexadecaploid plant species is found to be 16n = 128 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 128/16 = 8 and 128/2 = 64</i></p>
PROMPT_144F_5C5B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_144F_5C5B_CHOICE_1';
8 chromosomes
LITERAL_144F_5C5B_CHOICE_1
$choice_2 = <<'LITERAL_144F_5C5B_CHOICE_2';
16 chromosomes
LITERAL_144F_5C5B_CHOICE_2
$choice_3 = <<'LITERAL_144F_5C5B_CHOICE_3';
64 chromosomes
LITERAL_144F_5C5B_CHOICE_3
$choice_4 = <<'LITERAL_144F_5C5B_CHOICE_4';
128 chromosomes
LITERAL_144F_5C5B_CHOICE_4
$choice_5 = <<'LITERAL_144F_5C5B_CHOICE_5';
256 chromosomes
LITERAL_144F_5C5B_CHOICE_5
$correct_1 = <<'LITERAL_144F_5C5B_CORRECT_1';
64 chromosomes
LITERAL_144F_5C5B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
