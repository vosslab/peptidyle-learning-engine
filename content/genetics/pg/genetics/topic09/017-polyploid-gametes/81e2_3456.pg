## DESCRIPTION
## Imported Genetics source row 81e2_3456; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_81E2_3456';
<p>81e2_3456</p> <p>A a decaploid plant species is found to be 10n = 110 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 110/10 = 11 and 110/2 = 55</i></p>
PROMPT_81E2_3456
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_81E2_3456_CHOICE_1';
20 chromosomes
LITERAL_81E2_3456_CHOICE_1
$choice_2 = <<'LITERAL_81E2_3456_CHOICE_2';
22 chromosomes
LITERAL_81E2_3456_CHOICE_2
$choice_3 = <<'LITERAL_81E2_3456_CHOICE_3';
27 chromosomes
LITERAL_81E2_3456_CHOICE_3
$choice_4 = <<'LITERAL_81E2_3456_CHOICE_4';
55 chromosomes
LITERAL_81E2_3456_CHOICE_4
$choice_5 = <<'LITERAL_81E2_3456_CHOICE_5';
110 chromosomes
LITERAL_81E2_3456_CHOICE_5
$correct_1 = <<'LITERAL_81E2_3456_CORRECT_1';
55 chromosomes
LITERAL_81E2_3456_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
