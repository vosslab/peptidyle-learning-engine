## DESCRIPTION
## Imported Genetics source row f244_c4ff; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F244_C4FF';
<p>f244_c4ff</p> <p>A an octaploid plant species is found to be 8n = 32 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 32/2 = 16 and 32/8 = 4</i></p>
PROMPT_F244_C4FF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F244_C4FF_CHOICE_1';
4 chromosomes
LITERAL_F244_C4FF_CHOICE_1
$choice_2 = <<'LITERAL_F244_C4FF_CHOICE_2';
8 chromosomes
LITERAL_F244_C4FF_CHOICE_2
$choice_3 = <<'LITERAL_F244_C4FF_CHOICE_3';
16 chromosomes
LITERAL_F244_C4FF_CHOICE_3
$choice_4 = <<'LITERAL_F244_C4FF_CHOICE_4';
32 chromosomes
LITERAL_F244_C4FF_CHOICE_4
$choice_5 = <<'LITERAL_F244_C4FF_CHOICE_5';
64 chromosomes
LITERAL_F244_C4FF_CHOICE_5
$correct_1 = <<'LITERAL_F244_C4FF_CORRECT_1';
16 chromosomes
LITERAL_F244_C4FF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
