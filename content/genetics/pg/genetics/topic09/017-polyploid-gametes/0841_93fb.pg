## DESCRIPTION
## Imported Genetics source row 0841_93fb; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0841_93FB';
<p>0841_93fb</p> <p>A a tetradecaploid plant species is found to be 14n = 154 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 154/2 = 77 and 154/14 = 11</i></p>
PROMPT_0841_93FB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0841_93FB_CHOICE_1';
7 chromosomes
LITERAL_0841_93FB_CHOICE_1
$choice_2 = <<'LITERAL_0841_93FB_CHOICE_2';
11 chromosomes
LITERAL_0841_93FB_CHOICE_2
$choice_3 = <<'LITERAL_0841_93FB_CHOICE_3';
38 chromosomes
LITERAL_0841_93FB_CHOICE_3
$choice_4 = <<'LITERAL_0841_93FB_CHOICE_4';
77 chromosomes
LITERAL_0841_93FB_CHOICE_4
$choice_5 = <<'LITERAL_0841_93FB_CHOICE_5';
308 chromosomes
LITERAL_0841_93FB_CHOICE_5
$correct_1 = <<'LITERAL_0841_93FB_CORRECT_1';
77 chromosomes
LITERAL_0841_93FB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
