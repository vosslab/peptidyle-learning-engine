## DESCRIPTION
## Imported Genetics source row 1e4f_1ea1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1E4F_1EA1';
<p>1e4f_1ea1</p> <p>A a hexaploid plant species is found to be 6n = 48 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 48/2 = 24 and 48/6 = 8</i></p>
PROMPT_1E4F_1EA1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1E4F_1EA1_CHOICE_1';
3 chromosomes
LITERAL_1E4F_1EA1_CHOICE_1
$choice_2 = <<'LITERAL_1E4F_1EA1_CHOICE_2';
6 chromosomes
LITERAL_1E4F_1EA1_CHOICE_2
$choice_3 = <<'LITERAL_1E4F_1EA1_CHOICE_3';
8 chromosomes
LITERAL_1E4F_1EA1_CHOICE_3
$choice_4 = <<'LITERAL_1E4F_1EA1_CHOICE_4';
24 chromosomes
LITERAL_1E4F_1EA1_CHOICE_4
$choice_5 = <<'LITERAL_1E4F_1EA1_CHOICE_5';
48 chromosomes
LITERAL_1E4F_1EA1_CHOICE_5
$correct_1 = <<'LITERAL_1E4F_1EA1_CORRECT_1';
24 chromosomes
LITERAL_1E4F_1EA1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
