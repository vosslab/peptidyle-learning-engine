## DESCRIPTION
## Imported Genetics source row ea59_ab19; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EA59_AB19';
<p>ea59_ab19</p> <p>A a decaploid plant species is found to be 10n = 90 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 90/10 = 9 and 90/2 = 45</i></p>
PROMPT_EA59_AB19
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_EA59_AB19_CHOICE_1';
5 chromosomes
LITERAL_EA59_AB19_CHOICE_1
$choice_2 = <<'LITERAL_EA59_AB19_CHOICE_2';
20 chromosomes
LITERAL_EA59_AB19_CHOICE_2
$choice_3 = <<'LITERAL_EA59_AB19_CHOICE_3';
22 chromosomes
LITERAL_EA59_AB19_CHOICE_3
$choice_4 = <<'LITERAL_EA59_AB19_CHOICE_4';
45 chromosomes
LITERAL_EA59_AB19_CHOICE_4
$choice_5 = <<'LITERAL_EA59_AB19_CHOICE_5';
90 chromosomes
LITERAL_EA59_AB19_CHOICE_5
$correct_1 = <<'LITERAL_EA59_AB19_CORRECT_1';
45 chromosomes
LITERAL_EA59_AB19_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
