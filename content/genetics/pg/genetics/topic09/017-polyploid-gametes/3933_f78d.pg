## DESCRIPTION
## Imported Genetics source row 3933_f78d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3933_F78D';
<p>3933_f78d</p> <p>A an octaploid plant species is found to be 8n = 40 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 40/2 = 20 and 40/8 = 5</i></p>
PROMPT_3933_F78D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3933_F78D_CHOICE_1';
4 chromosomes
LITERAL_3933_F78D_CHOICE_1
$choice_2 = <<'LITERAL_3933_F78D_CHOICE_2';
8 chromosomes
LITERAL_3933_F78D_CHOICE_2
$choice_3 = <<'LITERAL_3933_F78D_CHOICE_3';
10 chromosomes
LITERAL_3933_F78D_CHOICE_3
$choice_4 = <<'LITERAL_3933_F78D_CHOICE_4';
20 chromosomes
LITERAL_3933_F78D_CHOICE_4
$choice_5 = <<'LITERAL_3933_F78D_CHOICE_5';
80 chromosomes
LITERAL_3933_F78D_CHOICE_5
$correct_1 = <<'LITERAL_3933_F78D_CORRECT_1';
20 chromosomes
LITERAL_3933_F78D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
