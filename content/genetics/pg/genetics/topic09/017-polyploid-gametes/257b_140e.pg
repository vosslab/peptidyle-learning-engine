## DESCRIPTION
## Imported Genetics source row 257b_140e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_257B_140E';
<p>257b_140e</p> <p>A a tetradecaploid plant species is found to be 14n = 112 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 112/2 = 56 and 112/14 = 8</i></p>
PROMPT_257B_140E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_257B_140E_CHOICE_1';
14 chromosomes
LITERAL_257B_140E_CHOICE_1
$choice_2 = <<'LITERAL_257B_140E_CHOICE_2';
16 chromosomes
LITERAL_257B_140E_CHOICE_2
$choice_3 = <<'LITERAL_257B_140E_CHOICE_3';
56 chromosomes
LITERAL_257B_140E_CHOICE_3
$choice_4 = <<'LITERAL_257B_140E_CHOICE_4';
112 chromosomes
LITERAL_257B_140E_CHOICE_4
$choice_5 = <<'LITERAL_257B_140E_CHOICE_5';
224 chromosomes
LITERAL_257B_140E_CHOICE_5
$correct_1 = <<'LITERAL_257B_140E_CORRECT_1';
56 chromosomes
LITERAL_257B_140E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
