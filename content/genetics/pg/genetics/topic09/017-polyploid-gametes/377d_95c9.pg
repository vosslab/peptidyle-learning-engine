## DESCRIPTION
## Imported Genetics source row 377d_95c9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_377D_95C9';
<p>377d_95c9</p> <p>A a tetraploid plant species is found to be 4n = 20 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 20/2 = 10 and 20/4 = 5</i></p>
PROMPT_377D_95C9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_377D_95C9_CHOICE_1';
2 chromosomes
LITERAL_377D_95C9_CHOICE_1
$choice_2 = <<'LITERAL_377D_95C9_CHOICE_2';
4 chromosomes
LITERAL_377D_95C9_CHOICE_2
$choice_3 = <<'LITERAL_377D_95C9_CHOICE_3';
5 chromosomes
LITERAL_377D_95C9_CHOICE_3
$choice_4 = <<'LITERAL_377D_95C9_CHOICE_4';
10 chromosomes
LITERAL_377D_95C9_CHOICE_4
$choice_5 = <<'LITERAL_377D_95C9_CHOICE_5';
40 chromosomes
LITERAL_377D_95C9_CHOICE_5
$correct_1 = <<'LITERAL_377D_95C9_CORRECT_1';
10 chromosomes
LITERAL_377D_95C9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
