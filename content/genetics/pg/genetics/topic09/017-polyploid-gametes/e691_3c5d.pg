## DESCRIPTION
## Imported Genetics source row e691_3c5d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E691_3C5D';
<p>e691_3c5d</p> <p>A a decaploid plant species is found to be 10n = 100 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 100/10 = 10 and 100/2 = 50</i></p>
PROMPT_E691_3C5D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E691_3C5D_CHOICE_1';
5 chromosomes
LITERAL_E691_3C5D_CHOICE_1
$choice_2 = <<'LITERAL_E691_3C5D_CHOICE_2';
20 chromosomes
LITERAL_E691_3C5D_CHOICE_2
$choice_3 = <<'LITERAL_E691_3C5D_CHOICE_3';
25 chromosomes
LITERAL_E691_3C5D_CHOICE_3
$choice_4 = <<'LITERAL_E691_3C5D_CHOICE_4';
50 chromosomes
LITERAL_E691_3C5D_CHOICE_4
$choice_5 = <<'LITERAL_E691_3C5D_CHOICE_5';
100 chromosomes
LITERAL_E691_3C5D_CHOICE_5
$correct_1 = <<'LITERAL_E691_3C5D_CORRECT_1';
50 chromosomes
LITERAL_E691_3C5D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
