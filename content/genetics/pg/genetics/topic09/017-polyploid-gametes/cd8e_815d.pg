## DESCRIPTION
## Imported Genetics source row cd8e_815d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CD8E_815D';
<p>cd8e_815d</p> <p>A a hexaploid plant species is found to be 6n = 54 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 54/6 = 9 and 54/2 = 27</i></p>
PROMPT_CD8E_815D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CD8E_815D_CHOICE_1';
6 chromosomes
LITERAL_CD8E_815D_CHOICE_1
$choice_2 = <<'LITERAL_CD8E_815D_CHOICE_2';
9 chromosomes
LITERAL_CD8E_815D_CHOICE_2
$choice_3 = <<'LITERAL_CD8E_815D_CHOICE_3';
27 chromosomes
LITERAL_CD8E_815D_CHOICE_3
$choice_4 = <<'LITERAL_CD8E_815D_CHOICE_4';
54 chromosomes
LITERAL_CD8E_815D_CHOICE_4
$choice_5 = <<'LITERAL_CD8E_815D_CHOICE_5';
108 chromosomes
LITERAL_CD8E_815D_CHOICE_5
$correct_1 = <<'LITERAL_CD8E_815D_CORRECT_1';
27 chromosomes
LITERAL_CD8E_815D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
