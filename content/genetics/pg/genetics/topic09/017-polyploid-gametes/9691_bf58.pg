## DESCRIPTION
## Imported Genetics source row 9691_bf58; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9691_BF58';
<p>9691_bf58</p> <p>A a decaploid plant species is found to be 10n = 40 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 40/2 = 20 and 40/10 = 4</i></p>
PROMPT_9691_BF58
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9691_BF58_CHOICE_1';
4 chromosomes
LITERAL_9691_BF58_CHOICE_1
$choice_2 = <<'LITERAL_9691_BF58_CHOICE_2';
5 chromosomes
LITERAL_9691_BF58_CHOICE_2
$choice_3 = <<'LITERAL_9691_BF58_CHOICE_3';
8 chromosomes
LITERAL_9691_BF58_CHOICE_3
$choice_4 = <<'LITERAL_9691_BF58_CHOICE_4';
20 chromosomes
LITERAL_9691_BF58_CHOICE_4
$choice_5 = <<'LITERAL_9691_BF58_CHOICE_5';
40 chromosomes
LITERAL_9691_BF58_CHOICE_5
$correct_1 = <<'LITERAL_9691_BF58_CORRECT_1';
20 chromosomes
LITERAL_9691_BF58_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
