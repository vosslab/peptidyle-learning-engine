## DESCRIPTION
## Imported Genetics source row f27a_0080; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F27A_0080';
<p>f27a_0080</p> <p>A a hexadecaploid plant species is found to be 16n = 96 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 96/16 = 6 and 96/2 = 48</i></p>
PROMPT_F27A_0080
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F27A_0080_CHOICE_1';
6 chromosomes
LITERAL_F27A_0080_CHOICE_1
$choice_2 = <<'LITERAL_F27A_0080_CHOICE_2';
24 chromosomes
LITERAL_F27A_0080_CHOICE_2
$choice_3 = <<'LITERAL_F27A_0080_CHOICE_3';
32 chromosomes
LITERAL_F27A_0080_CHOICE_3
$choice_4 = <<'LITERAL_F27A_0080_CHOICE_4';
48 chromosomes
LITERAL_F27A_0080_CHOICE_4
$choice_5 = <<'LITERAL_F27A_0080_CHOICE_5';
96 chromosomes
LITERAL_F27A_0080_CHOICE_5
$correct_1 = <<'LITERAL_F27A_0080_CORRECT_1';
48 chromosomes
LITERAL_F27A_0080_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
