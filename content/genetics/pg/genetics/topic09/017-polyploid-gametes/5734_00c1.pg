## DESCRIPTION
## Imported Genetics source row 5734_00c1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5734_00C1';
<p>5734_00c1</p> <p>A a tetraploid plant species is found to be 4n = 32 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 32/4 = 8 and 32/2 = 16</i></p>
PROMPT_5734_00C1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5734_00C1_CHOICE_1';
2 chromosomes
LITERAL_5734_00C1_CHOICE_1
$choice_2 = <<'LITERAL_5734_00C1_CHOICE_2';
4 chromosomes
LITERAL_5734_00C1_CHOICE_2
$choice_3 = <<'LITERAL_5734_00C1_CHOICE_3';
8 chromosomes
LITERAL_5734_00C1_CHOICE_3
$choice_4 = <<'LITERAL_5734_00C1_CHOICE_4';
16 chromosomes
LITERAL_5734_00C1_CHOICE_4
$choice_5 = <<'LITERAL_5734_00C1_CHOICE_5';
32 chromosomes
LITERAL_5734_00C1_CHOICE_5
$correct_1 = <<'LITERAL_5734_00C1_CORRECT_1';
16 chromosomes
LITERAL_5734_00C1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
