## DESCRIPTION
## Imported Genetics source row ff2b_529b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FF2B_529B';
<p>ff2b_529b</p> <p>A a hexaploid plant species is found to be 6n = 36 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 36/2 = 18 and 36/6 = 6</i></p>
PROMPT_FF2B_529B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FF2B_529B_CHOICE_1';
3 chromosomes
LITERAL_FF2B_529B_CHOICE_1
$choice_2 = <<'LITERAL_FF2B_529B_CHOICE_2';
6 chromosomes
LITERAL_FF2B_529B_CHOICE_2
$choice_3 = <<'LITERAL_FF2B_529B_CHOICE_3';
12 chromosomes
LITERAL_FF2B_529B_CHOICE_3
$choice_4 = <<'LITERAL_FF2B_529B_CHOICE_4';
18 chromosomes
LITERAL_FF2B_529B_CHOICE_4
$choice_5 = <<'LITERAL_FF2B_529B_CHOICE_5';
72 chromosomes
LITERAL_FF2B_529B_CHOICE_5
$correct_1 = <<'LITERAL_FF2B_529B_CORRECT_1';
18 chromosomes
LITERAL_FF2B_529B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
