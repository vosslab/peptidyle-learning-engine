## DESCRIPTION
## Imported Genetics source row 0c79_6c84; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0C79_6C84';
<p>0c79_6c84</p> <p>A a tetradecaploid plant species is found to be 14n = 154 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 154/14 = 11 and 154/2 = 77</i></p>
PROMPT_0C79_6C84
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0C79_6C84_CHOICE_1';
11 chromosomes
LITERAL_0C79_6C84_CHOICE_1
$choice_2 = <<'LITERAL_0C79_6C84_CHOICE_2';
38 chromosomes
LITERAL_0C79_6C84_CHOICE_2
$choice_3 = <<'LITERAL_0C79_6C84_CHOICE_3';
77 chromosomes
LITERAL_0C79_6C84_CHOICE_3
$choice_4 = <<'LITERAL_0C79_6C84_CHOICE_4';
154 chromosomes
LITERAL_0C79_6C84_CHOICE_4
$choice_5 = <<'LITERAL_0C79_6C84_CHOICE_5';
308 chromosomes
LITERAL_0C79_6C84_CHOICE_5
$correct_1 = <<'LITERAL_0C79_6C84_CORRECT_1';
77 chromosomes
LITERAL_0C79_6C84_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
