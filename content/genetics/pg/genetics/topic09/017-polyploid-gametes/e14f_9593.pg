## DESCRIPTION
## Imported Genetics source row e14f_9593; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E14F_9593';
<p>e14f_9593</p> <p>A a tetradecaploid plant species is found to be 14n = 126 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 126/2 = 63 and 126/14 = 9</i></p>
PROMPT_E14F_9593
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E14F_9593_CHOICE_1';
14 chromosomes
LITERAL_E14F_9593_CHOICE_1
$choice_2 = <<'LITERAL_E14F_9593_CHOICE_2';
28 chromosomes
LITERAL_E14F_9593_CHOICE_2
$choice_3 = <<'LITERAL_E14F_9593_CHOICE_3';
63 chromosomes
LITERAL_E14F_9593_CHOICE_3
$choice_4 = <<'LITERAL_E14F_9593_CHOICE_4';
126 chromosomes
LITERAL_E14F_9593_CHOICE_4
$choice_5 = <<'LITERAL_E14F_9593_CHOICE_5';
252 chromosomes
LITERAL_E14F_9593_CHOICE_5
$correct_1 = <<'LITERAL_E14F_9593_CORRECT_1';
63 chromosomes
LITERAL_E14F_9593_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
