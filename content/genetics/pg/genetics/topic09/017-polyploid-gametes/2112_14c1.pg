## DESCRIPTION
## Imported Genetics source row 2112_14c1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2112_14C1';
<p>2112_14c1</p> <p>A a decaploid plant species is found to be 10n = 60 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 60/2 = 30 and 60/10 = 6</i></p>
PROMPT_2112_14C1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2112_14C1_CHOICE_1';
6 chromosomes
LITERAL_2112_14C1_CHOICE_1
$choice_2 = <<'LITERAL_2112_14C1_CHOICE_2';
12 chromosomes
LITERAL_2112_14C1_CHOICE_2
$choice_3 = <<'LITERAL_2112_14C1_CHOICE_3';
15 chromosomes
LITERAL_2112_14C1_CHOICE_3
$choice_4 = <<'LITERAL_2112_14C1_CHOICE_4';
30 chromosomes
LITERAL_2112_14C1_CHOICE_4
$choice_5 = <<'LITERAL_2112_14C1_CHOICE_5';
120 chromosomes
LITERAL_2112_14C1_CHOICE_5
$correct_1 = <<'LITERAL_2112_14C1_CORRECT_1';
30 chromosomes
LITERAL_2112_14C1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
