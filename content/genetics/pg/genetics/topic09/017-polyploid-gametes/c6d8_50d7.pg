## DESCRIPTION
## Imported Genetics source row c6d8_50d7; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C6D8_50D7';
<p>c6d8_50d7</p> <p>A a dodecaploid plant species is found to be 12n = 120 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 120/2 = 60 and 120/12 = 10</i></p>
PROMPT_C6D8_50D7
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C6D8_50D7_CHOICE_1';
6 chromosomes
LITERAL_C6D8_50D7_CHOICE_1
$choice_2 = <<'LITERAL_C6D8_50D7_CHOICE_2';
24 chromosomes
LITERAL_C6D8_50D7_CHOICE_2
$choice_3 = <<'LITERAL_C6D8_50D7_CHOICE_3';
60 chromosomes
LITERAL_C6D8_50D7_CHOICE_3
$choice_4 = <<'LITERAL_C6D8_50D7_CHOICE_4';
120 chromosomes
LITERAL_C6D8_50D7_CHOICE_4
$choice_5 = <<'LITERAL_C6D8_50D7_CHOICE_5';
240 chromosomes
LITERAL_C6D8_50D7_CHOICE_5
$correct_1 = <<'LITERAL_C6D8_50D7_CORRECT_1';
60 chromosomes
LITERAL_C6D8_50D7_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
