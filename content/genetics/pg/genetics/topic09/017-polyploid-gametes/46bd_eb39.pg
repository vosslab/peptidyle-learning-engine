## DESCRIPTION
## Imported Genetics source row 46bd_eb39; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_46BD_EB39';
<p>46bd_eb39</p> <p>A a hexaploid plant species is found to be 6n = 24 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 24/2 = 12 and 24/6 = 4</i></p>
PROMPT_46BD_EB39
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_46BD_EB39_CHOICE_1';
3 chromosomes
LITERAL_46BD_EB39_CHOICE_1
$choice_2 = <<'LITERAL_46BD_EB39_CHOICE_2';
4 chromosomes
LITERAL_46BD_EB39_CHOICE_2
$choice_3 = <<'LITERAL_46BD_EB39_CHOICE_3';
8 chromosomes
LITERAL_46BD_EB39_CHOICE_3
$choice_4 = <<'LITERAL_46BD_EB39_CHOICE_4';
12 chromosomes
LITERAL_46BD_EB39_CHOICE_4
$choice_5 = <<'LITERAL_46BD_EB39_CHOICE_5';
48 chromosomes
LITERAL_46BD_EB39_CHOICE_5
$correct_1 = <<'LITERAL_46BD_EB39_CORRECT_1';
12 chromosomes
LITERAL_46BD_EB39_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
