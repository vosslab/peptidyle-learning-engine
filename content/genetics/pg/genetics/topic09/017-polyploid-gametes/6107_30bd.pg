## DESCRIPTION
## Imported Genetics source row 6107_30bd; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6107_30BD';
<p>6107_30bd</p> <p>A a tetradecaploid plant species is found to be 14n = 70 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 70/14 = 5 and 70/2 = 35</i></p>
PROMPT_6107_30BD
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6107_30BD_CHOICE_1';
10 chromosomes
LITERAL_6107_30BD_CHOICE_1
$choice_2 = <<'LITERAL_6107_30BD_CHOICE_2';
17 chromosomes
LITERAL_6107_30BD_CHOICE_2
$choice_3 = <<'LITERAL_6107_30BD_CHOICE_3';
35 chromosomes
LITERAL_6107_30BD_CHOICE_3
$choice_4 = <<'LITERAL_6107_30BD_CHOICE_4';
70 chromosomes
LITERAL_6107_30BD_CHOICE_4
$choice_5 = <<'LITERAL_6107_30BD_CHOICE_5';
140 chromosomes
LITERAL_6107_30BD_CHOICE_5
$correct_1 = <<'LITERAL_6107_30BD_CORRECT_1';
35 chromosomes
LITERAL_6107_30BD_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
