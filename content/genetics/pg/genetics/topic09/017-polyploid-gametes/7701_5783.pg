## DESCRIPTION
## Imported Genetics source row 7701_5783; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7701_5783';
<p>7701_5783</p> <p>A a hexaploid plant species is found to be 6n = 42 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 42/6 = 7 and 42/2 = 21</i></p>
PROMPT_7701_5783
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7701_5783_CHOICE_1';
3 chromosomes
LITERAL_7701_5783_CHOICE_1
$choice_2 = <<'LITERAL_7701_5783_CHOICE_2';
6 chromosomes
LITERAL_7701_5783_CHOICE_2
$choice_3 = <<'LITERAL_7701_5783_CHOICE_3';
12 chromosomes
LITERAL_7701_5783_CHOICE_3
$choice_4 = <<'LITERAL_7701_5783_CHOICE_4';
21 chromosomes
LITERAL_7701_5783_CHOICE_4
$choice_5 = <<'LITERAL_7701_5783_CHOICE_5';
84 chromosomes
LITERAL_7701_5783_CHOICE_5
$correct_1 = <<'LITERAL_7701_5783_CORRECT_1';
21 chromosomes
LITERAL_7701_5783_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
