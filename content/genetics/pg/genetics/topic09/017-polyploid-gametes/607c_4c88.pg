## DESCRIPTION
## Imported Genetics source row 607c_4c88; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_607C_4C88';
<p>607c_4c88</p> <p>A a hexaploid plant species is found to be 6n = 42 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 42/2 = 21 and 42/6 = 7</i></p>
PROMPT_607C_4C88
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_607C_4C88_CHOICE_1';
7 chromosomes
LITERAL_607C_4C88_CHOICE_1
$choice_2 = <<'LITERAL_607C_4C88_CHOICE_2';
12 chromosomes
LITERAL_607C_4C88_CHOICE_2
$choice_3 = <<'LITERAL_607C_4C88_CHOICE_3';
21 chromosomes
LITERAL_607C_4C88_CHOICE_3
$choice_4 = <<'LITERAL_607C_4C88_CHOICE_4';
42 chromosomes
LITERAL_607C_4C88_CHOICE_4
$choice_5 = <<'LITERAL_607C_4C88_CHOICE_5';
84 chromosomes
LITERAL_607C_4C88_CHOICE_5
$correct_1 = <<'LITERAL_607C_4C88_CORRECT_1';
21 chromosomes
LITERAL_607C_4C88_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
