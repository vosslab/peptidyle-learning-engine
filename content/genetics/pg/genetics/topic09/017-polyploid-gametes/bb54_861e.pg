## DESCRIPTION
## Imported Genetics source row bb54_861e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BB54_861E';
<p>bb54_861e</p> <p>A a hexaploid plant species is found to be 6n = 60 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 60/2 = 30 and 60/6 = 10</i></p>
PROMPT_BB54_861E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BB54_861E_CHOICE_1';
3 chromosomes
LITERAL_BB54_861E_CHOICE_1
$choice_2 = <<'LITERAL_BB54_861E_CHOICE_2';
15 chromosomes
LITERAL_BB54_861E_CHOICE_2
$choice_3 = <<'LITERAL_BB54_861E_CHOICE_3';
30 chromosomes
LITERAL_BB54_861E_CHOICE_3
$choice_4 = <<'LITERAL_BB54_861E_CHOICE_4';
60 chromosomes
LITERAL_BB54_861E_CHOICE_4
$choice_5 = <<'LITERAL_BB54_861E_CHOICE_5';
120 chromosomes
LITERAL_BB54_861E_CHOICE_5
$correct_1 = <<'LITERAL_BB54_861E_CORRECT_1';
30 chromosomes
LITERAL_BB54_861E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
