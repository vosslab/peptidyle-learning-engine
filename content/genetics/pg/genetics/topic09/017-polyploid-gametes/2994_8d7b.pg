## DESCRIPTION
## Imported Genetics source row 2994_8d7b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2994_8D7B';
<p>2994_8d7b</p> <p>A an octaploid plant species is found to be 8n = 48 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 48/8 = 6 and 48/2 = 24</i></p>
PROMPT_2994_8D7B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2994_8D7B_CHOICE_1';
8 chromosomes
LITERAL_2994_8D7B_CHOICE_1
$choice_2 = <<'LITERAL_2994_8D7B_CHOICE_2';
12 chromosomes
LITERAL_2994_8D7B_CHOICE_2
$choice_3 = <<'LITERAL_2994_8D7B_CHOICE_3';
16 chromosomes
LITERAL_2994_8D7B_CHOICE_3
$choice_4 = <<'LITERAL_2994_8D7B_CHOICE_4';
24 chromosomes
LITERAL_2994_8D7B_CHOICE_4
$choice_5 = <<'LITERAL_2994_8D7B_CHOICE_5';
48 chromosomes
LITERAL_2994_8D7B_CHOICE_5
$correct_1 = <<'LITERAL_2994_8D7B_CORRECT_1';
24 chromosomes
LITERAL_2994_8D7B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
