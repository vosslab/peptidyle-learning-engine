## DESCRIPTION
## Imported Genetics source row 2538_b510; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2538_B510';
<p>2538_b510</p> <p>A a hexaploid plant species is found to be 6n = 66 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 66/6 = 11 and 66/2 = 33</i></p>
PROMPT_2538_B510
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2538_B510_CHOICE_1';
3 chromosomes
LITERAL_2538_B510_CHOICE_1
$choice_2 = <<'LITERAL_2538_B510_CHOICE_2';
11 chromosomes
LITERAL_2538_B510_CHOICE_2
$choice_3 = <<'LITERAL_2538_B510_CHOICE_3';
22 chromosomes
LITERAL_2538_B510_CHOICE_3
$choice_4 = <<'LITERAL_2538_B510_CHOICE_4';
33 chromosomes
LITERAL_2538_B510_CHOICE_4
$choice_5 = <<'LITERAL_2538_B510_CHOICE_5';
132 chromosomes
LITERAL_2538_B510_CHOICE_5
$correct_1 = <<'LITERAL_2538_B510_CORRECT_1';
33 chromosomes
LITERAL_2538_B510_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
