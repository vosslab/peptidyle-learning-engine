## DESCRIPTION
## Imported Genetics source row 680d_1902; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_680D_1902';
<p>680d_1902</p> <p>A an octaploid plant species is found to be 8n = 72 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 72/2 = 36 and 72/8 = 9</i></p>
PROMPT_680D_1902
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_680D_1902_CHOICE_1';
4 chromosomes
LITERAL_680D_1902_CHOICE_1
$choice_2 = <<'LITERAL_680D_1902_CHOICE_2';
9 chromosomes
LITERAL_680D_1902_CHOICE_2
$choice_3 = <<'LITERAL_680D_1902_CHOICE_3';
18 chromosomes
LITERAL_680D_1902_CHOICE_3
$choice_4 = <<'LITERAL_680D_1902_CHOICE_4';
36 chromosomes
LITERAL_680D_1902_CHOICE_4
$choice_5 = <<'LITERAL_680D_1902_CHOICE_5';
144 chromosomes
LITERAL_680D_1902_CHOICE_5
$correct_1 = <<'LITERAL_680D_1902_CORRECT_1';
36 chromosomes
LITERAL_680D_1902_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
