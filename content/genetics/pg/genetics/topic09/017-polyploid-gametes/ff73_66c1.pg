## DESCRIPTION
## Imported Genetics source row ff73_66c1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FF73_66C1';
<p>ff73_66c1</p> <p>A a dodecaploid plant species is found to be 12n = 60 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 60/12 = 5 and 60/2 = 30</i></p>
PROMPT_FF73_66C1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FF73_66C1_CHOICE_1';
5 chromosomes
LITERAL_FF73_66C1_CHOICE_1
$choice_2 = <<'LITERAL_FF73_66C1_CHOICE_2';
10 chromosomes
LITERAL_FF73_66C1_CHOICE_2
$choice_3 = <<'LITERAL_FF73_66C1_CHOICE_3';
24 chromosomes
LITERAL_FF73_66C1_CHOICE_3
$choice_4 = <<'LITERAL_FF73_66C1_CHOICE_4';
30 chromosomes
LITERAL_FF73_66C1_CHOICE_4
$choice_5 = <<'LITERAL_FF73_66C1_CHOICE_5';
120 chromosomes
LITERAL_FF73_66C1_CHOICE_5
$correct_1 = <<'LITERAL_FF73_66C1_CORRECT_1';
30 chromosomes
LITERAL_FF73_66C1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
