## DESCRIPTION
## Imported Genetics source row 3bc6_d01f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3BC6_D01F';
<p>3bc6_d01f</p> <p>A a tetradecaploid plant species is found to be 14n = 84 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 84/2 = 42 and 84/14 = 6</i></p>
PROMPT_3BC6_D01F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3BC6_D01F_CHOICE_1';
6 chromosomes
LITERAL_3BC6_D01F_CHOICE_1
$choice_2 = <<'LITERAL_3BC6_D01F_CHOICE_2';
12 chromosomes
LITERAL_3BC6_D01F_CHOICE_2
$choice_3 = <<'LITERAL_3BC6_D01F_CHOICE_3';
14 chromosomes
LITERAL_3BC6_D01F_CHOICE_3
$choice_4 = <<'LITERAL_3BC6_D01F_CHOICE_4';
42 chromosomes
LITERAL_3BC6_D01F_CHOICE_4
$choice_5 = <<'LITERAL_3BC6_D01F_CHOICE_5';
84 chromosomes
LITERAL_3BC6_D01F_CHOICE_5
$correct_1 = <<'LITERAL_3BC6_D01F_CORRECT_1';
42 chromosomes
LITERAL_3BC6_D01F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
