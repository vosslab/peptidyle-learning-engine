## DESCRIPTION
## Imported Genetics source row b1bd_d4f9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B1BD_D4F9';
<p>b1bd_d4f9</p> <p>A a hexadecaploid plant species is found to be 16n = 176 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 176/16 = 11 and 176/2 = 88</i></p>
PROMPT_B1BD_D4F9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B1BD_D4F9_CHOICE_1';
11 chromosomes
LITERAL_B1BD_D4F9_CHOICE_1
$choice_2 = <<'LITERAL_B1BD_D4F9_CHOICE_2';
32 chromosomes
LITERAL_B1BD_D4F9_CHOICE_2
$choice_3 = <<'LITERAL_B1BD_D4F9_CHOICE_3';
88 chromosomes
LITERAL_B1BD_D4F9_CHOICE_3
$choice_4 = <<'LITERAL_B1BD_D4F9_CHOICE_4';
176 chromosomes
LITERAL_B1BD_D4F9_CHOICE_4
$choice_5 = <<'LITERAL_B1BD_D4F9_CHOICE_5';
352 chromosomes
LITERAL_B1BD_D4F9_CHOICE_5
$correct_1 = <<'LITERAL_B1BD_D4F9_CORRECT_1';
88 chromosomes
LITERAL_B1BD_D4F9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
