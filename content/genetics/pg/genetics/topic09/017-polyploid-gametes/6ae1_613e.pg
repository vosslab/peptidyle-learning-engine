## DESCRIPTION
## Imported Genetics source row 6ae1_613e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6AE1_613E';
<p>6ae1_613e</p> <p>A an octaploid plant species is found to be 8n = 88 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 88/8 = 11 and 88/2 = 44</i></p>
PROMPT_6AE1_613E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6AE1_613E_CHOICE_1';
4 chromosomes
LITERAL_6AE1_613E_CHOICE_1
$choice_2 = <<'LITERAL_6AE1_613E_CHOICE_2';
11 chromosomes
LITERAL_6AE1_613E_CHOICE_2
$choice_3 = <<'LITERAL_6AE1_613E_CHOICE_3';
16 chromosomes
LITERAL_6AE1_613E_CHOICE_3
$choice_4 = <<'LITERAL_6AE1_613E_CHOICE_4';
44 chromosomes
LITERAL_6AE1_613E_CHOICE_4
$choice_5 = <<'LITERAL_6AE1_613E_CHOICE_5';
88 chromosomes
LITERAL_6AE1_613E_CHOICE_5
$correct_1 = <<'LITERAL_6AE1_613E_CORRECT_1';
44 chromosomes
LITERAL_6AE1_613E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
