## DESCRIPTION
## Imported Genetics source row 842d_a018; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_842D_A018';
<p>842d_a018</p> <p>A a dodecaploid plant species is found to be 12n = 96 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 96/2 = 48 and 96/12 = 8</i></p>
PROMPT_842D_A018
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_842D_A018_CHOICE_1';
8 chromosomes
LITERAL_842D_A018_CHOICE_1
$choice_2 = <<'LITERAL_842D_A018_CHOICE_2';
16 chromosomes
LITERAL_842D_A018_CHOICE_2
$choice_3 = <<'LITERAL_842D_A018_CHOICE_3';
24 chromosomes
LITERAL_842D_A018_CHOICE_3
$choice_4 = <<'LITERAL_842D_A018_CHOICE_4';
48 chromosomes
LITERAL_842D_A018_CHOICE_4
$choice_5 = <<'LITERAL_842D_A018_CHOICE_5';
96 chromosomes
LITERAL_842D_A018_CHOICE_5
$correct_1 = <<'LITERAL_842D_A018_CORRECT_1';
48 chromosomes
LITERAL_842D_A018_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
