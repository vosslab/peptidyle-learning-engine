## DESCRIPTION
## Imported Genetics source row b9c6_3bf3; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B9C6_3BF3';
<p>b9c6_3bf3</p> <p>A an octaploid plant species is found to be 8n = 56 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 56/2 = 28 and 56/8 = 7</i></p>
PROMPT_B9C6_3BF3
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B9C6_3BF3_CHOICE_1';
7 chromosomes
LITERAL_B9C6_3BF3_CHOICE_1
$choice_2 = <<'LITERAL_B9C6_3BF3_CHOICE_2';
14 chromosomes
LITERAL_B9C6_3BF3_CHOICE_2
$choice_3 = <<'LITERAL_B9C6_3BF3_CHOICE_3';
16 chromosomes
LITERAL_B9C6_3BF3_CHOICE_3
$choice_4 = <<'LITERAL_B9C6_3BF3_CHOICE_4';
28 chromosomes
LITERAL_B9C6_3BF3_CHOICE_4
$choice_5 = <<'LITERAL_B9C6_3BF3_CHOICE_5';
112 chromosomes
LITERAL_B9C6_3BF3_CHOICE_5
$correct_1 = <<'LITERAL_B9C6_3BF3_CORRECT_1';
28 chromosomes
LITERAL_B9C6_3BF3_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
