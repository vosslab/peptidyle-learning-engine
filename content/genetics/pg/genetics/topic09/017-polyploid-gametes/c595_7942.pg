## DESCRIPTION
## Imported Genetics source row c595_7942; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-polyploid-gametes-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_C595_7942';
<p>c595_7942</p> <p>A a hexadecaploid plant species is found to be 16n = 80 chromosomes.</p> <h5>How many chromosomes would present in the gametes of this species?</h5><p><i>Note: 80/2 = 40 and 80/16 = 5</i></p>
PROMPT_C595_7942
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_C595_7942_CHOICE_1';
10 chromosomes
LITERAL_C595_7942_CHOICE_1
$choice_2 = <<'LITERAL_C595_7942_CHOICE_2';
16 chromosomes
LITERAL_C595_7942_CHOICE_2
$choice_3 = <<'LITERAL_C595_7942_CHOICE_3';
20 chromosomes
LITERAL_C595_7942_CHOICE_3
$choice_4 = <<'LITERAL_C595_7942_CHOICE_4';
40 chromosomes
LITERAL_C595_7942_CHOICE_4
$choice_5 = <<'LITERAL_C595_7942_CHOICE_5';
80 chromosomes
LITERAL_C595_7942_CHOICE_5
$correct_1 = <<'LITERAL_C595_7942_CORRECT_1';
40 chromosomes
LITERAL_C595_7942_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
