## DESCRIPTION
## Imported Genetics source row ec8a_ca0e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-MATCH-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EC8A_CA0E';
<p>ec8a_ca0e</p> <p>Match each of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_EC8A_CA0E
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_EC8A_CA0E_MATCH_TERM_0';
<span style="color: #006690;">non-reciprocal translocation</span>
LITERAL_EC8A_CA0E_MATCH_TERM_0
$match_term_1 = <<'LITERAL_EC8A_CA0E_MATCH_TERM_1';
<span style="color: #95346b;">pericentric inversion</span>
LITERAL_EC8A_CA0E_MATCH_TERM_1
$match_term_2 = <<'LITERAL_EC8A_CA0E_MATCH_TERM_2';
<span style="color: #4d690c;">deletion</span>
LITERAL_EC8A_CA0E_MATCH_TERM_2
$match_term_3 = <<'LITERAL_EC8A_CA0E_MATCH_TERM_3';
<span style="color: #713bb8;">paracentric inversion</span>
LITERAL_EC8A_CA0E_MATCH_TERM_3
$match_term_4 = <<'LITERAL_EC8A_CA0E_MATCH_TERM_4';
<span style="color: #006c6a;">duplications</span>
LITERAL_EC8A_CA0E_MATCH_TERM_4
$match_choice_0 = <<'LITERAL_EC8A_CA0E_MATCH_CHOICE_0';
a complete <strong><span style="color: #008672;">chromosome</span></strong> that also has a group of <strong><span style="color: #43861a;">genes</span></strong> from another <strong><span style="color: #008672;">chromosome</span></strong>
LITERAL_EC8A_CA0E_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_EC8A_CA0E_MATCH_CHOICE_1';
includes the <strong><span style="color: #c1480a;">centromere</span></strong> and there is a break point in each arm
LITERAL_EC8A_CA0E_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_EC8A_CA0E_MATCH_CHOICE_2';
when a <strong><span style="color: #008672;">chromosome</span></strong> breaks a part of it is lost
LITERAL_EC8A_CA0E_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_EC8A_CA0E_MATCH_CHOICE_3';
can change two monocentric <strong><span style="color: #008672;">chromosome</span></strong>s into a dicentric <strong><span style="color: #008672;">chromosome</span></strong>
LITERAL_EC8A_CA0E_MATCH_CHOICE_3
$match_choice_4 = <<'LITERAL_EC8A_CA0E_MATCH_CHOICE_4';
<strong><span style="color: #008672;">chromosome</span></strong> that has an extra copy of a group of <strong><span style="color: #43861a;">genes</span></strong>
LITERAL_EC8A_CA0E_MATCH_CHOICE_4
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D", "E"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D", "E"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D", "E"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D", "E"], 4);
$match_dropdown_4 = make_popup(['', "A", "B", "C", "D", "E"], 5);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*

[_]{$match_dropdown_4} *5.* [$match_term_4]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*

*E.* [$match_choice_4]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
