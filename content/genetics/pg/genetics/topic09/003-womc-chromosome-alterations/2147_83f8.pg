DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2147_83F8';
<p>2147_83f8</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a group of <strong><span style="color: #43861a;">genes</span></strong> on one arm of the <strong><span style="color: #008672;">chromosome</span></strong> is the <strong><span style="color: #56225d;">reverse</span></strong> of the normal order'</strong></span>.</p>
PROMPT_2147_83F8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2147_83F8_CHOICE_1';
deletion
LITERAL_2147_83F8_CHOICE_1
$choice_2 = <<'LITERAL_2147_83F8_CHOICE_2';
non-disjunction
LITERAL_2147_83F8_CHOICE_2
$choice_3 = <<'LITERAL_2147_83F8_CHOICE_3';
non-reciprocal translocation
LITERAL_2147_83F8_CHOICE_3
$choice_4 = <<'LITERAL_2147_83F8_CHOICE_4';
paracentric inversion
LITERAL_2147_83F8_CHOICE_4
$choice_5 = <<'LITERAL_2147_83F8_CHOICE_5';
reciprocal translocation
LITERAL_2147_83F8_CHOICE_5
$correct_1 = <<'LITERAL_2147_83F8_CORRECT_1';
paracentric inversion
LITERAL_2147_83F8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
