## DESCRIPTION
## Imported Genetics source row 55fe_2f9d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_55FE_2F9D';
<p>55fe_2f9d</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a portion of a single <strong><span style="color: #008672;">chromosome</span></strong> arm has broken off, turned upside down, and reattached'</strong></span>.</p>
PROMPT_55FE_2F9D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_55FE_2F9D_CHOICE_1';
Robertsonian translocation
LITERAL_55FE_2F9D_CHOICE_1
$choice_2 = <<'LITERAL_55FE_2F9D_CHOICE_2';
deletion
LITERAL_55FE_2F9D_CHOICE_2
$choice_3 = <<'LITERAL_55FE_2F9D_CHOICE_3';
duplications
LITERAL_55FE_2F9D_CHOICE_3
$choice_4 = <<'LITERAL_55FE_2F9D_CHOICE_4';
non-disjunction
LITERAL_55FE_2F9D_CHOICE_4
$choice_5 = <<'LITERAL_55FE_2F9D_CHOICE_5';
paracentric inversion
LITERAL_55FE_2F9D_CHOICE_5
$correct_1 = <<'LITERAL_55FE_2F9D_CORRECT_1';
paracentric inversion
LITERAL_55FE_2F9D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
