## DESCRIPTION
## Imported Genetics source row 0d04_8bd7; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0D04_8BD7';
<p>0d04_8bd7</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a complete <strong><span style="color: #008672;">chromosome</span></strong> that also has a group of <strong><span style="color: #43861a;">genes</span></strong> from another <strong><span style="color: #008672;">chromosome</span></strong>'</strong></span>.</p>
PROMPT_0D04_8BD7
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0D04_8BD7_CHOICE_1';
Robertsonian translocation
LITERAL_0D04_8BD7_CHOICE_1
$choice_2 = <<'LITERAL_0D04_8BD7_CHOICE_2';
non-disjunction
LITERAL_0D04_8BD7_CHOICE_2
$choice_3 = <<'LITERAL_0D04_8BD7_CHOICE_3';
non-reciprocal translocation
LITERAL_0D04_8BD7_CHOICE_3
$choice_4 = <<'LITERAL_0D04_8BD7_CHOICE_4';
pericentric inversion
LITERAL_0D04_8BD7_CHOICE_4
$choice_5 = <<'LITERAL_0D04_8BD7_CHOICE_5';
reciprocal translocation
LITERAL_0D04_8BD7_CHOICE_5
$correct_1 = <<'LITERAL_0D04_8BD7_CORRECT_1';
non-reciprocal translocation
LITERAL_0D04_8BD7_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
