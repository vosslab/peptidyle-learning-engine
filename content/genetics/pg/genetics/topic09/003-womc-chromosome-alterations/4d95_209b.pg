## DESCRIPTION
## Imported Genetics source row 4d95_209b; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_4D95_209B';
<p>4d95_209b</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #008672;">chromosome</span></strong> that has an extra copy of a group of <strong><span style="color: #43861a;">genes</span></strong>'</strong></span>.</p>
PROMPT_4D95_209B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4D95_209B_CHOICE_1';
Robertsonian translocation
LITERAL_4D95_209B_CHOICE_1
$choice_2 = <<'LITERAL_4D95_209B_CHOICE_2';
duplications
LITERAL_4D95_209B_CHOICE_2
$choice_3 = <<'LITERAL_4D95_209B_CHOICE_3';
non-reciprocal translocation
LITERAL_4D95_209B_CHOICE_3
$choice_4 = <<'LITERAL_4D95_209B_CHOICE_4';
paracentric inversion
LITERAL_4D95_209B_CHOICE_4
$choice_5 = <<'LITERAL_4D95_209B_CHOICE_5';
pericentric inversion
LITERAL_4D95_209B_CHOICE_5
$correct_1 = <<'LITERAL_4D95_209B_CORRECT_1';
duplications
LITERAL_4D95_209B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
