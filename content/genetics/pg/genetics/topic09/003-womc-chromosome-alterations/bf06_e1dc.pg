## DESCRIPTION
## Imported Genetics source row bf06_e1dc; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_BF06_E1DC';
<p>bf06_e1dc</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'fusion of two <strong><span style="color: #008672;">chromosome</span></strong>s that have short p arms'</strong></span>.</p>
PROMPT_BF06_E1DC
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BF06_E1DC_CHOICE_1';
Robertsonian translocation
LITERAL_BF06_E1DC_CHOICE_1
$choice_2 = <<'LITERAL_BF06_E1DC_CHOICE_2';
deletion
LITERAL_BF06_E1DC_CHOICE_2
$choice_3 = <<'LITERAL_BF06_E1DC_CHOICE_3';
non-disjunction
LITERAL_BF06_E1DC_CHOICE_3
$choice_4 = <<'LITERAL_BF06_E1DC_CHOICE_4';
non-reciprocal translocation
LITERAL_BF06_E1DC_CHOICE_4
$choice_5 = <<'LITERAL_BF06_E1DC_CHOICE_5';
reciprocal translocation
LITERAL_BF06_E1DC_CHOICE_5
$correct_1 = <<'LITERAL_BF06_E1DC_CORRECT_1';
Robertsonian translocation
LITERAL_BF06_E1DC_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
