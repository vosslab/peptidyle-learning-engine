## DESCRIPTION
## Imported Genetics source row 2091_34a1; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_2091_34A1';
<p>2091_34a1</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a pair of non-homologous <strong><span style="color: #008672;">chromosome</span></strong>s swapping <strong><span style="color: #43861a;">genes</span></strong> with each other'</strong></span>.</p>
PROMPT_2091_34A1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_2091_34A1_CHOICE_1';
Robertsonian translocation
LITERAL_2091_34A1_CHOICE_1
$choice_2 = <<'LITERAL_2091_34A1_CHOICE_2';
duplications
LITERAL_2091_34A1_CHOICE_2
$choice_3 = <<'LITERAL_2091_34A1_CHOICE_3';
paracentric inversion
LITERAL_2091_34A1_CHOICE_3
$choice_4 = <<'LITERAL_2091_34A1_CHOICE_4';
pericentric inversion
LITERAL_2091_34A1_CHOICE_4
$choice_5 = <<'LITERAL_2091_34A1_CHOICE_5';
reciprocal translocation
LITERAL_2091_34A1_CHOICE_5
$correct_1 = <<'LITERAL_2091_34A1_CORRECT_1';
reciprocal translocation
LITERAL_2091_34A1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
