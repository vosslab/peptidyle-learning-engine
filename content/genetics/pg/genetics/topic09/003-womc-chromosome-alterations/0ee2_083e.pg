## DESCRIPTION
## Imported Genetics source row 0ee2_083e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0EE2_083E';
<p>0ee2_083e</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'when a <strong><span style="color: #008672;">chromosome</span></strong> breaks a part of it is lost'</strong></span>.</p>
PROMPT_0EE2_083E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0EE2_083E_CHOICE_1';
Robertsonian translocation
LITERAL_0EE2_083E_CHOICE_1
$choice_2 = <<'LITERAL_0EE2_083E_CHOICE_2';
deletion
LITERAL_0EE2_083E_CHOICE_2
$choice_3 = <<'LITERAL_0EE2_083E_CHOICE_3';
duplications
LITERAL_0EE2_083E_CHOICE_3
$choice_4 = <<'LITERAL_0EE2_083E_CHOICE_4';
non-disjunction
LITERAL_0EE2_083E_CHOICE_4
$choice_5 = <<'LITERAL_0EE2_083E_CHOICE_5';
pericentric inversion
LITERAL_0EE2_083E_CHOICE_5
$correct_1 = <<'LITERAL_0EE2_083E_CORRECT_1';
deletion
LITERAL_0EE2_083E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
