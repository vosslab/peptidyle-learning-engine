DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9A92_52E8';
<p>9a92_52e8</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'two breaks and <strong><span style="color: #56225d;">reversal</span></strong> of the <strong><span style="color: #43861a;">genes</span></strong> occurs on both arms or sides of the <strong><span style="color: #c1480a;">centromere</span></strong>'</strong></span>.</p>
PROMPT_9A92_52E8
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9A92_52E8_CHOICE_1';
Robertsonian translocation
LITERAL_9A92_52E8_CHOICE_1
$choice_2 = <<'LITERAL_9A92_52E8_CHOICE_2';
duplications
LITERAL_9A92_52E8_CHOICE_2
$choice_3 = <<'LITERAL_9A92_52E8_CHOICE_3';
non-disjunction
LITERAL_9A92_52E8_CHOICE_3
$choice_4 = <<'LITERAL_9A92_52E8_CHOICE_4';
paracentric inversion
LITERAL_9A92_52E8_CHOICE_4
$choice_5 = <<'LITERAL_9A92_52E8_CHOICE_5';
pericentric inversion
LITERAL_9A92_52E8_CHOICE_5
$correct_1 = <<'LITERAL_9A92_52E8_CORRECT_1';
pericentric inversion
LITERAL_9A92_52E8_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
