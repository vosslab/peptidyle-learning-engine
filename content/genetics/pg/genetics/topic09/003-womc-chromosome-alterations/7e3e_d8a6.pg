DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_7E3E_D8A6';
<p>7e3e_d8a6</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a portion of a <strong><span style="color: #008672;">chromosome</span></strong> that includes both arms has broken off, <strong><span style="color: #56225d;">reverse</span></strong>d, and reattached'</strong></span>.</p>
PROMPT_7E3E_D8A6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_7E3E_D8A6_CHOICE_1';
duplications
LITERAL_7E3E_D8A6_CHOICE_1
$choice_2 = <<'LITERAL_7E3E_D8A6_CHOICE_2';
non-disjunction
LITERAL_7E3E_D8A6_CHOICE_2
$choice_3 = <<'LITERAL_7E3E_D8A6_CHOICE_3';
non-reciprocal translocation
LITERAL_7E3E_D8A6_CHOICE_3
$choice_4 = <<'LITERAL_7E3E_D8A6_CHOICE_4';
pericentric inversion
LITERAL_7E3E_D8A6_CHOICE_4
$choice_5 = <<'LITERAL_7E3E_D8A6_CHOICE_5';
reciprocal translocation
LITERAL_7E3E_D8A6_CHOICE_5
$correct_1 = <<'LITERAL_7E3E_D8A6_CORRECT_1';
pericentric inversion
LITERAL_7E3E_D8A6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
