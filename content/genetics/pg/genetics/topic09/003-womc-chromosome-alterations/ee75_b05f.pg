## DESCRIPTION
## Imported Genetics source row ee75_b05f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EE75_B05F';
<p>ee75_b05f</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'the transferring of a <strong><span style="color: #008672;">chromosome</span></strong> segment from one <strong><span style="color: #008672;">chromosome</span></strong> to another non-homologous <strong><span style="color: #008672;">chromosome</span></strong>'</strong></span>.</p>
PROMPT_EE75_B05F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_EE75_B05F_CHOICE_1';
deletion
LITERAL_EE75_B05F_CHOICE_1
$choice_2 = <<'LITERAL_EE75_B05F_CHOICE_2';
duplications
LITERAL_EE75_B05F_CHOICE_2
$choice_3 = <<'LITERAL_EE75_B05F_CHOICE_3';
non-disjunction
LITERAL_EE75_B05F_CHOICE_3
$choice_4 = <<'LITERAL_EE75_B05F_CHOICE_4';
non-reciprocal translocation
LITERAL_EE75_B05F_CHOICE_4
$choice_5 = <<'LITERAL_EE75_B05F_CHOICE_5';
reciprocal translocation
LITERAL_EE75_B05F_CHOICE_5
$correct_1 = <<'LITERAL_EE75_B05F_CORRECT_1';
non-reciprocal translocation
LITERAL_EE75_B05F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
