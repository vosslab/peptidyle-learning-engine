## DESCRIPTION
## Imported Genetics source row 6861_dc7a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6861_DC7A';
<p>6861_dc7a</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'the exchange of broken <strong><span style="color: #008672;">chromosome</span></strong> segments between two nonhomologous <strong><span style="color: #008672;">chromosome</span></strong>s'</strong></span>.</p>
PROMPT_6861_DC7A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6861_DC7A_CHOICE_1';
duplications
LITERAL_6861_DC7A_CHOICE_1
$choice_2 = <<'LITERAL_6861_DC7A_CHOICE_2';
non-disjunction
LITERAL_6861_DC7A_CHOICE_2
$choice_3 = <<'LITERAL_6861_DC7A_CHOICE_3';
non-reciprocal translocation
LITERAL_6861_DC7A_CHOICE_3
$choice_4 = <<'LITERAL_6861_DC7A_CHOICE_4';
paracentric inversion
LITERAL_6861_DC7A_CHOICE_4
$choice_5 = <<'LITERAL_6861_DC7A_CHOICE_5';
reciprocal translocation
LITERAL_6861_DC7A_CHOICE_5
$correct_1 = <<'LITERAL_6861_DC7A_CORRECT_1';
reciprocal translocation
LITERAL_6861_DC7A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
