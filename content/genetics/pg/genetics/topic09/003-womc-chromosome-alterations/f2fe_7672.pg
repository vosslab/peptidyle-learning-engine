## DESCRIPTION
## Imported Genetics source row f2fe_7672; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_F2FE_7672';
<p>f2fe_7672</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a sequence of DNA is left out during DNA replication'</strong></span>.</p>
PROMPT_F2FE_7672
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_F2FE_7672_CHOICE_1';
deletion
LITERAL_F2FE_7672_CHOICE_1
$choice_2 = <<'LITERAL_F2FE_7672_CHOICE_2';
non-disjunction
LITERAL_F2FE_7672_CHOICE_2
$choice_3 = <<'LITERAL_F2FE_7672_CHOICE_3';
paracentric inversion
LITERAL_F2FE_7672_CHOICE_3
$choice_4 = <<'LITERAL_F2FE_7672_CHOICE_4';
pericentric inversion
LITERAL_F2FE_7672_CHOICE_4
$choice_5 = <<'LITERAL_F2FE_7672_CHOICE_5';
reciprocal translocation
LITERAL_F2FE_7672_CHOICE_5
$correct_1 = <<'LITERAL_F2FE_7672_CORRECT_1';
deletion
LITERAL_F2FE_7672_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
