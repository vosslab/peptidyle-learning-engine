## DESCRIPTION
## Imported Genetics source row 1fa4_4248; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1FA4_4248';
<p>1fa4_4248</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'portion of the <strong><span style="color: #008672;">chromosome</span></strong> is missing'</strong></span>.</p>
PROMPT_1FA4_4248
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1FA4_4248_CHOICE_1';
Robertsonian translocation
LITERAL_1FA4_4248_CHOICE_1
$choice_2 = <<'LITERAL_1FA4_4248_CHOICE_2';
deletion
LITERAL_1FA4_4248_CHOICE_2
$choice_3 = <<'LITERAL_1FA4_4248_CHOICE_3';
non-disjunction
LITERAL_1FA4_4248_CHOICE_3
$choice_4 = <<'LITERAL_1FA4_4248_CHOICE_4';
non-reciprocal translocation
LITERAL_1FA4_4248_CHOICE_4
$choice_5 = <<'LITERAL_1FA4_4248_CHOICE_5';
pericentric inversion
LITERAL_1FA4_4248_CHOICE_5
$correct_1 = <<'LITERAL_1FA4_4248_CORRECT_1';
deletion
LITERAL_1FA4_4248_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
