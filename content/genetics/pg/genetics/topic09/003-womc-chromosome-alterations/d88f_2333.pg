## DESCRIPTION
## Imported Genetics source row d88f_2333; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D88F_2333';
<p>d88f_2333</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'a part of a <strong><span style="color: #008672;">chromosome</span></strong> is left out during DNA replication'</strong></span>.</p>
PROMPT_D88F_2333
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D88F_2333_CHOICE_1';
Robertsonian translocation
LITERAL_D88F_2333_CHOICE_1
$choice_2 = <<'LITERAL_D88F_2333_CHOICE_2';
deletion
LITERAL_D88F_2333_CHOICE_2
$choice_3 = <<'LITERAL_D88F_2333_CHOICE_3';
duplications
LITERAL_D88F_2333_CHOICE_3
$choice_4 = <<'LITERAL_D88F_2333_CHOICE_4';
non-reciprocal translocation
LITERAL_D88F_2333_CHOICE_4
$choice_5 = <<'LITERAL_D88F_2333_CHOICE_5';
paracentric inversion
LITERAL_D88F_2333_CHOICE_5
$correct_1 = <<'LITERAL_D88F_2333_CORRECT_1';
deletion
LITERAL_D88F_2333_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
