## DESCRIPTION
## Imported Genetics source row 925c_4e70; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_925C_4E70';
<p>925c_4e70</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'can change two monocentric <strong><span style="color: #008672;">chromosome</span></strong>s into an acentric <strong><span style="color: #008672;">chromosome</span></strong>'</strong></span>.</p>
PROMPT_925C_4E70
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_925C_4E70_CHOICE_1';
deletion
LITERAL_925C_4E70_CHOICE_1
$choice_2 = <<'LITERAL_925C_4E70_CHOICE_2';
duplications
LITERAL_925C_4E70_CHOICE_2
$choice_3 = <<'LITERAL_925C_4E70_CHOICE_3';
non-disjunction
LITERAL_925C_4E70_CHOICE_3
$choice_4 = <<'LITERAL_925C_4E70_CHOICE_4';
paracentric inversion
LITERAL_925C_4E70_CHOICE_4
$choice_5 = <<'LITERAL_925C_4E70_CHOICE_5';
pericentric inversion
LITERAL_925C_4E70_CHOICE_5
$correct_1 = <<'LITERAL_925C_4E70_CORRECT_1';
paracentric inversion
LITERAL_925C_4E70_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
