## DESCRIPTION
## Imported Genetics source row 6841_2947; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic09/bbq-WOMC-chromosome_alterations-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_6841_2947';
<p>6841_2947</p> <p>Which one of the following alterations to <strong><span style="color: #008672;">chromosome</span></strong> structure correspond to the description <span style='font-size: 1em;'><strong>'includes the <strong><span style="color: #c1480a;">centromere</span></strong> and there is a break point in each arm'</strong></span>.</p>
PROMPT_6841_2947
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_6841_2947_CHOICE_1';
Robertsonian translocation
LITERAL_6841_2947_CHOICE_1
$choice_2 = <<'LITERAL_6841_2947_CHOICE_2';
non-disjunction
LITERAL_6841_2947_CHOICE_2
$choice_3 = <<'LITERAL_6841_2947_CHOICE_3';
paracentric inversion
LITERAL_6841_2947_CHOICE_3
$choice_4 = <<'LITERAL_6841_2947_CHOICE_4';
pericentric inversion
LITERAL_6841_2947_CHOICE_4
$choice_5 = <<'LITERAL_6841_2947_CHOICE_5';
reciprocal translocation
LITERAL_6841_2947_CHOICE_5
$correct_1 = <<'LITERAL_6841_2947_CORRECT_1';
pericentric inversion
LITERAL_6841_2947_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
