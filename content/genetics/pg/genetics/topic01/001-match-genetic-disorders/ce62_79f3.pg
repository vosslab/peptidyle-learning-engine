DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CE62_79F3';
<p>ce62_79f3</p> <p>Match each of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_CE62_79F3
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_CE62_79F3_MATCH_TERM_0';
<span style="color: #00668d;">Maple syrup urine disease</span>
LITERAL_CE62_79F3_MATCH_TERM_0
$match_term_1 = <<'LITERAL_CE62_79F3_MATCH_TERM_1';
<span style="color: #6a46a9;">Triple X syndrome</span>
LITERAL_CE62_79F3_MATCH_TERM_1
$match_term_2 = <<'LITERAL_CE62_79F3_MATCH_TERM_2';
<span style="color: #1e702a;">Duchenne muscular dystrophy</span>
LITERAL_CE62_79F3_MATCH_TERM_2
$match_term_3 = <<'LITERAL_CE62_79F3_MATCH_TERM_3';
<span style="color: #8b4b0c;">Achondroplasia</span>
LITERAL_CE62_79F3_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_CE62_79F3_MATCH_CHOICE_0';
<strong><span style="color: #935d00;">metabolic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> affecting branched-chain amino acids
LITERAL_CE62_79F3_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_CE62_79F3_MATCH_CHOICE_1';
a <strong><span style="color: #b74300;">genetic</span></strong> condition in females which there are three copies of the X <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_CE62_79F3_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_CE62_79F3_MATCH_CHOICE_2';
<strong><span style="color: #d40000;">disorder</span></strong> that affects the muscles, leading to muscle wasting that gets worse over time
LITERAL_CE62_79F3_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_CE62_79F3_MATCH_CHOICE_3';
impairs the growth of bone in the limbs and causes abnormal growth in the spine and skull
LITERAL_CE62_79F3_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
