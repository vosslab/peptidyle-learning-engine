## DESCRIPTION
## Imported Genetics source row ce62_1558; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-MATCH-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CE62_1558';
<p>ce62_1558</p> <p>Match each of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_CE62_1558
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_CE62_1558_MATCH_TERM_0';
<span style="color: #7c5600;">Cystic fibrosis</span>
LITERAL_CE62_1558_MATCH_TERM_0
$match_term_1 = <<'LITERAL_CE62_1558_MATCH_TERM_1';
<span style="color: #863697;">Wolf-Hirschhorn syndrome</span>
LITERAL_CE62_1558_MATCH_TERM_1
$match_term_2 = <<'LITERAL_CE62_1558_MATCH_TERM_2';
<span style="color: #2e5f9a;">WAGR syndrome</span>
LITERAL_CE62_1558_MATCH_TERM_2
$match_term_3 = <<'LITERAL_CE62_1558_MATCH_TERM_3';
<span style="color: #006f51;">Hemophilia</span>
LITERAL_CE62_1558_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_CE62_1558_MATCH_CHOICE_0';
a faulty protein that affects the cells, tissues, and the glands that make mucus and sweat
LITERAL_CE62_1558_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_CE62_1558_MATCH_CHOICE_1';
<strong><span style="color: #b74300;">genetic</span></strong> condition caused by a deletion of a group of genes located on <strong><span style="color: #6c6c00;">chromosome</span></strong> number 4
LITERAL_CE62_1558_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_CE62_1558_MATCH_CHOICE_2';
<strong><span style="color: #d40000;">disorder</span></strong> caused when a small part of <strong><span style="color: #6c6c00;">chromosome</span></strong> 11 is missing
LITERAL_CE62_1558_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_CE62_1558_MATCH_CHOICE_3';
an inherited bleeding <strong><span style="color: #d40000;">disorder</span></strong> in which the blood does<strong> <strong>NOT</strong> </strong>clot properly
LITERAL_CE62_1558_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
