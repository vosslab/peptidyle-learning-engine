## DESCRIPTION
## Imported Genetics source row ce62_062a; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-MATCH-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CE62_062A';
<p>ce62_062a</p> <p>Match each of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_CE62_062A
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_CE62_062A_MATCH_TERM_0';
<span style="color: #00668d;">Hemophilia</span>
LITERAL_CE62_062A_MATCH_TERM_0
$match_term_1 = <<'LITERAL_CE62_062A_MATCH_TERM_1';
<span style="color: #1e702a;">Cri du chat syndrome</span>
LITERAL_CE62_062A_MATCH_TERM_1
$match_term_2 = <<'LITERAL_CE62_062A_MATCH_TERM_2';
<span style="color: #7c5600;">Achondroplasia</span>
LITERAL_CE62_062A_MATCH_TERM_2
$match_term_3 = <<'LITERAL_CE62_062A_MATCH_TERM_3';
<span style="color: #6a46a9;">Klinefelter syndrome</span>
LITERAL_CE62_062A_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_CE62_062A_MATCH_CHOICE_0';
an inherited bleeding <strong><span style="color: #d40000;">disorder</span></strong> in which the blood does<strong> <strong>NOT</strong> </strong>clot properly
LITERAL_CE62_062A_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_CE62_062A_MATCH_CHOICE_1';
usually include a high-pitched cat-like cry, mental disability, delayed development, distinctive facial features, widely-spaced eyes
LITERAL_CE62_062A_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_CE62_062A_MATCH_CHOICE_2';
impairs the growth of bone in the limbs and causes abnormal growth in the spine and skull
LITERAL_CE62_062A_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_CE62_062A_MATCH_CHOICE_3';
result of a random error that causes a male to be born with an extra X <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_CE62_062A_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
