## DESCRIPTION
## Imported Genetics source row ce62_5cec; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-MATCH-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CE62_5CEC';
<p>ce62_5cec</p> <p>Match each of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s with their corresponding descriptions.</p><p><i>Note:</i> Each choice will be used exactly once.</p>
PROMPT_CE62_5CEC
loadMacros('PGML.pl', 'parserPopUp.pl');
sub make_popup { return defined &DropDown ? DropDown(@_) : PopUp(@_); }
$match_term_0 = <<'LITERAL_CE62_5CEC_MATCH_TERM_0';
DiGeorge syndrome
LITERAL_CE62_5CEC_MATCH_TERM_0
$match_term_1 = <<'LITERAL_CE62_5CEC_MATCH_TERM_1';
Philadelphia <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_CE62_5CEC_MATCH_TERM_1
$match_term_2 = <<'LITERAL_CE62_5CEC_MATCH_TERM_2';
Patau syndrome
LITERAL_CE62_5CEC_MATCH_TERM_2
$match_term_3 = <<'LITERAL_CE62_5CEC_MATCH_TERM_3';
Duchenne muscular dystrophy
LITERAL_CE62_5CEC_MATCH_TERM_3
$match_choice_0 = <<'LITERAL_CE62_5CEC_MATCH_CHOICE_0';
<strong><span style="color: #d40000;">disorder</span></strong> that is due to a missing piece (deletion) of a specific part of <strong><span style="color: #6c6c00;">chromosome</span></strong> 22
LITERAL_CE62_5CEC_MATCH_CHOICE_0
$match_choice_1 = <<'LITERAL_CE62_5CEC_MATCH_CHOICE_1';
forms when <strong><span style="color: #6c6c00;">chromosome</span></strong> 9 and <strong><span style="color: #6c6c00;">chromosome</span></strong> 22 break and exchange portions of their <strong><span style="color: #b74300;">genetic</span></strong> material
LITERAL_CE62_5CEC_MATCH_CHOICE_1
$match_choice_2 = <<'LITERAL_CE62_5CEC_MATCH_CHOICE_2';
<strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> caused by the presence of all or part of a third copy of <strong><span style="color: #6c6c00;">chromosome</span></strong> 13
LITERAL_CE62_5CEC_MATCH_CHOICE_2
$match_choice_3 = <<'LITERAL_CE62_5CEC_MATCH_CHOICE_3';
<strong><span style="color: #d40000;">disorder</span></strong> that affects the muscles, leading to muscle wasting that gets worse over time
LITERAL_CE62_5CEC_MATCH_CHOICE_3
$match_dropdown_0 = make_popup(['', "A", "B", "C", "D"], 1);
$match_dropdown_1 = make_popup(['', "A", "B", "C", "D"], 2);
$match_dropdown_2 = make_popup(['', "A", "B", "C", "D"], 3);
$match_dropdown_3 = make_popup(['', "A", "B", "C", "D"], 4);
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_PGML
[@ MODES(HTML => '<div class="two-column">') @]*
[@ MODES(HTML => '<div>') @]*
[_]{$match_dropdown_0} *1.* [$match_term_0]*

[_]{$match_dropdown_1} *2.* [$match_term_1]*

[_]{$match_dropdown_2} *3.* [$match_term_2]*

[_]{$match_dropdown_3} *4.* [$match_term_3]*
[@ MODES(HTML => '</div><div>') @]*
*A.* [$match_choice_0]*

*B.* [$match_choice_1]*

*C.* [$match_choice_2]*

*D.* [$match_choice_3]*
[@ MODES(HTML => '</div></div>') @]*
END_PGML

ENDDOCUMENT();
