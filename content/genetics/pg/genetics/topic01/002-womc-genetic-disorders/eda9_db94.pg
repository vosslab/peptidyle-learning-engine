## DESCRIPTION
## Imported Genetics source row eda9_db94; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_EDA9_DB94';
<p>eda9_db94</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'people with the <strong><span style="color: #d40000;">disorder</span></strong> do<strong> <strong>NOT</strong> </strong>have enough of an enzyme called beta-hexosaminidase'</strong></span>.</p>
PROMPT_EDA9_DB94
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_EDA9_DB94_CHOICE_1';
Hemophilia
LITERAL_EDA9_DB94_CHOICE_1
$choice_2 = <<'LITERAL_EDA9_DB94_CHOICE_2';
Klinefelter syndrome
LITERAL_EDA9_DB94_CHOICE_2
$choice_3 = <<'LITERAL_EDA9_DB94_CHOICE_3';
Tay-Sachs disease
LITERAL_EDA9_DB94_CHOICE_3
$choice_4 = <<'LITERAL_EDA9_DB94_CHOICE_4';
WAGR syndrome
LITERAL_EDA9_DB94_CHOICE_4
$correct_1 = <<'LITERAL_EDA9_DB94_CORRECT_1';
Tay-Sachs disease
LITERAL_EDA9_DB94_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
