## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3C6E_E7BE';
<p>3c6e_e7be</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #d40000;">disorder</span></strong> caused when a small part of <strong><span style="color: #6c6c00;">chromosome</span></strong> 11 is missing'</strong></span>.</p>
PROMPT_3C6E_E7BE
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3C6E_E7BE_CHOICE_1';
Duchenne muscular dystrophy
LITERAL_3C6E_E7BE_CHOICE_1
$choice_2 = <<'LITERAL_3C6E_E7BE_CHOICE_2';
Maple syrup urine disease
LITERAL_3C6E_E7BE_CHOICE_2
$choice_3 = <<'LITERAL_3C6E_E7BE_CHOICE_3';
Turner syndrome
LITERAL_3C6E_E7BE_CHOICE_3
$choice_4 = <<'LITERAL_3C6E_E7BE_CHOICE_4';
WAGR syndrome
LITERAL_3C6E_E7BE_CHOICE_4
$correct_1 = <<'LITERAL_3C6E_E7BE_CORRECT_1';
WAGR syndrome
LITERAL_3C6E_E7BE_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
