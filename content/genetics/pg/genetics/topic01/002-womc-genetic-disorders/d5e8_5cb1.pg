DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D5E8_5CB1';
<p>d5e8_5cb1</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'also known as 47,XXX, is a <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> that results in a female that has three X <strong><span style="color: #6c6c00;">chromosome</span></strong>s'</strong></span>.</p>
PROMPT_D5E8_5CB1
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D5E8_5CB1_CHOICE_1';
Duchenne muscular dystrophy
LITERAL_D5E8_5CB1_CHOICE_1
$choice_2 = <<'LITERAL_D5E8_5CB1_CHOICE_2';
Fragile X syndrome
LITERAL_D5E8_5CB1_CHOICE_2
$choice_3 = <<'LITERAL_D5E8_5CB1_CHOICE_3';
Patau syndrome
LITERAL_D5E8_5CB1_CHOICE_3
$choice_4 = <<'LITERAL_D5E8_5CB1_CHOICE_4';
Triple X syndrome
LITERAL_D5E8_5CB1_CHOICE_4
$correct_1 = <<'LITERAL_D5E8_5CB1_CORRECT_1';
Triple X syndrome
LITERAL_D5E8_5CB1_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
