## DESCRIPTION
## Imported Genetics source row fa21_233e; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FA21_233E';
<p>fa21_233e</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #b74300;">genetic</span></strong> condition caused by a deletion of a group of genes located on <strong><span style="color: #6c6c00;">chromosome</span></strong> number 11'</strong></span>.</p>
PROMPT_FA21_233E
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FA21_233E_CHOICE_1';
Hemophilia
LITERAL_FA21_233E_CHOICE_1
$choice_2 = <<'LITERAL_FA21_233E_CHOICE_2';
Philadelphia <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_FA21_233E_CHOICE_2
$choice_3 = <<'LITERAL_FA21_233E_CHOICE_3';
Tay-Sachs disease
LITERAL_FA21_233E_CHOICE_3
$choice_4 = <<'LITERAL_FA21_233E_CHOICE_4';
WAGR syndrome
LITERAL_FA21_233E_CHOICE_4
$correct_1 = <<'LITERAL_FA21_233E_CORRECT_1';
WAGR syndrome
LITERAL_FA21_233E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
