## DESCRIPTION
## Imported Genetics source row d135_6569; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D135_6569';
<p>d135_6569</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'caused by a deletion within HSA band on the short arm of <strong><span style="color: #6c6c00;">chromosome</span></strong> 4'</strong></span>.</p>
PROMPT_D135_6569
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D135_6569_CHOICE_1';
DiGeorge syndrome
LITERAL_D135_6569_CHOICE_1
$choice_2 = <<'LITERAL_D135_6569_CHOICE_2';
Galactosemia
LITERAL_D135_6569_CHOICE_2
$choice_3 = <<'LITERAL_D135_6569_CHOICE_3';
Triple X syndrome
LITERAL_D135_6569_CHOICE_3
$choice_4 = <<'LITERAL_D135_6569_CHOICE_4';
Wolf-Hirschhorn syndrome
LITERAL_D135_6569_CHOICE_4
$correct_1 = <<'LITERAL_D135_6569_CORRECT_1';
Wolf-Hirschhorn syndrome
LITERAL_D135_6569_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
