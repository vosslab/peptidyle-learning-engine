## DESCRIPTION
## Imported Genetics source row 3ad4_e5d9; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_3AD4_E5D9';
<p>3ad4_e5d9</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'a <strong><span style="color: #b74300;">genetic</span></strong> condition involving changes in part of the X <strong><span style="color: #6c6c00;">chromosome</span></strong>'</strong></span>.</p>
PROMPT_3AD4_E5D9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_3AD4_E5D9_CHOICE_1';
Down syndrome
LITERAL_3AD4_E5D9_CHOICE_1
$choice_2 = <<'LITERAL_3AD4_E5D9_CHOICE_2';
Fragile X syndrome
LITERAL_3AD4_E5D9_CHOICE_2
$choice_3 = <<'LITERAL_3AD4_E5D9_CHOICE_3';
Marfan syndrome
LITERAL_3AD4_E5D9_CHOICE_3
$choice_4 = <<'LITERAL_3AD4_E5D9_CHOICE_4';
Sickle-cell anemia
LITERAL_3AD4_E5D9_CHOICE_4
$correct_1 = <<'LITERAL_3AD4_E5D9_CORRECT_1';
Fragile X syndrome
LITERAL_3AD4_E5D9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
