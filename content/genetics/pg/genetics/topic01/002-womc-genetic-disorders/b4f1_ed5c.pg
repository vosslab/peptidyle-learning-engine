## DESCRIPTION
## Imported Genetics source row b4f1_ed5c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B4F1_ED5C';
<p>b4f1_ed5c</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> caused by the presence of all or part of a third copy of <strong><span style="color: #6c6c00;">chromosome</span></strong> 21'</strong></span>.</p>
PROMPT_B4F1_ED5C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B4F1_ED5C_CHOICE_1';
Cystic fibrosis
LITERAL_B4F1_ED5C_CHOICE_1
$choice_2 = <<'LITERAL_B4F1_ED5C_CHOICE_2';
Down syndrome
LITERAL_B4F1_ED5C_CHOICE_2
$choice_3 = <<'LITERAL_B4F1_ED5C_CHOICE_3';
Edwards syndrome
LITERAL_B4F1_ED5C_CHOICE_3
$choice_4 = <<'LITERAL_B4F1_ED5C_CHOICE_4';
Triple X syndrome
LITERAL_B4F1_ED5C_CHOICE_4
$correct_1 = <<'LITERAL_B4F1_ED5C_CORRECT_1';
Down syndrome
LITERAL_B4F1_ED5C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
