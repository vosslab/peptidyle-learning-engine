## DESCRIPTION
## Imported Genetics source row 1be3_6e23; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_1BE3_6E23';
<p>1be3_6e23</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #d40000;">disorder</span></strong> that causes the progressive breakdown (degeneration) of nerve cells in the brain'</strong></span>.</p>
PROMPT_1BE3_6E23
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_1BE3_6E23_CHOICE_1';
Huntington's disease
LITERAL_1BE3_6E23_CHOICE_1
$choice_2 = <<'LITERAL_1BE3_6E23_CHOICE_2';
Patau syndrome
LITERAL_1BE3_6E23_CHOICE_2
$choice_3 = <<'LITERAL_1BE3_6E23_CHOICE_3';
WAGR syndrome
LITERAL_1BE3_6E23_CHOICE_3
$choice_4 = <<'LITERAL_1BE3_6E23_CHOICE_4';
Wolf-Hirschhorn syndrome
LITERAL_1BE3_6E23_CHOICE_4
$correct_1 = <<'LITERAL_1BE3_6E23_CORRECT_1';
Huntington's disease
LITERAL_1BE3_6E23_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
