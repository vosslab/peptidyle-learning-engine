DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_5924_29BB';
<p>5924_29bb</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'multi-systemic <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> that affects the connective tissue'</strong></span>.</p>
PROMPT_5924_29BB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_5924_29BB_CHOICE_1';
DiGeorge syndrome
LITERAL_5924_29BB_CHOICE_1
$choice_2 = <<'LITERAL_5924_29BB_CHOICE_2';
Marfan syndrome
LITERAL_5924_29BB_CHOICE_2
$choice_3 = <<'LITERAL_5924_29BB_CHOICE_3';
Patau syndrome
LITERAL_5924_29BB_CHOICE_3
$choice_4 = <<'LITERAL_5924_29BB_CHOICE_4';
Turner syndrome
LITERAL_5924_29BB_CHOICE_4
$correct_1 = <<'LITERAL_5924_29BB_CORRECT_1';
Marfan syndrome
LITERAL_5924_29BB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
