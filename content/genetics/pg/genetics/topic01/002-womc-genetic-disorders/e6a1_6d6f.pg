## DESCRIPTION
## Imported Genetics source row e6a1_6d6f; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_E6A1_6D6F';
<p>e6a1_6d6f</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'inherited <strong><span style="color: #d40000;">disorder</span></strong> of metabolism that causes an increase in the blood of a chemical known as phenylalanine'</strong></span>.</p>
PROMPT_E6A1_6D6F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_E6A1_6D6F_CHOICE_1';
Down syndrome
LITERAL_E6A1_6D6F_CHOICE_1
$choice_2 = <<'LITERAL_E6A1_6D6F_CHOICE_2';
Duchenne muscular dystrophy
LITERAL_E6A1_6D6F_CHOICE_2
$choice_3 = <<'LITERAL_E6A1_6D6F_CHOICE_3';
Fragile X syndrome
LITERAL_E6A1_6D6F_CHOICE_3
$choice_4 = <<'LITERAL_E6A1_6D6F_CHOICE_4';
Phenylketonuria
LITERAL_E6A1_6D6F_CHOICE_4
$correct_1 = <<'LITERAL_E6A1_6D6F_CORRECT_1';
Phenylketonuria
LITERAL_E6A1_6D6F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
