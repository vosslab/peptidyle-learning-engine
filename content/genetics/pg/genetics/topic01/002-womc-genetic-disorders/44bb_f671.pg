DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_44BB_F671';
<p>44bb_f671</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'a <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> that results in the destruction of nerve cells in the brain and spinal cord'</strong></span>.</p>
PROMPT_44BB_F671
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_44BB_F671_CHOICE_1';
Duchenne muscular dystrophy
LITERAL_44BB_F671_CHOICE_1
$choice_2 = <<'LITERAL_44BB_F671_CHOICE_2';
Edwards syndrome
LITERAL_44BB_F671_CHOICE_2
$choice_3 = <<'LITERAL_44BB_F671_CHOICE_3';
Hemophilia
LITERAL_44BB_F671_CHOICE_3
$choice_4 = <<'LITERAL_44BB_F671_CHOICE_4';
Tay-Sachs disease
LITERAL_44BB_F671_CHOICE_4
$correct_1 = <<'LITERAL_44BB_F671_CORRECT_1';
Tay-Sachs disease
LITERAL_44BB_F671_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
