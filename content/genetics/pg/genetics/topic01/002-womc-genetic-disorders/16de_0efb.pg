## DESCRIPTION
## Imported Genetics source row 16de_0efb; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_16DE_0EFB';
<p>16de_0efb</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'affects your red blood cells, turning them from round flexible discs into stiff and sticky, long, and rigid cells'</strong></span>.</p>
PROMPT_16DE_0EFB
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_16DE_0EFB_CHOICE_1';
Angelman syndrome
LITERAL_16DE_0EFB_CHOICE_1
$choice_2 = <<'LITERAL_16DE_0EFB_CHOICE_2';
Fragile X syndrome
LITERAL_16DE_0EFB_CHOICE_2
$choice_3 = <<'LITERAL_16DE_0EFB_CHOICE_3';
Sickle-cell anemia
LITERAL_16DE_0EFB_CHOICE_3
$choice_4 = <<'LITERAL_16DE_0EFB_CHOICE_4';
Wolf-Hirschhorn syndrome
LITERAL_16DE_0EFB_CHOICE_4
$correct_1 = <<'LITERAL_16DE_0EFB_CORRECT_1';
Sickle-cell anemia
LITERAL_16DE_0EFB_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
