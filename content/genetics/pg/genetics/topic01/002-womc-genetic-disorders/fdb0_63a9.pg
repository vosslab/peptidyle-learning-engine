DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_FDB0_63A9';
<p>fdb0_63a9</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'forms when <strong><span style="color: #6c6c00;">chromosome</span></strong> 9 and <strong><span style="color: #6c6c00;">chromosome</span></strong> 22 break and exchange portions of their <strong><span style="color: #b74300;">genetic</span></strong> material'</strong></span>.</p>
PROMPT_FDB0_63A9
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_FDB0_63A9_CHOICE_1';
Achondroplasia
LITERAL_FDB0_63A9_CHOICE_1
$choice_2 = <<'LITERAL_FDB0_63A9_CHOICE_2';
Duchenne muscular dystrophy
LITERAL_FDB0_63A9_CHOICE_2
$choice_3 = <<'LITERAL_FDB0_63A9_CHOICE_3';
Maple syrup urine disease
LITERAL_FDB0_63A9_CHOICE_3
$choice_4 = <<'LITERAL_FDB0_63A9_CHOICE_4';
Philadelphia <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_FDB0_63A9_CHOICE_4
$correct_1 = <<'LITERAL_FDB0_63A9_CORRECT_1';
Philadelphia <strong><span style="color: #6c6c00;">chromosome</span></strong>
LITERAL_FDB0_63A9_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
