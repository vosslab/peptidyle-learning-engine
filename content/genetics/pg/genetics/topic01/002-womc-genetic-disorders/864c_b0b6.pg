## DESCRIPTION
## Imported Genetics source row 864c_b0b6; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_864C_B0B6';
<p>864c_b0b6</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'inherited <strong><span style="color: #d40000;">disorder</span></strong> that causes an amino acid called phenylalanine to build up in the body'</strong></span>.</p>
PROMPT_864C_B0B6
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_864C_B0B6_CHOICE_1';
DiGeorge syndrome
LITERAL_864C_B0B6_CHOICE_1
$choice_2 = <<'LITERAL_864C_B0B6_CHOICE_2';
Phenylketonuria
LITERAL_864C_B0B6_CHOICE_2
$choice_3 = <<'LITERAL_864C_B0B6_CHOICE_3';
Prader-Willi syndrome
LITERAL_864C_B0B6_CHOICE_3
$choice_4 = <<'LITERAL_864C_B0B6_CHOICE_4';
Sickle-cell anemia
LITERAL_864C_B0B6_CHOICE_4
$correct_1 = <<'LITERAL_864C_B0B6_CORRECT_1';
Phenylketonuria
LITERAL_864C_B0B6_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
