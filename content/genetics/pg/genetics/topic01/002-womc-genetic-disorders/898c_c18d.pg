## DESCRIPTION
## Imported Genetics source row 898c_c18d; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_898C_C18D';
<p>898c_c18d</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'autosomal recessive <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> affecting most critically the lungs'</strong></span>.</p>
PROMPT_898C_C18D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_898C_C18D_CHOICE_1';
Cystic fibrosis
LITERAL_898C_C18D_CHOICE_1
$choice_2 = <<'LITERAL_898C_C18D_CHOICE_2';
Phenylketonuria
LITERAL_898C_C18D_CHOICE_2
$choice_3 = <<'LITERAL_898C_C18D_CHOICE_3';
Triple X syndrome
LITERAL_898C_C18D_CHOICE_3
$choice_4 = <<'LITERAL_898C_C18D_CHOICE_4';
WAGR syndrome
LITERAL_898C_C18D_CHOICE_4
$correct_1 = <<'LITERAL_898C_C18D_CORRECT_1';
Cystic fibrosis
LITERAL_898C_C18D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
