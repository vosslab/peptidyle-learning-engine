DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_9F25_303F';
<p>9f25_303f</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #d40000;">disorder</span></strong> that affects the muscles, leading to muscle wasting that gets worse over time'</strong></span>.</p>
PROMPT_9F25_303F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_9F25_303F_CHOICE_1';
Cri du chat syndrome
LITERAL_9F25_303F_CHOICE_1
$choice_2 = <<'LITERAL_9F25_303F_CHOICE_2';
Cystic fibrosis
LITERAL_9F25_303F_CHOICE_2
$choice_3 = <<'LITERAL_9F25_303F_CHOICE_3';
Duchenne muscular dystrophy
LITERAL_9F25_303F_CHOICE_3
$choice_4 = <<'LITERAL_9F25_303F_CHOICE_4';
Hemophilia
LITERAL_9F25_303F_CHOICE_4
$correct_1 = <<'LITERAL_9F25_303F_CORRECT_1';
Duchenne muscular dystrophy
LITERAL_9F25_303F_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
