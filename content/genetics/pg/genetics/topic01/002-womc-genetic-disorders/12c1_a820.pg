## DESCRIPTION
## Imported Genetics source row 12c1_a820; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_12C1_A820';
<p>12c1_a820</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'<strong><span style="color: #935d00;">metabolic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong> that affects an individual's ability to metabolize the sugar galactose properly'</strong></span>.</p>
PROMPT_12C1_A820
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_12C1_A820_CHOICE_1';
Galactosemia
LITERAL_12C1_A820_CHOICE_1
$choice_2 = <<'LITERAL_12C1_A820_CHOICE_2';
Hemophilia
LITERAL_12C1_A820_CHOICE_2
$choice_3 = <<'LITERAL_12C1_A820_CHOICE_3';
Patau syndrome
LITERAL_12C1_A820_CHOICE_3
$choice_4 = <<'LITERAL_12C1_A820_CHOICE_4';
Prader-Willi syndrome
LITERAL_12C1_A820_CHOICE_4
$correct_1 = <<'LITERAL_12C1_A820_CORRECT_1';
Galactosemia
LITERAL_12C1_A820_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
