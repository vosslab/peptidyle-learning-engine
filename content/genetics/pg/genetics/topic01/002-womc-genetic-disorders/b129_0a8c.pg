## DESCRIPTION
## Imported Genetics source row b129_0a8c; static curriculum staging source.
## ENDDESCRIPTION
## KEYWORDS('genetics','imported-curriculum')
## DBsubject('Genetics')
## Author('Neil R. Voss; imported from source/topic01/bbq-WOMC-genetic_disorders-questions.txt')
## Institution('Roosevelt University')

DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_B129_0A8C';
<p>b129_0a8c</p> <p>Which one of the following <strong><span style="color: #b74300;">genetic</span></strong> <strong><span style="color: #d40000;">disorder</span></strong>s correspond to the description <span style='font-size: 1em;'><strong>'an inherited bleeding <strong><span style="color: #d40000;">disorder</span></strong> in which the blood does<strong> <strong>NOT</strong> </strong>clot properly'</strong></span>.</p>
PROMPT_B129_0A8C
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B129_0A8C_CHOICE_1';
Cri du chat syndrome
LITERAL_B129_0A8C_CHOICE_1
$choice_2 = <<'LITERAL_B129_0A8C_CHOICE_2';
Hemophilia
LITERAL_B129_0A8C_CHOICE_2
$choice_3 = <<'LITERAL_B129_0A8C_CHOICE_3';
Sickle-cell anemia
LITERAL_B129_0A8C_CHOICE_3
$choice_4 = <<'LITERAL_B129_0A8C_CHOICE_4';
Tay-Sachs disease
LITERAL_B129_0A8C_CHOICE_4
$correct_1 = <<'LITERAL_B129_0A8C_CORRECT_1';
Hemophilia
LITERAL_B129_0A8C_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
