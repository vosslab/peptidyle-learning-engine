DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_434A_967B';
<p>434a_967b</p> <h4>Three-Point Test Cross Problem</h4><p>A test cross is a way to explore the relationship between genes and their respective alleles. It is a useful tool for genetic mapping and deciphering the inheritance of traits. Specifically, a three-point test cross examines three (3) genes at the same time to learn about their assortment in gamete formation.</p><p>A standard three-point test cross involves crossing a heterozygous organism for all three genes with an organism that is homozygous recessive for all three genes</p> <p>For this problem, a test cross using a fruit fly (<i>Drosophila melanogaster</i>) heterozygous for three genes was conducted to understand their genetic interactions.</p><h6>Characteristics of Recessive Phenotypes</h6><p><ul><li><strong><span style="color: #646108;">Gene A</span></strong> is related to the '<span style="color: #646108;"><i>artsy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #646108;">Gene A</span> has wings that are colorful and distinctive patterns.</li> <li><strong><span style="color: #086594;">Gene D</span></strong> is linked with the '<span style="color: #086594;"><i>dewy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #086594;">Gene D</span> appears moist, with its body covered in tiny droplets of water.</li> <li><strong><span style="color: #8a378a;">Gene E</span></strong> is linked with the '<span style="color: #8a378a;"><i>eery</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #8a378a;">Gene E</span> appears to have something off, crooked limbs and other twisted appendages.</li> </ul></p><table style="border-collapse: collapse; border: 2px solid black;"><tr><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Phenotype</span></th><th colspan="3" align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Genotypes</span></th><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Progeny<br/>Count</span></th></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, dewy, eery</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">d</span></td><td align="center" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">e</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">34,344</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, dewy</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">d</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">39,953</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, eery</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">e</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">45,159</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">10,348</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">dewy, eery</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">d</span></td><td align="center" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">e</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">10,499</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">dewy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">d</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">45,290</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">eery</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">e</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">39,794</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">34,613</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">260,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>E</b> and <b>D</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>E</b> and <b>D</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_434A_967B
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_434A_967B_CHOICE_1';
<sup>(10,348 + 10,499 + 34,344 + 34,613)</sup>/<sub>260,000</sub> = <sup>89,804</sup>/<sub>260,000</sub> = 0.3454 = <strong>34.54 cM</strong>
LITERAL_434A_967B_CHOICE_1
$choice_2 = <<'LITERAL_434A_967B_CHOICE_2';
<sup>(10,348 + 10,499 + 34,344 + 39,794)</sup>/<sub>260,000</sub> = <sup>94,985</sup>/<sub>260,000</sub> = 0.3653 = <strong>36.53 cM</strong>
LITERAL_434A_967B_CHOICE_2
$choice_3 = <<'LITERAL_434A_967B_CHOICE_3';
<sup>(10,348 + 10,499 + 45,159 + 45,290)</sup>/<sub>260,000</sub> = <sup>111,296</sup>/<sub>260,000</sub> = 0.4281 = <strong>42.81 cM</strong>
LITERAL_434A_967B_CHOICE_3
$choice_4 = <<'LITERAL_434A_967B_CHOICE_4';
<sup>(10,499 + 34,344 + 34,613 + 39,953)</sup>/<sub>260,000</sub> = <sup>119,409</sup>/<sub>260,000</sub> = 0.4593 = <strong>45.93 cM</strong>
LITERAL_434A_967B_CHOICE_4
$choice_5 = <<'LITERAL_434A_967B_CHOICE_5';
<sup>(10,499 + 34,613 + 39,953 + 45,290)</sup>/<sub>260,000</sub> = <sup>130,355</sup>/<sub>260,000</sub> = 0.5014 = <strong>50.14 cM</strong>
LITERAL_434A_967B_CHOICE_5
$choice_6 = <<'LITERAL_434A_967B_CHOICE_6';
<sup>(45,159 + 45,290)</sup>/<sub>260,000</sub> = <sup>90,449</sup>/<sub>260,000</sub> = 0.3479 = <strong>34.79 cM</strong>
LITERAL_434A_967B_CHOICE_6
$correct_1 = <<'LITERAL_434A_967B_CORRECT_1';
<sup>(10,348 + 10,499 + 34,344 + 34,613)</sup>/<sub>260,000</sub> = <sup>89,804</sup>/<sub>260,000</sub> = 0.3454 = <strong>34.54 cM</strong>
LITERAL_434A_967B_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
