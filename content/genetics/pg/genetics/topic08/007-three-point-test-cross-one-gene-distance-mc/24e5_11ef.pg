ter" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">t</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">29,677</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">chummy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #cbf5e6; padding: 5px;"><span style="font-size: large; color: #000000;">c</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">1,123</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">tipsy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #006e59;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffdffa; padding: 5px;"><span style="font-size: large; color: #000000;">t</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">16,680</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #006e59;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #8a378a;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">2,351</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">100,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>A</b> and <b>T</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>A</b> and <b>T</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_24E5_11EF
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_24E5_11EF_CHOICE_1';
<sup>(1,123 + 1,137 + 16,680 + 16,850)</sup>/<sub>100,000</sub> = <sup>35,790</sup>/<sub>100,000</sub> = 0.3579 = <strong>35.79 cM</strong>
LITERAL_24E5_11EF_CHOICE_1
$choice_2 = <<'LITERAL_24E5_11EF_CHOICE_2';
<sup>(1,123 + 1,137 + 16,680 + 29,677)</sup>/<sub>100,000</sub> = <sup>48,617</sup>/<sub>100,000</sub> = 0.4862 = <strong>48.62 cM</strong>
LITERAL_24E5_11EF_CHOICE_2
$choice_3 = <<'LITERAL_24E5_11EF_CHOICE_3';
<sup>(1,123 + 1,137 + 2,279 + 16,680)</sup>/<sub>100,000</sub> = <sup>21,219</sup>/<sub>100,000</sub> = 0.2122 = <strong>21.22 cM</strong>
LITERAL_24E5_11EF_CHOICE_3
$choice_4 = <<'LITERAL_24E5_11EF_CHOICE_4';
<sup>(1,123 + 1,137 + 2,279 + 2,351)</sup>/<sub>100,000</sub> = <sup>6,890</sup>/<sub>100,000</sub> = 0.0689 = <strong>6.89 cM</strong>
LITERAL_24E5_11EF_CHOICE_4
$choice_5 = <<'LITERAL_24E5_11EF_CHOICE_5';
<sup>(2,279 + 2,351 + 16,680 + 29,677)</sup>/<sub>100,000</sub> = <sup>50,987</sup>/<sub>100,000</sub> = 0.5099 = <strong>50.99 cM</strong>
LITERAL_24E5_11EF_CHOICE_5
$choice_6 = <<'LITERAL_24E5_11EF_CHOICE_6';
<sup>(29,677 + 29,903)</sup>/<sub>100,000</sub> = <sup>59,580</sup>/<sub>100,000</sub> = 0.5958 = <strong>59.58 cM</strong>
LITERAL_24E5_11EF_CHOICE_6
$correct_1 = <<'LITERAL_24E5_11EF_CORRECT_1';
<sup>(1,123 + 1,137 + 2,279 + 2,351)</sup>/<sub>100,000</sub> = <sup>6,890</sup>/<sub>100,000</sub> = 0.0689 = <strong>6.89 cM</strong>
LITERAL_24E5_11EF_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

