DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_CD85_524A';
<p>cd85_524a</p> <h4>Three-Point Test Cross Problem</h4><p>A test cross is a way to explore the relationship between genes and their respective alleles. It is a useful tool for genetic mapping and deciphering the inheritance of traits. Specifically, a three-point test cross examines three (3) genes at the same time to learn about their assortment in gamete formation.</p><p>A standard three-point test cross involves crossing a heterozygous organism for all three genes with an organism that is homozygous recessive for all three genes</p> <p>For this problem, a test cross using a fruit fly (<i>Drosophila melanogaster</i>) heterozygous for three genes was conducted to understand their genetic interactions.</p><h6>Characteristics of Recessive Phenotypes</h6><p><ul><li><strong><span style="color: #4b6924;">Gene F</span></strong> is linked with the '<span style="color: #4b6924;"><i>fuzzy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #4b6924;">Gene F</span> is covered in a dense layer of hairs, giving it a soft appearance.</li> <li><strong><span style="color: #00697f;">Gene R</span></strong> is analogous to the '<span style="color: #00697f;"><i>rusty</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #00697f;">Gene R</span> has a reddish-brown color, much like rusted iron metal.</li> <li><strong><span style="color: #9a3064;">Gene X</span></strong> is analogous to the '<span style="color: #9a3064;"><i>xanthic</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #9a3064;">Gene X</span> has a fluorescent bright yellow coloring.</li> </ul></p><table style="border-collapse: collapse; border: 2px solid black;"><tr><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Phenotype</span></th><th colspan="3" align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Genotypes</span></th><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Progeny<br/>Count</span></th></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">fuzzy, rusty, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #e1f2c5; padding: 5px;"><span style="font-size: large; color: #000000;">f</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">156</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">fuzzy, rusty</span></td><td align="center" style="border: 1px solid black; background-color: #e1f2c5; padding: 5px;"><span style="font-size: large; color: #000000;">f</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">50,213</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">fuzzy, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #e1f2c5; padding: 5px;"><span style="font-size: large; color: #000000;">f</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">4,174</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">fuzzy</span></td><td align="center" style="border: 1px solid black; background-color: #e1f2c5; padding: 5px;"><span style="font-size: large; color: #000000;">f</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">10,373</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">rusty, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #4b6924;">+</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">10,205</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">rusty</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #4b6924;">+</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">4,275</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #4b6924;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">50,447</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #4b6924;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">157</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">130,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>X</b> and <b>R</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>X</b> and <b>R</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_CD85_524A
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_CD85_524A_CHOICE_1';
<sup>(156 + 157 + 10,205 + 10,373)</sup>/<sub>130,000</sub> = <sup>20,891</sup>/<sub>130,000</sub> = 0.1607 = <strong>16.07 cM</strong>
LITERAL_CD85_524A_CHOICE_1
$choice_2 = <<'LITERAL_CD85_524A_CHOICE_2';
<sup>(156 + 157 + 4,174 + 4,275)</sup>/<sub>130,000</sub> = <sup>8,762</sup>/<sub>130,000</sub> = 0.0674 = <strong>6.74 cM</strong>
LITERAL_CD85_524A_CHOICE_2
$choice_3 = <<'LITERAL_CD85_524A_CHOICE_3';
<sup>(156 + 157 + 4,174 + 50,213)</sup>/<sub>130,000</sub> = <sup>54,700</sup>/<sub>130,000</sub> = 0.4208 = <strong>42.08 cM</strong>
LITERAL_CD85_524A_CHOICE_3
$choice_4 = <<'LITERAL_CD85_524A_CHOICE_4';
<sup>(157 + 4,275 + 10,373 + 50,447)</sup>/<sub>130,000</sub> = <sup>65,252</sup>/<sub>130,000</sub> = 0.5019 = <strong>50.19 cM</strong>
LITERAL_CD85_524A_CHOICE_4
$choice_5 = <<'LITERAL_CD85_524A_CHOICE_5';
<sup>(4,174 + 4,275 + 10,205 + 10,373)</sup>/<sub>130,000</sub> = <sup>29,027</sup>/<sub>130,000</sub> = 0.2233 = <strong>22.33 cM</strong>
LITERAL_CD85_524A_CHOICE_5
$choice_6 = <<'LITERAL_CD85_524A_CHOICE_6';
<sup>(50,213 + 50,447)</sup>/<sub>130,000</sub> = <sup>100,660</sup>/<sub>130,000</sub> = 0.7743 = <strong>77.43 cM</strong>
LITERAL_CD85_524A_CHOICE_6
$correct_1 = <<'LITERAL_CD85_524A_CORRECT_1';
<sup>(156 + 157 + 10,205 + 10,373)</sup>/<sub>130,000</sub> = <sup>20,891</sup>/<sub>130,000</sub> = 0.1607 = <strong>16.07 cM</strong>
LITERAL_CD85_524A_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
