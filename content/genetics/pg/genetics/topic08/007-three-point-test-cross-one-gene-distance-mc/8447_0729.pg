DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_8447_0729';
<p>8447_0729</p> <h4>Three-Point Test Cross Problem</h4><p>A test cross is a way to explore the relationship between genes and their respective alleles. It is a useful tool for genetic mapping and deciphering the inheritance of traits. Specifically, a three-point test cross examines three (3) genes at the same time to learn about their assortment in gamete formation.</p><p>A standard three-point test cross involves crossing a heterozygous organism for all three genes with an organism that is homozygous recessive for all three genes</p> <p>For this problem, a test cross using a fruit fly (<i>Drosophila melanogaster</i>) heterozygous for three genes was conducted to understand their genetic interactions.</p><h6>Characteristics of Recessive Phenotypes</h6><p><ul><li><strong><span style="color: #993e11;">Gene A</span></strong> is related to the '<span style="color: #993e11;"><i>artsy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #993e11;">Gene A</span> has wings that are colorful and distinctive patterns.</li> <li><strong><span style="color: #286d3f;">Gene H</span></strong> is associated with the '<span style="color: #286d3f;"><i>horsey</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #286d3f;">Gene H</span> is quite big and strong-looking, much larger than your typical fruit fly.</li> <li><strong><span style="color: #7441a6;">Gene K</span></strong> is linked with the '<span style="color: #7441a6;"><i>kidney</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #7441a6;">Gene K</span> has a body shape that is curved, similar to a kidney bean.</li> </ul></p><table style="border-collapse: collapse; border: 2px solid black;"><tr><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Phenotype</span></th><th colspan="3" align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Genotypes</span></th><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Progeny<br/>Count</span></th></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, horsey, kidney</span></td><td align="center" style="border: 1px solid black; background-color: #ffe4da; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #d4f4d6; padding: 5px;"><span style="font-size: large; color: #000000;">h</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">k</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">2,996</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, horsey</span></td><td align="center" style="border: 1px solid black; background-color: #ffe4da; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #d4f4d6; padding: 5px;"><span style="font-size: large; color: #000000;">h</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">31,866</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy, kidney</span></td><td align="center" style="border: 1px solid black; background-color: #ffe4da; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #286d3f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">k</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">69,738</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">artsy</span></td><td align="center" style="border: 1px solid black; background-color: #ffe4da; padding: 5px;"><span style="font-size: large; color: #000000;">a</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #286d3f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">327</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">horsey, kidney</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #993e11;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d4f4d6; padding: 5px;"><span style="font-size: large; color: #000000;">h</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">k</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">281</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">horsey</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #993e11;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d4f4d6; padding: 5px;"><span style="font-size: large; color: #000000;">h</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">69,890</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">kidney</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #993e11;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #286d3f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">k</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">31,891</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #993e11;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #286d3f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">3,011</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">210,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>A</b> and <b>K</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>A</b> and <b>K</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_8447_0729
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8447_0729_CHOICE_1';
<sup>(281 + 2,996 + 31,866 + 31,891)</sup>/<sub>210,000</sub> = <sup>67,034</sup>/<sub>210,000</sub> = 0.3192 = <strong>31.92 cM</strong>
LITERAL_8447_0729_CHOICE_1
$choice_2 = <<'LITERAL_8447_0729_CHOICE_2';
<sup>(281 + 327 + 2,996 + 3,011)</sup>/<sub>210,000</sub> = <sup>6,615</sup>/<sub>210,000</sub> = 0.0315 = <strong>3.15 cM</strong>
LITERAL_8447_0729_CHOICE_2
$choice_3 = <<'LITERAL_8447_0729_CHOICE_3';
<sup>(281 + 327 + 3,011 + 31,891)</sup>/<sub>210,000</sub> = <sup>35,510</sup>/<sub>210,000</sub> = 0.1691 = <strong>16.91 cM</strong>
LITERAL_8447_0729_CHOICE_3
$choice_4 = <<'LITERAL_8447_0729_CHOICE_4';
<sup>(281 + 327 + 31,866 + 31,891)</sup>/<sub>210,000</sub> = <sup>64,365</sup>/<sub>210,000</sub> = 0.3065 = <strong>30.65 cM</strong>
LITERAL_8447_0729_CHOICE_4
$choice_5 = <<'LITERAL_8447_0729_CHOICE_5';
<sup>(327 + 3,011 + 31,891 + 69,890)</sup>/<sub>210,000</sub> = <sup>105,119</sup>/<sub>210,000</sub> = 0.5006 = <strong>50.06 cM</strong>
LITERAL_8447_0729_CHOICE_5
$choice_6 = <<'LITERAL_8447_0729_CHOICE_6';
<sup>(69,738 + 69,890)</sup>/<sub>210,000</sub> = <sup>139,628</sup>/<sub>210,000</sub> = 0.6649 = <strong>66.49 cM</strong>
LITERAL_8447_0729_CHOICE_6
$correct_1 = <<'LITERAL_8447_0729_CORRECT_1';
<sup>(281 + 327 + 31,866 + 31,891)</sup>/<sub>210,000</sub> = <sup>64,365</sup>/<sub>210,000</sub> = 0.3065 = <strong>30.65 cM</strong>
LITERAL_8447_0729_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
