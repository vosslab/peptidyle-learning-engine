loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_0F8F_E46D';
<p>0f8f_e46d</p> <h4>Three-Point Test Cross Problem</h4><p>A test cross is a way to explore the relationship between genes and their respective alleles. It is a useful tool for genetic mapping and deciphering the inheritance of traits. Specifically, a three-point test cross examines three (3) genes at the same time to learn about their assortment in gamete formation.</p><p>A standard three-point test cross involves crossing a heterozygous organism for all three genes with an organism that is homozygous recessive for all three genes</p> <p>For this problem, a test cross using a fruit fly (<i>Drosophila melanogaster</i>) heterozygous for three genes was conducted to understand their genetic interactions.</p><h6>Characteristics of Recessive Phenotypes</h6><p><ul><li><strong><span style="color: #646108;">Gene C</span></strong> is connected with the '<span style="color: #646108;"><i>chummy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #646108;">Gene C</span> shows behavior where it always maintains a close distance to other flies.</li> <li><strong><span style="color: #00697f;">Gene R</span></strong> is linked with the '<span style="color: #00697f;"><i>rusty</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #00697f;">Gene R</span> has a reddish-brown color, much like rusted iron metal.</li> <li><strong><span style="color: #7441a6;">Gene X</span></strong> is associated with the '<span style="color: #7441a6;"><i>xanthic</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #7441a6;">Gene X</span> has a fluorescent bright yellow coloring.</li> </ul></p><table style="border-collapse: collapse; border: 2px solid black;"><tr><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Phenotype</span></th><th colspan="3" align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Genotypes</span></th><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Progeny<br/>Count</span></th></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">chummy, rusty, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">c</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">3,183</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">chummy, rusty</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">c</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">26,918</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">chummy, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">c</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">47,605</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">chummy</span></td><td align="center" style="border: 1px solid black; background-color: #f1edba; padding: 5px;"><span style="font-size: large; color: #000000;">c</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">27,628</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">rusty, xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">27,395</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">rusty</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #cbf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">r</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">47,186</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">xanthic</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f2e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">x</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">26,866</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #646108;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #00697f;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7441a6;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">3,219</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">210,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>C</b> and <b>X</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>C</b> and <b>X</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_0F8F_E46D
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_0F8F_E46D_CHOICE_1';
<sup>(26,866 + 26,918 + 27,395 + 27,628)</sup>/<sub>210,000</sub> = <sup>108,807</sup>/<sub>210,000</sub> = 0.5181 = <strong>51.81 cM</strong>
LITERAL_0F8F_E46D_CHOICE_1
$choice_2 = <<'LITERAL_0F8F_E46D_CHOICE_2';
<sup>(3,183 + 26,866 + 26,918 + 27,395)</sup>/<sub>210,000</sub> = <sup>84,362</sup>/<sub>210,000</sub> = 0.4017 = <strong>40.17 cM</strong>
LITERAL_0F8F_E46D_CHOICE_2
$choice_3 = <<'LITERAL_0F8F_E46D_CHOICE_3';
<sup>(3,183 + 3,219 + 26,866 + 26,918)</sup>/<sub>210,000</sub> = <sup>60,186</sup>/<sub>210,000</sub> = 0.2866 = <strong>28.66 cM</strong>
LITERAL_0F8F_E46D_CHOICE_3
$choice_4 = <<'LITERAL_0F8F_E46D_CHOICE_4';
<sup>(3,183 + 3,219 + 47,186 + 47,605)</sup>/<sub>210,000</sub> = <sup>101,193</sup>/<sub>210,000</sub> = 0.4819 = <strong>48.19 cM</strong>
LITERAL_0F8F_E46D_CHOICE_4
$choice_5 = <<'LITERAL_0F8F_E46D_CHOICE_5';
<sup>(3,219 + 27,395 + 27,628 + 47,605)</sup>/<sub>210,000</sub> = <sup>105,847</sup>/<sub>210,000</sub> = 0.5040 = <strong>50.40 cM</strong>
LITERAL_0F8F_E46D_CHOICE_5
$choice_6 = <<'LITERAL_0F8F_E46D_CHOICE_6';
<sup>(47,186 + 47,605)</sup>/<sub>210,000</sub> = <sup>94,791</sup>/<sub>210,000</sub> = 0.4514 = <strong>45.14 cM</strong>
LITERAL_0F8F_E46D_CHOICE_6
$correct_1 = <<'LITERAL_0F8F_E46D_CORRECT_1';
<sup>(26,866 + 26,918 + 27,395 + 27,628)</sup>/<sub>210,000</sub> = <sup>108,807</sup>/<sub>210,000</sub> = 0.5181 = <strong>51.81 cM</strong>
LITERAL_0F8F_E46D_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
