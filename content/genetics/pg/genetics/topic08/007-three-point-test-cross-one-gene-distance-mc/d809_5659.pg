DOCUMENT();
loadMacros('PGstandard.pl', 'MathObjects.pl', 'PGcourse.pl');
TEXT(beginproblem());
$showPartialCorrectAnswers = 0;
$prompt = <<'PROMPT_D809_5659';
<p>d809_5659</p> <h4>Three-Point Test Cross Problem</h4><p>A test cross is a way to explore the relationship between genes and their respective alleles. It is a useful tool for genetic mapping and deciphering the inheritance of traits. Specifically, a three-point test cross examines three (3) genes at the same time to learn about their assortment in gamete formation.</p><p>A standard three-point test cross involves crossing a heterozygous organism for all three genes with an organism that is homozygous recessive for all three genes</p> <p>For this problem, a test cross using a fruit fly (<i>Drosophila melanogaster</i>) heterozygous for three genes was conducted to understand their genetic interactions.</p><h6>Characteristics of Recessive Phenotypes</h6><p><ul><li><strong><span style="color: #775900;">Gene N</span></strong> is analogous to the '<span style="color: #775900;"><i>nerdy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #775900;">Gene N</span> has large, prominent eyes that stand out, much like thick-rimmed glasses.</li> <li><strong><span style="color: #086594;">Gene P</span></strong> is related to the '<span style="color: #086594;"><i>prickly</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #086594;">Gene P</span> is covered with sharp bristles, giving it a spiky texture.</li> <li><strong><span style="color: #9a3064;">Gene W</span></strong> is affiliated with the '<span style="color: #9a3064;"><i>waxy</i></span>' phenotype. A fruit fly that is homozygous recessive for <span style="color: #9a3064;">Gene W</span> has a thick protective layer that is water resistant and opague.</li> </ul></p><table style="border-collapse: collapse; border: 2px solid black;"><tr><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Phenotype</span></th><th colspan="3" align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Genotypes</span></th><th align="center" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">Progeny<br/>Count</span></th></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">nerdy, prickly, waxy</span></td><td align="center" style="border: 1px solid black; background-color: #ffe7bb; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">p</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">w</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">27,808</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">nerdy, prickly</span></td><td align="center" style="border: 1px solid black; background-color: #ffe7bb; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">p</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">78,739</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">nerdy, waxy</span></td><td align="center" style="border: 1px solid black; background-color: #ffe7bb; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">w</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">4,202</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">nerdy</span></td><td align="center" style="border: 1px solid black; background-color: #ffe7bb; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">14,429</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">prickly, waxy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">p</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">w</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">14,361</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">prickly</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #d9edff; padding: 5px;"><span style="font-size: large; color: #000000;">p</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">4,258</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">waxy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ffe1eb; padding: 5px;"><span style="font-size: large; color: #000000;">w</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">78,596</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #775900;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #086594;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9a3064;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">27,607</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">250,000</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>P</b> and <b>N</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>P</b> and <b>N</b>,</strong> expressing your answer in centimorgans (cM)</p>
PROMPT_D809_5659
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D809_5659_CHOICE_1';
<sup>(14,361 + 14,429 + 27,607 + 27,808)</sup>/<sub>250,000</sub> = <sup>84,205</sup>/<sub>250,000</sub> = 0.3368 = <strong>33.68 cM</strong>
LITERAL_D809_5659_CHOICE_1
$choice_2 = <<'LITERAL_D809_5659_CHOICE_2';
<sup>(4,202 + 4,258 + 14,361 + 14,429)</sup>/<sub>250,000</sub> = <sup>37,250</sup>/<sub>250,000</sub> = 0.1490 = <strong>14.90 cM</strong>
LITERAL_D809_5659_CHOICE_2
$choice_3 = <<'LITERAL_D809_5659_CHOICE_3';
<sup>(4,202 + 4,258 + 14,361 + 27,607)</sup>/<sub>250,000</sub> = <sup>50,428</sup>/<sub>250,000</sub> = 0.2017 = <strong>20.17 cM</strong>
LITERAL_D809_5659_CHOICE_3
$choice_4 = <<'LITERAL_D809_5659_CHOICE_4';
<sup>(4,202 + 4,258 + 14,429 + 78,739)</sup>/<sub>250,000</sub> = <sup>101,628</sup>/<sub>250,000</sub> = 0.4065 = <strong>40.65 cM</strong>
LITERAL_D809_5659_CHOICE_4
$choice_5 = <<'LITERAL_D809_5659_CHOICE_5';
<sup>(4,258 + 14,429 + 27,808 + 78,739)</sup>/<sub>250,000</sub> = <sup>125,234</sup>/<sub>250,000</sub> = 0.5009 = <strong>50.09 cM</strong>
LITERAL_D809_5659_CHOICE_5
$choice_6 = <<'LITERAL_D809_5659_CHOICE_6';
<sup>(78,596 + 78,739)</sup>/<sub>250,000</sub> = <sup>157,335</sup>/<sub>250,000</sub> = 0.6293 = <strong>62.93 cM</strong>
LITERAL_D809_5659_CHOICE_6
$correct_1 = <<'LITERAL_D809_5659_CORRECT_1';
<sup>(4,202 + 4,258 + 14,361 + 14,429)</sup>/<sub>250,000</sub> = <sup>37,250</sup>/<sub>250,000</sub> = 0.1490 = <strong>14.90 cM</strong>
LITERAL_D809_5659_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{$answer->buttons\}
END_TEXT
ANS($answer->cmp);

ENDDOCUMENT();
