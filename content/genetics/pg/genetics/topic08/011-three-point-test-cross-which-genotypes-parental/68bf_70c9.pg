$choice_1 = <<'LITERAL_68BF_70C9_CHOICE_1';
bxy
LITERAL_68BF_70C9_CHOICE_1
$choice_2 = <<'LITERAL_68BF_70C9_CHOICE_2';
bx+
LITERAL_68BF_70C9_CHOICE_2
$choice_3 = <<'LITERAL_68BF_70C9_CHOICE_3';
b+y
LITERAL_68BF_70C9_CHOICE_3
$choice_4 = <<'LITERAL_68BF_70C9_CHOICE_4';
b++
LITERAL_68BF_70C9_CHOICE_4
