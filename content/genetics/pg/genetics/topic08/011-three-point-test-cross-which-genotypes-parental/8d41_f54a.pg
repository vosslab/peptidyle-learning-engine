$choice_1 = <<'LITERAL_8D41_F54A_CHOICE_1';
dfw
LITERAL_8D41_F54A_CHOICE_1
$choice_2 = <<'LITERAL_8D41_F54A_CHOICE_2';
df+
LITERAL_8D41_F54A_CHOICE_2
$choice_3 = <<'LITERAL_8D41_F54A_CHOICE_3';
d+w
LITERAL_8D41_F54A_CHOICE_3
$choice_4 = <<'LITERAL_8D41_F54A_CHOICE_4';
d++
LITERAL_8D41_F54A_CHOICE_4
