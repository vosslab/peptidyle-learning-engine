$choice_1 = <<'LITERAL_5175_2783_CHOICE_1';
dfr
LITERAL_5175_2783_CHOICE_1
$choice_2 = <<'LITERAL_5175_2783_CHOICE_2';
df+
LITERAL_5175_2783_CHOICE_2
$choice_3 = <<'LITERAL_5175_2783_CHOICE_3';
d+r
LITERAL_5175_2783_CHOICE_3
$choice_4 = <<'LITERAL_5175_2783_CHOICE_4';
d++
