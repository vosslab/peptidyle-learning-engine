$choice_1 = <<'LITERAL_0983_0534_CHOICE_1';
jky
LITERAL_0983_0534_CHOICE_1
$choice_2 = <<'LITERAL_0983_0534_CHOICE_2';
jk+
LITERAL_0983_0534_CHOICE_2
$choice_3 = <<'LITERAL_0983_0534_CHOICE_3';
j+y
LITERAL_0983_0534_CHOICE_3
