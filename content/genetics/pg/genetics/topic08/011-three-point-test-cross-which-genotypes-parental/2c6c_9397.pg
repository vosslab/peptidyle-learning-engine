$choice_1 = <<'LITERAL_2C6C_9397_CHOICE_1';
bjn
LITERAL_2C6C_9397_CHOICE_1
$choice_2 = <<'LITERAL_2C6C_9397_CHOICE_2';
bj+
LITERAL_2C6C_9397_CHOICE_2
$choice_3 = <<'LITERAL_2C6C_9397_CHOICE_3';
b+n
LITERAL_2C6C_9397_CHOICE_3
$choice_4 = <<'LITERAL_2C6C_9397_CHOICE_4';
b++
LITERAL_2C6C_9397_CHOICE_4
