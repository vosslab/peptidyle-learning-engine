="border: 1px solid black; background-color: #f3e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">21</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">mushy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9c3a1c;">+</span></td><td align="center" style="border: 1px solid black; background-color: #ccf2ff; padding: 5px;"><span style="font-size: large; color: #000000;">m</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #6c43ae;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">334</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;">nerdy</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9c3a1c;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #006a7a;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f3e4ff; padding: 5px;"><span style="font-size: large; color: #000000;">n</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">888</span></td></tr><tr><td align="left" style="border: 1px solid black; background-color: #ffffff; padding: 5px;">&nbsp;<span style="font-size: medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9c3a1c;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #006a7a;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #6c43ae;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">190</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">2,800</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>With the progeny data from the table, and using only the genotypes that result from crossover events between the two genes <b>F</b> and <b>M</b> during meiosis.</p> <p><strong>calculate the genetic distance between the two genes <b>F</b> and <b>M</b>,</strong> expressing your answer in centimorgans (cM)</p> <h6>Important Answer Guidelines</h6><p><ul><li><i>Important Tip 1:</i> Your calculated distance between the pair of genes should be a whole number. Finding a decimal in your answer, such as 5.5, indicates a mistake was made. Please provide your answer as a complete number without fractions or decimals.</li><li><i>Important Tip 2:</i> Your answer should be written as a numerical value only, with no spaces, commas, or units such as "cM" or "map units". For example, if the distance is fifty one centimorgans, simply write "51".</li></ul></p>
PROMPT_1006_1506
$tolerance = "0.10000000";
$answer = Real("24.00000000")->with(tolerance => $tolerance, tolType => 'absolute');
$lower_bound = "23.90000000";
$upper_bound = "24.10000000";
$inclusive_numeric_cmp = sub {
  my ($correct, $student, $ans_hash) = @_;
  my $student_value = $student->value;
  return $student_value >= $lower_bound && $student_value <= $upper_bound;
};
TEXT(MODES(HTML => $prompt, TeX => ''));
BEGIN_TEXT
\{ans_rule(20)\}
END_TEXT
ANS($answer->cmp(checker => $inclusive_numeric_cmp));

ENDDOCUMENT();
