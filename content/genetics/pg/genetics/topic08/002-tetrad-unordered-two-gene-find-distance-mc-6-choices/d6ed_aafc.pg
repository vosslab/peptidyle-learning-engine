distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,334) + 3&times;(122)</td></tr> <tr><td style="text-align: center;">4,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,167 + 366</td></tr> <tr><td style="text-align: center;">4,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,533</td></tr> <tr><td style="text-align: center;">4,800</td></tr></table> = 0.3194 = <strong>31.94 cM</strong>
