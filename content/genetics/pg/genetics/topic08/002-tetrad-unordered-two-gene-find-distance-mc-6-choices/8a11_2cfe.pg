loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_8A11_2CFE_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,221) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1110.5 + 0</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1110.5</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = 0.2776 = <strong>27.76 cM</strong>
