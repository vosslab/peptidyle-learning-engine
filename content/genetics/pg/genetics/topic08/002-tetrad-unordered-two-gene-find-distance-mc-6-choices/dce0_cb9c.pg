distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,787) + 3&times;(61)</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1393.5 + 183</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1576.5</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = 0.3427 = <strong>34.27 cM</strong>
