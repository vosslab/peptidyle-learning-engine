e; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px; background-color: #d8dc7d"><span style="font-size: large; font-family: monospace;">j</span></td> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #006b71;">+</span></td></tr></table></div></span></td> <td align="right" style="border: 1px solid black;"><span style="font-size: medium;">24</span></td></tr><tr> <th colspan="5" align="right" style="border: 1px solid black;">TOTAL =</th> <td align="right" style="border: 1px solid black;">1,200</td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Step-by-Step Instructions</h6><ul> <li>Step 1: Find the row for the Parental Type for all three genes.</li> <li>Step 2: Looking at only your two genes, assign PD, NPD, TT.</li> <li>Step 3: Determine if the two genes are linked.</li> <ul><li>PD &gt;&gt; NPD &rarr; linked; PD &approx; NPD &rarr; unlinked</li></ul> <li>Step 4: Determine the map distance between the two genes.</li> <ul><li>D = &half; (TT + 6 NPD) / total = (3 NPD + &half; TT) / total</li></ul></ul><h5>Determine the distance between the two genes J and P</h5>
PROMPT_051D_000F
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_051D_000F_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(24) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">12 + 0</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">12</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = 0.0100 = <strong>1 cM</strong>
LITERAL_051D_000F_CHOICE_1
$choice_2 = <<'LITERAL_051D_000F_CHOICE_2';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(536) + 3&times;(24)</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">268 + 72</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">340</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = 0.2833 = <strong>28.33 cM</strong>
LITERAL_051D_000F_CHOICE_2
$choice_3 = <<'LITERAL_051D_000F_CHOICE_3';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(536 + 640) + 3&times;(24)</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">588 + 72</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">660</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = 0.5500 = <strong>55 cM</strong>
