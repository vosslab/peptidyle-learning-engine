distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(24) + 3&times;(24)</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">12 + 72</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">84</td></tr> <tr><td style="text-align: center;">1,200</td></tr></table> = 0.0700 = <strong>7 cM</strong>
LITERAL_051D_000F_CHOICE_4
