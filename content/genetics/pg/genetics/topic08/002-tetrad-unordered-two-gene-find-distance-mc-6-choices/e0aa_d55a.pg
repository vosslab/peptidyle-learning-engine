distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(154)</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 462</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">462</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = 0.0722 = <strong>7.22 cM</strong>
