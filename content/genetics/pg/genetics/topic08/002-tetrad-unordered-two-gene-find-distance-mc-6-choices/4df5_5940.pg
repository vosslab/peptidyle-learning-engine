loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_4DF5_5940_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,100 + 3,429) + 3&times;(71)</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2764.5 + 213</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2977.5</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = 0.5317 = <strong>53.17 cM</strong>
