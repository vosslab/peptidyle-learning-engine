distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(4,998) + 3&times;(146)</td></tr> <tr><td style="text-align: center;">8,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,499 + 438</td></tr> <tr><td style="text-align: center;">8,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,937</td></tr> <tr><td style="text-align: center;">8,800</td></tr></table> = 0.3337 = <strong>33.38 cM</strong>
