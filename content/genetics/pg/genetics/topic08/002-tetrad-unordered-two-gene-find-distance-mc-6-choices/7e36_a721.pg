$choice_1 = <<'LITERAL_7E36_A721_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(50) + 3&times;(50)</td></tr> <tr><td style="text-align: center;">4,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">25 + 150</td></tr> <tr><td style="text-align: center;">4,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">175</td></tr> <tr><td style="text-align: center;">4,200</td></tr></table> = 0.0417 = <strong>4.17 cM</strong>
