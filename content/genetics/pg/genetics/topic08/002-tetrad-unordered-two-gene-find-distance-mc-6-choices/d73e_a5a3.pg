distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(70) + 3&times;(70)</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">35 + 210</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">245</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = 0.0490 = <strong>4.90 cM</strong>
