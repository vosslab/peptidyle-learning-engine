loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_D73E_A5A3_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,944) + 3&times;(70)</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">972 + 210</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,182</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = 0.2364 = <strong>23.64 cM</strong>
