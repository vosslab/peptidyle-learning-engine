distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,864) + 3&times;(91)</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">932 + 273</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,205</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = 0.3013 = <strong>30.12 cM</strong>
