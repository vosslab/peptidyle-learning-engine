distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,564) + 3&times;(78)</td></tr> <tr><td style="text-align: center;">7,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,282 + 234</td></tr> <tr><td style="text-align: center;">7,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,516</td></tr> <tr><td style="text-align: center;">7,400</td></tr></table> = 0.2049 = <strong>20.49 cM</strong>
