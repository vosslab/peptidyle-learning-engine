adding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #5f6300;">+</span></td> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #006b71;">+</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #5f6300;">+</span></td> <td align="center" style="border: 0px; background-color: #88e7ee"><span style="font-size: large; font-family: monospace;">n</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px; background-color: #d8dc7d"><span style="font-size: large; font-family: monospace;">e</span></td> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #006b71;">+</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px; background-color: #d8dc7d"><span style="font-size: large; font-family: monospace;">e</span></td> <td align="center" style="border: 0px; background-color: #88e7ee"><span style="font-size: large; font-family: monospace;">n</span></td></tr></table></div></span></td> <td align="right" style="border: 1px solid black;"><span style="font-size: medium;">2,820</span></td></tr><tr> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;">3</span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #5f6300;">+</span></td> <td align="center" style="border: 0px; background-color: #88e7ee"><span style="font-size: large; font-family: monospace;">n</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #5f6300;">+</span></td> <td align="center" style="border: 0px; background-color: #88e7ee"><span style="font-size: large; font-family: monospace;">n</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px; background-color: #d8dc7d"><span style="font-size: large; font-family: monospace;">e</span></td> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #006b71;">+</span></td></tr></table></div></span></td> <td align="center" style="border: 1px solid black;"><span style="font-size: medium;"><div style="padding-left: 5px; padding-right: 5px;"><table style="border-collapse: collapse; border: 0px; padding-left: 50px; padding-right: 50px;"><tr> <td align="center" style="border: 0px; background-color: #d8dc7d"><span style="font-size: large; font-family: monospace;">e</span></td> <td align="center" style="border: 0px;"><span style="font-size: large; font-family: monospace; color: #006b71;">+</span></td></tr></table></div></span></td> <td align="right" style="border: 1px solid black;"><span style="font-size: medium;">3,662</span></td></tr><tr> <th colspan="5" align="right" style="border: 1px solid black;">TOTAL =</th> <td align="right" style="border: 1px solid black;">6,600</td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Step-by-Step Instructions</h6><ul> <li>Step 1: Find the row for the Parental Type for all three genes.</li> <li>Step 2: Looking at only your two genes, assign PD, NPD, TT.</li> <li>Step 3: Determine if the two genes are linked.</li> <ul><li>PD &gt;&gt; NPD &rarr; linked; PD &approx; NPD &rarr; unlinked</li></ul> <li>Step 4: Determine the map distance between the two genes.</li> <ul><li>D = &half; (TT + 6 NPD) / total = (3 NPD + &half; TT) / total</li></ul></ul><h5>Determine the distance between the two genes E and N</h5>
PROMPT_B734_0006
loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_B734_0006_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(118)</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 354</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">354</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = 0.0536 = <strong>5.36 cM</strong>
