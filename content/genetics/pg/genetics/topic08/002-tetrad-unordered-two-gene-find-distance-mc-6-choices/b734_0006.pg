distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,820) + 3&times;(118)</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,410 + 354</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,764</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = 0.2673 = <strong>26.73 cM</strong>
