distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,389) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">694.5 + 0</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">694.5</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = 0.3157 = <strong>31.57 cM</strong>
