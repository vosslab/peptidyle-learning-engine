$choice_1 = <<'LITERAL_50E2_7EDA_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,529) + 3&times;(117)</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1264.5 + 351</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1615.5</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = 0.3231 = <strong>32.31 cM</strong>
