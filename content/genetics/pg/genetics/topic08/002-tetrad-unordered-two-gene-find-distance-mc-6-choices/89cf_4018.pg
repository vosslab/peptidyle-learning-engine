loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_89CF_4018_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(92) + 3&times;(92)</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">46 + 276</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">322</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = 0.0847 = <strong>8.47 cM</strong>
