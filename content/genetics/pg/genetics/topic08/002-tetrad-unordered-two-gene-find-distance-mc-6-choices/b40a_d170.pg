distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(83)</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 249</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">249</td></tr> <tr><td style="text-align: center;">3,800</td></tr></table> = 0.0655 = <strong>6.55 cM</strong>
