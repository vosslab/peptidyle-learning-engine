distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,250) + 3&times;(112)</td></tr> <tr><td style="text-align: center;">8,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,625 + 336</td></tr> <tr><td style="text-align: center;">8,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,961</td></tr> <tr><td style="text-align: center;">8,600</td></tr></table> = 0.2280 = <strong>22.80 cM</strong>
