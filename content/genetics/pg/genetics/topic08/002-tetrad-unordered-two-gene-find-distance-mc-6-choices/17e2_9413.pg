$choice_1 = <<'LITERAL_17E2_9413_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(998) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">2,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">499 + 0</td></tr> <tr><td style="text-align: center;">2,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">499</td></tr> <tr><td style="text-align: center;">2,800</td></tr></table> = 0.1782 = <strong>17.82 cM</strong>
