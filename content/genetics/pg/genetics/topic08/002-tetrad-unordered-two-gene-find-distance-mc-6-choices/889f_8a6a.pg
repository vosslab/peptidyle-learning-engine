$choice_1 = <<'LITERAL_889F_8A6A_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,972) + 3&times;(100)</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">986 + 300</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,286</td></tr> <tr><td style="text-align: center;">4,000</td></tr></table> = 0.3215 = <strong>32.15 cM</strong>
