distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,110) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">555 + 0</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">555</td></tr> <tr><td style="text-align: center;">2,200</td></tr></table> = 0.2523 = <strong>25.23 cM</strong>
