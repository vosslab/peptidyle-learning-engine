distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(74) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">37 + 0</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">37</td></tr> <tr><td style="text-align: center;">6,400</td></tr></table> = 0.0058 = <strong>0.58 cM</strong>
