distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,954) + 3&times;(160)</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,977 + 480</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,457</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = 0.2614 = <strong>26.14 cM</strong>
