distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,892) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,446 + 0</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,446</td></tr> <tr><td style="text-align: center;">5,600</td></tr></table> = 0.2582 = <strong>25.82 cM</strong>
