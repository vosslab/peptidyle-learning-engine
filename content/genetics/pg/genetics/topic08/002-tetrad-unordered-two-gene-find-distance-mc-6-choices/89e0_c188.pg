distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(112) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">56 + 0</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">56</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = 0.0104 = <strong>1.04 cM</strong>
