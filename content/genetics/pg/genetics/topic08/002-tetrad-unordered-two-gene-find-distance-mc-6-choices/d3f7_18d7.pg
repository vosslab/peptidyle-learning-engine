distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(142) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">71 + 0</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">71</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = 0.0089 = <strong>0.89 cM</strong>
