distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(98) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">49 + 0</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">49</td></tr> <tr><td style="text-align: center;">4,600</td></tr></table> = 0.0107 = <strong>1.07 cM</strong>
