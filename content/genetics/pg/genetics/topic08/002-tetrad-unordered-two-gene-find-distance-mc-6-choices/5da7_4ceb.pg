distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(94)</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 282</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">282</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = 0.0470 = <strong>4.70 cM</strong>
