distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,162 + 1,177) + 3&times;(61)</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1169.5 + 183</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1352.5</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = 0.5635 = <strong>56.35 cM</strong>
