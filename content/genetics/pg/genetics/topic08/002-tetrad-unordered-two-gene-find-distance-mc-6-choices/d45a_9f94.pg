distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,914) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">3,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">957 + 0</td></tr> <tr><td style="text-align: center;">3,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">957</td></tr> <tr><td style="text-align: center;">3,200</td></tr></table> = 0.2991 = <strong>29.91 cM</strong>
