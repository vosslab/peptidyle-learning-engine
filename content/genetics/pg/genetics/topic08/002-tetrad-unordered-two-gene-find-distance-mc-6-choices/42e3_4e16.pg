distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(2,094) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,047 + 0</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,047</td></tr> <tr><td style="text-align: center;">5,000</td></tr></table> = 0.2094 = <strong>20.94 cM</strong>
