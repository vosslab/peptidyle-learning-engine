$choice_1 = <<'LITERAL_53EB_8E20_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(41) + 3&times;(41)</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">20.5 + 123</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">143.5</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = 0.0598 = <strong>5.98 cM</strong>
