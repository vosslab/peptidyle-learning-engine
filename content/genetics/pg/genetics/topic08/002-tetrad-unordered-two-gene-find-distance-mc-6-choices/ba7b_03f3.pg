loadMacros('parserRadioButtons.pl');
$choice_1 = <<'LITERAL_BA7B_03F3_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,648 + 4,181) + 3&times;(171)</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">3914.5 + 513</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">4427.5</td></tr> <tr><td style="text-align: center;">8,000</td></tr></table> = 0.5534 = <strong>55.34 cM</strong>
