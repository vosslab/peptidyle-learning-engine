$choice_1 = <<'LITERAL_6604_EF1B_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(128) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">64 + 0</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">64</td></tr> <tr><td style="text-align: center;">6,000</td></tr></table> = 0.0107 = <strong>1.07 cM</strong>
