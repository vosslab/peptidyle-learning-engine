distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(124)</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 372</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">372</td></tr> <tr><td style="text-align: center;">5,400</td></tr></table> = 0.0689 = <strong>6.89 cM</strong>
