distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(64)</td></tr> <tr><td style="text-align: center;">5,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 192</td></tr> <tr><td style="text-align: center;">5,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">192</td></tr> <tr><td style="text-align: center;">5,200</td></tr></table> = 0.0369 = <strong>3.69 cM</strong>
