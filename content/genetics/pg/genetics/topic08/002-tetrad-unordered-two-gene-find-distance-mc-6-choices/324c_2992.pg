$choice_1 = <<'LITERAL_324C_2992_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(89) + 3&times;(89)</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">44.5 + 267</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">311.5</td></tr> <tr><td style="text-align: center;">6,600</td></tr></table> = 0.0472 = <strong>4.72 cM</strong>
