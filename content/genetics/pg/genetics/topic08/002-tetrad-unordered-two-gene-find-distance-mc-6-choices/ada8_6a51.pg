$choice_1 = <<'LITERAL_ADA8_6A51_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(512) + 3&times;(16)</td></tr> <tr><td style="text-align: center;">1,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">256 + 48</td></tr> <tr><td style="text-align: center;">1,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">304</td></tr> <tr><td style="text-align: center;">1,400</td></tr></table> = 0.2171 = <strong>21.71 cM</strong>
