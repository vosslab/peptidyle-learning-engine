distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(0) + 3&times;(54)</td></tr> <tr><td style="text-align: center;">2,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">0 + 162</td></tr> <tr><td style="text-align: center;">2,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">162</td></tr> <tr><td style="text-align: center;">2,600</td></tr></table> = 0.0623 = <strong>6.23 cM</strong>
