distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,758) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">6,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,879 + 0</td></tr> <tr><td style="text-align: center;">6,200</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,879</td></tr> <tr><td style="text-align: center;">6,200</td></tr></table> = 0.3031 = <strong>30.31 cM</strong>
