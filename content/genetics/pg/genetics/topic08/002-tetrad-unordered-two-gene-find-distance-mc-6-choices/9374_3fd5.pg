distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(107) + 3&times;(107)</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">53.5 + 321</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">374.5</td></tr> <tr><td style="text-align: center;">9,400</td></tr></table> = 0.0398 = <strong>3.98 cM</strong>
