distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(103) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">6,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">51.5 + 0</td></tr> <tr><td style="text-align: center;">6,800</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">51.5</td></tr> <tr><td style="text-align: center;">6,800</td></tr></table> = 0.0076 = <strong>0.76 cM</strong>
