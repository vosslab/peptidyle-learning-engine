distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(5,477) + 3&times;(157)</td></tr> <tr><td style="text-align: center;">9,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2738.5 + 471</td></tr> <tr><td style="text-align: center;">9,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">3209.5</td></tr> <tr><td style="text-align: center;">9,600</td></tr></table> = 0.3343 = <strong>33.43 cM</strong>
