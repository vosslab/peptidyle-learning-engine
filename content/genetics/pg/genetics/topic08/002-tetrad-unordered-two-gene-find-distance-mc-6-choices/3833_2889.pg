distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(47) + 3&times;(47)</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">23.5 + 141</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">164.5</td></tr> <tr><td style="text-align: center;">2,400</td></tr></table> = 0.0685 = <strong>6.85 cM</strong>
