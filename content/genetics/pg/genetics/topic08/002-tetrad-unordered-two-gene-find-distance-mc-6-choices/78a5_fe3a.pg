distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,278) + 3&times;(139)</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,639 + 417</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,056</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = 0.2705 = <strong>27.05 cM</strong>
