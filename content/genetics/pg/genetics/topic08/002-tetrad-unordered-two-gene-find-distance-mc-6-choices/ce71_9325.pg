distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(3,604) + 3&times;(135)</td></tr> <tr><td style="text-align: center;">9,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">1,802 + 405</td></tr> <tr><td style="text-align: center;">9,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,207</td></tr> <tr><td style="text-align: center;">9,000</td></tr></table> = 0.2452 = <strong>24.52 cM</strong>
