distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(140) + 3&times;(140)</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">70 + 420</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">490</td></tr> <tr><td style="text-align: center;">7,600</td></tr></table> = 0.0645 = <strong>6.45 cM</strong>
