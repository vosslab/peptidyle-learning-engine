distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(148) + 3&times;(148)</td></tr> <tr><td style="text-align: center;">8,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">74 + 444</td></tr> <tr><td style="text-align: center;">8,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">518</td></tr> <tr><td style="text-align: center;">8,400</td></tr></table> = 0.0617 = <strong>6.17 cM</strong>
