$choice_1 = <<'LITERAL_EF93_A5CA_CHOICE_1';
distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(1,472) + 3&times;(63)</td></tr> <tr><td style="text-align: center;">3,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">736 + 189</td></tr> <tr><td style="text-align: center;">3,400</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">925</td></tr> <tr><td style="text-align: center;">3,400</td></tr></table> = 0.2721 = <strong>27.21 cM</strong>
