distance = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">&half;(4,150) + 3&times;(0)</td></tr> <tr><td style="text-align: center;">7,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,075 + 0</td></tr> <tr><td style="text-align: center;">7,000</td></tr></table> = <table style="border-collapse: collapse; display: inline-table; vertical-align: middle;"> <tr><td style="border-bottom: 1px solid black; text-align: center;">2,075</td></tr> <tr><td style="text-align: center;">7,000</td></tr></table> = 0.2964 = <strong>29.64 cM</strong>
LITERAL_9751_20D2_CHOICE_5
