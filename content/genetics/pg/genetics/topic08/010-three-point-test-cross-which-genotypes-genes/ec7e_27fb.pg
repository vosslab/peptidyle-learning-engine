+++
LITERAL_EC7E_27FB_CHOICE_8
$correct_1 = <<'LITERAL_EC7E_27FB_CORRECT_1';
fj+
LITERAL_EC7E_27FB_CORRECT_1
$correct_2 = <<'LITERAL_EC7E_27FB_CORRECT_2';
f++
LITERAL_EC7E_27FB_CORRECT_2
