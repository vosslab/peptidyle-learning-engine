medium; color: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #7f5402;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #0e6a75;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #6640bd;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">61</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">1,200</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>Based on the traits expressed in the offspring, identify the <span style="color: DarkBlue;"><strong>all recombinant genotypes</strong></span> for genes <b>T</b> and <b>J</b>. These genotypes result from crossover events that occur between the two genes <b>T</b> and <b>J</b> during meiosis.</p> <p>More than one genotype will be correct. Select all that apply.</p>
PROMPT_C19C_29CF
loadMacros('parserCheckboxList.pl');
$choice_1 = <<'LITERAL_C19C_29CF_CHOICE_1';
jrt
LITERAL_C19C_29CF_CHOICE_1
$choice_2 = <<'LITERAL_C19C_29CF_CHOICE_2';
jr+
LITERAL_C19C_29CF_CHOICE_2
$choice_3 = <<'LITERAL_C19C_29CF_CHOICE_3';
j+t
LITERAL_C19C_29CF_CHOICE_3
$choice_4 = <<'LITERAL_C19C_29CF_CHOICE_4';
j++
LITERAL_C19C_29CF_CHOICE_4
$choice_5 = <<'LITERAL_C19C_29CF_CHOICE_5';
+rt
LITERAL_C19C_29CF_CHOICE_5
$choice_6 = <<'LITERAL_C19C_29CF_CHOICE_6';
+r+
LITERAL_C19C_29CF_CHOICE_6
$choice_7 = <<'LITERAL_C19C_29CF_CHOICE_7';
++t
LITERAL_C19C_29CF_CHOICE_7
$choice_8 = <<'LITERAL_C19C_29CF_CHOICE_8';
+++
LITERAL_C19C_29CF_CHOICE_8
$correct_1 = <<'LITERAL_C19C_29CF_CORRECT_1';
jr+
LITERAL_C19C_29CF_CORRECT_1
$correct_2 = <<'LITERAL_C19C_29CF_CORRECT_2';
j++
LITERAL_C19C_29CF_CORRECT_2
$correct_3 = <<'LITERAL_C19C_29CF_CORRECT_3';
+rt
LITERAL_C19C_29CF_CORRECT_3
$correct_4 = <<'LITERAL_C19C_29CF_CORRECT_4';
++t
LITERAL_C19C_29CF_CORRECT_4
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7, $choice_8);
@correct = ($correct_1, $correct_2, $correct_3, $correct_4);
$answer = CheckboxList([@choices], [@correct], labels => 'ABC', displayLabels => 1, randomize => 0, separator => '<div style="margin-bottom: 0.7em;"></div>');
