LITERAL_D77D_3C51_CHOICE_7
$choice_8 = <<'LITERAL_D77D_3C51_CHOICE_8';
+++
LITERAL_D77D_3C51_CHOICE_8
$correct_1 = <<'LITERAL_D77D_3C51_CORRECT_1';
e+m
LITERAL_D77D_3C51_CORRECT_1
$correct_2 = <<'LITERAL_D77D_3C51_CORRECT_2';
e++
LITERAL_D77D_3C51_CORRECT_2
