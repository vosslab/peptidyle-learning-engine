+++
LITERAL_AC2D_101D_CHOICE_8
$correct_1 = <<'LITERAL_AC2D_101D_CORRECT_1';
cfh
LITERAL_AC2D_101D_CORRECT_1
$correct_2 = <<'LITERAL_AC2D_101D_CORRECT_2';
cf+
LITERAL_AC2D_101D_CORRECT_2
$correct_3 = <<'LITERAL_AC2D_101D_CORRECT_3';
++h
LITERAL_AC2D_101D_CORRECT_3
