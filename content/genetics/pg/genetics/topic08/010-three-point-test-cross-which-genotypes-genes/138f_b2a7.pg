f+k
LITERAL_138F_B2A7_CHOICE_3
$choice_4 = <<'LITERAL_138F_B2A7_CHOICE_4';
f++
LITERAL_138F_B2A7_CHOICE_4
$choice_5 = <<'LITERAL_138F_B2A7_CHOICE_5';
+hk
LITERAL_138F_B2A7_CHOICE_5
