e+x
LITERAL_3A6D_681E_CHOICE_3
$choice_4 = <<'LITERAL_3A6D_681E_CHOICE_4';
e++
LITERAL_3A6D_681E_CHOICE_4
$choice_5 = <<'LITERAL_3A6D_681E_CHOICE_5';
+nx
LITERAL_3A6D_681E_CHOICE_5
