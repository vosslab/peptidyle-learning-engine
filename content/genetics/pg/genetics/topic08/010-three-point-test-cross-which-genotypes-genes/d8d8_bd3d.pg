$choice_1 = <<'LITERAL_D8D8_BD3D_CHOICE_1';
ajm
LITERAL_D8D8_BD3D_CHOICE_1
$choice_2 = <<'LITERAL_D8D8_BD3D_CHOICE_2';
aj+
