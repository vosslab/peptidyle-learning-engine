$choice_3 = <<'LITERAL_5274_523C_CHOICE_3';
k+x
LITERAL_5274_523C_CHOICE_3
$choice_4 = <<'LITERAL_5274_523C_CHOICE_4';
k++
LITERAL_5274_523C_CHOICE_4
$choice_5 = <<'LITERAL_5274_523C_CHOICE_5';
+px
