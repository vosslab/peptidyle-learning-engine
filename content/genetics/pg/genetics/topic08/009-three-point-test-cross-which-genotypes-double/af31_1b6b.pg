or: #000000;"><i>wildtype</i></span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #9c3a1c;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #1d6d53;">+</span></td><td align="center" style="border: 1px solid black; background-color: #f8f8f8; padding: 5px;"><span style="font-size: large; color: #6c40b5;">+</span></td><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">723</span></td></tr><tr><th colspan="4" align="right" style="border: 1px solid black; background-color: #cccccc; padding: 10px;"><span style="font-size: medium; color: #000000;">TOTAL =</span></th><td align="right" style="border: 1px solid black; background-color: #ffffff; padding: 5px;"><span style="font-size: medium; color: #000000;">8,600</span></td></tr></table><p>The resulting phenotypes are summarized in the table above.</p> <h6>Question</h6> <p>Based on the traits expressed in the offspring, identify the <span style="color: DarkGreen;"><strong>double crossover genotype combinations</strong></span>. These allele combinations are a result of two genetic crossover events.</p> <p>More than one genotype will be correct. Select all that apply.</p>
PROMPT_AF31_1B6B
loadMacros('parserCheckboxList.pl');
$choice_1 = <<'LITERAL_AF31_1B6B_CHOICE_1';
amp
LITERAL_AF31_1B6B_CHOICE_1
$choice_2 = <<'LITERAL_AF31_1B6B_CHOICE_2';
am+
LITERAL_AF31_1B6B_CHOICE_2
$choice_3 = <<'LITERAL_AF31_1B6B_CHOICE_3';
a+p
LITERAL_AF31_1B6B_CHOICE_3
$choice_4 = <<'LITERAL_AF31_1B6B_CHOICE_4';
a++
LITERAL_AF31_1B6B_CHOICE_4
$choice_5 = <<'LITERAL_AF31_1B6B_CHOICE_5';
+mp
LITERAL_AF31_1B6B_CHOICE_5
$choice_6 = <<'LITERAL_AF31_1B6B_CHOICE_6';
+m+
LITERAL_AF31_1B6B_CHOICE_6
$choice_7 = <<'LITERAL_AF31_1B6B_CHOICE_7';
++p
LITERAL_AF31_1B6B_CHOICE_7
$choice_8 = <<'LITERAL_AF31_1B6B_CHOICE_8';
+++
LITERAL_AF31_1B6B_CHOICE_8
$correct_1 = <<'LITERAL_AF31_1B6B_CORRECT_1';
a++
LITERAL_AF31_1B6B_CORRECT_1
$correct_2 = <<'LITERAL_AF31_1B6B_CORRECT_2';
+mp
LITERAL_AF31_1B6B_CORRECT_2
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7, $choice_8);
@correct = ($correct_1, $correct_2);
$answer = CheckboxList([@choices], [@correct], labels => 'ABC', displayLabels => 1, randomize => 0, separator => '<div style="margin-bottom: 0.7em;"></div>');
