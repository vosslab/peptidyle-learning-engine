$choice_1 = <<'LITERAL_F7DD_C96E_CHOICE_1';
bcf
LITERAL_F7DD_C96E_CHOICE_1
$choice_2 = <<'LITERAL_F7DD_C96E_CHOICE_2';
bc+
LITERAL_F7DD_C96E_CHOICE_2
