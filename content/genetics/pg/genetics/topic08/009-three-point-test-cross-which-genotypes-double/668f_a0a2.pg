bnt
LITERAL_668F_A0A2_CHOICE_1
$choice_2 = <<'LITERAL_668F_A0A2_CHOICE_2';
bn+
LITERAL_668F_A0A2_CHOICE_2
$choice_3 = <<'LITERAL_668F_A0A2_CHOICE_3';
b+t
LITERAL_668F_A0A2_CHOICE_3
