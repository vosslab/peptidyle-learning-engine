+e+
LITERAL_A1ED_D9F5_CHOICE_6
$choice_7 = <<'LITERAL_A1ED_D9F5_CHOICE_7';
++t
LITERAL_A1ED_D9F5_CHOICE_7
$choice_8 = <<'LITERAL_A1ED_D9F5_CHOICE_8';
