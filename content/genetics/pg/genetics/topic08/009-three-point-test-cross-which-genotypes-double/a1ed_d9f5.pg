ae+
LITERAL_A1ED_D9F5_CORRECT_1
$correct_2 = <<'LITERAL_A1ED_D9F5_CORRECT_2';
++t
LITERAL_A1ED_D9F5_CORRECT_2
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7, $choice_8);
