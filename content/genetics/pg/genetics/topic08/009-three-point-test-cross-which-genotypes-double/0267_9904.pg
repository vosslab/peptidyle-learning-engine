$choice_1 = <<'LITERAL_0267_9904_CHOICE_1';
ahj
LITERAL_0267_9904_CHOICE_1
$choice_2 = <<'LITERAL_0267_9904_CHOICE_2';
ah+
LITERAL_0267_9904_CHOICE_2
$choice_3 = <<'LITERAL_0267_9904_CHOICE_3';
a+j
LITERAL_0267_9904_CHOICE_3
$choice_4 = <<'LITERAL_0267_9904_CHOICE_4';
a++
