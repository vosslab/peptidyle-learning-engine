$choice_9 = <<'LITERAL_627E_E662_CHOICE_9';
complete interference, 100%
LITERAL_627E_E662_CHOICE_9
$correct_1 = <<'LITERAL_627E_E662_CORRECT_1';
<sup>1</sup>/<sub>11</sub> = 0.0909 = 9%
LITERAL_627E_E662_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6, $choice_7, $choice_8, $choice_9);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
