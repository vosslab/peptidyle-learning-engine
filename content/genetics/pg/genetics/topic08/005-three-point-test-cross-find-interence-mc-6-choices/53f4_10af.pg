LITERAL_53F4_10AF_CHOICE_3
$choice_4 = <<'LITERAL_53F4_10AF_CHOICE_4';
<sup>3</sup>/<sub>7</sub> = 0.4286 = 43%
LITERAL_53F4_10AF_CHOICE_4
$choice_5 = <<'LITERAL_53F4_10AF_CHOICE_5';
<sup>1</sup>/<sub>2</sub> = 0.5000 = 50%
LITERAL_53F4_10AF_CHOICE_5
$choice_6 = <<'LITERAL_53F4_10AF_CHOICE_6';
<sup>4</sup>/<sub>7</sub> = 0.5714 = 57%
LITERAL_53F4_10AF_CHOICE_6
$choice_7 = <<'LITERAL_53F4_10AF_CHOICE_7';
