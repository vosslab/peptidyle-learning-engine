LITERAL_2404_BAF0_CHOICE_3
$choice_4 = <<'LITERAL_2404_BAF0_CHOICE_4';
<sup>1</sup>/<sub>2</sub> = 0.5000 = 50%
LITERAL_2404_BAF0_CHOICE_4
$choice_5 = <<'LITERAL_2404_BAF0_CHOICE_5';
<sup>2</sup>/<sub>3</sub> = 0.6667 = 67%
LITERAL_2404_BAF0_CHOICE_5
$choice_6 = <<'LITERAL_2404_BAF0_CHOICE_6';
<sup>5</sup>/<sub>6</sub> = 0.8333 = 83%
