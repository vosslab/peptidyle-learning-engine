LITERAL_945C_40F0_CHOICE_3
$choice_4 = <<'LITERAL_945C_40F0_CHOICE_4';
<sup>5</sup>/<sub>12</sub> = 0.4167 = 42%
LITERAL_945C_40F0_CHOICE_4
$choice_5 = <<'LITERAL_945C_40F0_CHOICE_5';
<sup>1</sup>/<sub>2</sub> = 0.5000 = 50%
LITERAL_945C_40F0_CHOICE_5
$choice_6 = <<'LITERAL_945C_40F0_CHOICE_6';
<sup>7</sup>/<sub>12</sub> = 0.5833 = 58%
LITERAL_945C_40F0_CHOICE_6
$choice_7 = <<'LITERAL_945C_40F0_CHOICE_7';
<sup>3</sup>/<sub>4</sub> = 0.7500 = 75%
LITERAL_945C_40F0_CHOICE_7
$choice_8 = <<'LITERAL_945C_40F0_CHOICE_8';
<sup>11</sup>/<sub>12</sub> = 0.9167 = 92%
LITERAL_945C_40F0_CHOICE_8
