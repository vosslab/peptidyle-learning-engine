LITERAL_B994_C07E_CHOICE_2
$choice_3 = <<'LITERAL_B994_C07E_CHOICE_3';
<sup>(22,094 + 57,910)</sup>/<sub>160,000</sub> = <sup>80,004</sup>/<sub>160,000</sub> = 0.5000 = <strong>50.00 cM</strong>
LITERAL_B994_C07E_CHOICE_3
$choice_4 = <<'LITERAL_B994_C07E_CHOICE_4';
<sup>(22,114 + 57,882)</sup>/<sub>160,000</sub> = <sup>79,996</sup>/<sub>160,000</sub> = 0.5000 = <strong>50.00 cM</strong>
LITERAL_B994_C07E_CHOICE_4
$choice_5 = <<'LITERAL_B994_C07E_CHOICE_5';
<sup>(22,114 + 57,910)</sup>/<sub>160,000</sub> = <sup>80,024</sup>/<sub>160,000</sub> = 0.5001 = <strong>50.02 cM</strong>
LITERAL_B994_C07E_CHOICE_5
$choice_6 = <<'LITERAL_B994_C07E_CHOICE_6';
<sup>(57,882 + 57,910)</sup>/<sub>160,000</sub> = <sup>115,792</sup>/<sub>160,000</sub> = 0.7237 = <strong>72.37 cM</strong>
LITERAL_B994_C07E_CHOICE_6
$correct_1 = <<'LITERAL_B994_C07E_CORRECT_1';
<sup>(22,094 + 22,114)</sup>/<sub>160,000</sub> = <sup>44,208</sup>/<sub>160,000</sub> = 0.2763 = <strong>27.63 cM</strong>
LITERAL_B994_C07E_CORRECT_1
@choices = ($choice_1, $choice_2, $choice_3, $choice_4, $choice_5, $choice_6);
$answer = RadioButtons([@choices], $correct_1, labels => 'ABC', displayLabels => 1, randomize => 0, noindex => 1, separator => '<div style="margin-bottom: 0.7em;"></div>');
