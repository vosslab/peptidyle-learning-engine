LITERAL_372B_7D98_CHOICE_3
$choice_4 = <<'LITERAL_372B_7D98_CHOICE_4';
<sup>(13,245 + 31,567)</sup>/<sub>90,000</sub> = <sup>44,812</sup>/<sub>90,000</sub> = 0.4979 = <strong>49.79 cM</strong>
LITERAL_372B_7D98_CHOICE_4
$choice_5 = <<'LITERAL_372B_7D98_CHOICE_5';
<sup>(13,245 + 32,000)</sup>/<sub>90,000</sub> = <sup>45,245</sup>/<sub>90,000</sub> = 0.5027 = <strong>50.27 cM</strong>
LITERAL_372B_7D98_CHOICE_5
$choice_6 = <<'LITERAL_372B_7D98_CHOICE_6';
<sup>(31,567 + 32,000)</sup>/<sub>90,000</sub> = <sup>63,567</sup>/<sub>90,000</sub> = 0.7063 = <strong>70.63 cM</strong>
LITERAL_372B_7D98_CHOICE_6
$correct_1 = <<'LITERAL_372B_7D98_CORRECT_1';
<sup>(13,188 + 13,245)</sup>/<sub>90,000</sub> = <sup>26,433</sup>/<sub>90,000</sub> = 0.2937 = <strong>29.37 cM</strong>
LITERAL_372B_7D98_CORRECT_1
