$choice_4 = <<'LITERAL_0239_CD79_CHOICE_4';
<sup>(7,913 + 7,990)</sup>/<sub>47,500</sub> = <sup>15,903</sup>/<sub>47,500</sub> = 0.3348 = <strong>33.48 cM</strong>
LITERAL_0239_CD79_CHOICE_4
$choice_5 = <<'LITERAL_0239_CD79_CHOICE_5';
<sup>(7,990 + 15,693)</sup>/<sub>47,500</sub> = <sup>23,683</sup>/<sub>47,500</sub> = 0.4986 = <strong>49.86 cM</strong>
LITERAL_0239_CD79_CHOICE_5
$choice_6 = <<'LITERAL_0239_CD79_CHOICE_6';
<sup>(7,990 + 15,904)</sup>/<sub>47,500</sub> = <sup>23,894</sup>/<sub>47,500</sub> = 0.5030 = <strong>50.30 cM</strong>
LITERAL_0239_CD79_CHOICE_6
$correct_1 = <<'LITERAL_0239_CD79_CORRECT_1';
<sup>(7,913 + 7,990)</sup>/<sub>47,500</sub> = <sup>15,903</sup>/<sub>47,500</sub> = 0.3348 = <strong>33.48 cM</strong>
