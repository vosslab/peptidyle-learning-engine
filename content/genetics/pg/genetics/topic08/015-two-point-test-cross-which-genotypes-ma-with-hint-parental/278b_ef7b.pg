+w
LITERAL_278B_EF7B_CHOICE_3
$choice_4 = <<'LITERAL_278B_EF7B_CHOICE_4';
++
LITERAL_278B_EF7B_CHOICE_4
$correct_1 = <<'LITERAL_278B_EF7B_CORRECT_1';
b+
LITERAL_278B_EF7B_CORRECT_1
$correct_2 = <<'LITERAL_278B_EF7B_CORRECT_2';
+w
LITERAL_278B_EF7B_CORRECT_2
@choices = ($choice_1, $choice_2, $choice_3, $choice_4);
@correct = ($correct_1, $correct_2);
$answer = CheckboxList([@choices], [@correct], labels => 'ABC', displayLabels => 1, randomize => 0, separator => '<div style="margin-bottom: 0.7em;"></div>');
