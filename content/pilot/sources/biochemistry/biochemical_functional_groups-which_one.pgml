## DESCRIPTION
## Select the biochemical functional group that corresponds to the given description.
## ENDDESCRIPTION
## KEYWORDS('seven biochemical functional groups','descriptions','which one','multiple choice')
## DBsubject('Biochemistry')
## DBchapter('')
## DBsection('')
## Date('2026-07-12')
## Author('Neil R. Voss')
## Institution('Roosevelt University')

